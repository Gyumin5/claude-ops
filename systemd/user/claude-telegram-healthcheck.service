[Unit]
Description=Claude Telegram Healthcheck (프로젝트 봇 inbound 좀비 감시)

[Service]
Type=oneshot
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.local/bin/claude-telegram-healthcheck
StandardOutput=append:%h/.claude/logs/telegram-healthcheck.log
StandardError=append:%h/.claude/logs/telegram-healthcheck.log
