#!/bin/bash
# claude-session-nudge: 지정 세션들에게 주기적으로 "진행상황 보고 + 계속 진행"
# 메시지를 텔레그램(userbot)으로 주입. "밤새/N시간 계속해"를 줘도 세션이
# ScheduleWakeup 자기판단에 실패해 도중에 멈추는 문제의 외부 결정론적 대체재.
#
# 재설계(2026-07-24): 세션별 독립 설정 + 세션별 지속 데몬(systemd 템플릿 유닛).
#  - 상태: 세션별 파일 ~/.claude/state/session-nudge/<session>.json (원자적, 상호 비간섭).
#  - 유닛: claude-session-nudge@<session>.service (Type=simple, Restart=on-failure,
#          내부 while 루프. end_ts 도달/enabled=false 면 정상 exit 0 → Restart 안 됨.
#          크래시(exit!=0)만 부활 → 침묵사망 방지).
#  - 한 세션 등록/중단이 다른 세션에 영향 없음(구 단일 상태파일 통째 덮어쓰기 버그 해소).
#
# 사용:
#   claude-session-nudge --start --sessions <세션1>,<세션2> --hours 8 [--interval 30] [--message TEXT]
#   claude-session-nudge --start --sessions <세션> --until 09:00
#   claude-session-nudge --stop <session>        # 전체는 --stop --all (인자 없으면 거절)
#   claude-session-nudge --status
#   claude-session-nudge --refresh-defaults      # 등록분의 문구·간격을 지금 기본값으로
#   claude-session-nudge --daemon <session>      # systemd 템플릿 유닛이 호출하는 데몬 모드

set -uo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/operator_chat.sh"   # 방 번호 단일 출처

# 저장소 안 자리는 자기 위치에서 뽑는다. 심링크로 배포되니 readlink 로 실체를 먼저 푼다.
NUDGE_REPO_DIR="$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")"

STATE_DIR="${CLAUDE_NUDGE_STATE_DIR:-$HOME/.claude/state}"
NUDGE_DIR="$STATE_DIR/session-nudge"          # 세션별 <session>.json 디렉토리
LEGACY_STATE="$STATE_DIR/session-nudge.json"  # 구 단일 상태파일(마이그레이션 후 .bak)
# 검사가 실제 운영 로그에 줄을 쌓지 않도록 경로를 바꿀 수 있게 둔다.
LOG_FILE="${CLAUDE_NUDGE_LOG:-$HOME/.claude/logs/session-nudge.log}"
# 회차마다 같은 자리에 같은 칸으로 적는 기계용 기록. 위 LOG_FILE 은 사람이 읽는 문장이라
# 문구를 고칠 때마다 집계가 깨진다 — 실제로 옛 기록은 "전송: <세션>" 과 "<세션>: 전송" 이
# 섞여 있어서 사유별로 셀 수가 없다. 판정에 쓴 값을 칸으로 남겨야 나중에 세어진다.
TICK_LOG="${CLAUDE_NUDGE_TICKLOG:-$HOME/.claude/logs/nudge-ticks.log}"
SEND="${CLAUDE_NUDGE_SEND:-$HOME/.local/bin/claude-userbot-send}"
PROBE="${CLAUDE_NUDGE_PROBE:-$HOME/.local/bin/claude-session-probe}"
# 운영자 알림용 dotfiles 봇. 파일이 없으면 tg() 가 조용히 아무것도 안 한다.
TG_ENV="${CLAUDE_NUDGE_TG_ENV:-$NUDGE_REPO_DIR/.claude/telegram/.env}"
TG_CHAT="$(operator_chat_id)" || exit 1
# 주입 주기(분). 데몬은 이 간격으로 깨어 회차마다 주입한다. 유휴 임계로 거르지 않는다 —
# 2026-10-16 운영자 지시("주기를 그냥 10분으로 고정하자", "10분마다
# 항상 보내라고해")로 2026-10-14 의 유휴 주입을 되돌렸다. 되돌릴 수 있었던 것은 주입이
# 15분 뒤 저절로 지워져서 운영자 화면에 안 쌓이기 때문이다. 일하는 세션에도 들어가지만
# 받는 쪽은 그 회차에 답장을 쓰지 않고 하던 일을 이어간다.
DEFAULT_INTERVAL=10
# 주입이 성공한 뒤 응답을 이만큼 기다린다(분). 한도 구간·도구가 열린 구간·탐침 실패
# 구간은 이 시계에서 뺀다 — 세션이 응답할 수 없거나 우리가 관측을 못 하는 시간이다.
RESPONSE_WAIT_MIN=20
# 무응답 창 이 횟수면 넛지 중단 + 사용자 알림. 20분 × 3 = 1시간 — 창 길이가 바뀌어도
# 사람에게 알리는 시점(총 침묵 1시간)은 그대로 둔다. 횟수를 안 맞추면 20분 침묵에
# 알림이 가서 긴 생각·긴 외부 대기가 전부 거짓 알림이 된다.
NO_RESP_MAX=3
# 도구가 이 분수 이상 열려 있으면 "도는 중"이 아니라 막힌 것으로 본다. 권한 승인 대기가
# 대표적이다(요청이 transcript 에 안 남아 직접은 못 본다). 정상 도구가 이만큼 걸리는
# 경우는 거의 없다 — ai-debate 가 최대 10분, run_in_background 는 즉시 결과가 돌아온다.
PENDING_STUCK_MIN="${CLAUDE_NUDGE_PENDING_STUCK_MIN:-30}"
# 주입 메시지를 보낸 뒤 이 초가 지나면 유저봇이 그 메시지를 지운다. 세션은 이미
# 받은 뒤라 영향이 없고(수신은 봇 쪽 getUpdates 로 몇 초 안에 끝난다), 지우는 것은
# 운영자 화면에 쌓이는 사본이다. 넛지 문구는 480자가 넘어서 회차마다 그대로 남으면
# 그 봇 대화가 넛지로 덮인다. 회차 간격(10분)보다 짧게 둬서 화면에 한 번에 한 건만
# 보이게 한다. 1분이면 수신은 이미 끝나 있다 — 전달은 봇 쪽 getUpdates 라 몇 초다.
# 대가는 하나다: 그 세션의 텔레그램 연결이 1분 넘게 끊겨 있던 구간이면 그 회차를
# 못 받는다. 주기 주입이라 손해는 한 회차고 10분 뒤 다음 회차가 온다.
NUDGE_DELETE_AFTER_SEC="${CLAUDE_NUDGE_DELETE_AFTER_SEC:-60}"
UNIT_SRC="$NUDGE_REPO_DIR/systemd/user/claude-session-nudge@.service"
UNIT_LINK="$HOME/.config/systemd/user/claude-session-nudge@.service"
# 대기 중이라고만 답하면 사람이 그걸 보고 아무 판단도 못 한다. 멈춰 있으면 무엇을
# 정해야 하는지까지 받아야 그 자리에서 답을 줄 수 있다(2026-08-14 사용자 요청).
# 후보가 여럿이면 고르지 말고 되도록 다 해본다 — 토론은 선택기가 아니라
# 명백히 불필요한 후보를 덜어내는 데 쓴다(2026-08-18 사용자 요청).
# 그리고 판단 지점은 사람에게 오기 전에 먼저 토론을 거친다 — 되돌릴 수 있는 건 토론이
# 정하고 사람에게는 토론으로도 안 닫히는 것만 남긴다(2026-08-18 사용자 요청).
# 목록 순서는 다시 정하되 그 재조정에 토론을 걸지는 않는다 — 순서 정하기에 ai-debate 를
# 물리면 매 넛지마다 수 분짜리 3자 호출이 붙는데, 그건 어느 항목을 먼저 하느냐에 비해
# 비싸다. 세션이 직접 정하고 넘어간다(2026-08-23 사용자 요청).
# 자원은 재보고 쓰는 것이다 — 세션이 자기 판단으로 보수적인 병렬도에 머물면 머신이
# 논다. 관측값을 근거로 올리고 내리게 한다(2026-08-15 사용자 요청).
# 스왑은 그 관측값에서 뺀다 — 리눅스는 메모리가 남아도 안 쓰는 페이지를 스왑에 내려두므로
# 스왑 사용량은 압박의 증거가 아니다. 그걸 신호로 두면 실제로는 남는 머신에서 병렬도를
# 못 올린다. 판단은 available 메모리로 한다(2026-08-25 사용자 지시).
# 문구는 짧게 유지한다 — 넛지는 사람 화면에도 그대로 뜬다. 위 주석이 각 조항의 근거를
# 들고 있으니 본문에는 지시만 남긴다(2026-08-25 사용자 지시: 777자가 너무 길다).
# 순서 재정렬만 시키면 목록은 계속 자란다 — 끝난 것을 내리고 겹치는 것을 합치는 일은
# 아무도 안 하면 안 일어난다. 회차마다 같이 시킨다(2026-08-28 사용자 지시).
# 넛지는 보고를 요구하지 않는다(2026-09-04 운영자 지시). 회차마다 진행상황 보고가
# 텔레그램에 쌓이는데 운영자가 요청한 적 없는 글이다. 넛지는 세션을 다시 굴리는
# 입력이지 질문이 아니므로 답장도 받지 않는다 — 무응답 판정은 텔레그램이 아니라
# claude-session-probe 가 transcript 의 assistant 레코드로 하므로 답장을 없애도
# 감시는 그대로 돈다.
# 자원 조항은 권고가 아니라 확인 가능한 조건으로 적는다(2026-10-14 운영자 지시,
# 그 세션 경유). "여유만큼 돌려" 는 세션이 읽고도 안 지켰는지 가릴 수가 없어서
# 실제로 안 지켜졌다 — 한 세션이 이 문구를 받고도 10-14 05~06시에 16코어 부하
# 0.8 로 놀았고 운영자가 같은 지적을 두 번 했다. 그래서 무엇으로 재고
# (nproc·uptime·free -g), 어느 선이 낮은 것이고(코어 수 절반), 그때 무엇을 해야 회차를
# 끝낼 수 있는지(잡 하나 이상 띄우기)를 문장 안에 박는다.
# 빠져나갈 구멍 둘을 같이 막는다(토론 run-20261014T064708Z). "돌릴 수 있는 게 없었다"
# 는 자기판단이라 밖에서 못 가리므로, 안 띄웠으면 태스크마다 못 돌리는 이유를 목록에
# 적게 한다 — 운영자가 사후에 공회전을 가릴 수 있는 유일한 흔적이다(텔레그램 보고가
# 아니라 목록이라 2026-10-16 의 답장 면제와 충돌하지 않는다). 그리고 재보기만 한 회차는
# 띄운 것으로 세지 않는다.
# 예외 한 구절도 같이 둔다. "하나 이상 띄우기 전에 끝내지 마라" 만 있으면 남은 후보가
# 승인 대기나 비가역 작업뿐일 때 세션이 그걸 띄운다 — 승인 대기로 막히면 30분 뒤
# pending_tool 판정에 걸려 넛지 자체가 멈춘다. 그래서 그 둘은 띄울 잡으로 치지 않는다.
DEFAULT_MSG="이어서 진행해. 이건 자동 넛지다(10분마다 온다) — 텔레그램 답장은 안 해도 되니 작업만 이어가라(정본은 전역 규칙 R68). 맥락이 차도 계속하고 너무 큰 요청만 줄여 다시 해(압축은 자동). 목적에 필요한 실행 가능한 다음 단계가 남았으면 회차를 닫지 마라 — 승인 범위 안에서 기존 태스크의 다음 단계부터 같은 턴에서 이어가라. 다시 재고 다시 적는 건 단계가 아니다. 막히면 이유와 재개 조건을 태스크 목록에 적고 다른 단계로 넘어가라. 할 일이 없으면 만들어내지 마라. 승인 대기·비가역은 막힌 걸로 센다. 새로 띄울 땐 자원을 봐라 — nproc·uptime 1분 부하·free -g available, 부하가 코어 절반 미만이면 미착수 독립 작업도 병렬로, 스왑은 무시. 도는 잡은 믿지 말고 유닛으로 확인하고 다시 안 띄운다. 판단은 ai-debate 로 닫아 — 가역이면 집행 후 보고, 갈리거나 비가역이면 근거와 함께. 끝난 항목은 완료(최근)로 내려라."


mkdir -p "$NUDGE_DIR" "$(dirname "$LOG_FILE")" "$HOME/.config/systemd/user"
log() { echo "[$(date '+%Y-%m-%d %H:%M:%S KST')] $1" >> "$LOG_FILE"; }

usage() {
    echo "Usage: claude-session-nudge --start --sessions a,b --hours N|--until HH:MM [--interval MIN] [--message TEXT]" >&2
    echo "       claude-session-nudge --stop <session> | --stop --all" >&2
    echo "       claude-session-nudge --status" >&2
    echo "       claude-session-nudge --refresh-defaults  # 등록분의 문구·간격을 지금 기본값으로" >&2
    echo "       claude-session-nudge --daemon <session>" >&2
    exit 1
}

ensure_unit_link() {
    # 템플릿 유닛 심링크 보장(dotfiles 소스 → ~/.config/systemd/user).
    [ -e "$UNIT_LINK" ] || ln -sf "$UNIT_SRC" "$UNIT_LINK"
}

session_file() { echo "$NUDGE_DIR/$1.json"; }

write_session() {
    # $1=session $2=interval_min $3=end_ts $4=message $5=문구를 --message 로 줬나(1/0)
    # 문구 출처를 파일에 적는다. --message 로 준 문구는 글자가 기본값과 같아도 맞춤으로
    # 본다 — 사람이 일부러 정한 값이라는 사실이 그 뒤 기본값 갱신의 판단 근거다.
    # --message 없이 시간만 다시 등록하는 경우(컨트롤봇의 연장 경로)에는 기존 맞춤 문구를
    # 그대로 둔다. 안 그러면 refresh 쪽만 맞춤값을 지키고 재등록 쪽이 조용히 지우는
    # 비대칭이 남는다(토론 run-20261014T064708Z 가 사본에서 재현했다).
    # 이미 상태파일이 있으면 무응답 추적 필드를 보존한다. 새 dict 로 통째 덮으면
    # alert_msg_id 를 잃어서 고정된 텔레그램 알림을 아무도 못 푼다 — clear_alert 는 그
    # id 로만 푼다. suspended 도 그대로 둔다: 종료시각을 새로 등록하는 건 "세션이 다시
    # 응답한다"는 뜻이 아니고, 응답이 관측되면 tick 이 알아서 풀고 재개한다. 여기서
    # 억지로 풀면 권한 승인 대기로 막힌 세션에 넛지를 다시 쏘게 되고, 그게 이 중단
    # 장치를 만든 원인(한 세션이 18시간 34분 멈춰 있던 것)이다.
    local s="$1" interval="$2" end_ts="$3" message="$4" explicit="${5:-0}"
    local f; f="$(session_file "$s")"
    local tmp="$f.tmp.$$"
    S="$s" INTERVAL="$interval" END_TS="$end_ts" MESSAGE="$message" \
    EXPLICIT="$explicit" F="$f" python3 -c "
import json, os, time
try:
    old = json.load(open(os.environ['F']))
except Exception:
    old = {}
explicit = os.environ['EXPLICIT'] == '1'
if explicit:
    message, from_default = os.environ['MESSAGE'], False
elif old.get('message') and not old.get('message_from_default', True):
    message, from_default = old['message'], False
else:
    message, from_default = os.environ['MESSAGE'], True
d = {
    'session': os.environ['S'],
    'interval_min': int(os.environ['INTERVAL']),
    'end_ts': int(os.environ['END_TS']),
    'message': message,
    'message_from_default': from_default,
    'enabled': True,
    'started_ts': int(old.get('started_ts') or time.time()),
    # 점검기가 '방금 등록을 손댄 구간' 을 알아야 유닛 켜짐·꺼짐 경합을 이상으로
    # 안 읽는다. started_ts 는 첫 등록이라 재등록에서는 안 움직인다.
    'registered_ts': int(time.time()),
}
# 진행 중인 응답 대기도 보존한다. 재등록으로 창이 닫히면 무응답이던 세션이 시각을
# 늘릴 때마다 추적을 처음부터 다시 시작한다.
for k in ('suspended', 'alert_msg_id', 'no_response', 'last_assistant', 'last_send_ok',
          'awaiting', 'await_since', 'await_base', 'await_excluded', 'excluded_since',
          'aux_event'):
    if k in old:
        d[k] = old[k]
json.dump(d, open('$tmp','w'), ensure_ascii=False, indent=2)
"
    mv -f "$tmp" "$f"
}

cmd_start() {
    local sessions="" hours="" until_hhmm="" interval="$DEFAULT_INTERVAL" message="$DEFAULT_MSG" msg_explicit=0
    while [[ "${1:-}" == --* ]]; do
        case "$1" in
            --sessions) sessions="$2"; shift 2 ;;
            --hours) hours="$2"; shift 2 ;;
            --until) until_hhmm="$2"; shift 2 ;;
            --interval) interval="$2"; shift 2 ;;
            --message) message="$2"; msg_explicit=1; shift 2 ;;
            *) usage ;;
        esac
    done
    [ -n "$sessions" ] || usage
    [ -n "$hours" ] || [ -n "$until_hhmm" ] || usage

    local end_ts
    if [ -n "$until_hhmm" ]; then
        end_ts=$(date -d "$until_hhmm" +%s)
        if [ "$end_ts" -le "$(date +%s)" ]; then
            end_ts=$(date -d "tomorrow $until_hhmm" +%s)
        fi
    else
        end_ts=$(( $(date +%s) + hours * 3600 ))
    fi

    ensure_unit_link
    systemctl --user daemon-reload
    local IFS=','
    for s in $sessions; do
        [ -n "$s" ] || continue
        write_session "$s" "$interval" "$end_ts" "$message" "$msg_explicit"
        systemctl --user enable --now "claude-session-nudge@${s}.service" 2>/dev/null || \
            systemctl --user restart "claude-session-nudge@${s}.service"
        log "시작: $s interval=${interval}min end=$(date -d @$end_ts '+%Y-%m-%d %H:%M KST')"
    done
    echo "시작됨. $(date -d @$end_ts '+%Y-%m-%d %H:%M KST') 까지 ${interval}분마다 [$sessions] 각 세션에 넛지 전송."
}

cmd_stop() {
    local target="${1:-}"
    # 인자 없는 --stop 은 아무것도 안 끈다. 전에는 등록 전체를 조용히 껐는데, 그건
    # 오타 한 번으로 모든 호스트의 넛지가 사라지는 경로이고 그 상태는 알림도 안 난다
    # (점검기는 살아 있는 등록만 본다). 전체를 끌 때는 --all 로 그 뜻을 적게 한다.
    if [ -z "$target" ]; then
        echo "claude-session-nudge --stop 은 끌 세션을 받는다: --stop <세션>" >&2
        echo "  등록 전체를 끄려면: --stop --all   (등록 목록은 --status)" >&2
        exit 2
    fi
    # --stop 은 그 밖에는 위치인자만 받는다. --start 문법(--sessions <이름>)을 그대로
    # 옮기면 target 이 "--sessions" 가 되어 존재하지 않는 유닛을 끄고도 성공을 찍었다
    # (2026-07-31 다른 세션 제보). 플래그처럼 생긴 인자는 거절한다.
    if [ "$target" != "--all" ] && [[ "$target" == --* ]]; then
        echo "claude-session-nudge --stop 은 위치인자만 받는다: --stop <세션>" >&2
        echo "  받은 인자: $target  (--start 의 --sessions 문법은 --stop 에 없다)" >&2
        exit 2
    fi
    if [ "$target" != "--all" ]; then
        local unit="claude-session-nudge@${target}.service"
        local f; f="$(session_file "$target")"
        # 끌 대상이 실재하는지 먼저 본다. 유닛도 상태파일도 없으면 오타이지
        # 성공이 아니다 — 조용히 넘기면 사용자는 껐다고 믿는다.
        local unit_known=0
        [ "$(systemctl --user is-active "$unit" 2>/dev/null)" = "active" ] && unit_known=1
        [ "$(systemctl --user is-enabled "$unit" 2>/dev/null)" = "enabled" ] && unit_known=1
        if [ "$unit_known" = 0 ] && [ ! -f "$f" ]; then
            echo "끌 넛지가 없다: $target (유닛 비활성 + 상태파일 없음)" >&2
            echo "  등록된 세션은 claude-session-nudge --status 로 확인." >&2
            exit 3
        fi
        systemctl --user disable --now "$unit" 2>/dev/null || true
        [ -f "$f" ] && S="$target" python3 -c "
import json
f='$f'
d=json.load(open(f)); d['enabled']=False
json.dump(d, open(f,'w'), ensure_ascii=False, indent=2)
"
        # 사후조건 확인 — disable 이 돌았다고 꺼진 게 아니다.
        local still; still="$(systemctl --user is-active "$unit" 2>/dev/null)"
        if [ "$still" = "active" ]; then
            echo "중지 실패: $target 유닛이 아직 active 다 (systemctl --user status $unit)" >&2
            log "중지 실패(여전히 active): $target"
            exit 4
        fi
        log "중지: $target"
        echo "중지됨: $target"
    else
        shopt -s nullglob
        for f in "$NUDGE_DIR"/*.json; do
            local s; s="$(basename "$f" .json)"
            systemctl --user disable --now "claude-session-nudge@${s}.service" 2>/dev/null || true
            # 단일 세션 --stop 과 동일하게 상태파일도 꺼야 한다. 유닛만 내리면
            # --status 가 enabled=True 로 계속 보고하고, 누가 유닛을 다시 켜면
            # 사용자가 끈 넛지가 되살아난다(2026-07-27 발견).
            F="$f" python3 -c "
import json, os
f=os.environ['F']
d=json.load(open(f)); d['enabled']=False
json.dump(d, open(f,'w'), ensure_ascii=False, indent=2)
"
        done
        log "중지: 전체"
        echo "전체 중지됨."
    fi
}

cmd_status() {
    shopt -s nullglob
    local any=0
    for f in "$NUDGE_DIR"/*.json; do
        any=1
        local s; s="$(basename "$f" .json)"
        local active; active="$(systemctl --user is-active "claude-session-nudge@${s}.service" 2>/dev/null)"; [ -n "$active" ] || active="unknown"
        F="$f" ACTIVE="$active" python3 -c "
import json, time, os
d=json.load(open(os.environ['F']))
remain=(d['end_ts']-time.time())/3600
extra=''
if d.get('suspended'):
    extra=' SUSPENDED(무응답 %s회 — 사용자 알림 고정 중, 세션이 응답하면 자동 재개)' % d.get('no_response')
elif d.get('no_response'):
    extra=' 무응답=%s' % d['no_response']
if d.get('awaiting') and d.get('enabled') and remain > 0:
    extra+=' 응답대기(%d분째)' % ((time.time()-d.get('await_since',0))//60)
print(f\"{d['session']}: 주입주기={d['interval_min']}min(회차마다) remain={remain:.1f}h enabled={d['enabled']} unit={os.environ['ACTIVE']}{extra}\")
"
    done
    if [ "$any" = 0 ]; then echo "등록된 세션 없음."; fi
}

# 한 회차. 보낼지 말지를 판정하고 필요하면 사용자에게 알린다.
# stdout 한 줄 = 로그 문구.
#
# 왜 무작정 안 보내나(2026-08-03 도입): 한 세션이 권한 승인 대기로 18시간 34분
# 멈춰 있는 동안 넛지 37건이 계속 꽂혔고 텔레그램 48건이 큐에만 쌓였다. 아무도
# 몰랐다. 넛지는 우리가 보낸 입력이므로 "보냈는데 반응이 없다" 를 추측이 아니라
# 사실로 안다 — 그 사실을 쓰지 않을 이유가 없다.
#
# 주입은 회차마다 한다(2026-10-16 운영자 지시). 유휴 임계로 거르던 2026-10-14 구조를
# 되돌린 것이고, 되돌릴 수 있었던 것은 주입이 15분 뒤 지워져 화면에 안 쌓이기 때문이다.
# 안 보내는 자리는 셋만 남는다 — 한도로 막힌 구간, 도구가 열린 구간(레코드가 안 늘어
# 무응답 판정이 거짓이 된다), 무응답 상한에 닿아 사람에게 알린 뒤의 정지 구간.
tick() {
    local s="$1" f="$2" message="$3"
    S="$s" F="$f" MSG="$message" SEND="$SEND" PROBE="$PROBE" \
    TG_ENV="$TG_ENV" TG_CHAT="$TG_CHAT" NO_RESP_MAX="$NO_RESP_MAX" \
    RESPONSE_WAIT_MIN="$RESPONSE_WAIT_MIN" \
    TICKLOG="$TICK_LOG" DELETE_AFTER="$NUDGE_DELETE_AFTER_SEC" \
    PENDING_STUCK_MIN="$PENDING_STUCK_MIN" python3 - <<'PY'
import json, os, subprocess, sys, time, urllib.parse, urllib.request

s = os.environ["S"]; f = os.environ["F"]; msg = os.environ["MSG"]
SEND = os.environ["SEND"]; PROBE = os.environ["PROBE"]
TG_ENV = os.environ["TG_ENV"]; TG_CHAT = os.environ["TG_CHAT"]
MAX = int(os.environ["NO_RESP_MAX"])
STUCK = int(os.environ["PENDING_STUCK_MIN"]) * 60
DELETE_AFTER = os.environ.get("DELETE_AFTER") or "0"
try:
    MACHINE = open(os.path.expanduser("~/.config/claude-machine-id")).read().strip() or "unknown"
except OSError:
    MACHINE = "unknown"
WAIT = int(os.environ["RESPONSE_WAIT_MIN"]) * 60
QUOTA_BLOCK = 90
QUOTA_BLOCK_7D = 99
# 보조 제외(관측으로 판정이 안 설 때 차단 표식만 믿고 무응답 집계를 멈추는 구간)의
# 상한. 차단이 얼마나 갈지를 추정한 값이 아니라, 감시를 얼마나 쉬게 둘지의 정책값이다.
# 주간 한도라도 늘리지 않는다 — 늘리면 그만큼 멈춘 세션을 늦게 안다.
AUX_MAX = 5 * 3600
NOW = int(time.time())


def rec(tag, idle="", rc="", alert="", wait="", opened=""):
    """회차 하나를 기계가 셀 수 있는 칸으로 남긴다. 실패해도 넛지 동작을 막지 않는다.

    사람이 읽는 로그와 따로 두는 이유는 집계다 — 문장은 문구를 고칠 때마다 과거와
    안 맞고, 실제로 옛 기록은 사유 칸이 아예 없어서 "왜 안 보냈나" 를 셀 수가 없다.
    """
    dd = globals().get("d") or {}
    pp = globals().get("p") or {}
    fields = [time.strftime("%Y-%m-%d %H:%M:%S KST"),
              "session=%s" % s,
              "tag=%s" % tag,
              "idle=%s" % idle,
              # 뜻이 다른 값을 한 칸에 섞지 않는다 — 유휴, 주입 뒤 유효 대기,
              # 도구가 열려 있던 시간은 각각 다른 것을 잰다.
              "wait=%s" % wait,
              "open=%s" % opened,
              # 주입 간격(분). 유휴 임계로 거르던 시절의 thr 칸을 대신한다 —
              # 지금은 회차마다 보내므로 임계라는 값 자체가 없다.
              "ivl=%s" % (dd.get("interval_min") or ""),
              "nores=%d" % int(dd.get("no_response") or 0),
              "await=%d" % (1 if dd.get("awaiting") else 0),
              "susp=%d" % (1 if dd.get("suspended") else 0),
              "tool=%s" % (pp.get("pending_tool_name") or ""),
              # 한도 판정이 무엇으로 섰나. blocked·clear 는 계정 검증된 두 창 관측이고
              # unknown 은 그 관측을 못 쓴 회차다. aux=1 은 그때 차단 표식을 보조로
              # 삼아 무응답 집계만 멈춘 회차 — 주입은 나갔다.
              "qv=%s" % (globals().get("QV") or ""),
              "aux=%d" % (1 if globals().get("AUX_ON") else 0),
              "rc=%s" % rc,
              # 사람에게 가는 고정 알림이 실제로 나갔는지. 안 적으면 "알렸다" 와
              # "알리려다 실패했다" 가 기록에서 같아 보인다.
              "alert=%s" % alert,
              "last=%s" % (globals().get("la") or "")]
    try:
        with open(os.environ["TICKLOG"], "a") as fh:
            fh.write("\t".join(fields) + "\n")
    except (OSError, KeyError):
        pass


def out(line, tag="other", idle="", rc="", alert="", wait="", opened=""):
    rec(tag, idle=idle, rc=rc, alert=alert, wait=wait, opened=opened)
    print("%s: %s" % (s, line))
    sys.exit(0)


def load():
    with open(f) as fh:
        return json.load(fh)


def save(d):
    # 저장 직전에 디스크를 다시 읽어 설정 칸은 디스크 것으로 되돌린다. tick 은 load 뒤
    # 탐침(최대 60초)과 전송을 거치는데, 그 사이 --refresh-defaults 나 --stop 이 바꾼
    # 값을 통째 덮으면 그 갱신이 조용히 사라진다 — refresh 는 "갱신" 을 찍어 놓고
    # 문구는 옛것인 상태가 된다(토론 run-20261014T064708Z). 이 함수가 적는 것은
    # 무응답 추적 칸뿐이라 설정 칸을 디스크에 맞춰도 잃는 것이 없다.
    try:
        with open(f) as fh:
            disk = json.load(fh)
    except Exception:
        disk = {}
    for k in ("message", "message_from_default", "interval_min", "enabled", "end_ts",
              "started_ts"):
        if k in disk:
            d[k] = disk[k]
    tmp = f + ".tmp.%d" % os.getpid()
    with open(tmp, "w") as fh:
        json.dump(d, fh, ensure_ascii=False, indent=2)
    os.replace(tmp, f)


def tg(method, **params):
    """dotfiles 봇으로 운영자 채팅에 호출. 실패해도 넛지 동작을 막지 않는다."""
    # 키 이름을 '=' 없이 비교한다. 리터럴에 대입 형태를 쓰면 secrets-scan 훅이
    # 자격증명 하드코딩으로 오탐한다(2026-08-03 실제로 차단당했다).
    keys = ("TELEGRAM_BOT_TOKEN", "BOT_TOKEN")
    tok = ""
    try:
        for ln in open(TG_ENV, errors="replace"):
            k, sep, v = ln.partition("=")
            if sep and k.strip() in keys:
                tok = v.strip().strip('"').strip("'")
    except OSError:
        return None
    if not tok:
        return None
    params["chat_id"] = TG_CHAT
    url = "https://api.telegram.org/bot%s/%s" % (tok, method)
    data = urllib.parse.urlencode(params).encode()
    try:
        with urllib.request.urlopen(url, data=data, timeout=10) as r:
            return json.loads(r.read().decode())
    except Exception:
        return None


d = load()
probe_err = ""
try:
    p = json.loads(subprocess.run([PROBE, s], capture_output=True, text=True,
                                  timeout=60).stdout or "{}")
except Exception as e:
    p, probe_err = {}, str(e)


def clear_alert(why):
    """고정 알림을 해소로 바꾸고 푼다. 사람이 손으로 풀 게 없어야 한다."""
    mid = d.get("alert_msg_id")
    if mid:
        tg("editMessageText", message_id=mid, text="해소됨 — %s %s" % (s, why))
        tg("unpinChatMessage", message_id=mid)
    d["suspended"] = False
    d["alert_msg_id"] = None
    d["no_response"] = 0


def raise_alert(text):
    """사람에게 한 번만 알리고 고정한다. 고정이 실패해도 상태는 남긴다."""
    r = tg("sendMessage", text=text)
    mid = ((r or {}).get("result") or {}).get("message_id")
    if mid:
        tg("pinChatMessage", message_id=mid, disable_notification="true")
    d["suspended"] = True
    d["alert_msg_id"] = mid
    return mid


def pause_clock():
    """응답 대기 시계를 멈춘다. 세션이 답할 수 없거나 우리가 관측을 못 하는 구간이다.

    멈추지 않으면 한도로 막힌 6시간이 그대로 "무응답" 으로 쌓여서, 가장 확실히
    차단된 순간에 넛지가 멈추고 사람에게 거짓 알림이 간다.
    """
    if d.get("awaiting") and not d.get("excluded_since"):
        d["excluded_since"] = NOW


def open_excluded():
    """아직 안 닫힌 제외 구간의 길이. 열려 있지 않으면 0."""
    st = int(d.get("excluded_since") or 0)
    return max(0, NOW - st) if st else 0


def resume_clock():
    """멈춰 둔 구간을 닫아 대기 시간에서 뺀다."""
    st = int(d.get("excluded_since") or 0)
    if st:
        d["await_excluded"] = int(d.get("await_excluded") or 0) + max(0, NOW - st)
        d["excluded_since"] = 0


def quota_verdict(obs):
    """두 창 관측 하나로 'blocked' | 'clear' | 'unknown' 을 낸다.

    해제(clear)는 두 창이 다 유효하고 다 임계 아래일 때만 선언한다. 한쪽만 보고
    풀면 7일 창이 찬 상태를 5시간 창이 비었다는 이유로 해제로 읽는다. 바깥 status 가
    fresh 여도 창 하나가 invalid·expired 면 그 창은 모르는 것이다 — 바깥 한 칸으로
    안쪽 둘을 대신 판정하지 않는다.
    """
    if (obs or {}).get("status") != "fresh":
        return "unknown"
    w5 = (obs.get("five_hour") or {})
    w7 = (obs.get("seven_day") or {})
    if w5.get("status") != "fresh" or w7.get("status") != "fresh":
        return "unknown"
    u5, u7 = w5.get("used"), w7.get("used")
    if not isinstance(u5, (int, float)) or not isinstance(u7, (int, float)):
        return "unknown"
    if u5 >= QUOTA_BLOCK or u7 >= QUOTA_BLOCK_7D:
        return "blocked"
    return "clear"


def aux_hold(p):
    """관측으로 판정이 안 설 때, 차단 표식을 보조 근거로 무응답 집계만 멈출까.

    (멈출까, 사유) 를 돌려준다. 멈춰도 주입은 보낸다 — 표식만으로 깨우기까지 끊으면
    낡은 관측·빈 큐·남은 표식이 서로를 받쳐 스스로 못 빠져나오는 자물쇠가 된다.
    그 순환은 2026-08-28 에 한 기계가 6시간 갇혔던 바로 그 모양이다.

    사건은 계정마다 한 번만 열고, 열린 뒤에는 기한이 안 밀린다. 복구 경로는 차단이
    이어지는 동안 표식을 다시 touch 하므로 그 시각을 키로 삼으면 사건이 회차마다
    새로 열려 상한이 이름뿐인 값이 된다. 사건을 여는 시각은 지금과 표식 시각 중
    이른 쪽이다 — 복구 경로가 안 돌아 오래 남아 있던 표식에 새 유예를 주지 않는다.
    계정이 바뀌면 이전 계정의 표식이므로 사건을 새로 연다.
    """
    flag = int(p.get("blocked_flag") or 0)
    acct = p.get("account")
    if not flag:
        d["aux_event"] = None       # 표식이 지워졌다 = 사건 종료
        return False, ""
    ev = d.get("aux_event") or {}
    if ev.get("account") == acct and ev.get("until"):
        until = int(ev["until"])
    else:
        opened = min(NOW, flag)
        until = opened + AUX_MAX
        d["aux_event"] = {"account": acct, "opened": opened, "until": until}
    if NOW >= until:
        return False, "표식 유예 만료(%s 까지였다)" % time.strftime(
            "%m-%d %H:%M", time.localtime(until))
    return True, "표식 %s · 유예 %d분 남음" % (
        time.strftime("%m-%d %H:%M", time.localtime(flag)), (until - NOW) // 60)


def skip(line, tag="other", idle="", wait="", opened=""):
    save(d)
    out(line, tag=tag, idle=idle, wait=wait, opened=opened)


def send(why, tag="send", idle="", reset_window=True):
    """주입하고 응답 대기 창을 연다. 실패한 전송은 창을 안 연다 — 말을 건 적이 없다.

    reset_window=False 는 이미 열린 창을 그대로 두고 보내기만 한다. 회차마다 보내는
    지금 구조에서 창을 매번 새로 열면 유효 대기가 판정 시간에 영영 안 닿아서, 세션이
    정말 막혔을 때 사람에게 가는 알림이 죽는다.
    """
    try:
        # 수신처는 <기계>/<세션> 완전 주소. 넛지 대상은 언제나 이 호스트의 유닛이다.
        # 짧은 이름 'dotfiles' 는 두 기계에 다 있어 claude-userbot-send 가 거절한다.
        # --silent: 주입은 60초 뒤 지워지지만 울린 푸시 알림은 안 지워져서, 10분마다
        # 운영자 화면에 알림만 쌓인다. 무음으로 보내도 받는 세션의 수신은 그대로다.
        rc = subprocess.run([SEND, "--session", f"{MACHINE}/{s}", "--silent",
                             "--delete-after", DELETE_AFTER, "--", msg],
                            capture_output=True, text=True, timeout=120).returncode
    except subprocess.TimeoutExpired:
        # 매달린 전송은 실패로 본다 — 창을 열면 보낸 적 없는 말을 기다리게 된다.
        rc = -1
    d["last_send_ok"] = (rc == 0)
    if reset_window or not d.get("awaiting"):
        d["awaiting"] = (rc == 0)
        d["await_since"] = NOW
        d["await_base"] = la
        d["await_excluded"] = 0
        d["excluded_since"] = 0
    save(d)
    out("%s — 전송" % why if rc == 0 else "%s — 전송 실패 rc=%d" % (why, rc),
        tag=tag if rc == 0 else "send-fail", idle=idle, rc=rc)


# --- 세지 않는 경우들. 무응답이 정상이거나, 애초에 말을 건 적이 없는 경우다.
if probe_err:
    pause_clock()
    skip("probe 실패 %s — 이번 회차 건너뜀" % probe_err, tag="probe-fail")
if not p.get("unit_active"):
    # probe 가 "없음(이름 어긋남)" 과 "꺼짐" 을 구분해 준다 — 그대로 옮긴다.
    pause_clock()
    skip("건너뜀 reason=%s unit=%s" % (p.get("reason") or "unit-not-active",
                                       p.get("unit", "")),
         tag=p.get("reason") or "unit-not-active")
# --- 한도. 세 층으로 가른다. 층을 나누는 이유는 2026-10-30 실측이다 — 한 세션이 차단
# 구간 내내 "한도 아님" 으로 읽혀 무응답 3회를 채우고 멈췄다. 차단된 세션은 턴이 없어
# statusline 캐시가 얼고(5시간 40분 차단 내내 38%), 아무도 말을 안 걸면 큐도 비어서,
# 가장 확실히 막힌 순간이 가장 깨끗해 보인다.
#
# 1층 큐: 그 세션에 대고 한 말이 밀려 있다. 가장 확실한 차단이고 회차를 건너뛴다.
if p.get("queue_bytes"):
    pause_clock()
    skip("건너뜀 reason=quota-blocked queue=%dB" % p["queue_bytes"],
         tag="quota-blocked")

# 2층 관측: 계정이 맞고 두 창이 다 신선할 때만 쓴다. 그때는 이게 정본이다.
QV = quota_verdict(p.get("quota_obs"))
AUX_ON = False
AUX_WHY = ""
if QV == "blocked":
    d["aux_event"] = None          # 관측이 섰으니 보조 사건은 할 일이 없다
    pause_clock()
    obs = p.get("quota_obs") or {}
    skip("건너뜀 reason=quota-blocked 5h=%s%% 7d=%s%%"
         % ((obs.get("five_hour") or {}).get("used"),
            (obs.get("seven_day") or {}).get("used")),
         tag="quota-blocked")
elif QV == "clear":
    # 해제 확정. 남아 있던 표식이 무엇이든 이 계정은 지금 안 막혀 있다 — 사건을 닫아
    # 표식이 안 지워진 채로 남아 무응답 감시를 영원히 재우는 길을 끊는다.
    d["aux_event"] = None
else:
    # 3층 보조: 관측을 못 쓴다. 차단 표식이 살아 있고 유예 안이면 무응답 집계만 멈추고
    # 주입은 그대로 보낸다. 표식만으로 주입까지 끊으면 낡은 관측·빈 큐·남은 표식이
    # 서로를 받쳐 스스로 못 빠져나온다.
    AUX_ON, AUX_WHY = aux_hold(p)
    if AUX_ON:
        pause_clock()
if not p.get("transcript"):
    # 기록 파일을 못 읽는 것은 "안 움직인다" 가 아니다. 유휴로 읽으면 교체·회전 중인
    # 세션에 주입이 꽂힌다.
    pause_clock()
    skip("건너뜀 reason=%s" % (p.get("reason") or "no-transcript"),
         tag=p.get("reason") or "no-transcript")

la = int(p.get("last_assistant") or 0)
base = int(d.get("last_assistant") or 0)
alive = la > base
suspended = bool(d.get("suspended"))

# --- 기록은 있는데 그 안에서 응답 레코드를 하나도 못 찾았다. 읽기가 실패했거나,
# 읽는 구간(꼬리 4MB) 밖으로 밀려난 것이다. 둘 다 "안 움직인다" 의 증거가 아니라
# "못 봤다" 다. 유휴로 읽으면 등록 시각부터 통째로 빈 것으로 세어 회차마다 주입이
# 꽂히고, 그대로 저장하면 마지막으로 믿을 수 있었던 관측까지 0 으로 지워진다.
# 한 번이라도 응답을 본 적이 있을 때만 이 갈래로 간다 — 등록 뒤 한 번도 응답이
# 없는 세션은 실제로 안 움직이는 것이므로 평소대로 깨운다.
if not la and base:
    pause_clock()
    skip("건너뜀 reason=no-assistant-record (관측 실패 — 마지막 관측 %s 유지)"
         % time.strftime("%m-%d %H:%M", time.localtime(base)),
         tag="no-assistant-record")

# --- 도구가 열려 있다. 도는 중일 수도, 권한 승인을 기다리는 중일 수도 있다.
# 짧으면 도는 중으로 보고 세지 않는다. 오래 열려 있으면 막힌 것으로 보고 표면화한다 —
# 권한 요청은 transcript 에 안 남아서 직접 볼 방법이 없고, 조용히 건너뛰기만 하면
# 넛지도 안 가고 알림도 안 가서 아무도 모른 채로 시간이 간다(한 세션이 18시간 34분 멈춰 있던 것).
if p.get("pending_tool"):
    since = int(p.get("pending_tool_since") or 0)
    idle = NOW - max(since, la)
    tool = p.get("pending_tool_name") or "이름 미상"
    if idle < STUCK:
        # 도구가 도는 동안은 레코드가 안 늘어난다 — 유휴로도, 무응답으로도 안 센다.
        pause_clock()
        d["last_assistant"] = la
        if suspended and alive:
            clear_alert("세션이 다시 응답한다. 넛지를 재개했다.")
            skip("복구 — 응답 재개(도구 실행 중이라 이번 회차는 안 보냄, 고정 해제)",
                 tag="recover", opened=idle // 60)
        skip("건너뜀 reason=tool-running tool=%s %d분 (도구 실행 중이라 레코드가 안 늘어난다)"
             % (tool, idle // 60), tag="tool-running", opened=idle // 60)
    if suspended:
        skip("대기 — %s 가 %d분째 열려 있다(알림 고정 유지)" % (tool, idle // 60),
             tag="suspended-hold", opened=idle // 60)
    # 막힘으로 멈추는 자리다. 열려 있던 응답 대기 창은 여기서 닫는다 — 나중에 풀렸을 때
    # 그 사이 시간을 무응답으로 세면 안 된다.
    d["awaiting"] = False
    d["excluded_since"] = 0
    mid = raise_alert(
        "%s 세션의 도구가 %d분째 열려 있다. 넛지를 멈췄다.\n"
        "도구: %s\n"
        "권한 승인 대기일 가능성이 높다 — 이 채팅의 🔐 Permission 메시지에서 "
        "수락하거나 거절해라.\n"
        "도구가 실제로 오래 걸리는 중일 수도 있다. 어느 쪽이든 진행되면 이 알림은 "
        "자동으로 풀리고 넛지도 재개된다."
        % (s, idle // 60, tool))
    save(d)
    out("도구 %d분 열림 — 넛지 중단, 사용자 알림%s"
        % (idle // 60, "(고정)" if mid else "(전송 실패)"),
        tag="tool-stuck-alert", opened=idle // 60,
        alert="ok" if mid else "fail")

# --- 여기부터는 관측이 되는 평시 회차다. 멈춰 둔 대기 시계를 다시 돌린다.
# 보조 제외 중에는 안 돌린다 — 돌리면 바로 위에서 멈춘 구간이 그 자리에서 다시 열려
# 한도로 막힌 시간이 무응답으로 쌓인다.
if not AUX_ON:
    resume_clock()
d["last_assistant"] = la

if suspended:
    if alive:
        clear_alert("세션이 다시 응답한다. 넛지를 재개했다.")
        skip("복구 — 응답 재개, 넛지 재개(고정 해제)", tag="recover")
    skip("대기 — 여전히 무응답(알림 고정 유지). 해소되면 자동 재개된다",
         tag="suspended-hold")

# --- 보낸 뒤 응답을 기다리는 중.
if d.get("awaiting"):
    if la > int(d.get("await_base") or 0):
        # 응답이 왔다. 창을 닫고 추적을 비운다.
        d["awaiting"] = False
        d["no_response"] = 0
        d["await_excluded"] = 0
        d["excluded_since"] = 0
        skip("응답 확인 — 무응답 계수 0 으로", tag="answered")
    # 아직 안 닫힌 제외 구간도 뺀다. 닫힌 것만 빼면 보조 제외가 이어지는 동안 대기
    # 시간이 계속 늘어서, 멈춰 두려던 바로 그 구간에 무응답 판정이 선다.
    waited = (NOW - int(d.get("await_since") or NOW)
              - int(d.get("await_excluded") or 0) - open_excluded())
    if waited < WAIT:
        # 창이 열려 있어도 회차는 거르지 않는다 — 주기 주입이다. 대신 창을 새로
        # 열지 않아서 무응답 판정 시계는 처음 보낸 시각부터 계속 간다.
        send("대기 중 재주입 — 주입 뒤 유효 %d분(판정은 %d분)%s"
             % (waited // 60, WAIT // 60,
                " · 무응답 집계 보류(%s)" % AUX_WHY if AUX_ON else ""),
             tag="send-awaiting",
             idle=(NOW - la) // 60 if la else "", reset_window=False)
    # 창 하나를 무응답으로 판정하고 닫는다. 같은 창을 다음 회차에 또 세지 않는다.
    n = int(d.get("no_response") or 0) + 1
    d["no_response"] = n
    d["awaiting"] = False
    d["await_excluded"] = 0
    d["excluded_since"] = 0
    if n < MAX:
        # 전송 결과를 문구에 함께 남긴다 — 실패를 "다시 전송" 으로 덮으면 거짓 성공이다.
        send("무응답 %d/%d — 다시" % (n, MAX), tag="resend")
else:
    # --- 평시. 회차마다 보낸다. 유휴 시간은 거르는 데 쓰지 않고 기록에만 남긴다 —
    # 나중에 "이 회차가 일하는 세션에 들어갔나" 를 그 칸으로 센다.
    idle = NOW - max(la, int(d.get("started_ts") or 0))
    send("회차 주입 — 마지막 응답 %d분 전%s"
         % (idle // 60, " · 무응답 집계 보류(%s)" % AUX_WHY if AUX_ON else ""),
         idle=idle // 60)

# 상한 도달: 넛지를 멈추고 사람에게 한 번만 알린다.
last_seen = time.strftime("%m-%d %H:%M", time.localtime(la)) if la else "기록 없음"
text = ("%s 세션이 넛지 %d회에 응답하지 않는다. 넛지를 멈췄다.\n"
        "마지막 응답: %s\n"
        "권한 수락 대기일 수 있다 — 원격 조작 화면을 확인해라.\n"
        "그래도 안 깨어나면: systemctl --user restart claude-%s\n"
        "세션이 다시 응답하면 이 알림은 자동으로 풀리고 넛지도 재개된다."
        % (s, n, last_seen, s))
mid = raise_alert(text)
save(d)
out("무응답 %d/%d — 넛지 중단, 사용자 알림%s"
    % (n, MAX, "(고정)" if mid else "(전송 실패)"), tag="suspend-alert",
    alert="ok" if mid else "fail")
PY
}

run_daemon() {
    local s="${1:-}"
    [ -n "$s" ] || usage
    local f; f="$(session_file "$s")"
    while true; do
        [ -f "$f" ] || { log "daemon $s: state 없음 → 종료"; exit 0; }
        local vals enabled end_ts interval message now
        vals="$(F="$f" python3 -c "
import json, os
d=json.load(open(os.environ['F']))
print(d.get('enabled',True))
print(int(d['end_ts']))
print(int(d['interval_min']))
print(d['message'])
" )" || { log "daemon $s: state 파싱 실패 → 종료"; exit 0; }
        enabled="$(sed -n 1p <<<"$vals")"
        end_ts="$(sed -n 2p <<<"$vals")"
        interval="$(sed -n 3p <<<"$vals")"
        message="$(sed -n '4,$p' <<<"$vals")"
        now="$(date +%s)"
        [ "$enabled" = "True" ] || { log "daemon $s: enabled=false → 종료"; exit 0; }
        if [ "$now" -ge "$end_ts" ]; then log "daemon $s: 만료 → 종료"; exit 0; fi
        log "$(tick "$s" "$f" "$message")"
        local remain sleep_s
        remain=$(( end_ts - $(date +%s) ))
        sleep_s=$(( interval * 60 ))
        [ "$remain" -lt "$sleep_s" ] && sleep_s="$remain"
        [ "$sleep_s" -lt 1 ] && { log "daemon $s: 만료 → 종료"; exit 0; }
        sleep "$sleep_s"
    done
}

# 등록된 상태 파일의 문구와 회차 간격을 지금 기본값으로 맞춘다. 둘 다 등록 시점에
# 파일로 복사되므로, 스크립트만 고치면 이미 등록된 세션은 옛 값을 계속 쓴다(데몬은
# 회차마다 파일에서 다시 읽는다 — 즉 이 파일을 고치면 재등록 없이 바로 반영된다).
# 맞춤 문구(--message 로 준 것)는 안 건드리고 건너뛴 사실만 찍는다 — 기본값 교체가
# 맞춤값을 조용히 지우면 그 세션은 왜 지시가 바뀌었는지 알 길이 없다. 가르는 기준은
# 등록 때 적어 둔 message_from_default 이고, 그 필드가 없는 옛 파일은 기본값으로 본다
# (2026-10-14 두 호스트 등록분 10개 전수 확인 — 전부 당시 기본값과 글자까지 같았다).
# 간격은 맞춤값이어도 기본값으로 맞춘다 — 회차 간격은 전세션 공통 운영값이다.
cmd_refresh() {
    local f found=0 out="" skipped=""
    for f in "$NUDGE_DIR"/*.json; do
        [ -e "$f" ] || continue
        found=1
        out="$(F="$f" MSG="$DEFAULT_MSG" IVL="$DEFAULT_INTERVAL" python3 - <<'PY'
import json, os

f = os.environ["F"]
new_msg = os.environ["MSG"]
new_ivl = int(os.environ["IVL"])
d = json.load(open(f))
old_msg = d.get("message", "")
old_ivl = d.get("interval_min")
s = d.get("session", os.path.basename(f))
changed = []
from_default = d.get("message_from_default", True)
if old_msg != new_msg and from_default:
    d["message"] = new_msg
    d["message_from_default"] = True
    changed.append("문구(옛 머리 %r)" % old_msg[:24])
elif old_msg != new_msg:
    print("%s: 맞춤 문구라 건너뜀(간격만 본다)" % s)
if old_ivl != new_ivl:
    d["interval_min"] = new_ivl
    changed.append("간격 %s→%d분" % (old_ivl, new_ivl))
if not changed:
    print("%s: 이미 최신" % s)
else:
    tmp = f + ".tmp.%d" % os.getpid()
    with open(tmp, "w") as fh:
        json.dump(d, fh, ensure_ascii=False, indent=2)
    os.replace(tmp, f)
    print("%s: 갱신 — %s" % (s, ", ".join(changed)))
PY
)"
        echo "$out"
        case "$out" in
            *"맞춤 문구라 건너뜀"*) skipped="$skipped $(basename "$f" .json)" ;;
        esac
    done
    [ "$found" = 1 ] || echo "등록된 세션 없음: $NUDGE_DIR"
    # 건너뛴 사실을 줄마다 흘리고 끝내지 않는다 — 그 세션에는 이번에 바뀐 기본 조항이
    # 안 들어갔다는 뜻이고, 운영자가 그걸 알아야 맞춤 문구를 손볼지 정할 수 있다.
    [ -n "$skipped" ] && echo "경고: 맞춤 문구라 새 기본 조항이 안 들어간 세션 —$skipped" >&2
    return 0
}

case "${1:-}" in
    --start) shift; cmd_start "$@" ;;
    --stop) shift; cmd_stop "${1:-}" ;;
    --status) cmd_status ;;
    --refresh-defaults) cmd_refresh ;;
    --tick) shift  # 검증용: 한 회차만 돌린다(데몬 루프 없이)
        t="${1:-}"; [ -n "$t" ] || usage
        tf="$(session_file "$t")"
        [ -f "$tf" ] || { echo "state 없음: $tf" >&2; exit 3; }
        tmsg="$(F="$tf" python3 -c "import json,os;print(json.load(open(os.environ['F']))['message'])")"
        tick "$t" "$tf" "$tmsg" ;;
    --daemon) shift; run_daemon "${1:-}" ;;
    *) usage ;;
esac
