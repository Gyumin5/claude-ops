#!/bin/bash
# claude-config-review: 분기별 설정 리뷰 리포트 (리포트 전용 — 어떤 설정도 수정하지 않음).
# 목적: 인프라에 쌓인 낡은 것들을 분기마다 한 번 수집해 "정리 후보"로 사용자에게 알림.
# 근거: ai-debate run-20260610T225112Z (d)안 채택 — 자동 변경 금지, 리포트+알림 1건만.
# 실행: systemd timer (3/6/9/12월) 또는 수동. 출력: ~/.claude/state/config-review/YYYY-MM-DD.md

set -uo pipefail

OUTDIR="$HOME/.claude/state/config-review"
mkdir -p "$OUTDIR"
TODAY=$(date '+%Y-%m-%d')
OUT="$OUTDIR/${TODAY}.md"
HOST=$(hostname -s)

{
echo "# 설정 리뷰 리포트 ${TODAY} (${HOST})"
echo "생성: $(date '+%Y-%m-%d %H:%M KST') | 리포트 전용 — 아무것도 수정하지 않음"
echo

echo "## 1. 미사용 capability (최근 90일 텔레메트리 대조)"
if [ -x "$HOME/dotfiles/bin/claude-unused-capability-report" ]; then
    "$HOME/dotfiles/bin/claude-unused-capability-report" --days 90 2>/dev/null || echo "(실행 실패)"
else
    echo "(claude-unused-capability-report 없음)"
fi
echo

echo "## 2. CLAUDE.md 상태"
CM="$HOME/.claude/CLAUDE.md"
if [ -f "$CM" ]; then
    lines=$(wc -l < "$CM")
    echo "- 글로벌 CLAUDE.md: ${lines}줄 (@import 분리 임계 400줄)"
    echo "- 사고 날짜 박힌 보정 지시 (낡음 후보 — 6개월 지난 건 검토):"
    grep -noE '\(20[0-9]{2}-[0-9]{2}-[0-9]{2}[^)]*\)' "$CM" | head -15 | sed 's/^/  · line /'
else
    echo "(없음)"
fi
echo

echo "## 3. 훅 인벤토리"
echo "- ~/.claude/hooks/*.sh:"
ls -1 "$HOME/.claude/hooks/"*.sh 2>/dev/null | sed 's|.*/|  · |'
echo "- settings.json 훅 이벤트 수:"
python3 -c "
import json, os
try:
    d = json.load(open(os.path.expanduser('~/.claude/settings.json')))
    for ev, hs in (d.get('hooks') or {}).items():
        print(f'  · {ev}: {len(hs)}')
except Exception as e:
    print(f'  (읽기 실패: {e})')"
echo

echo "## 4. 최근 30일 가드 활동 (일하는지/노는지)"
now=$(date +%s)
echo "- rate-limit 차단 알림 플래그 (mtime 30일 내):"
found=0
for f in "$HOME"/.claude/state/rate-limit-alerted-*.flag; do
    [ -f "$f" ] || continue
    age=$(( (now - $(stat -c %Y "$f")) / 86400 ))
    if [ "$age" -le 30 ]; then echo "  · $(basename "$f" .flag | sed 's/rate-limit-alerted-//') (${age}일 전)"; found=1; fi
done
[ "$found" = 0 ] && echo "  · 없음"
echo "- bash-latency 누적 (30일 내 건수):"
BL="$HOME/.claude/telemetry/bash-latency.jsonl"
if [ -f "$BL" ]; then
    cutoff=$(date -d '30 days ago' '+%Y-%m-%d')
    cnt=$(awk -v c="$cutoff" -F'"ts":"' 'NF>1 {split($2,a,"\""); if (a[1] >= c) n++} END{print n+0}' "$BL")
    echo "  · ${cnt}건"
else
    echo "  · 텔레메트리 없음"
fi
echo "- AI 호출 (30일 내, provider별):"
AC="$HOME/.claude/telemetry/ai-calls.jsonl"
if [ -f "$AC" ]; then
    python3 - "$AC" <<'PYEOF'
import json, sys
from datetime import datetime, timedelta
cutoff = (datetime.now() - timedelta(days=30)).strftime('%Y-%m-%d')
counts = {}
for l in open(sys.argv[1]):
    try:
        o = json.loads(l)
        if str(o.get('ts', ''))[:10] >= cutoff:
            counts[o.get('provider', '?')] = counts.get(o.get('provider', '?'), 0) + 1
    except Exception:
        pass
print('\n'.join(f'  · {k}: {v}' for k, v in sorted(counts.items())) or '  · 없음')
PYEOF
else
    echo "  · 텔레메트리 없음"
fi
echo

echo "## 5. 머신 간 훅 drift (home vs peer, best-effort)"
if ssh -o BatchMode=yes -o ConnectTimeout=6 peer 'ls -1 ~/.claude/hooks/*.sh 2>/dev/null | xargs -n1 basename' > /tmp/peer-hooks.txt 2>/dev/null; then
    ls -1 "$HOME/.claude/hooks/"*.sh 2>/dev/null | xargs -n1 basename > /tmp/home-hooks.txt
    d=$(diff /tmp/home-hooks.txt /tmp/peer-hooks.txt 2>/dev/null)
    if [ -z "$d" ]; then echo "- 동일 (drift 없음)"; else echo "- 차이 발견:"; echo "$d" | sed 's/^/  /'; fi
    rm -f /tmp/peer-hooks.txt /tmp/home-hooks.txt
else
    echo "- peer 접속 불가 (스킵)"
fi
echo

echo "## 6. CLAUDE.md 정당화·중복 점검 (일일 리서치 2026-06-15 #1 채택)"
# 라인별 정당화 원칙(arps18): 중복/근접중복 라인은 정당화 약한 후보 → 사람이 판단.
if [ -f "$CM" ]; then
    echo "- 중복 라인 (공백·헤더·코드펜스·짧은 라벨 제외, 2회+ 등장 — 통합 후보):"
    dup=$(grep -vE '^\s*$|^\s*#|^\s*-{3,}|^\s*```|^\s*\|' "$CM" | sed 's/^[[:space:]]*//' \
        | awk '{ if (length($0) >= 12) print }' | sort | uniq -d | head -10)
    if [ -n "$dup" ]; then echo "$dup" | sed 's/^/  · /'; else echo "  · 없음"; fi
    echo "- 섹션별 줄 수 (60줄+ 섹션은 간결화 검토 후보):"
    awk '/^## / {if (h) print "  · " h ": " n "줄"; h=$0; sub(/^## /,"",h); n=0; next} {n++} END{if(h) print "  · " h ": " n "줄"}' "$CM" \
        | awk -F': ' '{split($2,a,"줄"); if (a[1]+0 >= 30) print $0}' | head -20
    echo "  (주의: 안전 가드/사고 보정 라인은 짧아도 정당화 있음 — 삭제 압력 금물)"
else
    echo "(CLAUDE.md 없음)"
fi
echo

echo "## 7. 미문서 설정 탐지 — 금지목록 감사 (일일 리서치 2026-06-15 #3 채택)"
# 근거: ai-debate run-20260614T221321Z — 미문서 hook/memory/permission 필드는 입력·권한·출력·
# 메모리를 세션로그 밖에서 바꿔 안전게이트와 충돌. "식별자 존재≠의미 안전". 활성 설정에 있으면 안 됨.
# 탐지만 함(리포트 전용). 발견되어도 자동 제거 안 함 — 사람이 검토.
SCAN_PATHS=("$HOME/.claude/settings.json" "$HOME/.claude/settings.local.json" "$HOME/.claude/mcp.json")
[ -d "$HOME/.claude/hooks" ] && SCAN_PATHS+=("$HOME/.claude/hooks")
[ -d "$HOME/.claude/agents" ] && SCAN_PATHS+=("$HOME/.claude/agents")
[ -d "$HOME/.claude/skills" ] && SCAN_PATHS+=("$HOME/.claude/skills")
# 고위험: 발견 시 경고 (우리 환경에서 미사용이어야 정상)
HI_RISK='updatedInput|permissionDecision|updatedMCPToolOutput|asyncRewake|autoMemoryEnabled|autoDreamEnabled|criticalSystemReminder_EXPERIMENTAL|omitClaudeMd|autoMode\.environment'
echo "- 고위험 미문서 키 (입력·권한·출력·메모리 세션로그 밖 변조 — 발견 시 즉시 검토):"
hit=$(grep -rnoE "$HI_RISK" "${SCAN_PATHS[@]}" 2>/dev/null | grep -v 'claude-config-review' | head -20)
if [ -n "$hit" ]; then echo "$hit" | sed 's|.*/\([^/]*:[0-9]*:\)|  ⚠ \1 |;t;s/^/  ⚠ /'; else echo "  · 없음 (정상)"; fi
echo "- 참고 키 (맥락 의존 — 정당한 용도 가능, 용도 확인용):"
LO_RISK='\"once\"|\"async\"|context:\s*fork|memory:\s*project|watchPaths|additionalContext'
hit2=$(grep -rnoE "$LO_RISK" "${SCAN_PATHS[@]}" 2>/dev/null | grep -v 'claude-config-review' | head -15)
if [ -n "$hit2" ]; then echo "$hit2" | sed 's/^/  · /'; else echo "  · 없음"; fi
echo

echo "## 8. 운영 피드백 승격 절차 (일일 리서치 2026-06-15 #1 채택 — CLAUDE.local.md 대체 경로)"
echo "- 반복 피드백·운영 교훈은 gitignore 되는 CLAUDE.local.md 가 아니라 아래 경로로 승격:"
echo "  1) 즉시: history.md 결정 로그 또는 progress.md Do Not Repeat 에 기록"
echo "  2) 반복 확인되면: 글로벌 CLAUDE.md 변경 후보로 제안(사람 승인 후 추가, 삭제 0 검증)"
echo "- CLAUDE.local.md 는 머신별 경로·토큰·비밀·일시 선호만 허용. 가드·훅·권한·전역 운영정책 금지."
echo "  (이유: 11세션·2PC 드리프트 + gitignore 라 중앙 감사 비가시성)"
echo

echo "---"
echo "처리 방법: 위 항목 중 정리할 것을 골라 수동으로 지시. 이 리포트는 아무것도 자동 변경하지 않음."
} > "$OUT" 2>&1

echo "리포트 생성: $OUT ($(wc -l < "$OUT")줄)"

# 텔레그램 알림 1건 (dotfiles 봇, best-effort — 실패해도 리포트는 남음)
ENV_FILE="$HOME/dotfiles/.claude/telegram/.env"
if [ -f "$ENV_FILE" ] && [ "${CONFIG_REVIEW_NO_NOTIFY:-0}" != "1" ]; then
    . "$ENV_FILE"
    if [ -n "${TELEGRAM_BOT_TOKEN:-}" ]; then
        head60=$(head -c 3000 "$OUT")
        curl -s -m 10 "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
            --data-urlencode "chat_id=${TELEGRAM_CHAT_ID:-}" \
            --data-urlencode "text=[분기 설정 리뷰] ${TODAY} (${HOST}) 리포트 생성됨.
경로: ${OUT}
요약(앞부분):
${head60}" >/dev/null 2>&1 && echo "텔레그램 알림 발송" || echo "알림 실패(리포트는 보존)"
    fi
fi
exit 0
