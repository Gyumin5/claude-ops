#!/usr/bin/env bash
# 계정 사용량 쪽을 이 기계에 세운다 — 안쪽에서만 듣는 쪽 하나와, 명령이 못 박힌
# 접속 열쇠 하나.
#
# 왜 이 모양인가. 그 기계는 여럿이 함께 쓰므로 안쪽 주소로 듣는 것만으로는 안
# 막힌다 — 같은 기계의 다른 사용자도 붙을 수 있다. 그래서 쪽에 열쇠글을 걸고,
# 그 열쇠글은 열쇠에 못 박힌 명령 안에서만 읽는다. 바깥 사람은 열쇠 파일 하나만
# 받으면 되고 열쇠글은 알 수도 없다.
#
# 두 번 돌려도 안전하다 — 이미 있는 열쇠·열쇠글은 그대로 두고 빠진 것만 만든다.
# 접속 설정은 덧붙이기만 하고, 손대기 전에 시각을 붙인 사본을 남긴다.
#
#   claude-usage-serve-install [--port 8787] [--repo ~/dotfiles-snapshot]
set -euo pipefail

PORT=8787
REPO="$HOME/dotfiles-snapshot"
while [ $# -gt 0 ]; do
  case "$1" in
    --port) PORT="$2"; shift 2 ;;
    --repo) REPO="$2"; shift 2 ;;
    -h|--help) sed -n '2,14p' "$0" | sed 's/^# \?//'; exit 0 ;;
    *) echo "모르는 인자: $1" >&2; exit 2 ;;
  esac
done

WEB="$REPO/bin/claude-usage-web"
[ -x "$WEB" ] || { echo "쪽을 못 찾았다: $WEB" >&2; exit 1; }

umask 077
mkdir -p "$HOME/.config/systemd/user" "$HOME/.config/claude-usage/keys" \
         "$HOME/.local/bin" "$HOME/.ssh"
chmod 700 "$HOME/.config/claude-usage/keys"

TOKEN_FILE="$HOME/.config/claude-usage/token"
if [ ! -s "$TOKEN_FILE" ]; then
  python3 -c 'import secrets; print(secrets.token_urlsafe(24))' > "$TOKEN_FILE"
fi
chmod 600 "$TOKEN_FILE"

PY=$(command -v python3)
cat > "$HOME/.config/systemd/user/claude-usage-web.service" <<EOF
[Unit]
Description=Claude account usage page (this machine only)

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/sh -c 'exec $PY %h/${WEB#$HOME/} --host 127.0.0.1 --port $PORT --token "\$(cat %h/.config/claude-usage/token)"'
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
EOF

cat > "$HOME/.local/bin/claude-usage" <<EOF
#!/bin/sh
# 다시 재고 그 결과를 보여 준다. 이 열쇠로 붙으면 무엇을 치든 이것만 돈다.
# 연달아 누른 회차는 쪽이 막고, 그때는 이미 방금 잰 값이라 그대로 보여 준다.
# 보여 주는 모양은 셋이다. 그냥 부르면 막대(터미널), "plain" 을 붙이면 막대와 칸 맞춤을
# 뺀 글(텔레그램), "raw" 를 붙이면 손대지 않은 글줄.
# 막대 쪽이 어떤 이유로든 실패하면 받은 글줄을 그대로 낸다 — 보여 주기 때문에 못 보는 일은 없다.
t=\$(cat "\$HOME/.config/claude-usage/token")
curl -sS --max-time 120 -X POST "localhost:$PORT/measure?t=\$t" >/dev/null 2>&1 || true
out=\$(curl -sS --max-time 20 "localhost:$PORT/usage.txt?t=\$t") || exit 1
gauge_arg=
case " \${SSH_ORIGINAL_COMMAND:-} \$* " in
  *" raw "*) printf '%s\n' "\$out"; exit 0 ;;
  *" plain "*) gauge_arg=--no-bar ;;
esac
printf '%s\n' "\$out" | $REPO/bin/claude-usage-gauge \$gauge_arg 2>/dev/null || printf '%s\n' "\$out"
EOF
chmod 700 "$HOME/.local/bin/claude-usage"

# restrict 가 먼저 와서 전부 끄고, 뒤에 아무것도 다시 켜지 않는다. command 는
# 접속한 쪽이 무슨 명령을 보내든 그것 대신 돌아간다.
OPT='restrict,no-pty,no-port-forwarding,no-agent-forwarding,no-X11-forwarding,no-user-rc'
AK="$HOME/.ssh/authorized_keys"
[ -f "$AK" ] && cp -a "$AK" "$AK.bak-$(date +%Y%m%d-%H%M%S)"
touch "$AK"; chmod 600 "$AK"

key="$HOME/.config/claude-usage/keys/usage"
[ -f "$key" ] || ssh-keygen -q -t ed25519 -N '' -C "claude-usage" -f "$key"
if ! grep -q 'claude-usage$' "$AK"; then
  printf '%s\n' "command=\"$HOME/.local/bin/claude-usage\",$OPT $(cat "$key.pub")" >> "$AK"
fi

if [ "${CLAUDE_USAGE_NO_SYSTEMD:-}" != "1" ]; then
  systemctl --user daemon-reload
  systemctl --user enable --now claude-usage-web.service
fi

echo "쪽: localhost:$PORT (이 기계 안에서만)"
echo "열쇠: $HOME/.config/claude-usage/keys/usage"
