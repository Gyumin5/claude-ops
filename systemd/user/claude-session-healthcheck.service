[Unit]
Description=Claude Session Healthcheck (15분마다 활성 세션 무응답 감지)

[Service]
Type=oneshot
Environment="PATH=%h/.bun/bin:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=%h/.local/bin/claude-session-healthcheck
# 감시자가 매달려 있으면 heartbeat 가 갱신되지 않아야 한다(멈춘 채 살아있는 것보다
# 죽는 게 낫다 — heartbeat 노화를 daily-report-healthcheck 가 교차 확인한다).
# Type=oneshot 에서는 RuntimeMaxSec 이 무시된다(systemd 가 "has no effect in combination
# with Type=oneshot" 경고만 찍고 무동작 — 2026-07-27 peer 실측). oneshot 의 실행시간
# 상한은 TimeoutStartSec 이다. 기본값도 5min 이지만 기본값에 의존하면 조용히 사라질 수
# 있어 명시한다.
TimeoutStartSec=300
StandardOutput=append:%h/.claude/logs/session-healthcheck.log
StandardError=append:%h/.claude/logs/session-healthcheck.log
