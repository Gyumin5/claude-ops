#!/bin/bash
# claude-boot-stagger: 세션 유닛 ExecStartPre 로 붙어 "부팅 직후에만" 기동을 흩뿌린다.
#
# 문제: 재부팅하면 세션 유닛이 부팅 16초 뒤 전부 동시에 뜬다. 각 세션이 bun(telegram MCP)을
#   따로 띄우므로 순간 프로세스가 몰리고, 일부 세션의 채널 스폰이 exit 2 로 죽어 텔레그램에
#   못 붙는다(boot-loss). 같은 시각 gnome-keyring 도 실패하는 등 환경이 덜 갖춰진 구간이다.
#
# 왜 무조건 sleep 이 아닌가: 컨트롤봇의 전체 재시작·개별 재시작이 활성 세션에 systemctl
#   restart 를 병렬로 던진다. 유닛에 그냥 sleep 을 넣으면 그 경로까지 같이 느려진다.
#   그래서 uptime 조건부 — 부팅 후 BOOT_WINDOW 초 안에서만 대기하고, 그 외엔 즉시 0초.
#
# 왜 일괄 지연이 아닌가: 전부 같은 N 초를 기다리면 혼잡 시점만 뒤로 옮길 뿐 동시성은 그대로다.
#   슬롯(0/15/30/45)에 흩뿌린다. 슬롯 배정은 "이 머신 세션 유닛을 정렬한 목록에서 자기 순번"
#   기준 — 해시 % 4 는 실측에서 peer 8세션 중 4개가 같은 슬롯(30s)에 몰려 목적을 잃었다.
#   순번 방식은 균등 분산이 보장되고 유닛 집합이 그대로면 매 부팅 동일(재현성 유지).
#
# 계약: 어떤 경로로도 exit 0. 여기서 실패해 세션 기동이 막히면 안 된다.
# kill switch: CLAUDE_BOOT_STAGGER_OFF=1 이면 무조건 즉시 반환.
set -uo pipefail

BOOT_WINDOW=${CLAUDE_BOOT_STAGGER_WINDOW:-120}   # 초. 이 안이면 부팅 직후로 판정
SLOT_SEC=${CLAUDE_BOOT_STAGGER_SLOT:-15}         # 슬롯 간격
SLOTS=${CLAUDE_BOOT_STAGGER_SLOTS:-4}            # 0..SLOTS-1 → 최대 (SLOTS-1)*SLOT_SEC

[ "${CLAUDE_BOOT_STAGGER_OFF:-}" = "1" ] && exit 0

UP=$(cut -d. -f1 /proc/uptime 2>/dev/null || echo "")
case "${UP:-x}" in ''|*[!0-9]*) exit 0 ;; esac   # uptime 못 읽으면 지연 없이 통과
[ "$UP" -lt "$BOOT_WINDOW" ] || exit 0           # 부팅 직후가 아니면 즉시

NAME="${CLAUDE_SESSION_NAME:-}"
[ -z "$NAME" ] && NAME=$(basename "$PWD" 2>/dev/null | tr '_' '-' || echo unknown)

# 1순위: 이 머신 세션 유닛 정렬목록에서 자기 순번 → 슬롯 균등 분산.
IDX=""
UNIT_DIR="$HOME/.config/systemd/user"
if [ -d "$UNIT_DIR" ]; then
    i=0
    for u in $(grep -l 'claude-service-exec' "$UNIT_DIR"/claude-*.service 2>/dev/null | xargs -r -n1 basename 2>/dev/null | sort); do
        [ "$u" = "claude-${NAME}.service" ] && { IDX=$i; break; }
        i=$((i + 1))
    done
fi

# 2순위(폴백): 목록 조회 실패·자기 유닛 미발견 시 이름 해시.
if [ -z "$IDX" ]; then
    IDX=$(printf '%s' "$NAME" | cksum 2>/dev/null | cut -d' ' -f1)
    case "${IDX:-x}" in ''|*[!0-9]*) IDX=0 ;; esac
fi

SEC=$(( (IDX % SLOTS) * SLOT_SEC ))

if [ "$SEC" -gt 0 ]; then
    # --status 로 사람이 직접 확인할 때만 출력. 유닛 경로에서는 조용히.
    [ "${1:-}" = "--verbose" ] && echo "[boot-stagger] $NAME: uptime ${UP}s → ${SEC}s 대기"
    sleep "$SEC"
fi
exit 0
