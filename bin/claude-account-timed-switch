#!/bin/bash
# 타이머가 부르는 자리. 고르는 규칙은 claude-account-night-switch 가 갖고 여기서 하는
# 것은 둘뿐이다 — 어느 회차인지 고르고, 그 결과를 유닛의 성패로 옮긴다.
#
# 평소에 도는 것은 now 하나다(밤 10분마다). night·day 는 손으로 한 번 돌려 볼 때 쓴다 —
# now 가 구간을 스스로 판정하므로 경계 시각에 따로 설 유닛이 필요 없다.
#
# 사람에게 알리는 것은 이 파일이 안 한다. 도구가 claude-operator-alert 로 직접 보낸다 —
# 세션을 거치면 그 세션이 깨고, 한도에 막힌 세션에는 어차피 안 닿는다.
set -uo pipefail

# 자리는 고정이다. 환경변수는 검사에서 가짜 도구를 끼우려고 열어 둔 구멍이고,
# 타이머는 이 변수를 안 넘기므로 운영에서는 아래 기본값만 쓰인다.
TOOL="${CLAUDE_NIGHT_SWITCH_BIN:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/claude-account-night-switch}"

MODE="${1:-}"
case "$MODE" in
    now)   ARGS=(--now --apply);   LABEL="계정 구간 맞추기" ;;
    night) ARGS=(--apply);         LABEL="밤 공용 계정 전환" ;;
    day)   ARGS=(--day --apply);   LABEL="아침 개인 계정 복귀" ;;
    *) echo "쓰는 법: $(basename "$0") now|night|day" >&2; exit 2 ;;
esac

MACHINE=$(tr -d '[:space:]' < "$HOME/.config/claude-machine-id" 2>/dev/null || true)

OUT=$("$TOOL" "${ARGS[@]}" 2>&1)
RC=$?

# 바꾼 것도 알릴 것도 없는 회차는 로그에 안 적는다. 5분마다 도는 자리라 그대로 적으면
# 하루 288줄이 쌓여서 정작 봐야 하는 줄이 묻힌다.
if [ "$RC" -ne 0 ] || ! printf '%s' "$OUT" | grep -q "그대로 둔다"; then
    echo "=== $(date '+%Y-%m-%d %H:%M:%S KST') $LABEL (machine=${MACHINE:-모름}) rc=$RC ==="
    printf '%s\n' "$OUT"
fi

# 도구의 값을 유닛의 성패로 옮긴다. 다 막혔거나(2) 겹쳤거나(3) 복귀를 미룬 것은(7)
# 이 도구가 다루기로 정한 상태이고 사람에게 이미 알렸다 — 유닛까지 실패로 세우면
# 5분마다 실패한 유닛이 쌓여서 진짜 고장이 안 보인다. 설정이 어긋났거나(1) 자격이
# 불분명한 것만(4) 유닛 실패로 올린다.
case "$RC" in
    0|2|3|7) exit 0 ;;
    *)       exit "$RC" ;;
esac
