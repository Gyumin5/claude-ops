[Unit]
Description=Claude Memory Lifecycle (progress→history promotion + archive, daily, DRY_RUN 기본)

[Service]
Type=oneshot
Environment="PATH=%h/.bun/bin:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="DRY_RUN=1"
ExecStart=%h/.local/bin/claude-memory-lifecycle all
StandardOutput=append:%h/.claude/logs/memory-lifecycle.log
StandardError=append:%h/.claude/logs/memory-lifecycle.log
