[Unit]
Description=Claude Stall Guard (rate-limit 해제 후에도 안 깨어난 세션을 주입으로 복구)

[Service]
Type=oneshot
TimeoutStartSec=180
Environment="PATH=%h/.bun/bin:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=%h/.local/bin/claude-stall-guard
StandardOutput=append:%h/.claude/logs/stall-guard.log
StandardError=append:%h/.claude/logs/stall-guard.log
