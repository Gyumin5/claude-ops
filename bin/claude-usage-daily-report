#!/usr/bin/env python3
"""claude-usage-daily-report — 매일 09:00 KST 어제 일자 5h/7d 사용량 추이 리포트.

데이터 소스: ~/.claude/state/usage-history/YYYY-MM.jsonl (statusline.py가 누적)
출력: 컨트롤봇 한 채팅으로 한국어 평문 한 덩어리.
"""
import json
import os
import sys
import time
from datetime import datetime, timedelta, timezone
from pathlib import Path
import urllib.parse
import urllib.request

sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import claude_session_lib as csl   # noqa: E402  (계정 식별 단일 출처)

KST = timezone(timedelta(hours=9))
HISTORY_DIR = Path.home() / ".claude" / "state" / "usage-history"
CONTROL_BOT_ENV = Path.home() / ".claude" / "control-bot" / ".env"
sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
from operator_chat import chat_id   # noqa: E402  (방 번호 단일 출처)

CONTROL_CHAT_ID = chat_id()


def load_token():
    if not CONTROL_BOT_ENV.is_file():
        return None
    for line in CONTROL_BOT_ENV.read_text().splitlines():
        if "=" in line and not line.strip().startswith("#"):
            k, v = line.split("=", 1)
            if k.strip() == "CONTROL_BOT_TOKEN":
                return v.strip().strip('"').strip("'")
    return None


def telegram_send(token, text):
    if not token:
        return False
    url = f"https://api.telegram.org/bot{token}/sendMessage"
    data = urllib.parse.urlencode({"chat_id": CONTROL_CHAT_ID, "text": text}).encode()
    req = urllib.request.Request(url, data=data, method="POST")
    try:
        urllib.request.urlopen(req, timeout=8).read()
        return True
    except Exception:
        return False


def load_records_for(day_kst):
    """day_kst: date object in KST. Return list of records with ts in that day."""
    recs = []
    ym = day_kst.strftime("%Y-%m")
    f = HISTORY_DIR / f"{ym}.jsonl"
    files = [f]
    # 월 경계 처리
    prev = (day_kst - timedelta(days=1)).strftime("%Y-%m")
    if prev != ym:
        files.append(HISTORY_DIR / f"{prev}.jsonl")
    start = datetime.combine(day_kst, datetime.min.time(), tzinfo=KST).timestamp()
    end = start + 86400
    for path in files:
        if not path.is_file():
            continue
        try:
            for line in path.read_text().splitlines():
                line = line.strip()
                if not line:
                    continue
                try:
                    r = json.loads(line)
                except Exception:
                    continue
                ts = r.get("ts")
                if not isinstance(ts, (int, float)):
                    continue
                if start <= ts < end:
                    recs.append(r)
        except Exception:
            continue
    recs.sort(key=lambda r: r.get("ts", 0))
    return recs


def fmt_kst(ts):
    return datetime.fromtimestamp(ts, tz=KST).strftime("%H:%M")


def acct_label(uuid):
    """계정 번호를 자리 이름으로 바꾼다. 못 찾으면 번호 앞 여덟 자, 번호도 없으면 모름."""
    name = csl.account_name(uuid)
    if name:
        return name
    if isinstance(uuid, str) and uuid:
        return "계정 " + uuid[:8]
    return "계정 모름"


def window_label(ts):
    if not isinstance(ts, (int, float)):
        return "창 모름"
    return datetime.fromtimestamp(ts, tz=KST).strftime("%m-%d %H:%M 초기화")


def group(recs, pct_key, reset_key):
    """같은 선 위에 놓을 수 있는 표본만 묶는다 — 한 계정의 한 창이 한 묶음이다.

    계정을 갈아 끼우거나 창이 초기화되면 사용량은 0 부터 다시 쌓인다. 그 둘을 한
    줄로 합치면 쓰지도 않은 사용량이 줄어든 것처럼 읽히고(2026-11-07 둘째 기계 실측:
    "7일 시작 76퍼센트 → 종료 24퍼센트"), 피크와 최저도 서로 다른 계정의 값이
    섞인다. 묶음 안에서만 처음·끝·피크를 말한다.

    묶음은 처음 나온 순서로 돌려준다 — 하루를 시간 순서로 읽게.
    """
    out = {}
    for r in recs:
        if not isinstance(r.get(pct_key), (int, float)):
            continue
        out.setdefault((r.get("acct"), r.get(reset_key)), []).append(r)
    for rows in out.values():
        rows.sort(key=lambda r: r.get("ts", 0))
    return sorted(out.items(), key=lambda kv: kv[1][0].get("ts", 0))


def window_line(key, rows, pct_key):
    acct, reset = key
    pcts = [r[pct_key] for r in rows]
    top = max(rows, key=lambda r: r[pct_key])
    return ("  {} · {} 창: {}% ({}) → {}% ({}), 피크 {}% ({}), 표본 {}개"
            .format(acct_label(acct), window_label(reset),
                    round(pcts[0], 1), fmt_kst(rows[0]["ts"]),
                    round(pcts[-1], 1), fmt_kst(rows[-1]["ts"]),
                    round(top[pct_key], 1), fmt_kst(top["ts"]), len(rows)))


def summarize(recs):
    """하루치 표본을 계정·창 묶음으로 갈라 돌려준다. 묶음이 없으면 None."""
    if not recs:
        return None
    sd = group(recs, "sd_pct", "sd_reset")
    fh = group(recs, "fh_pct", "fh_reset")
    if not sd and not fh:
        return None
    return {"sd": sd, "fh": fh, "sample_count": len(recs)}


def main():
    yesterday = (datetime.now(tz=KST) - timedelta(days=1)).date()
    recs = load_records_for(yesterday)
    summary = summarize(recs)
    if not summary:
        msg = f"[usage-daily] {yesterday.strftime('%Y-%m-%d')} 어제 사용량 기록 없음 (statusline 미렌더 또는 세션 미사용)."
    else:
        ymd = yesterday.strftime("%Y-%m-%d")
        lines = [f"[usage-daily] {ymd} 어제 사용량", ""]
        if summary["sd"]:
            lines.append("7일 한도")
            lines += [window_line(k, rows, "sd_pct") for k, rows in summary["sd"]]
        if summary["fh"]:
            lines.append("5시간 한도")
            lines += [window_line(k, rows, "fh_pct") for k, rows in summary["fh"]]
        lines.append("")
        lines.append(f"표본 {summary['sample_count']}개. 줄은 계정과 창으로 가른다 — "
                     "계정을 갈아 끼우거나 창이 초기화되면 수치가 0 부터 다시 쌓이므로 "
                     "서로 다른 줄의 수치를 빼지 않는다.")
        msg = "\n".join(lines)

    token = load_token()
    if not telegram_send(token, msg):
        print(msg)


if __name__ == "__main__":
    main()
