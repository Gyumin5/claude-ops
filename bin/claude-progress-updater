#!/bin/bash
# claude-progress-updater: 세션 transcript jsonl을 분석해 progress.md를 자동 갱신.
# 메인 세션 블로킹 없이 헤드리스 claude -p로 차분 생성.
#
# 사용:
#   claude-progress-updater <project-cwd>
#   예: claude-progress-updater ~/dotfiles
#
# 동작:
#   1. cwd → claude project key (/와 _ 를 -로) → transcript jsonl 위치 결정
#   2. 가장 최신 jsonl의 last-processed offset (state file) 이후 entries 추출
#   3. 기존 progress.md 전문 + 새 entries → claude -p 로 "패치 목록"(JSON) 생성
#   4. 각 패치의 근거(evidence)가 입력에 글자 그대로 있는지 검증 후에만 적용
#   5. offset 갱신
#
# 2026-08-10 전면 개편 — 왜 전문 재생성을 버렸나 (ai-debate run-20260810T122622Z):
#   옛 방식은 "기존 progress.md(head 8000B) + transcript 조각" 을 주고 progress.md
#   전문을 다시 쓰게 한 뒤 그 결과로 파일을 통째 덮었다. 둘째 기계에서 5회 관측된 사고
#   (08-10 14:22~21:22 KST): 없던 사건을 완료로 기입("밤새 tick 14회", "08-11 07:00
#   guardian 라운드 실행"), updated 를 하루 미래로 기입, 세션이 직접 정정한 문장을
#   "재발 없음" 따위로 덮어씀. 하트비트 체인이 1시간 간격으로 연속이라 그 tick 들은
#   실재하지 않았다.
#   구조가 원인이다. (a) 프롬프트에 현재 시각이 없어 날짜를 추측하게 했고, (b) "기존
#   길이의 30% 이상" 하한이 새로 쓸 게 없을 때도 긴 문서를 기억으로 재생성하도록
#   강제했으며(재생성은 각색이 된다), (c) 8000B 로 자른 본문을 주고 전문을 요구해
#   못 본 tail 을 지어내게 했고, (d) 기존 가드 4종(길이·헤더·어휘중복 Jaccard)은 전부
#   형태만 봐서 유창한 창작을 전부 통과시켰다.
#   그래서 모델은 이제 파일을 쓰지 않는다. 모델은 "무엇을 무엇으로 바꿀지 + 그 근거"
#   만 제안하고, 파일 보존·적용·시각 기입은 이 스크립트가 결정론적으로 한다. 근거가
#   입력에 글자 그대로 없으면 그 패치는 버려진다 — 지어낸 사건은 근거를 댈 수 없다.
#   변경 없음({"patches":[]})은 정상 결과다. 옛 30% 하한·헤더검사·Jaccard drift 검사는
#   전부 제거했다(형태 가드로 사실을 막으려던 설계였고, 패치 방식에선 `old` 가 이 파일에
#   실재해야 하고 evidence 가 이 입력에 실재해야 하므로 타 세션 유출도 구조적으로 막힌다).

set -uo pipefail

CWD="${1:?usage: claude-progress-updater <project-cwd>}"
[ -d "$CWD" ] || { echo "[updater] cwd $CWD not found" >&2; exit 1; }

export NVM_DIR="$HOME/.nvm"
set +u; [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"; set -u
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

LOG_DIR="$HOME/.claude/logs"
STATE_DIR="$HOME/.claude/state/progress-updater"
mkdir -p "$LOG_DIR" "$STATE_DIR"

PROJ_KEY=$(echo "$CWD" | sed -e 's|/|-|g' -e 's|_|-|g')
PROJ_DIR="$HOME/.claude/projects/${PROJ_KEY}"
[ -d "$PROJ_DIR" ] || { echo "[updater] proj dir $PROJ_DIR not found" >&2; exit 1; }

LATEST_JSONL=$(ls -t "$PROJ_DIR"/*.jsonl 2>/dev/null | head -1)
[ -z "$LATEST_JSONL" ] && { echo "[updater] no jsonl in $PROJ_DIR" >&2; exit 0; }

STATE_FILE="$STATE_DIR/$(basename "$CWD").state"
LASTWRITE_FILE="$STATE_DIR/$(basename "$CWD").lastwrite"
LOG_FILE="$LOG_DIR/progress-updater.log"

log() { echo "[$(date -Iseconds)] [$(basename "$CWD")] $1" >> "$LOG_FILE"; }

# 마지막 처리 offset 읽기 (jsonl line count)
last_offset=0
[ -f "$STATE_FILE" ] && last_offset=$(cat "$STATE_FILE" 2>/dev/null || echo 0)

cur_lines=$(wc -l < "$LATEST_JSONL" 2>/dev/null || echo 0)
new_lines=$(( cur_lines - last_offset ))

# 2026-05-21: offset 추적 버그 픽스 + bounded mode.
# 1. 파일이 rotate/truncate 되어 cur_lines < last_offset 이면 offset reset (deadlock 회피).
# 2. 새 entries 가 너무 많으면 (MAX_NEW_LINES) tail 만 처리. 큰 jsonl 에서 OOM/timeout 회피.
MAX_NEW_LINES=500
if [ "$cur_lines" -lt "$last_offset" ]; then
    log "rotation detected (offset=$last_offset, cur=$cur_lines) → offset reset"
    last_offset=$(( cur_lines > MAX_NEW_LINES ? cur_lines - MAX_NEW_LINES : 0 ))
    new_lines=$(( cur_lines - last_offset ))
fi

if [ "$new_lines" -le 0 ]; then
    log "no new entries (offset=$last_offset, cur=$cur_lines)"
    exit 0
fi

if [ "$new_lines" -gt "$MAX_NEW_LINES" ]; then
    log "new_lines=$new_lines truncated to tail $MAX_NEW_LINES (bounded mode)"
    new_lines="$MAX_NEW_LINES"
fi

# 새 entries 추출 (text turns만, 너무 길면 자르기)
DIFF_FILE=$(mktemp)
PATCH_FILE=$(mktemp)
trap 'rm -f "$DIFF_FILE" "$PATCH_FILE"' EXIT
tail -n "$new_lines" "$LATEST_JSONL" | python3 -c "
import json, sys
for line in sys.stdin:
    try:
        d = json.loads(line)
    except:
        continue
    t = d.get('type', '')
    ts = (d.get('timestamp', '') or '')[:19]
    msg = d.get('message', {}) or {}
    if t == 'user':
        c = msg.get('content', '')
        if isinstance(c, str) and c.strip() and not c.startswith('<system-reminder>'):
            print(f'U[{ts}] {c[:500]}')
    elif t == 'assistant':
        c = msg.get('content', [])
        if isinstance(c, list):
            for it in c:
                if isinstance(it, dict):
                    if it.get('type') == 'text':
                        x = (it.get('text') or '').strip()
                        if x:
                            print(f'A[{ts}] {x[:500]}')
                    elif it.get('type') == 'tool_use':
                        print(f'A[{ts}] [tool:{it.get(\"name\",\"?\")}]')
" > "$DIFF_FILE"

diff_size=$(wc -c < "$DIFF_FILE")
# 2026-05-21: skip 룰 완화 (1500 → 300). 도구 위주 세션도 갱신 빈도 증가.
if [ "$diff_size" -lt 300 ]; then
    log "diff too small ($diff_size bytes), skip"
    echo "$cur_lines" > "$STATE_FILE"
    exit 0
fi

# diff 상한: 12KB (claude -p input 토큰 절약).
# 주의 — 이 절단은 evidence 대조 대상도 같이 자른다. 잘린 뒤쪽을 근거로 든 패치는
# 검증에서 떨어진다. 그건 의도한 fail-closed 다(못 본 걸 근거로 삼는 것보다 낫다).
if [ "$diff_size" -gt 12000 ]; then
    head -c 12000 "$DIFF_FILE" > "${DIFF_FILE}.trim"
    mv "${DIFF_FILE}.trim" "$DIFF_FILE"
    log "diff trimmed to 12KB"
fi

PROG="$CWD/progress.md"

# progress.md 는 정책상 180줄 상한이라 통째로 읽어도 작다. 옛 코드처럼 head 8000B 만
# 주면 모델이 못 본 tail 을 "복원"하다 지어낸다 — 이번 사고의 한 축이었다.
existing_prog=""
[ -f "$PROG" ] && existing_prog=$(cat "$PROG")
if [ -z "$existing_prog" ]; then
    log "progress.md 없음/빈 파일 — 패치 대상이 없어 스킵(신규 생성은 세션이 한다)"
    echo "$cur_lines" > "$STATE_FILE"
    exit 0
fi

# 2026-05-21: PostToolUse delta jsonl 도 프롬프트에 포함 (도구 위주 세션 활동 흔적).
# 마지막 100줄만, 합쳐 5KB 이내로 자름.
DELTA_FILE="$HOME/.claude/state/progress-delta/$(basename "$CWD").jsonl"
delta_summary=""
if [ -f "$DELTA_FILE" ]; then
    delta_summary=$(tail -n 100 "$DELTA_FILE" 2>/dev/null \
        | jq -r '"[" + (.ts // "?")[11:19] + "] " + .kind + " " + (.hint // "")' 2>/dev/null \
        | tail -c 5000)
fi

# 최근수정 가드 (2026-07-13 도입, 2026-08-10 확대):
# 라이브 세션이 방금 progress.md 를 직접 손봤으면 이번 사이클은 건드리지 않는다.
# 창을 600초에서 2100초로 넓힌 이유: 타이머 주기가 1800초라 600초 창은 매 주기의
# 2/3 를 무방비로 뒀다. 그 사고도 20:23 수동정정 → 20:43 자동덮어쓰기였다.
# 단, 직전에 파일을 쓴 게 우리 자신이면 그건 "세션이 손댄 것" 이 아니므로 통과시킨다.
RECENT_EDIT_GUARD_SEC="${RECENT_EDIT_GUARD_SEC:-2100}"
prog_mtime=$(stat -c %Y "$PROG" 2>/dev/null || echo 0)
now_ts=$(date +%s)
if [ $((now_ts - prog_mtime)) -lt "$RECENT_EDIT_GUARD_SEC" ]; then
    own_mtime=0
    [ -f "$LASTWRITE_FILE" ] && own_mtime=$(cat "$LASTWRITE_FILE" 2>/dev/null || echo 0)
    if [ "$prog_mtime" != "$own_mtime" ]; then
        # 커서를 전진시키지 않는다. 옛 코드는 여기서 offset 을 현재 줄수로 밀어버렸는데,
        # 그러면 스킵된 주기에 오간 대화가 영구히 근거에서 빠진다 — 다음 주기는 그 뒤부터만
        # 본다. 둘째 기계 실측(2026-08-27)에서 이게 실제로 사고를 만들었다: 세션이 압축된
        # 기억으로 옛 숫자(20/22)를 되살린 뒤 12주기 중 11회가 스킵됐고, 그 스킵들이 "22종
        # 전부로 올려 잡는다" 는 근거 문장을 통째로 버렸다. 근거가 사라지니 나중에 갱신기가
        # 돌아도 고칠 수 없다. 틀린 줄이 24시간 반 살아남아 깃허브 이슈로 새어나갔다.
        # 커서를 유지하면 그 대화가 다음 비스킵 주기까지 살아 있다. 밀리는 양은 위쪽
        # MAX_NEW_LINES(tail 500줄) 로 이미 묶여 있어 무한히 커지지 않는다.
        # (ai-debate run-20260827T062956Z — 아비터가 선행 확인으로 지목한 자리다.)
        log "progress.md 최근 ${RECENT_EDIT_GUARD_SEC}s 이내 세션이 직접 수정 — 이번 주기 스킵(커서 유지 offset=$last_offset)"
        exit 0
    fi
fi

NOW_KST=$(date '+%Y-%m-%d %H:%M KST')
TODAY=$(date '+%Y-%m-%d')

PROMPT=$(cat <<EOF
너는 progress.md 를 직접 쓰지 않는다. 무엇을 무엇으로 바꿀지와 그 근거만 JSON 으로 제안한다.
적용 여부는 프로그램이 근거를 대조해서 결정한다.

현재 시각: $NOW_KST (오늘은 $TODAY 다. 이보다 미래 날짜를 사건 기록으로 쓰지 마라.)
프로젝트: $CWD

## 현재 progress.md 전문
$existing_prog

## 새 transcript (마지막 처리 후 추가분)
$(cat "$DIFF_FILE")

## 최근 도구 활동 (PostToolUse delta — text turn 없이 실행된 명령/편집 흔적)
$delta_summary

## 출력 형식
JSON 한 덩어리만. 코드펜스(\`\`\`) 금지. 서론·설명 금지.

{"patches":[
  {"op":"replace","old":"<현재 progress.md 에 정확히 한 번 나오는 문자열>","new":"<바꿀 내용>","evidence":"<위 입력에서 글자 그대로 복사한 문장>"},
  {"op":"append","section":"<## 로 시작하는 섹션 제목 한 줄>","new":"<그 섹션 끝에 추가할 줄>","evidence":"<위 입력에서 글자 그대로 복사한 문장>"}
]}

## 규칙 (위반하면 그 패치는 기계적으로 버려진다)
1. evidence 는 위 "새 transcript" 또는 "최근 도구 활동" 에서 글자 그대로 복사해라. 요약·의역·재구성 금지.
   프로그램이 입력에 그 문자열이 실재하는지 대조한다. 근거를 못 대는 변경은 전부 버려진다.
2. 입력에 근거가 없는 사건을 쓰지 마라. 특히 "밤새 N회 실행", "07:00 라운드 완료" 처럼
   실행됐을 법한 일을 실행된 것으로 적지 마라.
3. 예정·계획·앞으로 할 일을 완료로 적지 마라. 예정이면 예정이라고 써라.
4. 바꿀 게 없으면 {"patches":[]} 를 출력해라. 그게 정상이고 아무 문제 없다.
   억지로 바꿀 거리를 만들지 마라.
5. updated: 줄은 건드리지 마라. 프로그램이 실제 시각으로 쓴다.
6. old 는 현재 progress.md 에 정확히 한 번만 나오는 문자열이어야 한다. 짧고 흔한 문자열 금지.
7. 이미 적혀 있는 판단을 반대로 뒤집는 패치는 입력에 그 반전의 근거가 명시적으로 있을 때만.
   세션이 직접 정정한 문장을 근거 없이 되돌리지 마라.
8. 패치는 최대 8개. 잡담·단순 Q&A·중간 디버깅은 반영하지 마라.
9. "## Blockers" 와 그 아래(### 완료(최근) 포함)는 건드리지 마라. 그 구역은 세션이 쓰는 할 일
   목록이고, 프로그램이 그 구역을 바꾸는 패치를 전부 거절한다. 항목을 더하지도, 고치지도,
   지우지도, 완료로 옮기지도, 완료 표시를 붙이지도 마라. 번호를 다시 매기지도 마라.
   그 구역에 적을 만한 것을 봤으면 패치로 내지 말고 그대로 둬라 — 거절된 제안은 대기함에
   기록되고 세션이 읽는다.
10. 회차 수치·경과·진행 로그("N회 돌았다", "DONE 1,22" 같은 것)는 할 일 목록이 아니라
   "## Current State" 에 한 줄로 적어라. 같은 줄을 회차마다 수치만 바꿔 다시 쓰지 마라.
EOF
)

log "calling claude -p (diff=$diff_size bytes, prog=${#existing_prog} bytes)"
# CLAUDE_AUTOMATED=1: 자동 hook들이 사용자 세션이 아님을 인지해서 스킵하도록.
# - telegram-reply-injector / enforcer: prompt 안에 채널 태그 있어도 reply 강제 X (이전 leak 원인).
# - rate-limit-prompt-guard: 자동 작업이므로 큐잉 대상 아님.
# --strict-mcp-config + 빈 mcp config: plugin:telegram 등 MCP 미로드.
#   이유: 자식 claude 가 부모와 같은 봇 토큰으로 getUpdates 들어가면 Telegram 이
#   "Conflict: terminated by other getUpdates request" 반환해 부모 bun 끊김.
EMPTY_MCP_CFG=$(mktemp -t empty-mcp-XXXX.json)
echo '{"mcpServers": {}}' > "$EMPTY_MCP_CFG"
# --output-format json: 결과 텍스트 외에 total_cost_usd/usage(토큰)도 같이 옴 —
# quota 추적을 위해 usage-log.jsonl 에 남긴다(2026-07-09, 사용자 요청).
# JSON 파싱 실패 시(형식 변경 등) 원본 그대로 통과 — 로깅만 스킵, 본 기능은 안 깨짐.
USAGE_LOG=~/.claude/state/progress-updater-usage.jsonl
mkdir -p "$(dirname "$USAGE_LOG")"
RAW_JSON=$(CLAUDE_AUTOMATED=1 timeout 90 claude --strict-mcp-config --mcp-config "$EMPTY_MCP_CFG" -p --output-format json "$PROMPT" 2>> "$LOG_FILE")
rm -f "$EMPTY_MCP_CFG"
printf '%s' "$RAW_JSON" | python3 -c '
import json, sys, datetime
raw = sys.stdin.read()
proj, log_path = sys.argv[1], sys.argv[2]
try:
    d = json.loads(raw)
except Exception:
    sys.stdout.write(raw)
    sys.exit(0)
usage = d.get("usage") or {}
rec = {
    "ts": datetime.datetime.now(datetime.timezone(datetime.timedelta(hours=9))).isoformat(timespec="seconds"),
    "project": proj,
    "cost_usd": d.get("total_cost_usd"),
    "duration_ms": d.get("duration_ms"),
    "input_tokens": usage.get("input_tokens"),
    "output_tokens": usage.get("output_tokens"),
    "cache_read_input_tokens": usage.get("cache_read_input_tokens"),
    "cache_creation_input_tokens": usage.get("cache_creation_input_tokens"),
}
try:
    with open(log_path, "a") as f:
        f.write(json.dumps(rec, ensure_ascii=False) + "\n")
except Exception:
    pass
sys.stdout.write(d.get("result", ""))
' "$(basename "$CWD")" "$USAGE_LOG" > "$PATCH_FILE"

if [ ! -s "$PATCH_FILE" ]; then
    log "claude returned empty response, skip"
    exit 0
fi

# 패치 검증·적용. 파일을 쓰는 건 여기 하나뿐이다.
APPLY_MODE=apply
[ "${UPDATER_AUTO_MERGE:-0}" = "1" ] || APPLY_MODE=propose

BACKUP_DIR="$HOME/.claude/state/progress-updater/backups/$(basename "$CWD")"
mkdir -p "$BACKUP_DIR"
# 제안본은 프로젝트 안에 두지 않는다. 이 도구의 다른 산출물(offset state·delta·백업·
# 사용량)이 전부 여기 있고, 프로젝트 루트에 쓰면 state/ 를 gitignore 안 한 저장소마다
# untracked 잔재가 생긴다 — auto-merge 가 기본 꺼짐이라 매 회차 쌓인다. 어디 있는지는
# PROPOSED 로그 줄에 경로를 찍어 알린다.
PROPOSED_DIR="$HOME/.claude/state/progress-updater/proposed"
mkdir -p "$PROPOSED_DIR"

# 대기함: 보호 구역(## Blockers) 때문에 거절한 제안을 버리지 않고 여기 남긴다.
# 세션이 읽고 수락·거절을 스스로 판단한다. 쓰기에 실패하면 progress.md 를 안 쓰고
# offset 도 안 올린다 — 조용히 잃는 것이 이 규칙이 막으려는 바로 그 일이다.
PENDING_DIR="$HOME/.claude/state/progress-updater/pending"
mkdir -p "$PENDING_DIR"

RESULT=$(PU_PATCH="$PATCH_FILE" PU_DIFF="$DIFF_FILE" PU_DELTA="$delta_summary" \
         PU_PROG="$PROG" PU_TODAY="$TODAY" PU_NOW="$NOW_KST" PU_MTIME="$prog_mtime" \
         PU_MODE="$APPLY_MODE" PU_BACKUP="$BACKUP_DIR" PU_LASTWRITE="$LASTWRITE_FILE" \
         PU_PROPOSED="$PROPOSED_DIR/$(basename "$CWD").md" \
         PU_PENDING="$PENDING_DIR/$(basename "$CWD").jsonl" \
         PU_SESSION="$(basename "$CWD")" \
         PU_RANGE="$last_offset..$cur_lines" \
         python3 - <<'PYEOF'
import hashlib, json, os, re, shutil, sys, time

patch_path = os.environ["PU_PATCH"]
prog_path  = os.environ["PU_PROG"]
today      = os.environ["PU_TODAY"]
now_kst    = os.environ["PU_NOW"]
mtime_seen = int(os.environ.get("PU_MTIME") or 0)
mode       = os.environ.get("PU_MODE", "propose")
backup_dir = os.environ["PU_BACKUP"]
lastwrite  = os.environ["PU_LASTWRITE"]

with open(os.environ["PU_DIFF"], encoding="utf-8", errors="replace") as f:
    evidence_blob = f.read()
evidence_blob += "\n" + (os.environ.get("PU_DELTA") or "")

with open(patch_path, encoding="utf-8", errors="replace") as f:
    raw = f.read().strip()

# 코드펜스로 감싸 오는 경우가 있어 방어적으로 벗긴다.
if raw.startswith("```"):
    raw = re.sub(r"^```[a-zA-Z]*\n", "", raw)
    raw = re.sub(r"\n```\s*$", "", raw)
m = re.search(r"\{.*\}", raw, re.S)
if not m:
    print("PARSE_FAIL 출력에 JSON 이 없다")
    sys.exit(20)
try:
    doc = json.loads(m.group(0))
except Exception as e:
    print("PARSE_FAIL %s" % e)
    sys.exit(20)

MAX_PATCHES_SEEN = 32   # 분류까지 보는 상한 (폭주 방어)
MAX_PATCHES_APPLY = 8   # 실제로 적용하는 상한 (종전 값)

patches = doc.get("patches")
if not isinstance(patches, list):
    print("PARSE_FAIL patches 배열이 없다")
    sys.exit(20)
if not patches:
    print("NO_CHANGE 모델이 바꿀 게 없다고 답했다")
    sys.exit(10)
# 상한을 거는 것은 분류 뒤다. 먼저 자르면 보호 구역을 건드리는 제안이 정상 패치를
# 상한 밖으로 밀어낸다 — 그 회차의 정당한 변경이 이유 없이 사라진다.
patches = patches[:MAX_PATCHES_SEEN]


def norm(s):
    return re.sub(r"\s+", " ", (s or "")).strip()


EV_BLOB = norm(evidence_blob)
# 근거 대조는 공백만 정규화한 부분문자열 일치. 의역·요약은 통과 못 한다 — 그게 목적이다.
MIN_EV = 15

DATE_RE = re.compile(r"(?<!\d)(20\d{2})-(\d{2})-(\d{2})(?!\d)")
MD_RE = re.compile(r"(?<!\d)(\d{2})-(\d{2})(?!\d)")
DONE_WORDS = ("완료", "실행", "확인", "집계", "했다", "됐다", "성공", "통과", "끝냈", "마침", "적용")
PLAN_WORDS = ("예정", "예상", "계획", "까지", "이내", "목표", "대기", "필요", "해야")


def future_fabrication(text):
    """오늘보다 미래인 날짜를 '일어난 일'로 적은 줄을 찾는다.

    미래 날짜 자체는 정당하다 — progress.md 에는 "08-13 만료 예정", "21:30 완료 예상"
    같은 기한이 늘 들어간다. 그래서 문서 전체가 아니라 줄 단위로, 완료를 말하는 어휘가
    있고 예정을 말하는 어휘가 없을 때만 거부한다. 2026-08-10 사고의 핵심 증상이다.
    """
    ty, tm, td = today.split("-")
    for line in (text or "").splitlines():
        hits = []
        for y, mo, d in DATE_RE.findall(line):
            hits.append((y, mo, d))
        for mo, d in MD_RE.findall(line):
            if not DATE_RE.search(line):
                hits.append((ty, mo, d))
        if not hits:
            continue
        if not any(w in line for w in DONE_WORDS):
            continue
        if any(w in line for w in PLAN_WORDS):
            continue
        for y, mo, d in hits:
            if not (1 <= int(mo) <= 12 and 1 <= int(d) <= 31):
                continue
            if (y, mo, d) > (ty, tm, td):
                return "%s-%s-%s" % (y, mo, d)
    return None


PROTECTED_HEAD = "## Blockers"


def protected_span(t):
    """보호 구역의 문자 구간 (시작, 끝). 없으면 None.

    구역은 "## Blockers" 줄부터 다음 "## " 머리말 직전까지이고 "### 완료(최근)" 도 안에
    든다. 완료 이동과 완료 표시 붙이기까지 같이 막아야 해서 하위 절을 떼지 않는다.
    """
    lines = t.split("\n")
    start = None
    for n, l in enumerate(lines):
        if l.strip() == PROTECTED_HEAD:
            start = n
            break
    if start is None:
        return None
    end = len(lines)
    for n in range(start + 1, len(lines)):
        if lines[n].startswith("## "):
            end = n
            break
    a = sum(len(l) + 1 for l in lines[:start])
    b = sum(len(l) + 1 for l in lines[:end])
    return (a, b)


def protected_block(t):
    """보호 구역의 내용. 없으면 None."""
    sp = protected_span(t)
    return None if sp is None else t[sp[0]:sp[1]]


def touches_protected(t, p):
    """이 패치가 보호 구역을 건드리려 하나 — 적용 전에 보이는 것만 본다.

    적용 뒤 불변식 대조가 최종 판정이고 이건 앞단 분류다. 앞단을 두는 이유는 상한
    때문이다 — 보호 대상을 먼저 걸러내야 정상 패치가 8개 밖으로 안 밀린다.
    """
    sp = protected_span(t)
    op = p.get("op")
    if op == "append":
        sec = (p.get("section") or "").strip()
        if sec == PROTECTED_HEAD or sec.startswith("### "):
            return True
        if sp is None:
            return False
        lines = t.split("\n")
        for n, l in enumerate(lines):
            if l.strip() == sec:
                at = sum(len(x) + 1 for x in lines[:n])
                return sp[0] <= at < sp[1]
        return False
    if op == "replace":
        old = p.get("old") or ""
        if PROTECTED_HEAD in old or PROTECTED_HEAD in (p.get("new") or ""):
            return True
        if sp is None or not old:
            return False
        idx = t.find(old)
        if idx < 0:
            return False
        # 구간이 겹치면 건드리는 것이다. 경계를 걸친 교체도 여기서 걸린다.
        return idx < sp[1] and (idx + len(old)) > sp[0]
    return False


with open(prog_path, encoding="utf-8") as f:
    text = f.read()

ORIG_TEXT = text
ORIG_BLOCK = protected_block(text)

applied, rejected, held = [], [], []
for i, p in enumerate(patches):
    if not isinstance(p, dict):
        rejected.append((i, "패치가 객체가 아니다"))
        continue
    if touches_protected(text, p):
        held.append((i, p, "보호 구역(%s)은 세션만 고친다" % PROTECTED_HEAD))
        continue
    if len(applied) >= MAX_PATCHES_APPLY:
        rejected.append((i, "적용 상한 %d 초과" % MAX_PATCHES_APPLY))
        continue
    op = p.get("op")
    new = p.get("new") or ""
    ev = norm(p.get("evidence"))
    if len(ev) < MIN_EV:
        rejected.append((i, "근거가 너무 짧다(%d자)" % len(ev)))
        continue
    if ev not in EV_BLOB:
        rejected.append((i, "근거가 입력에 없다: %s" % ev[:60]))
        continue
    bad = future_fabrication(new)
    if bad:
        rejected.append((i, "미래 날짜(%s)를 일어난 일로 적었다" % bad))
        continue
    if op == "replace":
        old = p.get("old") or ""
        if len(old.strip()) < 10:
            rejected.append((i, "old 가 너무 짧다"))
            continue
        cnt = text.count(old)
        if cnt != 1:
            rejected.append((i, "old 가 %d번 일치(정확히 1회여야 한다)" % cnt))
            continue
        cand = text.replace(old, new, 1)
        if protected_block(cand) != ORIG_BLOCK:
            held.append((i, p, "적용하면 보호 구역이 바뀐다"))
            continue
        text = cand
        applied.append((i, "replace"))
    elif op == "append":
        sec = (p.get("section") or "").strip()
        if not sec.startswith("#"):
            rejected.append((i, "section 이 헤더가 아니다"))
            continue
        lines = text.splitlines()
        try:
            at = next(n for n, l in enumerate(lines) if l.strip() == sec)
        except StopIteration:
            rejected.append((i, "section 을 못 찾았다: %s" % sec[:40]))
            continue
        end = len(lines)
        for n in range(at + 1, len(lines)):
            if lines[n].startswith("#"):
                end = n
                break
        while end > at + 1 and not lines[end - 1].strip():
            end -= 1
        lines[end:end] = new.splitlines() or [new]
        cand = "\n".join(lines) + ("\n" if text.endswith("\n") else "")
        if protected_block(cand) != ORIG_BLOCK:
            held.append((i, p, "적용하면 보호 구역이 바뀐다"))
            continue
        text = cand
        applied.append((i, "append"))
    else:
        rejected.append((i, "모르는 op: %r" % op))

def sha(s):
    return hashlib.sha256(s.encode("utf-8", "replace")).hexdigest()[:16]


def record_held(after_text):
    """보류한 제안을 대기함에 남긴다. 실패하면 False — 호출부가 쓰기를 멈춘다.

    남기는 것: 언제·어느 세션·입력 어느 구간을 보고 나온 제안인지, 패치 원문 그대로,
    보류 사유, 그리고 진행 파일의 변경 전후 해시. 나중에 "그때 무엇이 제안됐나" 에
    이 파일 하나로 답하려는 것이다.
    """
    if not held:
        return True
    path = os.environ.get("PU_PENDING")
    if not path:
        return False
    recs = []
    for i, p, why in held:
        recs.append(json.dumps({
            "ts": now_kst,
            "session": os.environ.get("PU_SESSION"),
            "input_range": os.environ.get("PU_RANGE"),
            "index": i,
            "reason": why,
            "patch": p,
            "prog_sha_before": sha(ORIG_TEXT),
            "prog_sha_after": sha(after_text) if after_text is not None else None,
            "mode": mode,
            "status": "held",
        }, ensure_ascii=False))
    try:
        with open(path, "a", encoding="utf-8") as f:
            f.write("\n".join(recs) + "\n")
            f.flush()
            os.fsync(f.fileno())
    except Exception as e:
        print("PENDING_WRITE_FAIL %s" % e)
        return False
    return True


detail = "applied=%d rejected=%d held=%d" % (len(applied), len(rejected), len(held))
for i, why in rejected:
    detail += " | REJECT#%d %s" % (i, why)
for i, _p, why in held:
    detail += " | HELD#%d %s" % (i, why)

if not applied:
    if not record_held(None):
        sys.exit(30)
    print("NO_APPLY " + detail)
    sys.exit(10)

# updated: 줄은 모델 출력에서 받지 않는다. 여기서 실제 시각으로 쓴다.
text, n = re.subn(r"(?m)^updated:.*$", "updated: " + now_kst, text, count=1)

if mode != "apply":
    if not record_held(text):
        sys.exit(30)
    proposed = os.environ["PU_PROPOSED"]
    with open(proposed + ".tmp", "w", encoding="utf-8") as f:
        f.write("<!-- claude-progress-updater 제안본 %s (auto-merge 꺼짐) -->\n" % now_kst)
        f.write("<!-- %s -->\n" % detail)
        f.write("<!-- 대상: %s -->\n\n" % prog_path)
        f.write(text)
    os.replace(proposed + ".tmp", proposed)
    print("PROPOSED " + detail + " | " + proposed)
    sys.exit(0)

# TOCTOU: claude -p 가 90초까지 걸린다. 그 사이 세션이 파일을 고쳤으면 덮지 않는다.
try:
    if int(os.stat(prog_path).st_mtime) != mtime_seen:
        print("ABORT_TOCTOU 생성 중 세션이 progress.md 를 수정했다 — 덮어쓰지 않음")
        sys.exit(20)
except OSError as e:
    print("ABORT_STAT %s" % e)
    sys.exit(20)

# 마지막 관문. 여기까지 온 본문의 보호 구역이 읽어온 때와 한 글자라도 다르면 쓰지 않는다.
# 앞단 분류와 패치별 대조를 다 지나온 뒤에도 한 번 더 보는 이유는, 앞의 둘이 패치 모양을
# 보고 판정하는 데 비해 이건 결과만 보기 때문이다 — 못 본 모양이 있어도 여기서 걸린다.
if protected_block(text) != ORIG_BLOCK:
    print("ABORT_PROTECTED 보호 구역이 바뀌었다 — 쓰지 않음")
    sys.exit(20)

# 대기함을 먼저 남기고 진행 파일을 쓴다. 순서가 반대면 기록에 실패한 회차의 제안이
# 사라진 채 본문만 전진한다.
if not record_held(text):
    sys.exit(30)

try:
    shutil.copy2(prog_path, os.path.join(backup_dir, time.strftime("%Y%m%d-%H%M%S") + ".md"))
except Exception:
    pass

tmp = prog_path + ".tmp"
with open(tmp, "w", encoding="utf-8") as f:
    f.write(text)
os.replace(tmp, prog_path)
try:
    with open(lastwrite, "w") as f:
        f.write(str(int(os.stat(prog_path).st_mtime)))
except Exception:
    pass
print("APPLIED " + detail)
PYEOF
)
rc=$?
log "patch $RESULT (rc=$rc)"

# 백업 정리는 성공·실패 무관하게. 30일 이상 된 것만.
find "$BACKUP_DIR" -name '*.md' -mtime +30 -delete 2>/dev/null || true

# offset 갱신 — 중단된 회차만 예외다. 그 경우 다음 주기에 같은 구간을 다시 본다.
# 대기함 기록 실패(PENDING_WRITE_FAIL)를 여기 넣는 이유: offset 을 올리면 그 구간이
# 다시는 안 읽혀서, 기록에 실패한 제안이 입력째로 사라진다.
case "$RESULT" in
    ABORT_TOCTOU*|ABORT_PROTECTED*|PENDING_WRITE_FAIL*)
        log "offset 유지(다음 주기 재시도)" ;;
    *) echo "$cur_lines" > "$STATE_FILE" ;;
esac

exit 0
