#!/usr/bin/env python3
"""claude-quota-observe — 계정 한도 관측을 셸에서 쓸 수 있는 한 벌로 내놓는다.

`claude-quota-observe` → key=value 줄들. `eval "$(claude-quota-observe --sh)"` 로 쓴다.

왜 있나: 같은 캐시 계산이 rate-limit-recovery · rate-limit-guard.sh ·
rate-limit-prompt-guard.sh 에 세 벌 복제돼 있었고 셋 다 cached_at 을 안 봐서,
얼어붙은 7일 창의 99% 가 한도 해제 뒤에도 세션을 계속 가뒀다(2026-08-28 둘째 기계
6시간). 규칙을 lib 한 곳에 두고 셸은 이걸 부른다.

내놓는 것:
  status        fresh | stale | relogin | stale-gen | account-unverified |
                other-account | missing | error
                (fresh 가 아니면 수치는 근거가 아니다. relogin = 그 수치가 지금 쓰는
                 자격증명보다 먼저 적혔다, stale-gen = 계정을 갈아끼운 뒤에 받아온
                 수치라는 확인이 없다, account-unverified = 지금 어느 계정인지가 안
                 선다, other-account = 다른 계정 수치다)
  cached_age    캐시가 몇 초 전 것인가. 모르면 -1
  blocked       true | false   (fresh 관측이 임계를 넘을 때만 true)
  why           그렇게 판정한 한 줄
  windows_blocked / windows_why
                캐시가 낡아도 창만 보고 "아직 막혀 있나" 를 답한다. 리셋 시각은 절대
                시각이라 낡은 캐시에서도 유효하다. 깨울지 정하는 쪽이 이걸 본다.
  fh_*, sd_*    5시간·7일 창의 status / pct / reset_at / reset_remain
                pct 는 모르면 -1, reset_at 은 모르면 빈 문자열
"""
import datetime
import os
import sys
import time

sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import claude_session_lib as csl   # noqa: E402  (판정 규칙 단일 출처)


def fmt_reset(ts):
    if not isinstance(ts, (int, float)):
        return "", ""
    kst = datetime.timezone(datetime.timedelta(hours=9))
    reset = datetime.datetime.fromtimestamp(ts, datetime.timezone.utc).astimezone(kst)
    remain = int((ts - time.time()) // 60)
    h, m = divmod(max(remain, 0), 60)
    return reset.strftime("%Y-%m-%d %H:%M KST"), "%dh%02dm" % (h, m)


def main():
    obs = csl.account_quota_observation()
    blocked, why = csl.quota_blocked()
    win_blocked, win_why = csl.windows_blocked()
    ca = obs.get("cached_at")
    rows = [
        ("status", obs["status"]),
        ("cached_age", int(time.time() - ca) if isinstance(ca, (int, float)) else -1),
        ("blocked", "true" if blocked else "false"),
        ("why", why),
        ("windows_blocked", "true" if win_blocked else "false"),
        ("windows_why", win_why),
        # account = 이 수치가 어느 계정 것인가, account_now = 지금 쓰는 자격의 계정.
        # 둘이 다르면 수치는 이 계정에 대해 아무것도 말하지 않는다.
        # account_now 가 빈 글자면 "모른다" 다 — 틀린 번호를 내는 것보다 낫다.
        # rate-limit-recovery 는 이 칸이 비면 교체 판정 자체를 건너뛴다. 모름을 낡은
        # 번호로 메우면 토큰이 저절로 갱신된 회차가 가짜 교체로 읽혀 캐시를 비우고
        # 전 세션을 깨운다(2026-11-10 토론 run-20261109T232244Z).
        ("account", obs.get("account") or ""),
        ("account_now", csl.current_account_id() or ""),
    ]
    for key, pre in (("five_hour", "fh"), ("seven_day", "sd")):
        w = obs[key]
        at, remain = fmt_reset(w.get("resets_at"))
        rows += [(pre + "_status", w["status"]),
                 (pre + "_pct", int(w["used"]) if w["used"] is not None else -1),
                 (pre + "_reset_at", at),
                 (pre + "_reset_remain", remain)]
    sh = "--sh" in sys.argv[1:]
    for k, v in rows:
        print(("QUOTA_%s='%s'" % (k.upper(), str(v).replace("'", "'\\''")))
              if sh else "%s=%s" % (k, v))
    return 0


if __name__ == "__main__":
    sys.exit(main())
