[Unit]
Description=Claude Code session for 251229 (telegram remote-control)
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/mon/251229/.claude/telegram/.env

[Service]
Type=simple
WorkingDirectory=%h/mon/251229
Environment="CLAUDE_SESSION_NAME=251229"
Environment="PATH=%h/.bun/bin:%h/.nvm/versions/node/v22.17.0/bin:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="TELEGRAM_STATE_DIR=%h/mon/251229/.claude/telegram"
Environment="TERM=xterm-256color"
ExecStart=%h/.local/bin/claude-service-exec
ExecStartPost=%h/.local/bin/claude-service-notify start claude-251229
ExecStopPost=%h/.local/bin/claude-service-notify stop claude-251229
Restart=always
RestartSec=5
StandardOutput=append:%h/.claude/logs/claude-251229.log
StandardError=append:%h/.claude/logs/claude-251229.log
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=default.target
