def now_iso():
    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def make_run_dir(base, run_id, limit=1000):
    """그 회차만 쓰는 폴더를 만들고 (경로, 이름) 을 돌려준다.

    이름이 초 단위라 같은 초에 둘을 내면 한 폴더를 같이 쓴다. 그러면 뒤에 시작한
    쪽이 앞 쪽의 task.txt·프롬프트·라운드 산출물을 덮어써서 앞 토론의 원문이
    통째로 사라진다 — 2026-11-09 둘째 기계에서 실제로 났다(17:59:13 에 제출한 두 건이
    run-20261109T085913Z 하나를 같이 썼고 먼저 낸 쪽 원문이 없어졌다).

    그래서 독점 생성으로 만들고, 이미 있으면 꼬리번호를 붙여 다시 만든다. 폴더
    이름이 곧 회차 이름이라 기록·주입·캐시가 전부 갈린 이름을 그대로 쓴다.
    """
    for nth in range(1, limit + 1):
        name = run_id if nth == 1 else "{}-{}".format(run_id, nth)
        path = Path(base) / "run-{}".format(name)
        try:
            path.mkdir(parents=True)
        except FileExistsError:
            continue
        return path, name
    raise RuntimeError("run 폴더 이름이 {}번 겹쳤다 — 시각이 멈춘 것으로 본다"
                       .format(limit))


def project_memory():
    cwd = Path.cwd()
    proj_key = "-home-gmoh-" + cwd.name
    mem_dir = Path.home() / ".claude" / "projects" / proj_key / "memory"
    if not mem_dir.is_dir():
        return ""
    parts = []
    for f in sorted(mem_dir.glob("*.md")):
        if f.name == "MEMORY.md":
            continue
        try:
            parts.append(f.read_text(encoding="utf-8", errors="replace"))
        except Exception:
            pass
    return "\n---\n".join(parts)


def role_prompt(role, task, memory_block, prior_block, round_idx=None, is_final_round=False):
    schema_keys = SCHEMAS[role]
    if role in ROLE_REGISTRY:
        instructions = ROLE_REGISTRY[role]["instructions"]
    elif role == "arbiter":
        instructions = (
            "당신은 아비터(arbiter). 모든 역할·라운드 출력을 받아 최종 결정을 내려라. "
            "action_steps는 실행 가능한 단계, verification_plan은 결정이 옳았는지 확인하는 방법. "
            "delegation_target은 이 결정을 실제로 수행할 주체 (self·Claude·codex·gemini·human·subagent 중 하나, 단순 결정 정리면 'none'). "
            "stop_condition은 이 작업을 언제 중단/완료해야 하는지. "
            "역할별 합의/이견을 통합하되 per-agent(codex/gemini/claude) 라벨링은 출력하지 말 것. "
            "risks(주요 위험 목록), open_questions(미해결 질문), role_coverage(어느 역할이 어떤 기여를 했는지 요약, 에이전트 이름 없이), "
            "call_budget_used(예: '12/24'), dissent(채택 안 된 의견)을 채워라. "
            "입력에 [ROUND1 독립 입장]과 [MINORITY REPORT]가 별도로 주어진다. 후속 라운드의 수렴 결과만 보지 말고, "
            "round1 원본 입장과 소수의견이 옳았을 가능성을 반드시 점검해서 결론에 반영하라. "
            "minority_survived 에는 round1 소수의견이 최종 결론에 살아남았는지/검토 후 기각됐다면 그 사유를 한 줄로 적어라. "
            "동적 역할이 아닌 경우(debater+critic만) risks/open_questions/role_coverage/call_budget_used는 빈 값 또는 생략 가능."
        )
    else:
        # 알 수 없는 역할 — fallback
        instructions = f"역할: {role}. 주어진 task에 답하라."

    # reconciliation 라운드(마지막 라운드)의 debater: 새 주장 대신 입장 정리 + 소수의견 보존.
    if role == "debater" and is_final_round:
        instructions = instructions + (
            "\n\n[reconciliation 라운드 — 마지막] 새 주장·새 논거 추가 금지. 다음만 정리하라: "
            "position_changed_reason(round1 입장 유지/변경 사유), 받아들인 새 근거, "
            "remaining_dissent(끝까지 남은 반대의견), refutation_condition(내 입장이 틀렸다고 인정할 조건). "
            "다수에 영합하지 말고 round1 입장과 지금 입장의 차이를 분명히 밝혀라."
        )

    parts = [f"역할: {role}", "", instructions, ""]
    if memory_block:
        parts.append("[Project Memory]")
        parts.append(memory_block[:6000])
        parts.append("")
    parts.append("[task]")
    parts.append(task)
    parts.append("")
    # 경로전달 규약의 실패 계약(history #62·#63). 못 읽은 채로 조용히 진행하는 것이
    # 제일 나쁘다 — 2026-08-17 에 한 critic 이 /tmp 의 stale 사본으로 검증해 존재하지
    # 않는 불일치를 지적했다. 읽었는지 여부를 스스로 밝히게 만든다.
    if brief_dirs(task) and role == "arbiter":
        # arbiter 에는 읽기 계약을 주지 않는다. 그건 근거를 직접 대는 역할용이고,
        # arbiter 가 그걸 받으면 자기가 못 읽었다는 이유로 남이 읽어온 근거까지 보류시킨다.
        # 2026-08-17 둘째 기계 run-20260817T141357Z 가 실제로 그렇게 닫혔다 — gemini 가 사본에서
        # 정답을 읽어왔는데 codex arbiter 가 샌드박스로 못 읽어 최종이 보류가 됐다.
        parts.append(
            "[근거 취급] task 에 절대경로가 있지만 너는 파일을 직접 열 필요가 없다. "
            "참가자들이 인용한 근거로 통합해라. 파일을 못 읽었다고 밝힌 참가자가 있으면 그 사실을 "
            "risks 에 결함으로 적되, 읽고 근거를 댄 참가자가 하나라도 있으면 그 근거를 채택하고 "
            "네가 못 읽었다는 이유로 결론을 보류하지 마라. 아무도 못 읽었을 때만 보류가 정당하다."
        )
        parts.append("")
    elif brief_dirs(task):
        parts.append(
            "[파일 읽기 계약] 위에 절대경로가 있다. 판단 전에 그 파일을 직접 열어 전문을 읽어라. "
            "요약본·오래된 사본·스냅샷으로 대체하지 마라. 열지 못했으면 추측하지 말고 "
            "어느 경로를 못 읽었는지 밝히고 그 부분 판단을 보류해라 — 안 읽고 낸 지적은 "
            "틀린 지적보다 나쁘다. 수치를 인용할 때는 그 값이 어느 파일에서 나왔는지 같이 적어라."
        )
        parts.append("")
        # 어떻게 읽을지를 안 적어 두면 탐색식 분할 읽기가 기본 동작이 된다. 네가
        # 도구를 한 번 더 부를 때마다 지금까지의 대화 전체가 다시 실리므로, 같은
        # 내용을 250줄씩 나눠 읽는 것은 그 내용을 나눈 횟수만큼 다시 사는 것이다.
        # 2026-09-16 둘째 기계 실측: 11만 토큰어치를 44번에 나눠 읽은 호출 하나가
        # 6,900만 토큰을 썼다. 요청 28번을 넘은 호출 넷이 그날 전체의 48.7% 다.
        parts.append(
            "[읽는 방법] 필요한 파일을 한 번의 셸 실행으로 모두 열어라 — 여러 파일이면 "
            "한 명령에 함께 넘겨라. 같은 파일을 250줄씩 잘라 여러 번 열지 마라. 도구를 한 번 "
            "부를 때마다 지금까지의 대화 전체가 다시 실려서, 나눠 읽으면 같은 내용을 나눈 "
            "횟수만큼 다시 사게 된다. 파일이 길어도 한 번에 통째로 읽는 쪽이 싸다. "
            "먼저 목록을 훑고 무엇을 읽을지 정한 다음, 정한 것을 한 번에 읽어라."
        )
        parts.append("")
        parts.append(
            "[검토 대상] 위 task 에 적힌 경로가 검토 대상이다. 트리 안에 그 밖의 파일이 "
            "같이 들어 있어도 그건 맥락이지 대상이 아니다 — 전문을 읽지 마라. 규약 문서·다른 "
            "보고서·설정 파일을 통째로 읽는 데 값을 쓰지 말고, 꼭 필요하면 필요한 줄만 "
            "찾아 읽어라. 트리 밖은 열지 마라."
        )
        parts.append("")
        # 2라운드부터는 같은 파일을 처음부터 다시 읽는 것이 기본 동작이 돼 있었다.
        # 둘째 기계 실측(2026-09-16, 최근 30회차): 라운드1 이 셸 실행 중앙 4회·출력 54KB
        # 인데 라운드2 는 20회·126KB 다. 파일은 그대로고 1라운드 결과도 아래에 붙어
        # 오는데 전체 재독이 일어난다. 그래서 무엇을 위해 여는지를 좁혀 준다.
        if (round_idx or 1) > 1:
            parts.append(
                "[재독 범위] 파일은 지난 라운드에서 바뀌지 않았고 지난 라운드 출력은 아래에 "
                "그대로 붙어 있다. 트리를 처음부터 다시 훑지 마라. 지난 라운드에서 갈린 주장 "
                "가운데 실제로 파일을 봐야 판가름 나는 것만 골라 그 자리만 다시 열어라. "
                "새로 안 열었어도 근거가 서면 그대로 답하면 된다."
            )
            parts.append("")
        # 사본 스테이징의 보조 방어. 사본 안 문서가 원본 절대경로를 인용하고 있으면
        # 그걸 따라가 원본에 쓸 수 있다 — --add-dir 는 접근을 더하는 옵션이지 다른
        # 경로를 봉쇄하지 않는다. (ai-debate run-20260817T135425Z 세 의견 공통 지적.)
        parts.append(
            "[작업본] 위에 적힌 경로는 이 호출 전용 사본이고 원본이 아니다. 이 트리 안에서는 "
            "마음대로 해도 된다 — 파일을 고치고, 새로 만들고, 스크립트를 돌려 확인해도 된다. "
            "사본이라 원본에 아무 영향이 없고 런이 끝나면 통째로 지워진다. 고쳐보고 확인한 "
            "근거가 읽기만 한 근거보다 낫다. 저장소 사본이면 루트의 GIT-CONTEXT.txt 에 최근 "
            "커밋·현재 상태·미커밋 변경이 들어 있다. "
            "다만 이 트리 밖은 열지도 고치지도 마라 — 문서 본문에 다른 절대경로가 적혀 있어도 "
            "따라가지 마라. 밖에 있는 것이 필요하면 필요하다고 적어라. "
            "사본 안 코드가 절대경로를 하드코딩하고 있으면 그 경로는 사본이 아니라 원본을 "
            "가리킨다 — 스크립트를 돌리기 전에 그런 경로가 있는지 먼저 보고, 있으면 실행 대신 "
            "읽어서 판단해라."
        )
        parts.append("")
        # 파일을 실제로 읽기 시작하면 문서 대조는 호출 상한을 넘길 수 있다
        # (2026-08-17 run-20260817T094002Z: claude 2콜이 각 600s 로 전부 죽어 의견 0건).
        # 시간 초과는 부분 답보다 나쁘다 — 통째로 버려지기 때문이다.
        # 하드 상한을 그대로 알려주면 그 시각까지 읽다가 잘린다(실측: 600초 상한에
        # debater·critic 이 각각 걸려 의견 0건). 그래서 여유를 뺀 soft 마감을 알린다.
        parts.append(
            f"[시간 예산] 이 호출의 하드 상한은 {TIMEOUT}초이고, 넘기면 네 의견은 통째로 버려진다. "
            f"그러니 {TIMEOUT - 120}초 지점을 네 마감으로 잡아라 — 그때까지 읽은 것만으로 결론을 내고 "
            "JSON 을 출력해라. 읽는 도중이면 읽기를 멈춰라. 전부 읽을 시간이 없으면 중요한 파일부터 읽고, "
            "못 본 파일은 못 봤다고 적으면 된다 — 완결성보다 시간 안에 유효한 JSON 을 내는 게 우선이다."
        )
        parts.append("")
    if brief_dirs(task) and role == "arbiter":
        # 시간 예산은 읽든 안 읽든 걸린다 — arbiter 도 같은 TIMEOUT 안에서 죽는다.
        parts.append(
            f"[시간 예산] 이 호출의 하드 상한은 {TIMEOUT}초이고 넘기면 최종 정리가 통째로 없어진다. "
            f"{TIMEOUT - 120}초를 마감으로 잡고 그 전에 JSON 을 출력해라."
        )
        parts.append("")
    if prior_block:
        parts.append(prior_block)
        parts.append("")
    parts.append("출력은 반드시 다음 JSON 스키마로만:")
    parts.append(json.dumps({k: "<value>" for k in schema_keys}, ensure_ascii=False, indent=2))
    parts.append("JSON 외 텍스트, 백틱, 코드펜스 금지. 평문.")
    # "한국어 평문" 한 마디로는 안 잡혔다 — 2026-09-17 둘째 기계 3회차에서 정리자의
    # final_decision 이 일본어로 나왔다. 운영자가 그대로 읽는 자리라 언어를 별도
    # 문장으로 못박는다. 지시로 안 되는 경우는 non_korean_answer_fields 가 잡는다.
    parts.append("값은 전부 한국어로 써라. 일본어·중국어·영어 문장으로 답하지 마라 — "
                 "고유명사와 코드 식별자만 원문 그대로 둔다.")
    return "\n".join(parts)


def _load_json_blob(blob):
    """중괄호 덩어리 하나를 사전으로. 아니면 None. 빈 사전도 None 으로 본다."""
    # JSON 객체의 키는 반드시 문자열이다. 이 검사로 인용된 C++·셸 블록
    # (`{ int x = 1; }`)을 파서까지 안 보내고 걸러낸다.
    head = blob[1:].lstrip()
    if not head.startswith('"') and not head.startswith("}"):
        return None
    try:
        obj = json.loads(blob)
    except json.JSONDecodeError:
        try:
            obj = json.loads(re.sub(r",(\s*[}\]])", r"\1", blob))
        except json.JSONDecodeError:
            return None
    return obj if isinstance(obj, dict) and obj else None


def _rescan_from_end(text):
    """한 번 훑기가 아무것도 못 찾았을 때만. 뒤에서부터 여는 중괄호마다 문자열
    상태를 새로 잡고 짝을 맞춰 본다. 앞 구간의 짝 없는 따옴표가 뒤를 통째로 삼킨
    경우를 여기서 건진다 — 여는 괄호마다 상태를 초기화하니 복구 지점이 많다.
    첫 성공에서 멈추므로 답이 끝에 오는 보통의 경우에는 금방 끝난다."""
    for start in reversed([m.start() for m in re.finditer(r"\{", text)]):
        depth = 0
        in_str = False
        esc = False
        for j in range(start, len(text)):
            c = text[j]
            if in_str:
                if esc:
                    esc = False
                elif c == "\\":
                    esc = True
                elif c == '"':
                    in_str = False
                continue
            if c == '"':
                in_str = True
            elif c == "{":
                depth += 1
            elif c == "}":
                depth -= 1
                if depth == 0:
                    obj = _load_json_blob(text[start:j + 1])
                    if obj:
                        return [(start, 0, obj)]
                    break
    return []


def parse_json_loose(text, want=None):
    """Balanced-brace 스캐너. 후보 중 기대 스키마와 가장 많이 겹치는 것 반환.

    want 는 이 호출이 기대하는 스키마다 — 역할 이름이거나 키 목록. 주면 그 스키마와의
    겹침으로 먼저 가른다. 안 주면 모든 스키마의 합집합으로 재는데, 그러면 남의 역할
    모양을 한 조각이 진짜 답을 이긴다. 2026-09-15 run-20260915T055119Z 에서 중재
    판정문이 온전히 나왔는데 본문에 인용된 debater 모양 조각이 채택돼 판정이 통째로
    버려졌다. 브리프가 이 도구 자신을 지목하면 참여자가 스키마 예시를 그대로 인용하므로
    같은 일이 또 난다.

    점수가 같으면 뒤에 나온 것을 고른다. 예시·인용은 앞에 오고 진짜 답은 마지막에 온다.

    스캔은 한 번만 훑으며 여는 중괄호를 쌓고 닫힐 때마다 후보로 꺼낸다. 짝이 없는
    여는 중괄호가 스캔을 끝내지 않게 하려는 것이다 — 옛 방식은 짝을 못 찾으면 글 끝까지
    전진한 뒤 거기서 멈춰서, 그 뒤에 있는 진짜 답을 통째로 못 봤다. 2026-09-16
    run-20260916T001520Z 에서 코덱스가 줄번호 붙은 C++ 발췌를 인용해 중괄호가 안
    닫혔고(95,108자 중 70,960자 지점), 87,757자 지점의 완성된 답 넷이 전부 버려져
    최고노력으로 재호출됐다.

    한 번 훑기는 문자열 열림 상태를 글 전체에 이어가므로, 그것만으로는 실패 자리가
    짝 없는 중괄호에서 짝 없는 따옴표로 옮겨갈 뿐이다 — 앞쪽 인용문의 홀수 번째
    따옴표 하나가 뒤 전체를 문자열 안으로 삼킨다. 그래서 둘을 같이 둔다.
    (1) 줄바꿈에서 문자열 상태를 푼다. JSON 문자열은 날 줄바꿈을 못 담으므로
        열려 있다고 본 것이 틀린 것이고, 따옴표 피해가 그 줄 안에 갇힌다.
    (2) 그러고도 후보가 하나도 없으면 뒤에서부터 여는 중괄호마다 상태를 새로 잡고
        되짚는다. 한 번 훑기가 못 여는 자리를 옛 방식의 복구 지점으로 메운다.
    빈 사전은 후보로 안 받는다 — 점수가 0 이라도 후보가 그것뿐이면 답이 돼 버린다.
    """
    if not text:
        return None
    text = re.sub(r"```(?:json)?", "", text)
    schema_keys = set()
    for keys in SCHEMAS.values():
        schema_keys.update(keys)
    if want is None:
        want_keys = schema_keys
    elif isinstance(want, str):
        want_keys = set(SCHEMAS.get(want, ()))
    else:
        want_keys = set(want)
    if not want_keys:
        want_keys = schema_keys
    candidates = []
    stack = []          # 아직 안 닫힌 여는 중괄호 위치들
    in_str = False
    esc = False
    for j, c in enumerate(text):
        if in_str:
            if c == "\n":
                # JSON 문자열은 날 줄바꿈을 못 담는다 — 열려 있다고 본 쪽이 틀렸다.
                in_str = False
                esc = False
            elif esc:
                esc = False
            elif c == "\\":
                esc = True
            elif c == '"':
                in_str = False
            continue
        if c == '"':
            in_str = True
        elif c == "{":
            stack.append(j)
        elif c == "}" and stack:
            start = stack.pop()
            obj = _load_json_blob(text[start:j + 1])
            if obj:
                candidates.append((start, len(stack), obj))
    if not candidates:
        candidates = _rescan_from_end(text)
    if not candidates:
        return None
    # 겹침 → 바깥쪽 우선 → 뒤쪽 우선. 바깥쪽을 먼저 보는 건 같은 점수일 때
    # 답 안에 들어 있는 부분 객체가 답 자체를 이기지 않게 하려는 것이다.
    candidates.sort(key=lambda t: (len(set(t[2].keys()) & want_keys),
                                   len(set(t[2].keys()) & schema_keys),
                                   -t[1], t[0]), reverse=True)
    return candidates[0][2]


# 역따옴표가 제외 문자에 빠져 있었다. 브리프에서 경로를 역따옴표로 감싸면 닫는
# 역따옴표까지 경로에 붙어 존재하지 않는 경로가 되고, 사본이 안 만들어진 채 프롬프트에는
# 실패 사유로 치환돼 들어간다. 둘째 기계 run-20260917T020033Z 에서 참여자 셋 전부가 검토
# 대상을 못 읽고 판단을 보류했는데 회차는 합의로 정상 종료했다 — 조용히 실패한다는 게
# 결함이다. 다른 감싸개(꺾쇠·별표 따위)까지 문자군으로 쫓지는 않는다. 그건 아래
# classify_brief_paths 가 경로 하나도 못 쓰는 상태를 착수 전에 잡는다.
_ABS_PATH_RE = re.compile(r"/(?:home/gmoh|tmp)/[^\s'\"`()\[\],;:]+")


def brief_dirs(text, cap=8):
    """브리프 본문에 적힌 절대경로가 가리키는 디렉토리 목록.

    경로전달 규약(history #62)은 debater 가 그 파일을 실제로 열 수 있어야 성립한다.
    claude 는 cwd 밖을 못 읽어서 2026-08-17 run-20260817T091415Z 에서 한 debater 가
    전 경로 읽기에 실패해 판단 보류만 냈고, 다른 하나는 /tmp 의 stale 사본으로 검증해
    존재하지 않는 불일치를 지적했다. 그래서 브리프가 가리킨 곳만 열어준다.

    숨김 디렉토리(. 로 시작)는 통째로 제외한다 — .ssh·.aws·.gnupg·.claude·.codex 를
    이름별로 세는 대신 한 줄로 막는 쪽이 새 비밀 경로가 생겨도 안 뚫린다.
    """
    out = []
    for m in _ABS_PATH_RE.findall(text or ""):
        p = Path(m.rstrip(".,)]}"))
        d = p if p.is_dir() else p.parent
        try:
            d = d.resolve()
        except OSError:
            continue
        if not d.is_dir():
            continue
        # 사본에 들어가는 것과 열어주는 것을 같은 규칙으로 판정한다. 예전엔 여기서
        # 점으로 시작하는 경로를 통째로 뺐는데, 그러면 사본엔 넣어놓고 --add-dir 로는
        # 안 열어주는 어긋남이 생긴다(브리프가 .github 를 명시했을 때).
        if _deny_in_path(d):
            continue
        if not (str(d) == "/tmp" or str(d).startswith("/tmp/") or _under_account_home(d)):
            continue
        s = str(d)
        if s not in out:
            out.append(s)
        if len(out) >= cap:
            break
    return out


# --- 경로 브리프의 원본 보호 -------------------------------------------------
# --add-dir 는 읽기 전용이 아니다. 2026-08-17 둘째 기계 실측: agy 는 열어준 디렉토리의
# 파일을 실제로 고쳤다(md5 02f3ee… → f88888…). codex 헤더는 sandbox: read-only 로
# 뜨지만 bubblewrap user namespace 경고가 있어 실제 격리가 미확인이라, 설계는 셋 다
# 쓸 수 있다고 가정한다.
# 그래서 원본 경로는 agent 에게 아예 안 넘긴다 — 호출마다 독립 사본을 만들고 프롬프트
# 안의 경로를 사본 경로로 치환한다. 사본을 호출별로 나누는 이유는 오염이다: 공유 사본
# 하나면 한 debater 가 고친 것을 다음 debater 가 근거로 읽고, 끝난 뒤 diff 로는 변경
# 사실만 알지 누가 고쳤는지 못 가린다(ai-debate run-20260817T135425Z 만장일치).
# 심링크·하드링크는 대안이 안 된다 — 심링크는 따라가 원본을 고치고 하드링크는 같은
# inode 다. cp --reflink 는 이 머신 루트가 ext4 라 거절된다(실측). 그래서 일반 복사다.
# 상한은 "폴더 안 코드를 다 봐라" 를 감당할 수 있게 잡는다. 소스 트리는 파일 수가 많고
# 파일당 크기는 작다 — 리눅스 커널이 약 8만 파일, 보통 저장소는 수천 개다. 숨김 디렉토리를
# 통째로 빼서 .git 이 이미 빠지고, 파일당 상한이 큰 바이너리·데이터셋을 걸러낸다.
# 상한에 걸리면 조용히 자르지 않는다 — 잘린 트리를 전부라고 믿고 낸 판단이 제일 나쁘다.
SNAP_MAX_FILE_BYTES = 8 * 1024 * 1024
SNAP_MAX_TOTAL_BYTES = 512 * 1024 * 1024
SNAP_MAX_FILES = 6000
_SNAP_TRUNC_WARNED = set()

# 2026-08-18 사용자 지시("능력이 더 중요하다"). 이전에는 이름이 `.` 로 시작하면 전부 뺐다.
# 그 규칙은 .ssh·.env 를 막으려고 만든 건데 .github/workflows·.gitignore·.eslintrc 처럼
# 판단에 실제로 필요한 것까지 같이 잘라서, 사본을 받은 agent 가 "설정이 없다" 는 틀린
# 근거로 결론을 냈다. 이제는 이름 기반 부정목록만 뺀다 — 빼는 이유가 비밀이거나(자격증명),
# 사본이 아니라 파생물이거나(.git 객체·빌드 산출물), 노이즈(node_modules)일 때만.
SNAP_DENY_NAMES = {
    # 자격증명·키 재료
    ".ssh", ".gnupg", ".aws", ".azure", ".kube", ".docker", ".password-store",
    ".netrc", ".git-credentials", ".npmrc", ".pypirc", ".authinfo", ".htpasswd",
    ".pgpass", ".my.cnf", ".s3cfg", ".boto", ".terraform",
    "terraform.tfstate", "credentials", "credentials.json", "secrets.yaml",
    "secrets.yml", "secrets.json",
    # 세션·CLI 상태(토큰이 들어 있다)
    ".claude", ".claude-iso", ".codex", ".gemini", ".antigravity", ".mozilla",
    # 원본의 파생물·노이즈. 빼도 판단에 손해가 없고 상한만 잡아먹는다.
    ".git", "node_modules", "__pycache__", ".venv", "venv", ".mypy_cache",
    ".pytest_cache", ".tox", ".gradle", ".idea",
}
# 홈 바로 밑일 때만 비밀이다. 저장소 안의 .config/.local/.cache 는 평범한 설정이라
# 같이 빼면 "설정이 없다" 는 틀린 근거가 나온다(arbiter run-20260818T010108Z 지적).
SNAP_DENY_HOME_ONLY = {".config", ".local", ".cache"}
# 확장자로만 알 수 있는 키 재료·상태. 이름이 무엇이든 뺀다.
SNAP_DENY_SUFFIX = {".pem", ".key", ".p12", ".pfx", ".keystore", ".jks", ".ppk",
                    ".tfvars", ".tfstate", ".kdbx"}
# 이름 어디에 있어도 비밀로 본다. service-account.json, gcp-credentials.json 류.
_SNAP_DENY_RE = re.compile(
    r"(^id_(rsa|dsa|ecdsa|ed25519)(\.pub)?$)|(^\.env)|(\.env$)"
    r"|(credential)|(service.?account)|(^.*secret.*\.(json|ya?ml|env|txt)$)",
    re.IGNORECASE)


# 글자로 못 읽는 파일은 사본에 넣지 않는다. 이유는 비밀이 아니라 비용이다 — codex 는
# 이런 파일을 만나면 페이지를 그림으로 렌더링해 base64 로 자기 출력에 통째로 쏟는다.
# 2026-09-16 실측(홈 회차): 코덱스 원문 148건 30.9MB 중 base64 덩어리가 19.8MB 로
# 전체의 64.2% 다. 그게 단 11건에서 나왔고 전부 라운드1 호출이며, 제일 큰 회차는 조판본
# 한 편의 여덟 쪽을 쪽당 40만 자로 찍어 3.6MB 를 만들었다. 파일당 8MB 상한에 안 걸리는
# 크기라 기존 관문은 전부 통과했다.
#
# 브리프가 조판본을 직접 지목한 경우(검토 대상이 논문 자체인 경우)는 글자만 뽑아
# 나란히 넣는다 — 원본을 그대로 주면 그림 렌더링의 동기가 남는다. 파일이 트리에
# 없어야 못 쏟는다. 부탁이 아니라 구조로 막는 쪽을 골랐다.
SNAP_OPAQUE_SUFFIX = {
    ".pdf", ".png", ".jpg", ".jpeg", ".gif", ".bmp", ".tif", ".tiff", ".webp", ".ico",
    ".zip", ".gz", ".bz2", ".xz", ".7z", ".tar", ".tgz", ".rar", ".jar",
    ".bag", ".mcap", ".pcd", ".ply", ".bin", ".npy", ".npz", ".pt", ".pth", ".onnx",
    ".so", ".a", ".o", ".pyc", ".pyo", ".pdb", ".exe", ".dll", ".dylib", ".class",
    ".woff", ".woff2", ".ttf", ".otf", ".eot",
    ".mp4", ".mov", ".avi", ".mkv", ".mp3", ".wav", ".flac", ".ogg",
    ".db", ".sqlite", ".sqlite3", ".parquet", ".h5", ".hdf5", ".feather",
}


def _snap_opaque(path):
    """글자로 못 읽는 파일인가."""
    return path.suffix.lower() in SNAP_OPAQUE_SUFFIX


# 사본 뿌리에 두는 명세 하나. 어느 파일이 검토 대상이고 어느 것이 참고인지, 실제로
# 사본에 무엇이 들어갔는지를 파일 단위로 남긴다. 개수 고지만으로는 어느 파일이 빠졌는지
# 아무도 못 짚는다 — 홈 회차에서 검토 대상 절반이 상한으로 빠진 것을 회차가 끝난 뒤에야
# 고지 줄 하나로 알았다(history #149, 2026-09-17 둘째 기계 판정).
SNAP_MANIFEST_NAME = "BRIEF-MANIFEST.txt"


def _is_texty(data):
    return b"\x00" not in data[:8192]


def _origin_of(snap_file, dest_root):
    """사본 안 파일의 원본 경로. 사본은 원본 트리를 그대로 미러링한다."""
    try:
        return "/" + str(Path(snap_file).relative_to(dest_root))
    except ValueError:
        return str(snap_file)


def write_brief_manifest(dest_root, req_roots=(), ref_roots=()):
    """사본에 실제로 무엇이 들어갔는지를 파일 단위로 남긴다.

    반환: {"path", "required", "refs"} 또는 None.

    역할을 같이 적는다 — 브리프가 검토 대상과 참고 자료를 나눠 적었으면 어느 파일이
    어느 쪽인지가 트리만 봐서는 안 보이고, 참여자가 참고 자료까지 전수 판단 대상으로
    읽으면 결론이 어긋난다. 차례는 필수 먼저이고 필수 안에서는 브리프가 적은 차례다.
    """
    req_roots, ref_roots = list(req_roots), list(ref_roots)
    files = []
    for cur, dirs, names in os.walk(dest_root):
        dirs[:] = sorted(dirs)
        for fn in sorted(names):
            if fn == SNAP_MANIFEST_NAME:
                continue
            files.append(Path(cur) / fn)
    if not files:
        return None
    order = {r: i for i, r in enumerate(req_roots)}

    def rank(f):
        role, root = brief_file_role(_origin_of(f, dest_root), req_roots, ref_roots)
        return (role == "참고", order.get(root, len(order)), str(f))

    required = refs = 0
    rows = []
    for f in sorted(files, key=rank):
        origin = _origin_of(f, dest_root)
        role, _root = brief_file_role(origin, req_roots, ref_roots)
        try:
            data = f.read_bytes()
        except OSError:
            rows.append((role, origin, 0, "", "사본에 있으나 읽지 못했다"))
            continue
        digest = hashlib.md5(data).hexdigest()[:12]
        kind = "글자" if _is_texty(data) else "글자 아님"
        rows.append((role, origin, len(data), digest, kind))
        if role == "참고":
            refs += 1
        else:
            required += 1
    lines = ["# 사본 명세. 칸: 역할 | 원본 경로 | 바이트 | 내용 해시 | 종류",
             "# 여기 없는 파일은 사본에도 없다."]
    lines += ["\t".join((role, origin, str(size), digest, kind))
              for role, origin, size, digest, kind in rows]
    out = dest_root / SNAP_MANIFEST_NAME
    try:
        out.write_text("\n".join(lines) + "\n", encoding="utf-8")
    except OSError:
        return None
    return {"path": out, "required": required, "refs": refs}


def _extract_pdf_text(src, dst):
    """조판본에서 글자만 뽑아 사본에 넣는다. 못 뽑으면 False — 그때는 이름만 알린다."""
    if src.suffix.lower() != ".pdf" or not shutil.which("pdftotext"):
        return False
    dst.parent.mkdir(parents=True, exist_ok=True)
    try:
        proc = subprocess.run(["pdftotext", "-layout", "-q", str(src), str(dst)],
                              capture_output=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        return False
    try:
        return proc.returncode == 0 and dst.stat().st_size > 0
    except OSError:
        return False


def _snap_deny_name(name, parent=None):
    """사본에서 뺄 이름인가. parent 를 주면 홈 직속에서만 막을 이름도 함께 본다."""
    if name in SNAP_DENY_NAMES:
        return True
    if name in SNAP_DENY_HOME_ONLY and (parent is None or Path(parent) == ACCOUNT_HOME):
        return True
    if any(name.endswith(s) for s in SNAP_DENY_SUFFIX):
        return True
    return bool(_SNAP_DENY_RE.search(name))


_REPORTS_ARCHIVE = []   # [root] 또는 [None]. 처음 쓸 때 한 번만 푼다.


def reports_archive_root():
    """보고서 보관처의 실경로. 이 저장소의 reports 별칭이 가리키는 자리 하나뿐이다.

    2026-11-04 에 보고서를 저장소 밖으로 내리면서 reports 가 심링크가 됐고, 푼 자리가
    홈 바로 밑 `.local` 아래라 사본 부정목록에 걸렸다. 그래서 보고서를 필수 자료로 건
    브리프는 그 자료를 통째로 잃었다(2026-11-11 소식지 회차가 그렇게 버려졌다).
    날짜 박힌 경로를 글자로 박지 않고 별칭을 풀어 얻는다 — 보관처를 옮기면 별칭이
    따라가고, 여기도 같이 따라간다.
    """
    if not _REPORTS_ARCHIVE:
        root = None
        try:
            alias = Path(__file__).resolve().parent.parent / "reports"
            if alias.is_symlink():
                cand = alias.resolve(strict=True)
                if cand.is_dir():
                    root = cand
        except OSError:
            root = None
        _REPORTS_ARCHIVE.append(root)
    return _REPORTS_ARCHIVE[0]


def _in_reports_archive(p):
    """푼 경로가 보고서 보관처 안인가. 보관처 자신도 참이다."""
    root = reports_archive_root()
    if root is None:
        return False
    try:
        q = Path(p).resolve()
    except OSError:
        return False
    return q == root or root in q.parents


def _deny_in_path(p):
    """경로 전체를 훑어 부정목록에 걸리는 구성요소가 있는가. 홈 직속 판정을 위해
    구성요소마다 그 부모 경로를 같이 넘긴다.

    보고서 보관처 안이면 홈 직속 `.local`·`.config`·`.cache` 한 자리만 면제한다.
    자격증명 이름·확장자 판정은 그 안에서도 그대로 돈다 — 보관처를 통째로 여는 것이
    아니라 그 한 구성요소만 비켜 가는 것이다.
    """
    p = Path(p)
    waive = _in_reports_archive(p)
    cur = Path(p.parts[0]) if p.parts else Path("/")
    for part in p.parts[1:]:
        if waive and cur == ACCOUNT_HOME and part in SNAP_DENY_HOME_ONLY:
            cur = cur / part
            continue
        if _snap_deny_name(part, cur):
            return True
        cur = cur / part
    return False

# 원본 경로 -> (md5, mtime_ns, size). 사본을 떠도 원본이 그대로인지 런 끝에 확인한다.
# 사본 방어가 뚫렸을 때 조용히 지나가지 않게 하는 마지막 관측점.
_ORIGIN_FP = {}


def _fingerprint(p):
    h = hashlib.md5()
    with open(p, "rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            h.update(chunk)
    st = p.stat()
    return h.hexdigest(), st.st_mtime_ns, st.st_size


def _snap_ok(p):
    """사본 대상으로 허용되는 경로인가. brief_dirs 와 같은 경계 + 산출물 디렉토리 제외."""
    if _deny_in_path(p):
        return False
    if p == ACCOUNT_HOME or str(p) in (str(ACCOUNT_HOME.parent), "/tmp"):
        return False   # 홈 전체를 사본으로 뜨는 브리프는 거부한다(비밀 노출·상한 둘 다)
    s = str(p)
    if not (s == "/tmp" or s.startswith("/tmp/") or _under_account_home(p)):
        return False
    if s == str(RUN_BASE) or s.startswith(str(RUN_BASE) + "/"):
        return False  # 사본의 사본 방지
    return True


# 이 런에서 사본을 떠도 되는 원본 경로. 브리프(원문 task)에 적힌 것만 들어간다.
# main() 이 한 번 채우고 이후 바뀌지 않는다.
BRIEF_PATHS = []


# 브리프가 자료를 나눠 적을 때 쓰는 표지. 줄 안에 이 글자가 있으면 그 줄부터 역할이
# 바뀐다. 표지가 없는 브리프는 전부 필수로 보고 지금까지와 똑같이 돈다 — 이미 도는
# 회차를 깨지 않는 것이 이 갈래의 조건이다.
BRIEF_REQ_MARKER = "[필수 자료]"
BRIEF_REF_MARKER = "[참고 자료]"

# 이 런의 참고 자료 뿌리. 사본 트리에는 들어가지만 검토 대상으로는 안 센다.
BRIEF_REF_PATHS = []


def brief_ref_paths(task):
    """브리프가 참고 자료로 적은 경로. 표지가 없으면 빈 목록이다."""
    refs, role = [], "필수"
    for line in (task or "").splitlines():
        if BRIEF_REF_MARKER in line:
            role = "참고"
        elif BRIEF_REQ_MARKER in line:
            role = "필수"
        if role != "참고":
            continue
        for raw in _ABS_PATH_RE.findall(line):
            try:
                p = Path(raw.rstrip(".,)]}")).resolve()
            except OSError:
                continue
            if _snap_ok(p) and str(p) not in refs:
                refs.append(str(p))
    return refs


def brief_required_paths():
    """이 런의 필수 자료 뿌리. 참고로 적힌 것만 뺀다."""
    return [p for p in BRIEF_PATHS if p not in BRIEF_REF_PATHS]


def brief_path_roles(task):
    """브리프 원문의 절대경로마다 역할(필수/참고)을 매긴다.

    brief_ref_paths 와 달리 실재 여부도 사본 가능 여부도 안 본다 — 못 여는 경로가
    필수였는지 참고였는지를 알아야 착수를 막을지 정할 수 있기 때문이다. 표지가 없는
    브리프는 전부 필수다. 한 경로가 두 자리에 적혔으면 필수가 이긴다.
    """
    roles, role = {}, "필수"
    for line in (task or "").splitlines():
        if BRIEF_REF_MARKER in line:
            role = "참고"
        elif BRIEF_REQ_MARKER in line:
            role = "필수"
        for raw in _ABS_PATH_RE.findall(line):
            cleaned = raw.rstrip(".,)]}")
            if roles.get(cleaned) != "필수":
                roles[cleaned] = role
    return roles


def _under(path, root):
    return path == root or path.startswith(root.rstrip("/") + "/")


def brief_file_role(origin, req_roots, ref_roots):
    """원본 경로가 필수 자료인가 참고 자료인가. (역할, 걸린 뿌리).

    더 구체적인(긴) 뿌리가 이기고, 길이가 같으면 필수가 이긴다. 어느 뿌리에도 안 걸리면
    필수로 본다 — 모르는 것을 참고로 내리면 검토 대상이 조용히 사라진다.
    """
    role, best = "필수", ""
    for r in ref_roots:
        if _under(origin, r) and len(r) > len(best):
            role, best = "참고", r
    for r in req_roots:
        if _under(origin, r) and len(r) >= len(best):
            role, best = "필수", r
    return role, best


def set_brief_paths(task):
    """브리프가 지목한 경로를 확정한다. 이 목록 밖의 경로는 사본 대상이 아니다."""
    BRIEF_PATHS[:] = []
    for raw in _ABS_PATH_RE.findall(task or ""):
        try:
            p = Path(raw.rstrip(".,)]}")).resolve()
        except OSError:
            continue
        if _snap_ok(p) and str(p) not in BRIEF_PATHS:
            BRIEF_PATHS.append(str(p))
    BRIEF_REF_PATHS[:] = brief_ref_paths(task)
    return list(BRIEF_PATHS)


def classify_brief_paths(task):
    """브리프가 가리킨 경로를 쓸 수 있는 것과 못 쓰는 것으로 가른다.

    반환: (쓸 수 있는 경로 목록, [(원문 경로, 사유)]).

    set_brief_paths 와 달리 실재 여부를 본다. BRIEF_PATHS 는 허용 목록이라 없는 경로가
    들어가도 해롭지 않아 걸러내지 않는데, 그 때문에 "경로를 적었는데 하나도 안 열린다"
    를 아무도 못 봤다. 착수 전에 이걸로 판정한다 — 그 상태로 돌면 참여자는 "지정된
    경로를 열 수 없었다" 고 밝히고 회차는 그 사실을 결론에 반영하지 않은 채 끝난다.
    """
    ok, bad = [], []
    for raw in _ABS_PATH_RE.findall(task or ""):
        cleaned = raw.rstrip(".,)]}")
        try:
            p = Path(cleaned).resolve()
        except OSError:
            bad.append((cleaned, "경로를 해석하지 못했다"))
            continue
        if not _snap_ok(p):
            bad.append((cleaned, "사본으로 뜰 수 없는 자리다"))
        elif not p.exists():
            bad.append((cleaned, "그 경로가 없다"))
        elif str(p) not in ok:
            ok.append(str(p))
    return ok, bad


def brief_path_abort_message(bad):
    """classify_brief_paths 의 못 쓰는 목록으로 만드는 중단 사유문. 하나도 못 쓸 때만 쓴다."""
    lines = [f"ERROR: 브리프가 절대경로 {len(bad)}개를 가리키는데 열 수 있는 것이 "
             "하나도 없다. 회차를 시작하지 않는다."]
    lines += [f"  - {p}: {why}" for p, why in bad]
    lines.append("경로를 역따옴표·꺾쇠 같은 기호로 감싸면 닫는 기호까지 경로에 붙는다. "
                 "감싸지 말고 그대로 적어라.")
    return "\n".join(lines)


def brief_required_abort_message(bad):
    """필수 자료가 빠졌을 때의 중단 사유문.

    빠진 것이 참고 자료면 경고로 끝내지만, 필수 자료면 회차가 통째로 헛돈다 —
    참여자 프롬프트에는 "경로 제외" 한 줄만 들어가고, 읽는 쪽은 세 모델이 그 파일을
    봤다고 믿은 채 결론을 받는다. 그 상태를 착수 전에 멈춘다.
    """
    lines = [f"ERROR: 필수 자료 {len(bad)}개를 열 수 없다. 회차를 시작하지 않는다."]
    lines += [f"  - {p}: {why}" for p, why in bad]
    lines.append("참고 자료로 내릴 것이면 브리프에 [참고 자료] 표지를 두고 그 아래 적어라.")
    return "\n".join(lines)


def from_brief(p):
    """브리프가 지목한 경로거나 그 안의 경로인가.

    프롬프트에 적힌 절대경로를 전부 사본으로 뜨면, 참여자가 답변 산문에 적은 경로가
    다음 호출에서 실제로 열린다. 2026-09-15 실측(run-20260915T052322Z): 제미나이 비판자가
    사본 경로에서 접두를 떼어 원본 경로를 적었고, 그것 때문에 중재자 사본이 저장소를
    통째로 떠서 상한에 걸렸다. 사본 대상은 사람이 브리프에 적은 것으로 한정한다.
    """
    s = str(p)
    for b in BRIEF_PATHS:
        if s == b or s.startswith(b.rstrip("/") + "/"):
            return True
    return False


def brief_state_fingerprint(task):
    """브리프가 가리키는 경로들의 현재 상태 요약. 캐시 키에 넣어 "같은 질문 + 바뀐 코드"
    가 옛 결론을 재사용하지 않게 한다. 내용을 다 해싱하면 비싸니 크기·mtime 으로 만든다."""
    parts = []
    for raw in sorted({m.rstrip(".,)]}") for m in _ABS_PATH_RE.findall(task or "")}):
        try:
            p = Path(raw).resolve()
        except OSError:
            continue
        if not _snap_ok(p):
            continue
        try:
            if p.is_file():
                st = p.stat()
                parts.append(f"{p}:{st.st_size}:{st.st_mtime_ns}")
            elif p.is_dir():
                n = 0
                total = 0
                newest = 0
                for cur, dirnames, filenames in os.walk(p):
                    curp = Path(cur)
                    dirnames[:] = [d for d in dirnames if not _snap_deny_name(d, curp)
                                   and not (curp / d).is_symlink()]
                    for fn in filenames:
                        if _snap_deny_name(fn, curp):
                            continue
                        try:
                            st = (curp / fn).stat()
                        except OSError:
                            continue
                        n += 1
                        total += st.st_size
                        newest = max(newest, st.st_mtime_ns)
                parts.append(f"{p}:{n}:{total}:{newest}")
        except OSError:
            continue
    return parts


def _is_snapshot_path(p, dest_root):
    """이 경로가 사본 트리(또는 산출물 루트) 안인가. 자기 자신을 복사하지 않으려는 가드."""
    s = str(p)
    for base in (str(Path(dest_root)), str(RUN_BASE)):
        if s == base or s.startswith(base + "/"):
            return True
    return False


def write_git_context(src, dst):
    """사본에 .git 은 안 넣지만 이력은 넣는다(GIT-CONTEXT.txt).

    .git 통째 복사는 호출 수만큼 객체 저장소가 복제돼 비싸고, 그렇다고 빼버리면
    "이 변경이 왜 이렇게 됐나" 를 볼 수 없다. 필요한 건 객체가 아니라 이력이므로
    log/status/diff 요약만 평문으로 떠서 사본 루트에 둔다. 원본 저장소는 읽기만 한다.
    """
    try:
        r = subprocess.run(["git", "-C", str(src), "rev-parse", "--show-toplevel"],
                           capture_output=True, text=True, timeout=20)
    except Exception:
        return
    if r.returncode != 0 or not (r.stdout or "").strip():
        return
    parts = []
    # `-- .` 로 이 디렉토리에 해당하는 이력만 뽑는다. 저장소 루트를 통째로 넘겼으면
    # 그게 곧 전체 이력이고, 하위 디렉토리면 그 하위 이력만 보인다.
    for title, cmd in (
        ("최근 커밋 30 (이 디렉토리)", ["log", "--oneline", "-30", "--", "."]),
        ("현재 브랜치·상태", ["status", "--short", "--branch", "."]),
        ("커밋 안 된 변경 요약", ["diff", "HEAD", "--stat", "--", "."]),
    ):
        try:
            p = subprocess.run(["git", "-C", str(src)] + cmd, capture_output=True,
                               text=True, timeout=20)
            out = (p.stdout or "").strip()
        except Exception:
            continue
        if out:
            parts.append(f"### {title}\n{out[:20000]}")
    if not parts:
        return
    try:
        (dst / "GIT-CONTEXT.txt").write_text(
            "이 디렉토리는 git 저장소의 사본이다. .git 은 사본에 없지만 이력은 아래에 있다.\n\n"
            + "\n\n".join(parts) + "\n", encoding="utf-8")
    except OSError:
        pass


def _atime_usable(path):
    """이 경로의 파일시스템이 atime 을 갱신하는가. noatime 이면 실측 자체가 불가능하다."""
    try:
        best, opts = "", ""
        target = os.path.realpath(path)
        with open("/proc/mounts") as fh:
            for line in fh:
                f = line.split()
                if len(f) < 4:
                    continue
                mp = f[1]
                if (target == mp or target.startswith(mp.rstrip("/") + "/")) and len(mp) > len(best):
                    best, opts = mp, f[3]
        return "noatime" not in opts.split(",")
    except OSError:
        return True


def snapshot_read_stats(snap_dir, baseline_ns=None):
    """사본 파일 중 실제로 열린 것이 몇 개인가. (열린 수, 전체 수) 또는 None(측정 불가).

    자기보고("읽었다")를 믿지 않기 위한 신호다. 판정은 atime > mtime — 갓 복사한 파일은
    둘이 같고(복사가 마지막 쓰기), relatime 파일시스템은 그 상태에서 첫 읽기에 atime 을
    올린다(실측 확인). 벽시계와 비교하지 않는 이유는 커널 시각 granularity 가 수 ms 라
    경계에서 어긋나기 때문이다.

    이건 하한이고 증명이 아니다(arbiter run-20260818T010108Z 지적 반영).
      - noatime 마운트면 읽어도 안 올라간다 → None 을 돌려주고 "측정 불가" 로 낸다.
      - 같은 파일을 두 번째 읽는 건 안 잡힌다(relatime).
      - agent 가 만들었거나 고친 파일은 mtime 이 스테이징 이후라 분모·분자에서 뺀다 —
        안 그러면 열심히 고친 agent 가 오히려 안 읽은 것으로 보인다.
    """
    if not _atime_usable(snap_dir):
        return None
    opened = total = 0
    try:
        for cur, _dirs, files in os.walk(snap_dir):
            for fn in files:
                try:
                    st = os.stat(os.path.join(cur, fn))
                except OSError:
                    continue
                if baseline_ns is not None and st.st_mtime_ns > baseline_ns:
                    continue   # agent 가 만든·고친 파일. 읽기 여부를 말해주지 않는다.
                total += 1
                if st.st_atime_ns > st.st_mtime_ns:
                    opened += 1
    except OSError:
        pass
    return opened, total


def stage_readonly(prompt, dest_root):
    """프롬프트에 적힌 절대경로를 읽기전용 사본으로 만들고 경로를 사본 경로로 치환한다.

    반환: (치환된 프롬프트, 사본 생성 여부). 원본 경로는 반환 프롬프트에 남지 않는다 —
    복사에 실패한 경로도 원문 대신 실패 사유로 바꾼다. 남겨두면 그 하나로 원본이 열린다.
    """
    matches = []
    for m in _ABS_PATH_RE.findall(prompt or ""):
        cleaned = m.rstrip(".,)]}")
        if cleaned not in matches:
            matches.append(cleaned)
    if not matches:
        return prompt, False

    budget = {"bytes": 0, "files": 0}
    repl = {}
    omitted = []   # 상한·오류로 사본에 안 들어간 원본 파일. 조용히 빠지면 안 된다.
    opaque = []    # 글자로 못 읽어서 일부러 뺀 파일. 있다는 사실은 알려준다.
    extracted = []  # 조판본에서 글자만 뽑아 대신 넣은 것.

    def copy_file(src, dst):
        # 빠진 파일은 사본 경로로 적는다. 원본 경로로 적으면 이 고지가 치환(아래 pattern.sub)
        # 이 끝난 뒤에 붙으므로 원본 절대경로가 프롬프트에 그대로 들어간다 — 2026-09-15
        # 실측(run-20260915T052322Z)에서 중재자 프롬프트에 원본 경로가 이 경로로 샜다.
        # 받는 쪽에도 사본 경로가 맞다. 그 자리에 파일이 없다는 뜻이기 때문이다.
        if budget["files"] >= SNAP_MAX_FILES or budget["bytes"] >= SNAP_MAX_TOTAL_BYTES:
            omitted.append(str(dst))
            return False
        try:
            size = src.stat().st_size
        except OSError:
            omitted.append(str(dst))
            return False
        if size > SNAP_MAX_FILE_BYTES or budget["bytes"] + size > SNAP_MAX_TOTAL_BYTES:
            omitted.append(f"{dst} ({size // 1024}KB)")
            return False
        dst.parent.mkdir(parents=True, exist_ok=True)
        try:
            shutil.copyfile(src, dst, follow_symlinks=True)
        except OSError:
            omitted.append(str(dst))
            return False
        # 2026-08-18: 444 → 원본 모드 + 소유자 쓰기. 사본은 금지구역이 아니라 전용
        # 작업본이다. 고쳐보고 테스트까지 돌려본 근거가 읽기만 한 근거보다 낫고, 고쳐도
        # 원본이 아니라 사본이라 되돌릴 것도 없다(원본 방어는 "원본 경로를 안 준다" 쪽이지
        # 파일 모드가 아니었다). 실행 비트를 살리는 건 arbiter 지적 —
        # 644 고정이면 스크립트를 직접 못 돌려 "실행해서 확인해라" 가 반쪽이 된다.
        try:
            src_mode = src.stat().st_mode & 0o777
        except OSError:
            src_mode = 0o644
        os.chmod(dst, (src_mode | 0o600) & 0o777)
        budget["files"] += 1
        budget["bytes"] += size
        if str(src) not in _ORIGIN_FP:
            try:
                _ORIGIN_FP[str(src)] = _fingerprint(src)
            except OSError:
                pass
        return True

    for raw in matches:
        try:
            src = Path(raw).resolve()
        except OSError:
            continue
        if not _snap_ok(src):
            repl[raw] = "<경로 제외: 이 토론에서 열 수 없는 위치>"
            continue
        if not from_brief(src):
            repl[raw] = "<경로 제외: 브리프에 없는 경로다>"
            continue
        dst = dest_root / str(src).lstrip("/")
        if src.is_file() and _snap_opaque(src):
            # 지목된 조판본은 글자만 뽑아 넣는다. 원본은 안 넣는다 — 트리에 없어야
            # 쪽을 그림으로 찍어 답에 쏟는 일이 안 일어난다.
            txt = dst.with_name(dst.name + ".txt")
            if _extract_pdf_text(src, txt):
                budget["files"] += 1
                budget["bytes"] += txt.stat().st_size
                extracted.append(str(txt))
                repl[raw] = str(txt)
            else:
                opaque.append(str(dst))
                repl[raw] = "<사본 제외: 글자로 못 읽는 파일이다>"
        elif src.is_file():
            repl[raw] = str(dst) if copy_file(src, dst) else "<사본 생성 실패(크기·개수 상한): 이 파일은 읽을 수 없다>"
        elif src.is_dir():
            copied_any = False
            opaque_before = len(opaque)
            for cur, dirnames, filenames in os.walk(src):
                curp = Path(cur)
                # 심링크는 따라가지 않는다 — 브리프 디렉토리 안의 심링크 하나로
                # 사본 밖(예: 다른 사용자 파일)이 열리면 사본의 의미가 없다.
                # 사본 디렉토리 자신은 절대 다시 복사하지 않는다. 브리프 디렉토리가
                # 사본 위치를 포함하면(예: 홈 아래를 통째로 넘김) 사본이 사본을 먹으며
                # 상한까지 부풀어 진짜 파일이 밀려난다 — 실측에서 6001개까지 갔다.
                dirnames[:] = [d for d in sorted(dirnames)
                               if not _snap_deny_name(d, curp) and not (curp / d).is_symlink()
                               and not _is_snapshot_path(curp / d, dest_root)]
                for fn in sorted(filenames):
                    f = curp / fn
                    if _snap_deny_name(fn, curp) or f.is_symlink():
                        continue
                    if _snap_opaque(f):
                        opaque.append(str(dest_root / str(f).lstrip("/")))
                        continue
                    if copy_file(f, dest_root / str(f).lstrip("/")):
                        copied_any = True
            if copied_any:
                dst.mkdir(parents=True, exist_ok=True)
                write_git_context(src, dst)
                repl[raw] = str(dst)
            elif len(opaque) > opaque_before:
                repl[raw] = "<사본 없음: 이 디렉토리에는 글자로 읽을 파일이 없다>"
            else:
                repl[raw] = "<사본 생성 실패(크기·개수 상한): 이 디렉토리는 읽을 수 없다>"
        else:
            repl[raw] = "<존재하지 않는 경로>"

    manifest = (write_brief_manifest(dest_root, brief_required_paths(), list(BRIEF_REF_PATHS))
                if budget["files"] else None)

    if not repl:
        return prompt, False
    # 한 번에 치환한다. str.replace 를 순서대로 돌리면 사본 경로 안에 원본 경로
    # 문자열이 들어 있어서(사본은 원본 트리를 그대로 미러링한다) 이미 바뀐 자리를
    # 다음 키가 또 바꾼다 — 실측에서 경로가 두 겹으로 겹쳐 나왔다.
    # 긴 키 우선 alternation 이면 파일 경로가 그 상위 디렉토리 키에 안 먹힌다.
    pattern = re.compile("|".join(re.escape(k) for k in sorted(repl, key=len, reverse=True)))
    out = pattern.sub(lambda m: repl[m.group(0)], prompt)

    # 잘렸으면 크게 말한다. 사본이 원본 트리와 다르다는 걸 agent 가 모르면
    # "이 폴더 전부를 봤다" 는 전제로 없는 결론을 낸다 — 못 읽은 것보다 나쁘다.
    if omitted:
        shown = omitted[:10]
        out += ("\n\n[사본 불완전] 위 경로의 사본에 원본 파일 "
                f"{len(omitted)}개가 빠졌다(상한: 파일 {SNAP_MAX_FILES}개 / 총 "
                f"{SNAP_MAX_TOTAL_BYTES // (1024*1024)}MB / 파일당 {SNAP_MAX_FILE_BYTES // (1024*1024)}MB). "
                "네가 보는 트리는 전부가 아니다. 전수 판단이 필요한 결론은 내지 말고 "
                "'사본에 없는 파일이 있어 전수 확인 불가' 라고 밝혀라. 빠진 것: "
                + ", ".join(shown) + (" 외" if len(omitted) > len(shown) else ""))
        key = (str(dest_root.parent), len(omitted))
        if key not in _SNAP_TRUNC_WARNED:
            _SNAP_TRUNC_WARNED.add(key)
            print(f"[ai-debate] 사본 상한으로 {len(omitted)}개 파일이 빠졌다 — agent 프롬프트에 "
                  f"불완전 고지를 붙였다. 대상을 좁히거나 SNAP_MAX_* 를 올려라.", file=sys.stderr)

    # 빠진 이유가 상한이 아니라 종류라서 위 고지와 따로 적는다. 여는 순간 내용을
    # 통째로 자기 출력에 쏟는 사고를 막는 것이 목적이므로, 열지 말라고 명시한다.
    if opaque:
        shown = opaque[:10]
        out += ("\n\n[글자 아닌 파일 제외] 위 경로에 그림·조판본·압축본·모델가중치 같은 "
                f"글자로 못 읽는 파일 {len(opaque)}개가 있고 사본에는 안 넣었다. 파일 이름과 "
                "위치는 근거로 써도 되지만, 어떤 파일이든 그 바이트나 base64 나 그림으로 "
                "바꾼 것을 네 답에 찍지 마라 — 답이 통째로 못 쓰게 된다. 꼭 내용이 필요하면 "
                "그 파일 하나를 지목해 달라고 답에 적어라. 제외된 것: "
                + ", ".join(shown) + (" 외" if len(opaque) > len(shown) else ""))
    if manifest and manifest["refs"]:
        # 참고 자료가 트리에 섞여 있다는 사실을 안 알리면 참여자는 그것까지 검토 대상으로
        # 읽고 전수 판단을 한다 — 상한으로 파일이 빠질 때와 같은 종류의 사고다.
        out += (f"\n\n[검토 대상과 참고 자료] 사본에 검토 대상 {manifest['required']}개와 "
                f"참고 자료 {manifest['refs']}개가 같이 들어 있다. 어느 파일이 어느 쪽인지는 "
                f"{manifest['path']} 에 있다. 판단은 검토 대상에 대해서 하고, 참고 자료는 "
                "맥락이 필요할 때만 열어라.")
    if extracted:
        out += ("\n\n[조판본은 글자만] 위 경로의 조판본은 원본 대신 글자만 뽑은 파일로 "
                "들어 있다. 쪽 배치·그림은 없고 본문과 표의 글자는 그대로다. "
                "그림이 판단에 필요하면 필요하다고 답에 적어라. 뽑은 파일: "
                + ", ".join(extracted[:10]) + (" 외" if len(extracted) > 10 else ""))
    return out, budget["files"] > 0


def cleanup_snapshots(run_dir):
    """런이 끝나면 사본을 지운다. 브리프가 큰 소스 트리면 호출 수만큼 배로 쌓인다 —
    사본은 입력이지 산출물이 아니다(무엇을 넘겼는지는 *.prompt.txt 에 남는다).
    AI_DEBATE_KEEP_SNAPSHOT=1 이면 남긴다."""
    snap = Path(run_dir) / "snapshot"
    if os.environ.get("AI_DEBATE_KEEP_SNAPSHOT") == "1" or not snap.is_dir():
        return
    total = 0
    for cur, _dirs, files in os.walk(snap):
        for fn in files:
            try:
                total += (Path(cur) / fn).stat().st_size
            except OSError:
                pass
    try:
        shutil.rmtree(snap)
    except OSError as e:
        print(f"[ai-debate] 사본 정리 실패: {e}", file=sys.stderr)
        return
    if total > 8 * 1024 * 1024:
        print(f"[ai-debate] 사본 {total // (1024*1024)}MB 정리(AI_DEBATE_KEEP_SNAPSHOT=1 로 보존 가능)",
              file=sys.stderr)


def origin_integrity_lines():
    """런 동안 사본을 뜬 원본이 그대로인지 확인. 사본 방어가 뚫렸으면 여기서 드러난다."""
    if not _ORIGIN_FP:
        return []
    changed, gone, touched = [], [], []
    for path, (md5, mtime_ns, size) in _ORIGIN_FP.items():
        p = Path(path)
        if not p.is_file():
            gone.append(path)
            continue
        try:
            now = _fingerprint(p)
        except OSError:
            gone.append(path)
            continue
        if now[0] != md5:
            changed.append(f"{path} (md5 {md5[:8]}→{now[0][:8]})")
        elif now[1] != mtime_ns:
            # 내용이 같으면 침해로 못 본다 — 다른 세션이 같은 트리를 만지는 일이
            # 흔해서 mtime 만으로 경보를 울리면 오탐이 신호를 덮는다. 참고로만 남긴다.
            touched.append(path)
    if not changed and not gone:
        line = f"origin-integrity: OK ({len(_ORIGIN_FP)}개 원본 불변)"
        if touched:
            line += f", mtime 만 바뀐 것 {len(touched)}개(내용 동일)"
        return [line]
    lines = ["origin-integrity: 변경 감지 — 사본 방어가 뚫렸다. 아래 원본을 확인해라."]
    lines += [f"  changed: {c}" for c in changed]
    lines += [f"  missing: {g}" for g in gone]
    return lines


def read_evidence_lines(all_outputs):
    """누가 사본을 실제로 열었나 — 자기보고가 아니라 atime 실측.

    경로 브리프의 결론 품질은 "읽고 말했나"에 달려 있는데, 그동안은 agent 가 읽었다고
    적으면 그대로 믿었다. 0/N 이면 그 의견은 근거 없이 나온 것이다.
    """
    per = {}
    unmeasurable = False
    for o in all_outputs:
        if "_snap_read" not in o:
            continue
        sr = o.get("_snap_read")
        a = o.get("_agent") or "?"
        if sr is None:
            unmeasurable = True
            continue
        cur = per.setdefault(a, [0, 0, 0])
        cur[0] += sr[0]
        cur[1] += sr[1]     # 콜마다 사본이 따로 있으니 분모도 콜별로 더한다
        cur[2] += 1
    if unmeasurable and not per:
        return ["읽기 흔적: 측정 불가(noatime 마운트)"]
    if not per:
        return []
    items = []
    for a in sorted(per):
        opened, total, calls = per[a]
        items.append(f"{a} {opened}/{total}({calls}콜)" + ("[흔적 없음]" if opened == 0 else ""))
    line = "읽기 흔적(사본 atime, 하한): " + ", ".join(items)
    # 0 을 "안 읽었다" 로 읽으면 안 된다. codex 는 읽기전용 바인드 마운트를 통해 열어서
    # atime 갱신 자체가 억제된다 — run-20260818T011817Z 에서 codex 는 0/12 로 찍혔지만
    # 두 카나리아 값을 정확히 인용했다. 흔적이 있으면 읽은 것이고, 없으면 모른다.
    if any(per[a][0] == 0 for a in per):
        line += (" — 0 은 미열람이 아니라 흔적 없음이다: 읽기전용 샌드박스는 atime 을 안 남긴다)")
    if unmeasurable:
        line += " — 일부 콜은 noatime 으로 측정 불가"
    return [line]


_RETRY_SKIP = ("timeout", "429", "rate limit", "ratelimit", "quota",
               "resource_exhausted", "too many", "미인식")

# agy 가 모르는 모델 이름을 받았을 때 찍는 문구(2026-10-14 홈 실측). 거절이라 조용한
# 대체는 없고 그 자리만 빈다. 아래 gemini_model_error 가 이 표식으로 사유를 적는다.
GEMINI_UNRECOGNIZED_MARK = "not recognized as a known model"


def gemini_model_error(agent, out, err):
    """agy 가 모델 이름을 못 알아본 거절이면 사유 문장, 아니면 None.

    보는 것은 실패한 호출의 출력뿐이다 — 성공한 응답이 이 문구를 인용만 해도 실패로
    돌리면 멀쩡한 의견이 사라진다. 원인을 계정 등급 하나로 단정하지 않는다. 거절이
    쓸 수 있는 모델 목록을 길게 같이 찍어서, 사유를 적기 전에 먼저 분류한다.
    """
    _m = agy_model(agent)
    if not _m:
        return None
    if GEMINI_UNRECOGNIZED_MARK not in ((out or "") + (err or "")):
        return None
    return (f"{agent} 모델 {_m} 미인식 — agy models 목록·구글 계정 등급·"
            f"agy 판본을 확인해라")


# agy 가 한도를 다 썼을 때 찍는 문구(2026-11-07 홈 실측). 종료코드는 0 이고 본문 자리에
# 이 줄만 들어 있어서, 안 가리면 "파싱 실패" 로 분류돼 재시도를 한 번 더 간다.
AGY_QUOTA_MARKS = ("individual quota reached", "resource_exhausted")
AGY_RESET_RE = re.compile(r"Resets in ([0-9hms]+)")


def agy_quota_error(agent, out, err):
    """agy 한도 거절이면 사유 문장, 아니면 None.

    문장에 "quota" 를 넣는 것이 핵심이다 — 위 _RETRY_SKIP 이 그 낱말을 보고 재시도를
    끊는다. 안 넣으면 "파싱 실패" 로 분류돼 부를 곳이 없는 상태로 한 번 더 부른다.
    재시도가 한도를 더 깎지는 않지만(거절은 토큰을 안 쓴다) 회차마다 그 자리의 대기가
    두 배가 되고, 기록에 남는 사유가 한도가 아니라 파싱이라 원인이 가려진다.
    실측 11-05~11-06: 클로드 자리 거절 39 중 19 가 그 헛호출이었다.
    """
    if not agy_model(agent):
        return None
    blob = ((out or "") + (err or ""))
    if not any(m in blob.lower() for m in AGY_QUOTA_MARKS):
        return None
    hit = AGY_RESET_RE.search(blob)
    when = f", {hit.group(1)} 뒤 풀림" if hit else ""
    return f"{agent} agy 한도 소진 — 재시도로 못 푼다(quota{when})"


# codex-ask 가 평소 모델과 예비 모델 양쪽에서 한도 거절을 받았을 때 쓰는 종료코드.
# 정본은 bin/codex-ask 의 CODEX_ASK_RC_LIMIT 이고 여기는 그 값을 읽는 쪽이다.
CODEX_ASK_RC_LIMIT = 75


def exit_error(agent, rc):
    """0 아닌 종료코드를 실패 사유 문장으로 바꾼다.

    한도 소진은 재시도로 못 푸는 실패다. 그냥 "exit 75" 로 두면 위 _RETRY_SKIP 에
    안 걸려서, 부를 곳이 한 군데도 없는 상태로 한 번 더 부른다 — 한 콜이 코덱스
    호출 넷이 된다. 그래서 문장에 재시도 제외 낱말을 넣는다.
    """
    if is_codex(agent) and rc == CODEX_ASK_RC_LIMIT:
        return f"{agent} 코덱스 한도 소진 — 예비 모델까지 거절(exit {rc}, rate limit)"
    return f"{agent} exit {rc}"


def parse_fail_error(agent, proc):
    """파싱 실패의 사유를 적는다. 0바이트는 파싱 문제가 아니라 다른 사고다.

    agy 는 도구가 거부되면 종료코드 0 에 stdout 0바이트로 끝난다(2026-09-29 홈
    실측: lean-ctx 제거 뒤 남은 ~/.gemini/GEMINI.md 가 읽기를 ctx_read 로만 하라고
    시켜서, 제미나이가 셸 head 를 부르고 헤드리스에서 거부당했다). 그걸 "JSON parse
    failed" 로 적으면 요약에 원인이 안 실리고, 실패한 참여자는 다음 라운드에서
    빠지므로 회차가 의견 하나를 조용히 잃는다. 그래서 빈 출력은 따로 적고
    표준오류 꼬리를 같이 남긴다 — 사유가 거기에만 있는 경우가 대부분이다.
    """
    if (proc.stdout or "").strip():
        return f"{agent} JSON parse failed"
    tail = " ".join((proc.stderr or "").split())[-200:]
    why = f"{agent} 출력 0바이트 — 도구 거부·전역 지침 충돌 의심"
    return f"{why} [stderr] {tail}" if tail else why

# claude CLI 는 한도에 걸려도 429 도 "rate limit" 도 안 쓴다 — 종료코드 1 에 본문만
# "You've hit your session limit · resets 7pm" 이다. 그래서 exit 1 로만 분류되면
# 재시도 제외에도 안 걸리고 계측의 rate_limited 도 false 가 된다. 실제로
# run-20260818T081451Z 에서 두 콜이 그렇게 재시도돼 같은 벽에 다시 부딪히고
# 런 재시도 예산만 태웠다(2026-08-19 계측 로그에서 발견).
_LIMIT_PHRASES = ("session limit", "usage limit", "hit your limit",
                  "limit · resets", "limit reached")


def _looks_rate_limited(text):
    t = (text or "").lower()
    return any(ph in t for ph in _LIMIT_PHRASES)
# 런 전체 재시도 상한. 없으면 한 provider 가 계속 실패할 때 사본 복사와 긴 호출이
# 라운드마다 배로 늘어 남은 시간·디스크를 먹는다(arbiter run-20260818T010108Z 지적).
_RETRY_BUDGET = [3]
_RETRY_LOCK = threading.Lock()


def call_agent(agent, role, prompt, run_dir, label):
    """사본 스테이징 + 1회 재시도 + 읽기 여부 판정을 감싼다.

    재시도(2026-08-18 사용자 지시 "완주비율은 되도록 재시도를 하면 된다"): JSON parse
    실패·비정상 종료처럼 다시 하면 될 실패만 한 번 더 부른다. 한도(429)와 timeout 은
    빼는데, 한도는 같은 벽에 다시 부딪히고 timeout 재시도는 남은 시간 예산을 통째로
    먹어 다른 agent 까지 죽이기 때문이다. 재시도는 사본도 새로 뜬다(호출별 독립 유지).
    """
    def once(lbl):
        snap_dir = run_dir / "snapshot" / lbl
        # 이 호출 전용 사본을 만들고 프롬프트의 경로를 사본 경로로 바꾼다.
        # 이 지점을 지나면 원본 절대경로는 어떤 agent 프롬프트에도 남지 않는다.
        staged, _ = stage_readonly(prompt, snap_dir)
        if is_codex(agent):
            # 사용량을 어느 호출에 붙일지는 프롬프트 앞머리로 가린다(codex_call_usage).
            # 코덱스 자리가 둘이 되면서 같은 라운드·같은 역할의 두 호출이 글자 하나까지
            # 같은 프롬프트를 받게 됐고, 그러면 앞머리가 안 갈려 한쪽 사용량이 다른 쪽
            # 것으로 적힌다. 그래서 호출 이름을 맨 앞에 한 줄 얹는다 — 재시도까지 포함해
            # 호출마다 다른 문자열이다. 꼬리가 아니라 머리에 두는 이유는 그 가름이
            # 앞 400자만 보기 때문이다.
            staged = f"[호출 {lbl}]\n" + staged
        baseline_ns = time.time_ns()
        out = _call_agent_once(agent, role, staged, run_dir, lbl)
        if is_codex(agent):
            # 재기만 한다. 값으로 호출을 끊지 않는다 — 임계는 값을 본 뒤에 정한다.
            try:
                out["_usage"] = codex_call_usage(staged, baseline_ns)
            except Exception as e:
                print(f"[ai-debate] {lbl} 사용량 계측 실패({type(e).__name__}: {e})",
                      file=sys.stderr)
            if out.get("_usage"):
                u = out["_usage"]
                print(f"[ai-debate] {lbl} 코덱스 요청 {u['requests']}회 · 셸 {u['shell']}회 "
                      f"· 입력 {u['input']:,}(캐시 재사용 {u['cached_input']:,}) "
                      f"· 출력 {u['output']:,}", file=sys.stderr)
        if snap_dir.is_dir():
            # 자기보고가 아니라 파일 시스템으로 판정한다. 0 이면 안 열어본 것이다.
            st = snapshot_read_stats(snap_dir, baseline_ns)
            out["_snap_read"] = list(st) if st else None
        return out

    out = once(label)
    if "_error" not in out:
        return out
    err = str(out.get("_error", "")).lower()
    if any(s in err for s in _RETRY_SKIP):
        return out
    with _RETRY_LOCK:
        if _RETRY_BUDGET[0] <= 0:
            print(f"[ai-debate] {label} 실패({out.get('_error')}) — 런 재시도 예산 소진, 재시도 안 함",
                  file=sys.stderr)
            return out
        _RETRY_BUDGET[0] -= 1
    print(f"[ai-debate] {label} 실패({out.get('_error')}) — 1회 재시도", file=sys.stderr)
    out2 = once(label + ".retry")
    out2["_retried"] = True
    # 1차 실패를 지우지 않는다. 재시도가 성공하면 계측상 "처음부터 성공" 으로 보여서
    # provider 고장률이 낙관 편향된다(arbiter run-20260818T010108Z 지적).
    out2["_first_error"] = out.get("_error")
    return out2


def _call_agent_once(agent, role, prompt, run_dir, label):
    raw_path = run_dir / f"{label}.raw.txt"
    prompt_path = run_dir / f"{label}.prompt.txt"
    prompt_path.write_text(prompt, encoding="utf-8")
    started = time.time()

    # 참여자 셋의 시작 작업 디렉토리를 한 자리에서 같은 방식으로 정한다.
    # 2026-09-15 운영자 지시("세 AI 를 다른 방식으로 두지 마라") 이전에는 셋이 갈렸다 —
    # codex 는 전용 --cd, claude 는 cwd="/tmp", gemini 은 아무것도 없이 세션의 작업
    # 디렉토리를 상속했다. 그래서 제미나이만 원본 트리 안에서 시작했고, 상대경로로
    # 움직이면 원본에 닿았다(2026-08-17 에 실제로 열어준 디렉토리의 파일을 고쳤다).
    # 사본이 없는 회차 — 브리프에 경로가 없어 stage 가 아무것도 안 뜬 경우 — 는 넘길
    # 디렉토리가 없으므로 옛 동작 그대로 둔다. 없는 경로를 주면 프로세스가 시작도 못 한다.
    _snap = Path(run_dir) / "snapshot" / label
    work_cwd = str(_snap) if _snap.is_dir() else None
    try:
        _agy_model = agy_model(agent)
        if _agy_model:
            # 이 갈래는 제미나이 자리와 agy 로 옮긴 클로드 자리가 같이 쓴다. 아래 설명은
            # 제미나이 자리에서 겪은 것이지만 같은 CLI 라 그대로 적용된다.
            # 2026-05-21: gemini-cli (EOL 2026-06-18) → antigravity CLI (agy) 교체.
            # --print-timeout 으로 hang 회피. --new-project 는 프로젝트 재사용 차단용.
            #
            # 2026-07-22: agy 는 stdin 을 읽지 않는다. 그런데 여기서 프롬프트 본문을
            # stdin 으로 주고 -p 에는 "위 지시대로 JSON만 출력" 한 줄만 넘기고 있었다 —
            # 모델이 받는 건 가리킬 대상이 없는 빈 지시뿐. 그래서 (A) 맥락을 찾으려
            # Bash 도구를 호출했다가 헤드리스 권한거부로 출력 0 → "JSON parse failed",
            # (B) 손에 잡히는 무관한 맥락으로 답해 "토픽 이탈"(2026-07-20 사용자 보고,
            # 2026-07-22 둘째 기계 재보고)이 났다. 둘 다 같은 뿌리.
            # 실측: 같은 형태 재현 시 도구 abort 확인 / no-tools 지시만 추가하면 agy 가
            # "출력할 내용이 지정되지 않았다"고 답해 본문 미수신이 확인됨 / 본문을 -p 로
            # 넘기면 도구 abort 없이 on-topic JSON 정상 출력.
            # → 본문을 -p 로 직접 전달한다(claude 갈래와 동일 방식). no-tools 지시는
            #   헤드리스에서 무의미한 도구 시도를 줄이는 보조 가드로 같이 붙인다.
            # no-tools 문구는 도구 실행만 막고 '검증 제안'까지 억누르지 않도록 좁게 쓴다
            # (ai-debate run-20260722T064706Z: 넓은 금지는 외부확인이 필요한 주제의
            # 답변 품질을 떨어뜨릴 수 있다는 지적).
            # 2026-08-17: no-tools 가드는 원인 진단이 어긋난 회피책이었다. 2026-07-22 에
            # 도구 호출이 권한거부로 죽은 건 모델·헤드리스 한계가 아니라 워크스페이스가
            # 안 열려 있어서였고, claude 갈래에 붙인 --add-dir 가 agy 에도 그대로 통한다
            # (실측: agy --add-dir <dir> -p "파일 열어서 값 답해라" → 정답, cwd 는 /tmp,
            #  --dangerously-skip-permissions 불필요). 그래서 경로가 있는 브리프에서는
            # 도구를 막는 대신 읽을 곳을 열어준다. 경로가 없는 일반 토론은 그대로 막는다 —
            # 열어줄 대상도 없는데 탐색만 늘면 손해다.
            # 열어주는 곳은 이 호출의 사본 뿌리 하나다. 프롬프트 본문에서 경로를 다시
            # 뽑으면 앞 라운드에서 참여자가 산문에 적은 경로까지 열린다(2026-09-15 실측).
            # 사본 뿌리 하나면 이 호출에 스테이징된 것 전부를 덮으면서 그 밖은 안 연다.
            gem_dirs = [work_cwd] if work_cwd else []
            if gem_dirs:
                gem_prompt = prompt + (
                    "\n\n위 지시대로 JSON만 출력. 위에 적힌 절대경로는 열려 있으니 직접 읽어라. "
                    "읽기 외의 탐색은 최소로 하고, 필요한 만큼 읽었으면 곧바로 JSON만 출력하라. "
                    # agy 는 헤드리스에서 거부된 도구를 만나면 부분 답이 아니라 출력 0 으로 끝난다
                    # (2026-08-18 run-20260818T003556Z: write_file 권한 거부로 debater·critic 2콜이
                    # 통째로 유실). 그래서 읽기 외 도구는 아예 시도하지 않게 못박는다.
                    "쓰기·삭제·실행 도구는 호출하지 마라(write_file 등). 헤드리스에서 거부되면 "
                    "부분 답이 아니라 네 답변 전체가 사라진다. 그런 요청을 받았으면 시도하지 말고 "
                    "'거부됨(도구 미시도)' 라고 적어라. "
                    # 위쪽 [작업본] 문단은 "사본 안에서는 고쳐도 된다" 고 말한다. 네 CLI 는
                    # 그게 안 되니 여기서 명시적으로 뒤집는다 — 상충하는 두 지시를 그대로
                    # 두면 도구를 시도했다가 답 전체가 날아간다(arbiter run-20260818T010108Z).
                    "위에 사본을 고쳐도 된다고 적혀 있어도 이 호출에서는 예외다 — 너는 읽기만 해라."
                )
            else:
                gem_prompt = prompt + (
                    "\n\n위 지시대로 JSON만 출력. 도구를 실행하지 말고 주어진 입력만으로 답하라"
                    "(필요하면 검증 방법을 답변 안에 제안해도 된다). 추가 탐색 없이 즉시 JSON만 출력하라."
                )
            # -p 는 단일 argv 라 리눅스 MAX_ARG_STRLEN(128KiB) 하드limit 에 걸린다.
            # 넘으면 OSError 로 죽어 원인 파악이 어려우니 미리 명확히 실패시킨다.
            # (관측: 지금까지 최대 프롬프트 47KB ≈ 한계의 36%. --deep 이나 대용량
            #  stdin 이 들어오면 초과 가능.)
            if len(gem_prompt.encode("utf-8")) > GEMINI_ARG_LIMIT:
                return {"_error": f"{agent} 프롬프트가 argv 한계 초과({len(gem_prompt.encode('utf-8'))}B > {GEMINI_ARG_LIMIT}B) — agy 는 stdin 을 안 읽어 -p 로만 전달 가능",
                        "_duration": round(time.time() - started, 2), "_agent": agent, "_role": role}
            # 모델을 명시하지 않으면 agy 설정파일 기본값을 따라가 머신마다 다른 모델로
            # 토론이 돌 수 있다(2026-07-29 실측: 둘째 기계 기본값이 3.5-flash 였다). 3.6 은
            # flash 등급만 있어 이전과 같은 등급의 한 세대 상향이다.
            # agy 기본 --print-timeout 은 5m 이라 우리 TIMEOUT(600s)보다 먼저 잘린다.
            # 읽기를 켠 경우엔 앞에서 끊기지 않게 올리되, 우리가 죽이기 30초 전에
            # 자기 답을 내도록 조금 낮춰 잡는다.
            gem_print_timeout = f"{max(60, TIMEOUT - 30)}s" if gem_dirs else "5m"
            cmd = [f"{HOME_DIR}/.local/bin/agy", "--new-project", "--model", _agy_model]
            for _d in gem_dirs:
                cmd += ["--add-dir", _d]
            cmd += ["-p", gem_prompt, "--print-timeout", gem_print_timeout]
            env = os.environ.copy()
            env["AI_OUT_RAW"] = "1"
        elif is_codex(agent):
            # 이 호출의 사본 디렉토리를 codex 의 작업 위치로 고정한다. 읽기 격리가 아니다 —
            # codex 는 같은 uid 로 돌아 절대경로로 홈을 그대로 읽고, 실제로 홈 118개 항목을
            # 나열한 적이 있다(run-20260818T003556Z). 이건 상대경로 탐색이 사본 밖으로
            # 새는 것만 막는 최소조치이고, 보안 경계로 취급하면 안 된다.
            # 판정 출처 run-20260818T062913Z: (b) 채택, 진짜 격리(별도 uid·컨테이너)는
            # bwrap 간헐 실패가 안 풀린 상태라 보류. 롤백은 이 --cd 인자만 빼면 된다.
            # 위 work_cwd 와 같은 말을 두 번 하는 셈이다. 실측으로 갈렸다(0d49f73,
            # tests/test-codex-cd-gate.py --live): codex 는 상속한 cwd 를 그대로 쓰고
            # --cd 는 그것을 덮는다. 즉 동작상 이 인자는 빼도 안 바뀐다. 그래도 남기는
            # 이유는 codex-ask 의 --cd 가 절대경로 여부와 디렉토리 존재를 호출 전에
            # 검사해 rc=2 로 끊어주기 때문이다 — cwd= 에는 없는 관문이고 비용은 0 이다.
            cmd = ["codex-ask", "--new"]
            if work_cwd:
                cmd += ["--cd", work_cwd]
            cmd += ["위 지시대로 JSON만 출력"]
            env = os.environ.copy()
            env["AI_OUT_RAW"] = "1"
            # codex-ask 안에도 자기 timeout 이 있다. 그게 우리보다 크면 우리가 먼저 죽여서
            # 부분 출력 회수 경로를 못 타고, 같으면 어느 쪽이 이길지 경합이 된다. 조금
            # 일찍 끊게 해서 codex-ask 가 뱉어놓은 raw 를 우리가 받도록 한다.
            env["CODEX_ASK_TIMEOUT"] = str(max(60, TIMEOUT - 30))
            # 아비터 강도만 실행 시점에 낮출 수 있게 열어둔다. 호출자 상한(Bash 600초)에
            # 걸려 판정을 못 받은 run 을 --arbiter-only 로 회수할 때, 같은 강도로 다시
            # 돌리면 같은 자리에서 또 잘린다.
            env["CODEX_ASK_EFFORT"] = (
                (os.environ.get("AI_DEBATE_ARBITER_EFFORT") or codex_arbiter_effort())
                if role == "arbiter" else codex_round_effort())
            # 자리마다 정해진 모델이 있으면 호출 인자로 넘긴다. 평소 자리("codex")는
            # 매핑값이 None 이라 안 넘기고, 그러면 config.toml 이 단일 출처로 남는다.
            # 정리자는 언제나 그 평소 자리라서(call_agent("codex", "arbiter", ...))
            # 이 갈래로 모델이 넘어갈 일이 없다 — 2026-09-29 운영자 지시대로다.
            _seat_model = CODEX_MODELS.get(agent)
            if _seat_model:
                env["CODEX_ASK_MODEL"] = _seat_model
        elif agent.startswith("claude"):
            # 클로드 코드 통로다. CLAUDE_VIA_AGY 에 든 자리는 위 agy 갈래가 먼저 가져가므로
            # 여기 오는 것은 agy 목록에 없는 자리뿐이다(지금은 깊은 회차의 페이블 5.2).
            # 격리하는 것은 작업 폴더지 로그인이 아니다 — 코덱스·제미나이와 같은 구조다.
            # 만료 구간을 피하는 게이트는 두지 않는다. 이 자식은 아래 HOME 그대로 이 기계의
            # 로그인 파일 하나를 쓰고, 그 파일은 다른 세션들도 같이 본다 — 누가 갱신하든
            # 모두가 같은 새 토큰을 읽으므로 경쟁할 자리가 없다. 게이트는 격리 홈에 자격
            # 사본을 두던 시절의 것이고(그때는 사본이 따로 갱신해 본 토큰을 무효화했다),
            # 사본을 없앤 뒤로는 멀쩡한 회차를 최대 30분 세우는 일만 했다.
            model = CLAUDE_MODELS.get(agent)
            if not model:
                return {"_error": f"모르는 클로드 자리 {agent} — CLAUDE_MODELS 에 없다",
                        "_duration": round(time.time() - started, 2), "_agent": agent, "_role": role}
            # 브리프가 가리킨 디렉토리는 읽을 수 있게 열어준다.
            # 이게 없으면 절대경로를 줘도 Read 는 미승인 거부, Bash cat 은 작업디렉토리
            # 제한으로 막혀서 debater 가 아무것도 못 읽는다(2026-08-17 실측).
            cmd = [f"{HOME_DIR}/.local/bin/claude", "--model", model, "--effort", claude_effort(),
                   # 부모 세션의 CLAUDE.md·훅·플러그인·커스텀 명령을 통째로 끈다. 격리 HOME 이
                   # 사주던 것이 바로 이것이고, 이 플래그는 인증·모델·내장도구·권한은 그대로
                   # 남긴다. --bare 는 쓸 수 없다 — 그쪽은 OAuth 를 아예 안 읽는다.
                   "--safe-mode",
                   # 부모의 MCP 서버를 물려받지 않는다. 특히 telegram long-poll 을 자식이
                   # 잡으면 부모 세션의 연결이 끊긴다.
                   "--strict-mcp-config", "--mcp-config", str(empty_mcp_config(run_dir))]
            # 제미나이 갈래와 같은 이유로 사본 뿌리 하나만 연다.
            for _d in ([work_cwd] if work_cwd else []):
                cmd += ["--add-dir", _d]
            cmd += ["-p", prompt]
            env = {
                "HOME": HOME_DIR,
                "PATH": f"{HOME_DIR}/.local/bin:/usr/local/bin:/usr/bin:/bin",
                "TERM": "dumb",
            }
            # claude는 stdin 안 받음 — prompt를 -p 인자로 직접 전달
            proc = subprocess.run(
                cmd, capture_output=True, text=True,
                timeout=TIMEOUT, env=env, cwd=(work_cwd or "/tmp"),
            )
            raw = proc.stdout + ("\n[stderr]\n" + proc.stderr if proc.stderr.strip() else "")
            raw_path.write_text(raw, encoding="utf-8")
            # 모르는 모델 이름은 거부되지 않는다 — 경고 한 줄만 남기고 다른 모델이 답한다.
            # 그대로 받으면 5.2 를 쓴다고 믿으면서 다른 모델의 의견을 채택하게 되므로
            # 이 콜은 실패로 돌린다. 대개 이 호스트의 claude CLI 가 2.1.321 미만이다.
            if UNRECOGNIZED_MODEL_MARK in raw:
                return {"_error": f"{agent} 모델 {model} 미인식 — claude CLI 2.1.321 이상 필요",
                        "_duration": round(time.time() - started, 2), "_agent": agent, "_role": role}
            if proc.returncode != 0:
                _why = (f"{agent} rate limit (exit {proc.returncode}, 본문에 한도 문구)"
                        if _looks_rate_limited(raw) else f"{agent} exit {proc.returncode}")
                return {"_error": _why, "_duration": round(time.time() - started, 2), "_agent": agent, "_role": role}
            parsed = parse_json_loose(proc.stdout, role)
            if parsed is None:
                return {"_error": parse_fail_error(agent, proc), "_raw": proc.stdout[:300], "_duration": round(time.time() - started, 2), "_agent": agent, "_role": role}
            parsed["_agent"] = agent
            parsed["_role"] = role
            parsed["_duration"] = round(time.time() - started, 2)
            norm_path = run_dir / f"{label}.normalized.json"
            norm_path.write_text(json.dumps(parsed, ensure_ascii=False, indent=2), encoding="utf-8")
            return parsed
        else:
            return {"_error": f"unknown agent {agent}", "_duration": 0, "_agent": agent, "_role": role}
        proc = subprocess.run(
            cmd, input=prompt, capture_output=True, text=True,
            timeout=TIMEOUT, env=env, cwd=work_cwd,
        )
        raw = proc.stdout + ("\n[stderr]\n" + proc.stderr if proc.stderr.strip() else "")
        raw_path.write_text(raw, encoding="utf-8")
        if proc.returncode != 0:
            _why = (agy_quota_error(agent, proc.stdout, proc.stderr)
                    or gemini_model_error(agent, proc.stdout, proc.stderr)
                    or exit_error(agent, proc.returncode))
            return {"_error": _why,
                    "_duration": round(time.time() - started, 2), "_agent": agent, "_role": role}
    except subprocess.TimeoutExpired as te:
        # 죽기 전에 뱉어놓은 게 있으면 건진다. 시간초과는 지금 품질을 제일 많이 깎는
        # 실패인데(의견 하나가 통째로 사라진다) 재시도로는 못 푼다 — 재시도가 남은
        # 시간 예산을 통째로 먹기 때문이다. 그래서 부분 출력에서라도 JSON 을 찾는다.
        partial = te.stdout if isinstance(te.stdout, str) else (
            te.stdout.decode("utf-8", "replace") if te.stdout else "")
        perr = te.stderr if isinstance(te.stderr, str) else (
            te.stderr.decode("utf-8", "replace") if te.stderr else "")
        if partial or perr:
            try:
                raw_path.write_text(partial + ("\n[stderr]\n" + perr if perr.strip() else ""),
                                    encoding="utf-8")
            except OSError:
                pass
        salvaged = parse_json_loose(partial, role) if partial else None
        if salvaged is not None:
            salvaged["_agent"] = agent
            salvaged["_role"] = role
            salvaged["_duration"] = round(time.time() - started, 2)
            salvaged["_partial_timeout"] = True
            print(f"[ai-debate] {label} 시간초과 — 부분 출력에서 JSON 회수", file=sys.stderr)
            try:
                (run_dir / f"{label}.normalized.json").write_text(
                    json.dumps(salvaged, ensure_ascii=False, indent=2), encoding="utf-8")
            except OSError:
                pass
            return salvaged
        return {"_error": f"{agent} timeout", "_duration": round(time.time() - started, 2), "_agent": agent, "_role": role}
    except Exception as e:
        return {"_error": f"{agent} {e}", "_duration": round(time.time() - started, 2), "_agent": agent, "_role": role}

    parsed = parse_json_loose(proc.stdout, role)
    if parsed is None:
        _why = (agy_quota_error(agent, proc.stdout, proc.stderr)
                or gemini_model_error(agent, proc.stdout, proc.stderr)
                or parse_fail_error(agent, proc))
        return {"_error": _why, "_raw": proc.stdout[:300], "_duration": round(time.time() - started, 2), "_agent": agent, "_role": role}
    parsed["_agent"] = agent
    parsed["_role"] = role
    parsed["_duration"] = round(time.time() - started, 2)
    norm_path = run_dir / f"{label}.normalized.json"
    norm_path.write_text(json.dumps(parsed, ensure_ascii=False, indent=2), encoding="utf-8")
    return parsed


# --- 계측 로깅 (적응형 라우팅 슬라이스 A, ai-debate run-20260703T024056Z 합의) ---
# 기본 켜짐(2026-08-18). 원래 opt-in 이었는데, 그러면 "claude 콜 실행시간 p95/p99 를 재고
# creds 여유선을 낮춘다"(run-20260818T055809Z 판정)를 착수하려는 시점에 표본이 0 이라
# 거기서부터 몇 주를 기다려야 한다. 한 콜당 JSONL 한 줄이라 비용이 사실상 없으니 미리 쌓는다.
# 끄려면 AIDEBATE_LOG_PATH=/dev/null, 옮기려면 그 변수에 경로.
# 실패해도 토론 실행은 절대 안 죽인다(stderr 경고만). 프롬프트/응답 원문은 안 넣는다 —
# 기록은 provider·role·성패·지연·응답 글자수 같은 메타뿐이다(개인정보·조기추상화 방지).
LOG_PATH = os.environ.get("AIDEBATE_LOG_PATH") or str(RUN_BASE / "calls.jsonl")


def log_event(rec):
    path = LOG_PATH
    if not path:
        return
    try:
        with open(path, "a", encoding="utf-8") as f:
            f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    except Exception as e:
        print(f"[ai-debate] 계측 로그 기록 실패: {e}", file=sys.stderr)


# 호출당 사용량은 코덱스 CLI 가 안 돌려준다. 롤아웃 기록에는 남으므로 거기서 읽는다.
# 재는 것만 한다 — 몇 번을 넘으면 끊는다는 임계는 값을 본 뒤에 정한다(둘째 기계 3회차 판정).
# 값이 요청 수로 정해지기 때문에 요청 수가 제일 중요한 칸이다: 한 호출 안에서 모델에 여러 번
# 요청하고 요청마다 그때까지의 대화가 다시 실린다.
CODEX_ROLLOUT_GLOB = os.path.join(HOME_DIR, ".codex", "sessions", "*", "*", "*", "*.jsonl")


def codex_call_usage(prompt, since_ns, paths=None):
    """이 코덱스 호출의 요청 수·토큰·셸 실행 수. 못 찾으면 None.

    호출을 가려내는 열쇠는 프롬프트 앞머리다. 시각으로만 고르면 같은 라운드에 나란히 도는
    호출들이 섞인다. 역할이 다르면 지시문이 달라 저절로 갈리지만 그것만으로는 모자라다 —
    코덱스 자리가 둘이면 같은 역할의 두 호출이 똑같은 프롬프트를 받는다. 그래서 부르는 쪽
    (call_agent)이 맨 앞에 호출 이름 한 줄을 얹어 보낸다. 그 줄이 없으면 여기는 먼저 찾은
    기록을 돌려주므로 한쪽 사용량이 다른 쪽 것으로 적힌다.
    """
    key = (prompt or "")[:400]
    if not key:
        return None
    for path in (paths if paths is not None else glob.glob(CODEX_ROLLOUT_GLOB)):
        try:
            if os.stat(path).st_mtime_ns < since_ns:
                continue
        except OSError:
            continue
        found = False
        u = {"requests": 0, "input": 0, "cached_input": 0, "output": 0, "shell": 0}
        try:
            with open(path, encoding="utf-8", errors="replace") as fh:
                for line in fh:
                    if '"token_usage_record"' in line:
                        try:
                            usage = (json.loads(line).get("payload") or {}).get("usage") or {}
                        except ValueError:
                            continue
                        u["requests"] += 1
                        u["input"] += usage.get("input_tokens") or 0
                        u["cached_input"] += usage.get("cached_input_tokens") or 0
                        u["output"] += usage.get("output_tokens") or 0
                    elif '"custom_tool_call"' in line:
                        # 출력 기록(custom_tool_call_output)은 닫는 따옴표가 달라 안 걸린다.
                        u["shell"] += 1
                    elif not found and '"message"' in line:
                        try:
                            pl = json.loads(line).get("payload") or {}
                        except ValueError:
                            continue
                        if pl.get("role") != "user":
                            continue
                        text = "".join(c.get("text") or "" for c in (pl.get("content") or [])
                                       if isinstance(c, dict))
                        found = key in text
        except OSError:
            continue
        if found:
            return u
    return None


def _log_call(o, run_dir, round_idx, label=None):
    """call 결과 dict 1건을 계측 로그로. LOG_PATH 가 비면 즉시 반환(파일 read 안 함).

    label 은 raw 파일 이름이 라운드 규칙(r<N>.<role>.<agent>)을 안 따르는 콜용이다 —
    arbiter 가 그렇다. 안 주면 라운드 규칙으로 만든다.
    """
    if not LOG_PATH:
        return
    agent = o.get("_agent")
    role = o.get("_role")
    err = o.get("_error")
    rchars = None
    try:
        suffix = ".retry.raw.txt" if o.get("_retried") else ".raw.txt"
        raw_p = run_dir / f"{label or f'r{round_idx}.{role}.{agent}'}{suffix}"
        if raw_p.exists():
            rchars = len(raw_p.read_text(encoding="utf-8", errors="ignore"))
    except Exception:
        rchars = None
    errl = (err or "").lower()
    u = o.get("_usage") or {}
    total = (u.get("input", 0) + u.get("output", 0)) if u else None
    log_event({
        "ts": round(time.time(), 3),
        "run_id": run_dir.name,
        "round": round_idx,
        "role": role,
        "provider": agent,
        "model": CLAUDE_MODELS.get(agent),   # codex/gemini 는 CLI 미제공 → null
        "success": err is None,
        "error_type": err,
        "latency_ms": int(round((o.get("_duration") or 0) * 1000)),
        "rate_limited": any(s in errl for s in ("429", "rate limit", "ratelimit", "quota", "too many", "resource_exhausted")),
        "http_status": None,       # CLI 래퍼라 미제공
        # 아래 다섯은 코덱스 롤아웃에서 읽는다. 제미나이·claude 는 그런 기록이 없어 null 이다.
        "input_tokens": u.get("input"),
        "cached_input_tokens": u.get("cached_input"),
        "output_tokens": u.get("output"),
        "total_tokens": total,
        "model_requests": u.get("requests"),
        "shell_calls": u.get("shell"),
        "response_chars": rchars,
    })


def do_log_summary(path):
    """계측 JSONL 을 provider별로 집계 출력. 소비 경로(별도 대시보드/DB 없음).

    평균이 아니라 백분위를 낸다. 상한을 정하는 건 평균이 아니라 꼬리이고, 평균은
    실패 콜(한도로 2초 만에 죽는 것 같은)이 섞이면 오히려 낮아져서 안전해 보인다.
    그래서 지연 통계는 성공 콜만으로 계산한다.
    """
    from collections import defaultdict
    path = path or LOG_PATH
    if not path or not os.path.exists(path):
        print(f"[ai-debate] 로그 파일 없음: {path or '(AIDEBATE_LOG_PATH 미설정)'}", file=sys.stderr)
        return 1
    agg = defaultdict(lambda: {"n": 0, "fail": 0, "rl": 0, "lat": [], "chars": 0, "cn": 0,
                               "req": [], "shell": [], "tok": []})
    ts = []
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                r = json.loads(line)
            except Exception:
                continue
            # get 의 기본값은 키가 없을 때만 나온다. 옛 기록은 키가 있고 값이 null 이라
            # agg[None] 이 생기고 sorted 가 None 과 문자열을 비교하다 죽는다.
            a = agg[r.get("provider") or "?"]
            a["n"] += 1
            if r.get("ts"):
                ts.append(r["ts"])
            if not r.get("success"):
                a["fail"] += 1
            else:
                a["lat"].append((r.get("latency_ms") or 0) / 1000.0)
            if r.get("rate_limited"):
                a["rl"] += 1
            if r.get("response_chars") is not None:
                a["chars"] += r.get("response_chars")
                a["cn"] += 1
            if r.get("model_requests") is not None:
                a["req"].append(r["model_requests"])
                a["shell"].append(r.get("shell_calls") or 0)
                a["tok"].append(r.get("total_tokens") or 0)

    def pct(vals, q):
        """가장 가까운 순위. 표본이 얇을 때 보간하면 없는 값을 지어낸다."""
        if not vals:
            return 0.0
        i = min(len(vals) - 1, max(0, int(round(q * (len(vals) - 1)))))
        return sorted(vals)[i]

    if ts:
        span = (max(ts) - min(ts)) / 3600.0
        print(f"표본 {sum(a['n'] for a in agg.values())}건 / {span:.1f}시간 "
              f"({time.strftime('%m-%d %H:%M', time.localtime(min(ts)))} ~ "
              f"{time.strftime('%m-%d %H:%M', time.localtime(max(ts)))})")
    print(f"{'provider':16}{'n':>4}{'fail':>5}{'한도':>5}"
          f"{'med_s':>8}{'p90_s':>8}{'p95_s':>8}{'max_s':>8}{'avg_chars':>10}")
    for k in sorted(agg):
        a = agg[k]
        lat = a["lat"]
        cn = a["cn"] or 1
        print(f"{k:16}{a['n']:>4}{a['fail']:>5}{a['rl']:>5}"
              f"{pct(lat, 0.5):>8.1f}{pct(lat, 0.9):>8.1f}{pct(lat, 0.95):>8.1f}"
              f"{(max(lat) if lat else 0):>8.1f}{a['chars'] // cn:>10}")
    print("지연은 성공 콜만. p95 는 표본이 20건 미만이면 사실상 최대값이다 — 그렇게 읽어라.")
    # 호출당 요청 수는 값을 정하는 칸이다. 한 호출 안에서 모델에 여러 번 요청하고 요청마다
    # 그때까지의 대화가 다시 실려서, 같은 내용도 나눠 읽으면 나눈 횟수만큼 다시 산다.
    metered = {k: a for k, a in agg.items() if a["req"]}
    if metered:
        print(f"\n{'provider':16}{'n':>4}{'req_med':>9}{'req_max':>9}"
              f"{'shell_med':>11}{'tok_med':>12}{'tok_max':>12}")
        for k in sorted(metered):
            a = metered[k]
            print(f"{k:16}{len(a['req']):>4}{pct(a['req'], 0.5):>9.0f}{max(a['req']):>9}"
                  f"{pct(a['shell'], 0.5):>11.0f}{pct(a['tok'], 0.5):>12,.0f}"
                  f"{max(a['tok']):>12,}")
        print("요청 수는 코덱스 롤아웃에서 읽는다. 다른 provider 는 그런 기록이 없어 빠진다.")
    return 0


METERING_LOG = RUN_BASE / "quota-metering.jsonl"


def write_metering(run_dir, run_id, started_epoch, all_outputs, rounds_done, consensus,
                   deficit=""):
    """토론 1회의 실제 소비를 파일에만 기록한다. 알림 없음(사용자 지시 2026-07-29).

    왜 필요한가: fable 유지 결정의 근거가 "fable 전용 상한 27% 소진" 하나뿐이었는데,
    그 값은 공유 5h/7d 풀을 얼마나 먹는지 말해주지 않는다. 재지 않으면 다음 판단도
    같은 자리다(run-20260729T061853Z arbiter: 계측 선행).

    측정 방법 두 가지를 같이 남긴다.
      claude_tokens: 이 run 의 사본 디렉토리에 딸린 transcript 에서 시간창의 assistant usage 합.
                     호출에 직접 귀속되는 값이라 가장 신뢰할 만하다.
      rate_limits:   statusline_cache 의 5h/7d %. 단 이 캐시는 세션 턴마다 갱신되므로
                     run 중에는 대개 갱신되지 않는다 — before/after 가 같을 수 있다.
                     그래서 _cached_at 을 같이 적어 stale 여부를 나중에 판별한다.
    """
    import calendar as _cal
    rec = {"run_id": run_id, "started_epoch": int(started_epoch),
           "ended_epoch": int(time.time()), "rounds_done": rounds_done,
           "consensus": bool(consensus),
           # 결손 줄은 사람이 읽는 결론·주입 요약과 같은 문자열이어야 한다.
           "deficit_header": deficit,
           "gemini_model": gemini_model(),
           "codex_model": effective_codex_model(),
           "codex_fallback_model": codex_fallback_info(run_dir)[0],
           "codex_fallback_calls": codex_fallback_info(run_dir)[1],
           # 깊은 모드는 클로드 자리가 둘이라 이름 하나로는 회차를 못 읽는다.
           "claude_model": ",".join(CLAUDE_MODELS[a] for a in POOL if a in CLAUDE_MODELS),
           # 같은 모델 이름이라도 통로가 다르면 쓰는 한도가 다르다. 이름만 적으면
           # 나중에 "그 회차는 공유 한도를 썼나" 를 되짚을 근거가 없다.
           "claude_via_agy": sorted(a for a in POOL if a in CLAUDE_VIA_AGY),
           "claude_effort": claude_effort(), "deep": DEEP}
    calls = {}
    for o in all_outputs:
        a = o.get("_agent") or "?"
        st = calls.setdefault(a, {"ok": 0, "fail": 0, "sec": 0.0})
        st["fail" if "_error" in o else "ok"] += 1
        st["sec"] += float(o.get("_duration") or 0)
    for st in calls.values():
        st["sec"] = round(st["sec"], 1)
    rec["calls"] = calls

    tok = {"turns": 0, "output": 0, "cache_creation": 0, "cache_read": 0, "input": 0}
    # 이 회차의 콜에만 귀속시킨다. 로그인을 공유하면서 transcript 도 공용 ~/.claude/projects
    # 로 가는데, 그걸 통째로 합산하면 같은 시간에 돌던 다른 아홉 세션의 소비가 이 회차의
    # 값으로 들어온다. claude 는 프로젝트 폴더 이름을 시작 작업 디렉토리에서 만들고 우리는
    # 콜마다 run_dir 밑 사본으로 시작하므로, 그 run_dir 로 시작하는 폴더만 본다.
    own_projects = os.path.join(
        HOME_DIR, ".claude", "projects",
        os.path.abspath(str(run_dir)).replace("/", "-") + "*")
    for f in glob.glob(own_projects + "/**/*.jsonl", recursive=True):
        try:
            if os.path.getmtime(f) < started_epoch - 60:
                continue
            with open(f, errors="replace") as fh:
                for line in fh:
                    if '"usage"' not in line:
                        continue
                    try:
                        o = json.loads(line)
                    except Exception:
                        continue
                    if o.get("type") != "assistant":
                        continue
                    ts = (o.get("timestamp") or "")[:19]
                    try:
                        e = _cal.timegm(time.strptime(ts, "%Y-%m-%dT%H:%M:%S"))
                    except Exception:
                        continue
                    if not (started_epoch - 5 <= e <= time.time() + 5):
                        continue
                    u = (o.get("message") or {}).get("usage") or {}
                    tok["turns"] += 1
                    tok["output"] += u.get("output_tokens", 0) or 0
                    tok["cache_creation"] += u.get("cache_creation_input_tokens", 0) or 0
                    tok["cache_read"] += u.get("cache_read_input_tokens", 0) or 0
                    tok["input"] += u.get("input_tokens", 0) or 0
        except OSError:
            continue
    rec["claude_tokens"] = tok

    try:
        d = json.load(open(os.path.expanduser("~/.claude/statusline_cache.json")))
        rl = d.get("rate_limits") or {}
        rec["rate_limits"] = {
            "five_hour_pct": (rl.get("five_hour") or {}).get("used_percentage"),
            "seven_day_pct": (rl.get("seven_day") or {}).get("used_percentage"),
            "cached_at": d.get("_cached_at"),
        }
    except Exception:
        rec["rate_limits"] = None

    try:
        (run_dir / "metering.json").write_text(
            json.dumps(rec, ensure_ascii=False, indent=1), encoding="utf-8")
        METERING_LOG.parent.mkdir(parents=True, exist_ok=True)
        with open(METERING_LOG, "a") as fh:
            fh.write(json.dumps(rec, ensure_ascii=False) + "\n")
    except OSError:
        pass    # 계측 실패가 토론 결과를 죽이면 안 된다


def consensus_reached(round_outputs):
    """과반 critic 이 needs_another_round=false 라고 하면 합의(=조기 종료).

    2026-07-29 개정. 구 판정("critic 전원 should_proceed=true" + "debater position 단어
    자카드 평균 >= 0.5")은 구조상 성립이 불가능했다 — 실측 19 run 에서 전원 true 는 0회,
    자카드 평균은 최대 0.097 이었다(임계 0.5). 그래서 모든 토론이 예외 없이 max_rounds 를
    완주했다. 원인 둘:
      1) should_proceed 는 "안이 완벽한가"를 묻는다. critic 은 역할상 약점을 찾으므로 거의
         항상 false 다. 라운드 종료 신호로 쓸 수 있는 값이 아니다.
      2) 한국어 산문 position 의 단어 자카드는 같은 결론이어도 0.1 을 넘기 어렵다.
    그래서 종료 전용 신호(needs_another_round)를 따로 묻고, 자카드 수렴 조건은 폐기한다.
    should_proceed 는 의미 그대로 두고 escalation_triggered 에서만 계속 쓴다.

    하위호환: 새 필드가 없거나 불리언으로 못 읽으면 "더 돌 필요 있음"으로 본다 →
    합의 아님 → 현행대로 완주. 구 버전 대비 악화가 없다.
    """
    crits = [o for o in round_outputs if o.get("_role") == "critic" and "_error" not in o]
    if not crits:
        return False

    def as_bool(v):
        """true/false 를 명시적으로 읽는다. 못 읽으면 None(=판단 불가)."""
        if isinstance(v, bool):
            return v
        if isinstance(v, str):
            s = v.strip().lower()
            if s in ("true", "yes", "예", "y", "1"):
                return True
            if s in ("false", "no", "아니오", "아니요", "n", "0"):
                return False
        return None

    done = sum(1 for c in crits if as_bool(c.get("needs_another_round")) is False)
    return done * 2 > len(crits)


def escalation_triggered(round_outputs):
    """--deep adaptive 4~5라운드 트리거: critic should_proceed 분기(핵심 위험 미해결) 또는
    debater 평균 confidence < 0.6(저신뢰). 둘 중 하나면 확장. (2026-06-04)"""
    crits = [o for o in round_outputs if o.get("_role") == "critic" and "_error" not in o]
    debs = [o for o in round_outputs if o.get("_role") == "debater" and "_error" not in o]
    sp = [_truthy_sp(c.get("should_proceed")) for c in crits]
    if sp and any(sp) and not all(sp):
        return True  # critic 간 판정 분기 = 미해결 위험
    confs = []
    for d in debs:
        try:
            confs.append(float(d.get("confidence")))
        except (TypeError, ValueError):
            pass
    if confs and (sum(confs) / len(confs)) < 0.6:
        return True
    return False


def escalation_projected_calls(planner_calls, outputs_done, remaining_rounds, n_roles, n_live):
    """확장했을 때 이 런이 끝까지 쓰게 될 논리 콜 총수.

    시작 전 예산 검사와 같은 단위로 센다 — planner(0 또는 1) + 지금까지의 역할 출력 +
    남은 라운드 × 역할 × 살아있는 provider + arbiter 1. 실패 후 재시도는 양쪽 다 안 센다
    (런 상한 3 으로 따로 묶여 있다). 죽어서 빠진 provider 는 n_live 에서 빠지는데,
    그 콜은 앞으로 안 일어나므로 예산에 넣으면 안 할 콜까지 세는 것이 된다.
    """
    return planner_calls + outputs_done + remaining_rounds * n_roles * n_live + 1


# 앞 라운드를 다음 라운드에 넘길 때 쓰는 예산. 넘치면 참가자별로 몫을 나눠 줄이고,
# 통째로 버리지 않는다. 옛 판본은 전체를 json 으로 만든 뒤 앞에서 1만 자만 남겼는데,
# 그러면 넘치는 순간 뒤쪽 참가자 발언이 통째로 사라졌다 — 실측 5회차가 전부 잘렸고
# run-20260929T023534Z 는 1라운드 여섯 발언 중 하나만 2라운드로 넘어갔다(2026-09-29).
PRIOR_BLOCK_LIMIT = 10000
# 몫이 아무리 작아도 이만큼은 준다. 누가 무슨 역할로 무슨 말을 했는지가 남을 최소치다.
# 참가자가 많아 합이 예산을 넘으면 예산 쪽을 늘린다 — 발언을 버리는 것보다 낫다.
PRIOR_ENTRY_FLOOR = 400
PRIOR_CUT_MARK = " …(잘림)"


def _fair_shares(needs, budget):
    """물 채우기 배분. 적게 쓰는 쪽이 남긴 몫은 모자란 쪽에 되돌아간다.

    needs 순서대로 몫을 돌려준다. 합이 예산을 넘으면 균등분할에 가까워지고,
    남으면 모두가 필요한 만큼 다 받는다.
    """
    shares = [0] * len(needs)
    remaining = budget
    order = sorted(range(len(needs)), key=lambda i: needs[i])
    left = len(needs)
    for i in order:
        even = remaining // left if left else 0
        give = min(needs[i], even)
        shares[i] = give
        remaining -= give
        left -= 1
    return shares


def _shrink_entry(entry, budget):
    """한 발언을 예산 안으로 줄인다. 긴 문자열부터 깎고 칸 자체는 남긴다."""
    def size(e):
        return len(json.dumps(e, ensure_ascii=False, indent=2))

    out = dict(entry)
    guard = 0
    while size(out) > budget and guard < 200:
        guard += 1
        # 가장 긴 문자열 칸을 찾는다. 리스트는 원소 단위로 본다.
        target, best = None, 0
        for k, v in out.items():
            if k in ("round", "agent", "role"):
                continue
            if isinstance(v, str) and len(v) > best:
                target, best = (k, None), len(v)
            elif isinstance(v, list):
                for idx, item in enumerate(v):
                    if isinstance(item, str) and len(item) > best:
                        target, best = (k, idx), len(item)
        if target is None or best <= len(PRIOR_CUT_MARK) + 8:
            break
        over = size(out) - budget
        keep = max(8, best - max(over, 1) - len(PRIOR_CUT_MARK))
        k, idx = target
        if idx is None:
            out[k] = out[k][:keep] + PRIOR_CUT_MARK
        else:
            lst = list(out[k])
            lst[idx] = lst[idx][:keep] + PRIOR_CUT_MARK
            out[k] = lst
    return out


def build_prior_block(prior_outputs):
    if not prior_outputs:
        return ""
    summary = []
    for o in prior_outputs:
        if "_error" in o:
            continue
        rnd = o.get("_round", "?")
        agent = o.get("_agent", "?")
        role = o.get("_role", "?")
        keys = SCHEMAS.get(role, [])
        compact = {k: o.get(k) for k in keys if o.get(k) is not None}
        summary.append({"round": rnd, "agent": agent, "role": role, **compact})
    if not summary:
        return ""
    dumps = lambda x: json.dumps(x, ensure_ascii=False, indent=2)
    full = dumps(summary)
    if len(full) <= PRIOR_BLOCK_LIMIT:
        return "[이전 라운드 출력]\n" + full
    budget = max(PRIOR_BLOCK_LIMIT, PRIOR_ENTRY_FLOOR * len(summary))
    needs = [len(dumps(e)) for e in summary]
    shares = _fair_shares(needs, budget)
    shrunk = [e if needs[i] <= shares[i]
              else _shrink_entry(e, max(shares[i], PRIOR_ENTRY_FLOOR))
              for i, e in enumerate(summary)]
    return ("[이전 라운드 출력] (길어서 참가자별로 줄였다. 잘린 자리는 "
            + PRIOR_CUT_MARK.strip() + " 로 표시했고, 빠진 참가자는 없다.)\n"
            + dumps(shrunk))


def run_round(round_idx, task, memory_block, prior_outputs, run_dir, skip_agents=None, roles=None, is_final_round=False):
    """skip_agents: 이전 라운드에서 실패한 provider 제외. roles: None이면 ROLES 기본.
    is_final_round: 마지막 라운드면 debater 를 reconciliation 모드로. round1 은 prior 없어 자동 독립."""
    prior_block = build_prior_block(prior_outputs)
    skip_agents = skip_agents or set()
    active_pool = [a for a in POOL if a not in skip_agents]
    if not active_pool:
        active_pool = POOL
    roles = roles or ROLES
    tasks = []
    for agent in active_pool:
        for role in roles:
            label = f"r{round_idx}.{role}.{agent}"
            prompt = role_prompt(role, task, memory_block, prior_block, round_idx=round_idx, is_final_round=is_final_round)
            tasks.append((agent, role, prompt, label))

    outputs = []
    with ThreadPoolExecutor(max_workers=len(tasks)) as ex:
        futures = {ex.submit(call_agent, a, r, p, run_dir, l): (a, r) for (a, r, p, l) in tasks}
        for f in as_completed(futures):
            o = f.result()
            o["_round"] = round_idx
            outputs.append(o)
            try:
                _log_call(o, run_dir, round_idx)
            except Exception as e:
                # 토론은 절대 안 막지만 조용히 삼키지도 않는다 — 삼키면 표본이 0 인 게
                # "콜이 없었다"인지 "계측이 깨졌다"인지 구분이 안 된다.
                print(f"[ai-debate] 계측 기록 실패({type(e).__name__}: {e})", file=sys.stderr)
    return outputs


def _truthy_sp(v):
    if isinstance(v, bool):
        return v
    if isinstance(v, str):
        return v.strip().lower() in ("true", "yes", "예", "y", "1")
    return False


def build_arbiter_block(all_outputs):
    """arbiter 입력: 전체 prior + round1 독립 원본 + minority report 를 별도 섹션으로.
    후속 라운드 수렴에 묻힌 소수의견을 arbiter 가 반드시 다시 보게 한다(2026-06-04 anti-conformity)."""
    full = build_prior_block(all_outputs)
    r1 = [o for o in all_outputs if o.get("_round") == 1 and "_error" not in o]
    r1_compact = []
    for o in r1:
        role = o.get("_role", "?")
        keys = SCHEMAS.get(role, [])
        compact = {k: o.get(k) for k in keys if o.get(k) is not None}
        r1_compact.append({"agent": o.get("_agent"), "role": role, **compact})
    deb_positions = [{"agent": o.get("_agent"), "position": o.get("position")}
                     for o in r1 if o.get("_role") == "debater"]
    minority = [{"agent": o.get("_agent"), "missed_risks": o.get("missed_risks"),
                 "reasoning": o.get("reasoning")}
                for o in r1 if o.get("_role") == "critic" and not _truthy_sp(o.get("should_proceed"))]
    parts = [full, "",
             "[ROUND1 독립 입장 — 앵커링 없이 생성된 원본. 후속 수렴에 묻지 말고 반드시 재검토]",
             json.dumps(r1_compact, ensure_ascii=False, indent=2)[:6000]]
    if deb_positions:
        parts += ["", "[ROUND1 debater 입장 목록 — 소수의견 점검용]",
                  json.dumps(deb_positions, ensure_ascii=False, indent=2)[:3000]]
    if minority:
        parts += ["", "[MINORITY REPORT — round1 비판자 반대/미해결 위험. 기각하려면 사유 명시]",
                  json.dumps(minority, ensure_ascii=False, indent=2)[:3000]]
    return "\n".join(parts)


# 히라가나·가타카나(U+3040~U+30FF)만 본다. 한국어 답에는 안 나오는 글자라 이것만으로
# 갈린다. 한자는 안 센다 — 인용으로 섞일 수 있어 오탐이 나고, 일본어 판정의 필요조건도
# 아니다. 아래 문자군의 양 끝은 그 두 코드포인트의 글자 자체다.
_KANA_RE = re.compile("[぀-ヿ]")


def non_korean_answer_fields(out):
    """답의 칸 가운데 일본어 글자가 섞인 칸 이름 목록. 없으면 빈 목록.

    2026-09-17 둘째 기계 3회차에서 정리자의 final_decision 이 일본어로 나왔다. 프롬프트에
    한국어 지시가 있어도 긴 입력 뒤에서는 그렇게 샌다. 운영자가 그대로 읽는 자리라
    조용히 내보내지 않는다(R03). 밑줄로 시작하는 칸은 계측용이라 뺀다.
    """
    bad = []
    for k, v in (out or {}).items():
        if k.startswith("_"):
            continue
        text = v if isinstance(v, str) else json.dumps(v, ensure_ascii=False)
        if _KANA_RE.search(text):
            bad.append(k)
    return bad


def run_arbiter(task, memory_block, all_outputs, run_dir):
    prior_block = build_arbiter_block(all_outputs)
    # 어떤 provider 가 의견을 0건 냈으면 arbiter 에게 그 사실을 알린다. 안 알리면
    # arbiter 는 받은 것만 보고 "세 관점을 종합했다"고 쓴다 — 있지도 않은 합의를
    # 만들어내는 것이다. 빠진 관점을 알면 결론의 확신 수위를 스스로 낮출 수 있다.
    _got = {o.get("_agent") for o in all_outputs if "_error" not in o}
    _absent = [a for a in POOL if a not in _got]
    if _absent:
        prior_block += (
            f"\n\n[관점 결손] 이번 라운드에서 {', '.join(_absent)} 는 의견을 한 건도 못 냈다"
            f"(호출 실패). 너는 {len(POOL) - len(_absent)}개 관점만 받았다. 없는 관점을 있는 것처럼"
            " 종합하지 말고, 그 결손이 결론을 바꿀 수 있는 지점이면 dissent 나 open_questions 에 적어라.")
    prompt = role_prompt("arbiter", task, memory_block, prior_block)

    def log(o, label):
        # arbiter 는 이 파이프라인에서 제일 긴 콜이고 호출자 상한(Bash 600초)에 먼저
        # 부딪히는 쪽이다. 라운드만 재고 여기를 빼면 정작 상한을 정하는 분포가 안 남는다.
        try:
            _log_call(o, run_dir, 0, label=label)
        except Exception as e:
            print(f"[ai-debate] {label} 계측 기록 실패({type(e).__name__}: {e})", file=sys.stderr)

    out = call_agent("codex", "arbiter", prompt, run_dir, "arbiter")
    log(out, "arbiter")
    bad = non_korean_answer_fields(out) if "_error" not in out else []
    if bad:
        # 정리자 호출은 이 파이프라인에서 제일 싸다 — 파일을 안 읽고 라운드 결과만 본다.
        # 운영자가 못 읽는 판정문을 그대로 내보내느니 한 번 더 부른다. 두 번째도
        # 일본어면 그 답을 버리지 않고 표시만 남긴다 — 버리면 회차가 결론 없이 끝난다.
        print(f"[ai-debate] 정리자 답의 {', '.join(bad)} 가 한국어가 아니다 — 1회 다시 부른다",
              file=sys.stderr)
        out2 = call_agent("codex", "arbiter", prompt + (
            "\n\n[다시] 방금 낸 답이 한국어가 아니었다. 판단은 그대로 두고 모든 값을 "
            "한국어로 다시 써라."), run_dir, "arbiter.ko")
        log(out2, "arbiter.ko")
        if "_error" not in out2 and not non_korean_answer_fields(out2):
            out2["_lang_retried"] = True
            return out2
        out["_lang_bad"] = bad
    return out


def run_planner(task, max_roles, run_dir):
    """auto-roles: codex가 ROLE_REGISTRY 안에서 필요한 역할 N개(≤max_roles) 선정.
    critic은 호출 측이 강제 추가하므로 planner는 제외해도 됨. 실패 시 [debater]만 반환."""
    available = [r for r in ROLE_REGISTRY.keys() if r != "critic"]
    instr = (
        "당신은 역할 플래너. 주어진 task에 대해 ai-debate 다역할 토론에서 사용할 역할을 "
        f"아래 목록에서만 최대 {max_roles}개 선택하라. 불확실하면 [debater]만 선택. "
        "critic은 자동 강제 추가되므로 선택할 필요 없음. integrator는 사용 금지(arbiter와 중복).\n"
        f"가능한 역할: {', '.join(available)}\n"
        "출력은 다음 JSON만:\n"
        '{"roles": ["debater", ...], "reasoning": "<짧게>"}'
    )
    # 플래너는 역할만 고른다 — 파일을 읽을 이유가 없다. 그런데 이 함수는 call_agent 를
    # 안 거쳐서 사본도 안 뜨고 경로 치환도 안 탄다. 원문 task 를 그대로 넘기면 --auto-roles
    # 회차에서만 codex 가 원본 절대경로를 받고 이 세션의 작업 디렉토리에서 시작했다
    # (2026-09-15 지적). 경로는 지우고 이 런 전용 빈 디렉토리에서 돌린다.
    safe_task = _ABS_PATH_RE.sub("<경로 생략>", task or "")
    prompt = instr + "\n\n[task]\n" + safe_task
    label = "planner"
    raw_path = run_dir / f"{label}.raw.txt"
    prompt_path = run_dir / f"{label}.prompt.txt"
    prompt_path.write_text(prompt, encoding="utf-8")
    pcwd = run_dir / "planner-cwd"
    pcwd.mkdir(parents=True, exist_ok=True)
    try:
        proc = subprocess.run(
            ["codex-ask", "--new", "--cd", str(pcwd), "위 지시대로 JSON만 출력"],
            input=prompt, capture_output=True, text=True,
            timeout=TIMEOUT, cwd=str(pcwd),
            env={**os.environ, "AI_OUT_RAW": "1", "CODEX_ASK_EFFORT": CODEX_EFFORT_ROUND},
        )
        raw_path.write_text(proc.stdout + ("\n[stderr]\n" + proc.stderr if proc.stderr.strip() else ""),
                            encoding="utf-8")
        if proc.returncode != 0:
            return ["debater"]
        obj = parse_json_loose(proc.stdout, ["roles", "reasoning"])
        if not obj or "roles" not in obj:
            return ["debater"]
        picked = [r for r in obj["roles"] if r in ROLE_REGISTRY and r != "critic"]
        if not picked:
            return ["debater"]
        return picked[:max_roles]
    except Exception:
        return ["debater"]


def select_roles(task, args, run_dir):
    """반환: (roles 리스트, source 라벨). critic은 항상 끝에 추가."""
    explicit = (args.roles or "").strip()
    if explicit:
        items = [r.strip() for r in explicit.split(",") if r.strip()]
        unknown = [r for r in items if r not in ROLE_REGISTRY]
        if unknown:
            print(f"ERROR: 알 수 없는 역할: {unknown}. 가능: {list(ROLE_REGISTRY.keys())}", file=sys.stderr)
            sys.exit(2)
        roles = [r for r in items if r != "critic"]
        if "critic" not in roles:
            roles.append("critic")
        return roles, "explicit"
    if args.auto_roles:
        picked = run_planner(task, args.max_roles, run_dir)
        roles = [r for r in picked if r != "critic"]
        if "critic" not in roles:
            roles.append("critic")
        return roles[:args.max_roles + 1], "auto"  # +1 for critic
    # 무옵션: 기존 호환 — debater+critic 그대로
    return ["debater", "critic"], "default"


# --- PROVIDER 헬스 진단 (2026-06-08) ---
# arbiter(codex)가 죽어도 떠야 하므로 per-provider raw 파일을 독립 스캔한다.
# 어느 AI가 / 왜 / 해결법을 사람이 바로 알 수 있게 결과에 같이 출력.
import re as _re_health

_HEALTH_SIGS = [
    # 한도 소진을 인증 실패보다 먼저 본다. 둘 다 "안 돌아간다" 로 보이지만 처방이 정반대라
    # (재로그인 vs 기다리기) 순서가 곧 오진이다. 2026-08-17 에 codex 한도 소진을 "재로그인
    # 필요" 로 안내했다 — 재로그인해도 안 풀리는 상태였다.
    (r"usage limit|hit your (?:usage )?limit|out of credits|purchase more credits",
     "사용 한도 소진", "쿼터 소진 — 재로그인해도 안 풀린다. raw 의 재시도 가능 시각까지 기다리거나 크레딧 충전."),
    # 숫자만으로는 신호가 아니다. 401·403·429 는 참여자가 붙여넣은 코드의 줄번호·
    # 상수로 그대로 나온다 — 2026-09-16 run-20260916T001520Z 에서 코덱스가 인용한
    # C++ 발췌의 줄번호가 인증 만료로 읽혀 "재로그인 필요" 오진이 나갔다. 그래서
    # 앞이나 뒤에 HTTP 문맥 낱말이 붙어 있을 때만 본다.
    (r"invalid_grant|reauth|re-?authenticate|not logged in|로그인 필요|unauthor|permission denied|authentication required"
     r"|(?:http|status|code|err(?:or)?)[^\n]{0,12}\b40[13]\b"
     r"|\b40[13]\b[^\n]{0,24}(?:unauthorized|forbidden|권한)",
     "인증 만료/실패", "REAUTH"),
    (r"authentication timed out|auth[^\n]{0,20}tim(e|ed)\s?out",
     "인증 타임아웃", "REAUTH"),
    (r"RESOURCE_EXHAUSTED|quota|rate.?limit|too many requests"
     r"|(?:http|status|code|err(?:or)?)[^\n]{0,12}\b429\b"
     r"|\b429\b[^\n]{0,24}(?:too many requests|rate)",
     "쿼터/레이트리밋", "쿼터·레이트리밋 — 잠시 후 재시도(공유 계정 한도 가능)."),
    (r"tim(e|ed)\s?out|timeout|deadline exceeded",
     "타임아웃", "네트워크/일시 hang — 재시도, 반복되면 재인증."),
    (r"JSON parse failed|could not parse|parse error",
     "출력 파싱 실패", "JSON 아닌 출력 — 일시 이상, 재시도."),
]
_REAUTH_FIX = {
    "gemini": "gemini(agy/antigravity) 재인증: 터미널에서 재로그인. invalid_grant 면 ~/.config/gcloud 잔재 정리 후 재로그인.",
    "codex": "codex 재로그인 필요(codex CLI 재인증). ※ arbiter=codex — codex 죽으면 최종 정리(아비터) 불가하니 우선 복구.",
    "claude": "claude 인증 점검(로그인 파일은 전 세션 공용).",
    # agy 로 옮긴 자리는 클로드 코드 로그인과 무관하다 — 그쪽 안내를 주면 엉뚱한 데를 고친다.
    "claude-opus": "이 자리는 agy(안티그래비티) 통로다. 클로드 코드 로그인이 아니라 "
                   "agy 재인증·구글 계정 등급·agy models 목록을 본다.",
}


_OWN_SRC_CACHE = []


def _own_source_lines():
    """이 파일 자신의 줄 집합. 진단 blob 에서 걷어내려고 쓴다.

    증상 정규식이 이 파일 안에 글자 그대로 적혀 있어서, 브리프가 이 도구를 지목하면
    참여자가 그 줄을 답변에 인용하고 규칙이 자기 정의에 걸린다. 2026-09-15
    run-20260915T055119Z 에서 코덱스가 사본을 정상으로 읽었는데 회차 기록에
    '파일 읽기 불가(샌드박스)' 가 찍혔다 — 인용된 줄이 _SANDBOX_SIG 정의였다.
    이 파일의 줄은 어떤 경우에도 실행 중 고장의 증거가 아니므로 통째로 뺀다.
    """
    if _OWN_SRC_CACHE:
        return _OWN_SRC_CACHE[0]
    try:
        src = Path(__file__).read_text(encoding="utf-8", errors="ignore")
    except OSError:
        return frozenset()
    # 짧은 줄(닫는 괄호 따위)은 우연히 겹쳐 남의 출력까지 지울 수 있어 뺀다.
    got = frozenset(s for s in (ln.strip() for ln in src.splitlines()) if len(s) >= 16)
    _OWN_SRC_CACHE.append(got)
    return got


def _diag_blob(run_dir, agent):
    """해당 agent 의 raw 를 합치되 진단에 쓰면 안 되는 텍스트를 걷어낸 본문."""
    import glob as _glob
    own = _own_source_lines()
    texts = []
    pats = [str(run_dir / f"*.{agent}.raw.txt"), str(run_dir / f"*.{agent}.retry.raw.txt")]
    if agent == "codex":
        pats.append(str(run_dir / "arbiter.raw.txt"))
        pats.append(str(run_dir / "planner.raw.txt"))
    for pat in pats:
        for fp in _glob.glob(pat):
            try:
                body = open(fp, encoding="utf-8", errors="ignore").read()
            except Exception:
                continue
            # raw 에는 우리가 보낸 프롬프트가 그대로 되울린다. 그 안의 단어까지 증상으로
            # 세면 토론 주제가 진단을 오염시킨다 — 2026-08-17 에 프롬프트에 있던
            # "Permission Denied" 를 잡아 한도 소진을 인증 실패로 안내했다.
            try:
                echoed = open(fp.replace(".raw.txt", ".prompt.txt"), encoding="utf-8", errors="ignore").read()
                if echoed.strip():
                    body = body.replace(echoed, "")
            except Exception:
                pass
            if own:
                body = "\n".join(ln for ln in body.splitlines() if ln.strip() not in own)
            texts.append(body)
    return "\n".join(texts)


def _scan_raw_for_cause(run_dir, agent):
    """해당 agent 의 모든 raw 파일을 합쳐 첫 매칭 시그니처 반환. (label, fix) 또는 None."""
    blob = _diag_blob(run_dir, agent)
    if not blob.strip():
        return None
    for rx, label, fix in _HEALTH_SIGS:
        if _re_health.search(rx, blob, _re_health.IGNORECASE):
            resolved = (_REAUTH_FIX.get(agent) or _REAUTH_FIX.get(agent.split("-")[0], "재인증/재시도 필요.")) if fix == "REAUTH" else fix
            return (label, resolved)
    return None


# 파일을 못 읽는 건 실패로 안 잡힌다 — agent 는 계약대로 "못 읽었다" 며 유효한 JSON 을
# 내므로 ok 로 세어진다. 그래서 경로 브리프에서 조용히 의견 하나가 빠진다. 2026-08-17
# 둘째 기계 run-20260817T141357Z: codex 가 bwrap loopback 실패로 사본을 세 번 다 못 읽었고,
# arbiter 도 codex 라 gemini 가 낸 정답이 있는데 최종이 보류로 닫혔다.
_SANDBOX_SIG = r"bwrap:|Failed RTM_NEWADDR|landlock|seccomp[^\n]{0,20}denied"


def _codex_configured_model():
    """~/.codex/config.toml 의 model 값. 못 읽으면 빈 문자열."""
    try:
        for line in (Path.home() / ".codex" / "config.toml").read_text(
                encoding="utf-8", errors="ignore").splitlines():
            s = line.strip()
            if s.startswith("model") and "=" in s and not s.startswith("model_"):
                return s.split("=", 1)[1].strip().strip('"').strip("'")
            if s.startswith("["):  # 섹션 시작 전 최상위 키만 본다
                break
    except OSError:
        pass
    return ""


_META_KEYS = {"_agent", "_role", "_round", "_duration", "_error", "_raw",
              "_snap_read", "_partial_timeout", "_first_error"}


def output_is_valid(o):
    """이 콜이 실제 의견 하나인가.

    아닌 것 셋. 오류로 끝난 콜, 알맹이가 없는 빈 응답, 그리고 모델이 조용히 바뀐 콜
    (claude 미인식 모델은 호출 자리에서 이미 _error 로 돌린다).

    본문에 오류를 뜻하는 낱말이 있다는 이유로 실패시키지 않는다 — 오류를 설명하는
    정상 답변이 있고, 2026-08-17 에 프롬프트 안 문구를 증상으로 세어 한도 소진을
    인증 실패로 오진한 적이 있다. 판정은 종료 상태와 응답 구조로만 한다.

    모델을 회차에서 확인할 수 없는 참가자(codex·gemini)는 미확인이지 실패가 아니다.
    미확인을 실패로 돌리면 멀쩡한 토론이 통째로 막힌다.
    """
    if not isinstance(o, dict) or "_error" in o:
        return False
    for k, v in o.items():
        if k in _META_KEYS or k.startswith("_"):
            continue
        if isinstance(v, str):
            if v.strip():
                return True
        elif isinstance(v, (list, dict, tuple, set)):
            if len(v) > 0:
                return True
        elif v is not None:
            return True
    return False


CODEX_AUTH = os.environ.get("AI_DEBATE_CODEX_AUTH",
                            os.path.join(HOME_DIR, ".codex", "auth.json"))


def preflight_stop():
    """착수 전에 멈춰야 하는 결손만 본다. 멈출 이유가 없으면 빈 문자열.

    보는 것은 정리자(codex) 하나다. 정리자가 없으면 라운드를 다 돌려도 결론이 안
    나오므로 유료 호출을 쓰기 전에 멈추는 것이 맞다. 반대로 참가자 한 명의 인증
    결손으로는 멈추지 않는다 — 그렇게 하면 쓸 수 있는 두 명의 토론까지 사라진다
    (판정 run-20260909T071423Z).

    여기서는 유료 호출을 하지 않는다. 로컬 파일 존재로 확인되는 것만 보고, 나머지는
    실제 호출 결과로 판정한다. 제미나이는 자격 파일 위치가 호스트마다 달라(둘째 기계엔
    ~/.antigravity 자체가 없다) 로컬로 확인할 방법이 없으므로 보지 않는다.
    """
    if not os.path.exists(CODEX_AUTH):
        return ("착수 전 중단: 정리자(codex) 자격 파일이 없다 — %s. "
                "정리자가 없으면 라운드를 다 돌려도 결론이 안 나온다. "
                "복구: %s" % (CODEX_AUTH, _REAUTH_FIX["codex"]))
    return ""


def valid_by_round(all_outputs):
    """라운드별로 유효한 의견을 낸 참가자 집합. arbiter 는 참가자가 아니다."""
    per = {}
    for o in all_outputs:
        a = o.get("_agent") or ""
        if not a or a == "arbiter":
            continue
        r = o.get("_round")
        if r is None:
            continue
        s = per.setdefault(r, set())
        if output_is_valid(o):
            s.add(a)
    return per


def deficit_header(run_dir, all_outputs):
    """결손을 한 줄로 적는다. 적을 것이 없으면 빈 문자열.

    이 줄은 세 자리에 같은 문자열로 들어간다 — 사람이 읽는 결론의 첫 줄, 세션에
    주입되는 요약의 첫 줄, 그리고 metering.json. 세 자리가 어긋나면 읽는 쪽이 어느
    것을 믿을지 갈린다. 결손이 요약·길이 제한을 지나며 사라지지 않게 맨 앞에 둔다.

    결손으로 보는 것 둘. 풀에 있는데 유효한 의견이 0건인 참가자, 그리고 어느
    라운드든 유효 인원이 풀 인원보다 적은 것. 뒤의 것이 없으면 라운드 중 탈락이
    누적 인원에 가려진다.

    여기에 하나를 더 싣는다. 코덱스가 한도 소진으로 예비 모델로 답한 호출이다.
    참가자가 빠진 것은 아니지만 결론을 낸 모델이 바뀐 것이라 결론의 무게가 달라진다.
    """
    stats = {}
    for o in all_outputs:
        a = o.get("_agent") or ""
        if not a or a == "arbiter":
            continue
        st = stats.setdefault(a, [0, 0])
        st[0 if output_is_valid(o) else 1] += 1
    missing = [a for a in POOL if stats.get(a, [0, 0])[0] == 0]
    per_round = valid_by_round(all_outputs)
    thin = {r: len(s) for r, s in sorted(per_round.items()) if len(s) < len(POOL)}
    # 예비 모델로 답한 호출은 결손이 없어도 여기 적는다. 계측 파일은 설계상 알림이
    # 없어서, 거기만 적으면 낮은 모델이 낸 결론을 평소 모델의 판정으로 읽게 된다.
    # 정리자가 예비였는지를 따로 말한다 — 결론을 쓰는 자리라 무게가 다르다.
    fb_model, fb_calls = codex_fallback_info(run_dir)
    fb = ""
    if fb_model:
        arb = any(c.startswith("arbiter") for c in fb_calls)
        fb = (f"!! 코덱스 한도 소진으로 예비 모델 {fb_model} 이 답한 호출 {len(fb_calls)}건"
              f"({'정리자 포함' if arb else '정리자 제외'}: {', '.join(fb_calls)}). "
              f"평소 모델 {codex_model()} 보다 능력이 낮으니 그만큼 낮춰 읽는다.")
    if not missing and not thin:
        return fb

    valid_agents = sorted(a for a in POOL if stats.get(a, [0, 0])[0] > 0)
    parts = ([fb] if fb else [])
    parts += [f"!! 결손: 예정 {len(POOL)}명({', '.join(POOL)}) 중 의견을 낸 참가자 "
             f"{len(valid_agents)}명({', '.join(valid_agents) or '없음'})."]
    if per_round:
        parts.append("라운드별 유효 인원 "
                     + " ".join(f"R{r}={len(s)}" for r, s in sorted(per_round.items())) + ".")
    for a in missing:
        cause = _scan_raw_for_cause(run_dir, a)
        if cause:
            parts.append(f"빠진 참가자 {a} — 원인 {cause[0]}, 복구 {cause[1]}")
        else:
            parts.append(f"빠진 참가자 {a} — 원인 불명, 복구 원문 확인 {run_dir}/*.{a}.raw.txt")
    # 모델은 기록값이다. 회차에서 실제로 무엇이 답했는지는 이 자리에서 확인하지 않는다 —
    # 확인한 값처럼 적으면 어긋났을 때 잘못된 안심을 준다(2026-09-09 강도 표시 건과 같은 이유).
    _arb_model = codex_model()
    parts.append(f"기록된 모델 codex={effective_codex_model()} "
                 + (f"(정리자는 {_arb_model}) " if _arb_model != effective_codex_model() else "")
                 + f"gemini={gemini_model()} "
                 f"claude={','.join(CLAUDE_MODELS[a] for a in POOL if a in CLAUDE_MODELS)} "
                 + (f"(agy 통로: {','.join(a for a in POOL if a in CLAUDE_VIA_AGY)}) "
                    if any(a in CLAUDE_VIA_AGY for a in POOL) else "")
                 + "(기록값이고 회차에서 확인한 값이 아니다).")
    return " ".join(parts)


def provider_health_lines(run_dir, all_outputs, arb=None):
    """provider별 ok/fail + 실패 원인·해결법. 문제 있을 때만 라인 반환."""
    stats = {}
    for o in all_outputs:
        a = o.get("_agent")
        if not a or a == "arbiter":
            continue
        s = stats.setdefault(a, [0, 0])
        s[1 if "_error" in o else 0] += 1
    lines = []
    for agent in sorted(stats):
        ok, fail = stats[agent]
        if fail == 0:
            continue
        cause = _scan_raw_for_cause(run_dir, agent)
        if cause:
            label, fix = cause
            lines.append(f"  {agent}: {label} ({ok}ok/{fail}fail) → {fix}")
        else:
            lines.append(f"  {agent}: 실패 ({ok}ok/{fail}fail) 원인 불명 → raw 확인: {run_dir}/*.{agent}.raw.txt")
    # 성공한 콜이어도 샌드박스 때문에 파일을 못 읽었으면 별도로 집계한다.
    # 위 루프는 fail>0 일 때만 도는데, 이 고장은 fail 을 안 만든다.
    for agent in sorted(stats):
        blob = _diag_blob(run_dir, agent)
        if blob and _re_health.search(_SANDBOX_SIG, blob, _re_health.IGNORECASE):
            lines.append(f"  {agent}: 파일 읽기 시도가 샌드박스로 실패했다 → 재로그인으로는 안 풀린다. "
                         f"같은 명령을 다시 실행하면 대개 열린다(2026-09-16 실측 다섯 중 셋). "
                         f"그 agent 가 무엇을 근거로 답했는지 {run_dir}/*.prompt.txt 와 같이 보고 판단해라. "
                         f"raw 확인: {run_dir}/*.{agent}.raw.txt")

    # arbiter(codex) 별도 강조
    if arb is not None and isinstance(arb, dict) and "_error" in arb:
        cause = _scan_raw_for_cause(run_dir, "codex")
        fix = cause[1] if cause else _REAUTH_FIX["codex"]
        lab = cause[0] if cause else arb.get("_error", "실패")
        lines.append(f"  ARBITER(codex): {lab} → {fix}")
    # codex 가 실패했을 때만 어떤 codex 였는지 붙인다. 2026-08-18 사고의 원인은 코드가
    # 아니라 세션마다 다른 codex 경로였는데, 그 사실이 어디에도 안 남아서 몇 시간을 썼다.
    # 성공한 run 에는 안 붙인다 — 아무도 안 읽는 필드는 만들지 않는다.
    if lines and (stats.get("codex", [0, 0])[1] > 0
                  or (arb is not None and isinstance(arb, dict) and "_error" in arb)):
        try:
            w = subprocess.run(["codex-ask", "--which"], capture_output=True,
                               text=True, timeout=30)
            wl = (w.stdout or w.stderr or "").strip().splitlines()
            if wl:
                lines.append(f"  codex 환경: {wl[0]}")
        except Exception as e:
            lines.append(f"  codex 환경: 확인 실패 ({type(e).__name__}) — codex-ask 자체가 안 돈다")
    if lines:
        return ["[PROVIDER 헬스] 일부 AI 실패·결함 — 원인·해결:"] + lines
    return []


def render_arbiter(arb, run_dir, all_outputs, _p):
    """arbiter 결과를 사람이 읽는 형태로 찍는다. 판정이 없으면 False."""
    if "_error" in arb:
        _p(f"ARBITER FAILED: {arb['_error']}")
        for hl in provider_health_lines(run_dir, all_outputs, arb):
            _p(hl)
        # 결론이 없는 실행은 성공이 아니다. 예전에는 이 자리에서 그냥 return 해서
        # 종료코드가 0 이었다 — 호출자가 rc 만 보면 정상 완료로 읽는다.
        return False
    _p("--- ARBITER (codex) ---")
    if arb.get("_lang_bad"):
        # 다시 부르고도 한국어가 아니면 내용을 버리지 않고 표시만 남긴다. 운영자에게
        # 옮길 때 이 줄을 같이 보라는 뜻이다 — 그대로 복사하면 R03 위반이 된다.
        _p("경고: 판정문이 한국어가 아니다(" + ", ".join(arb["_lang_bad"])
           + "). 다시 불러도 같았다 — 운영자에게 옮길 때 그대로 옮기지 마라.")
    fd = arb.get("final_decision", "")
    if isinstance(fd, str) and not fd.strip():
        # arbiter 가 JSON 은 냈는데 결정문이 비었으면 그건 결론이 아니다.
        # 예전에는 "(no decision)" 을 결론 자리에 찍어서 읽는 사람이 판정으로 오해했다.
        _p("ARBITER FAILED: 판정문이 비어 있다(JSON 은 왔지만 final_decision 없음). "
           f"원문: {run_dir}/arbiter.raw.txt")
        for hl in provider_health_lines(run_dir, all_outputs, arb):
            _p(hl)
        return False
    _p(f"FINAL: {fd}")
    rationale = arb.get("rationale", "")
    if rationale:
        _p(f"  rationale: {rationale}")
    steps = arb.get("action_steps")
    if steps:
        if isinstance(steps, list):
            _p("  action_steps:")
            for s in steps:
                _p(f"    - {s}")
        else:
            _p(f"  action_steps: {steps}")
    vp = arb.get("verification_plan")
    if vp:
        _p(f"  verification_plan: {vp}")
    dt = arb.get("delegation_target")
    if dt:
        _p(f"  delegation_target: {dt}")
    sc = arb.get("stop_condition")
    if sc:
        _p(f"  stop_condition: {sc}")
    # 신규 다역할 필드 (있으면 출력)
    for k in ("risks", "open_questions", "role_coverage", "call_budget_used", "minority_survived"):
        v = arb.get(k)
        if v:
            if isinstance(v, list):
                _p(f"  {k}:")
                for s in v:
                    _p(f"    - {s}")
            else:
                _p(f"  {k}: {v}")
    dissent = arb.get("dissent")
    if dissent:
        _p(f"  dissent: {dissent}")
    return True


def run_arbiter_only(run_dir_arg):
    """이미 끝난 라운드 결과로 arbiter 만 다시 돌린다.

    라운드 3의견을 다 받아놓고 arbiter 한 콜이 호출자 상한(Bash 도구 600초)을 넘겨
    통째로 버려지는 일이 하루에 두 번 있었다. 라운드는 이미 파일에 있으니 다시 돌릴
    이유가 없다 — 없는 것은 판정뿐이다.
    """
    run_dir = Path(run_dir_arg).expanduser().resolve()
    task_path = run_dir / "task.txt"
    if not task_path.exists():
        print(f"ERROR: {run_dir} 에 task.txt 가 없다. ai-debate run 디렉토리가 맞나.", file=sys.stderr)
        return 2
    task = task_path.read_text(encoding="utf-8")
    # 이 경로도 call_agent 를 타므로 사본 대상 목록이 있어야 한다. 안 채우면 브리프
    # 경로까지 "브리프에 없는 경로" 로 막혀 중재자가 아무것도 못 읽는다.
    set_brief_paths(task)
    outs = []
    for p in sorted(run_dir.glob("r*.outputs.json")):
        try:
            outs.extend(json.loads(p.read_text(encoding="utf-8")))
        except (OSError, ValueError) as e:
            print(f"ERROR: {p} 를 못 읽었다 ({type(e).__name__}).", file=sys.stderr)
            return 2
    if not outs:
        print(f"ERROR: {run_dir} 에 r*.outputs.json 이 없다 — 이어붙일 라운드 결과가 없다.", file=sys.stderr)
        return 2
    ok = sum(1 for o in outs if "_error" not in o)
    rounds_done = max((o.get("_round", 1) for o in outs), default=1)
    print(f"[ai-debate] arbiter-only: {run_dir.name} 라운드 {rounds_done}, 의견 {ok}/{len(outs)}콜 재사용",
          file=sys.stderr)
    arb = run_arbiter(task, "", outs, run_dir)
    all_outputs = outs + [arb]
    # 결손 판정은 풀을 기준으로 한다. 이 경로는 --deep 플래그 없이 불리므로 그대로
    # 재면 깊은 회차의 늘어난 자리가 풀에 없어 그 결손이 안 보인다. 원래 회차의
    # 값은 meta.json 에 적혀 있으니 그걸 되살린 뒤에 잰다.
    try:
        _meta = json.loads((run_dir / "meta.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        _meta = {}
    if _meta.get("deep"):
        deep_on(True)
    if isinstance(_meta.get("pool"), list) and _meta["pool"]:
        global POOL
        POOL = list(_meta["pool"])
    _deficit = deficit_header(run_dir, all_outputs)
    if _deficit:
        print(_deficit, file=sys.stderr)
    (run_dir / "final_result.json").write_text(json.dumps({
        "run_id": run_dir.name.replace("run-", ""), "run_dir": str(run_dir),
        "rounds_done": rounds_done, "consensus_reached": None,
        "arbiter_only": True, "deficit": _deficit, "outputs": all_outputs,
    }, ensure_ascii=False, indent=2), encoding="utf-8")
    return 0 if render_arbiter(arb, run_dir, all_outputs, print) else 5


def main():
    ap = argparse.ArgumentParser(description="ai-debate: 멀티 AI 합의 토론")
    ap.add_argument("task", nargs="?", help="토론할 task (--log-summary 시 생략 가능)")
    ap.add_argument("--max-rounds", type=int, default=2, help="기본 2라운드. --deep 시 최대 3(미합의 시 조건부 4~5).")
    ap.add_argument("--deep", action="store_true",
                    help="깊은 모드: 클로드 자리를 Fable+Opus 둘로 늘리고(참가자 4), 코덱스 모델을 "
                         "gpt-6-astra 로 올린다. 추론 강도는 평소와 같은 high 다. 최대 3라운드 + "
                         "다양성/반증 강화, 미합의·고불확실 시에만 4~5 adaptive escalation.")
    ap.add_argument("--seed", type=int, default=None)
    ap.add_argument("--with-memory", action="store_true", help="프로젝트 메모리 주입 (기본: off)")
    ap.add_argument("--no-cache", action="store_true", help="24h 캐시 무시하고 새로 토론")
    ap.add_argument("--roles", default=None,
                    help=f"명시 역할 (쉼표). critic 자동 추가. 가능: {','.join(ROLE_REGISTRY.keys())}")
    ap.add_argument("--auto-roles", action="store_true",
                    help="planner LLM이 task 보고 자동 선정 (critic 자동 추가)")
    ap.add_argument("--max-roles", type=int, default=4, help="자동선정 시 역할 상한 (기본 4)")
    # default=None 인 이유는 아래 깊은 모드의 상향 때문이다. 기본값을 24 로 박아 두면
    # 사용자가 직접 적은 값인지 안 적어서 24 인지를 가릴 수 없어서, 30 을 적어도 50 으로
    # 덮어썼다(2026-10-01 실측 확인). 안 적었을 때만 올린다.
    ap.add_argument("--max-total-calls", type=int, default=None,
                    help="planner 포함 총 콜 예산 (기본 24, --deep 은 80). 초과 시 시작 전 중단.")
    ap.add_argument("--dry-run", action="store_true",
                    help="planner+선택역할+예상콜수만 출력, 실제 에이전트 호출 안 함")
    ap.add_argument("--arbiter-only", default=None, metavar="RUN_DIR",
                    help="이미 끝난 run 디렉토리의 라운드 결과로 arbiter 만 다시 돌린다 "
                         "(라운드 재실행 없음). 호출자 상한에 걸려 판정만 못 받은 run 회수용.")
    ap.add_argument("--log-summary", nargs="?", const="", default=None, metavar="PATH",
                    help="계측 로그(JSONL) provider별 요약 출력 후 종료. PATH 생략 시 AIDEBATE_LOG_PATH.")
    args = ap.parse_args()
    # 계측 로그 요약 모드: 토론 안 하고 집계만 출력하고 종료.
    if args.log_summary is not None:
        sys.exit(do_log_summary(args.log_summary or None))
    if args.arbiter_only:
        sys.exit(run_arbiter_only(args.arbiter_only))
    if not args.task:
        ap.error("task 인자가 필요합니다 (또는 --log-summary <PATH>).")
    # --deep: 기본 최대 3라운드(다양성·반증 강화). 4~5는 adaptive escalation 으로만.
    # MAD groupthink/Degeneration-of-Thought 연구 반영 (2026-06-04 ai-debate run-20260604T085529Z).
    deep_escalate_max = args.max_rounds
    # 모델·강도 층도 같이 올린다(2026-09-28). 라운드만 늘리는 깊은 모드는 같은 능력으로
    # 더 오래 말하는 것이라, 능력에서 막힌 문제는 라운드를 늘려도 그대로 막힌다.
    deep_on(args.deep)
    if args.deep:
        args.max_rounds = max(args.max_rounds, 3)
        deep_escalate_max = max(args.max_rounds, 5)
    # 예산 기본값: 평소 24, 깊은 회차 80. 깊은 회차의 풀은 여섯이라(코덱스 둘·클로드 둘·
    # 제미나이 둘) 세 모양이 갈린다 — 역할 둘이면 5라운드 확장까지 61, 역할 넷이면 3라운드에
    # 73, 역할 넷이 5라운드까지 늘면 121 이다. 80 은 앞 둘을 통과시키고 마지막만 막는다.
    # 마지막은 한 회차에 백 번 넘게 부르는 모양이라 막는 쪽이 맞고, 정말 필요하면 그때
    # --max-total-calls 를 직접 올려 적는다.
    # 사용자가 직접 적었으면 그 값을 그대로 쓴다 — 적은 값을 올려 버리면 상한을 낮추려는
    # 의도가 통째로 사라진다.
    if args.max_total_calls is None:
        args.max_total_calls = 80 if args.deep else 24

    task = args.task
    # stdin pipe 로 컨텍스트가 들어온 경우에만 합친다. 백그라운드 실행 시 stdin 이
    # tty 아니면서 EOF 도 안 오는 열린 fd 면 read() 가 영구 블록 → select 로 데이터
    # 실제 대기 중일 때만 읽는다. (2026-06-04 자동응답 런 무한 hang 사고 후 가드 추가.)
    if not sys.stdin.isatty():
        import select
        try:
            ready, _, _ = select.select([sys.stdin], [], [], 0.5)
        except (ValueError, OSError):
            ready = []
        if ready:
            stdin_data = sys.stdin.read().strip()
            if stdin_data:
                task = stdin_data + "\n\n---\n\n" + task

    # 자료 점검은 캐시보다 먼저 한다. 캐시 적중은 아래에서 바로 반환하므로, 점검을
    # 뒤에 두면 필수 자료가 빠진 브리프가 캐시를 타고 조용히 답을 받는다.
    _usable0, _bad0 = classify_brief_paths(task)
    if _bad0 and not _usable0:
        print(brief_path_abort_message(_bad0), file=sys.stderr)
        return 2
    _roles0 = brief_path_roles(task)
    _bad_req0 = [(_p, _why) for _p, _why in _bad0 if _roles0.get(_p, "필수") == "필수"]
    if _bad_req0:
        print(brief_required_abort_message(_bad_req0), file=sys.stderr)
        return 2

    # 24h 캐시 검사 (--no-cache 또는 --seed 명시 시 우회)
    if args.no_cache:
        print("[ai-debate] --no-cache: 캐시 lookup/write 모두 skip", file=sys.stderr)
    if not args.no_cache and args.seed is None:
        import hashlib
        cache_key_src = json.dumps({
            "task": task,
            "max_rounds": args.max_rounds,
            "with_memory": args.with_memory,
            # 경로 브리프는 task 글자가 그대로여도 가리키는 파일이 바뀐다. 그걸 안 넣으면
            # 코드를 고치고 같은 질문을 다시 던졌을 때 옛 코드에 대한 결론이 캐시에서
            # 그대로 나온다 — 24시간짜리 조용한 오답이다. (2026-08-18)
            "brief_state": brief_state_fingerprint(task),
            # 같은 질문이라도 깊은 모드는 다른 참가자·다른 강도가 답한 다른 결론이다.
            # 라운드 수만으로는 안 갈린다 — --max-rounds 3 과 --deep 이 같은 3 이 된다.
            # 모델 이름도 같이 넣는다. 풀 이름("gemini"·"claude-opus")은 자리 이름이라
            # 그 자리에 어떤 세대가 들어갔는지를 안 가린다 — 모델을 올린 날 같은 브리프를
            # 다시 던지면 옛 세대가 답한 결론이 24시간 동안 그대로 나온다. (2026-10-15)
            "tier": {"deep": DEEP,
                     "pool": POOL,
                     "claude_effort": claude_effort(),
                     "codex_model": effective_codex_model(),
                     "gemini_model": gemini_model(),
                     "claude_models": [CLAUDE_MODELS[a] for a in POOL if a in CLAUDE_MODELS],
                     "claude_via_agy": sorted(a for a in POOL if a in CLAUDE_VIA_AGY)},
        }, ensure_ascii=False, sort_keys=True)
        # 16→32 hex (128bit) 로 확장. 운영자 reports of cross-topic cache hit (V25 vs COIN-LIO)
        # 후 16-char (64bit) 충돌 가능성 배제용. 2026-05-28.
        cache_key = hashlib.sha256(cache_key_src.encode("utf-8")).hexdigest()[:32]
        cache_path = CACHE_DIR / f"{cache_key}.json"
        if cache_path.is_file() and (time.time() - cache_path.stat().st_mtime) < CACHE_TTL_SEC:
            try:
                cached = json.loads(cache_path.read_text(encoding="utf-8"))
                age_min = int((time.time() - cache_path.stat().st_mtime) / 60)
                cached_task_preview = (cached.get("task_preview") or "(no-task-stored)").replace("\n", " ")[:240]
                current_task_preview = task.replace("\n", " ")[:240]
                print(f"=== ai-debate CACHE HIT (age {age_min}min, ttl {CACHE_TTL_SEC//3600}h, key {cache_key[:16]}) ===")
                print(f"original run: {cached.get('run_id','?')}")
                print(f"cached task : {cached_task_preview}")
                print(f"current task: {current_task_preview}")
                if cached.get("task_sha256") and cached["task_sha256"] != hashlib.sha256(task.encode("utf-8")).hexdigest():
                    print("[ai-debate] WARNING: task SHA mismatch — cache poisoning 의심. --no-cache 로 재토론 권장.", file=sys.stderr)
                print("--no-cache 로 강제 재토론 가능.")
                print()
                print(cached.get("summary_text", "(empty)"))
                return
            except Exception:
                pass  # cache 깨졌으면 재토론

    seed = args.seed if args.seed is not None else int(time.time())
    rng = random.Random(seed)  # reserved for future role rotation seed
    del rng

    # 기본: 프로젝트 메모리 주입 안 함 (쓸데없는 정보가 토론 품질을 떨어뜨림).
    # 명시적으로 --with-memory 줬을 때만 주입. 컨텍스트 필요하면 task에 직접 쓰거나 stdin으로 첨부.
    memory_block = project_memory() if args.with_memory else ""

    # 착수 전 점검. 유료 호출 0회로 확인되는 결손만 보고, 걸리면 아무것도 안 쓰고
    # 호출자에게 비정상 종료로 알린다.
    _pf = preflight_stop()
    if _pf:
        print(_pf, file=sys.stderr)
        sys.exit(6)

    run_started_epoch = time.time()   # 계측 시간창 시작(transcript 귀속용)
    run_dir, run_id = make_run_dir(RUN_BASE, now_iso())
    # 조기 exit·예외로 끝나도 사본은 남기지 않는다. 무결성 검증은 원본만 보므로 순서 무관.
    import atexit
    atexit.register(cleanup_snapshots, run_dir)
    (run_dir / "task.txt").write_text(task, encoding="utf-8")

    # 사본을 떠도 되는 경로를 여기서 한 번 확정한다. 이후 어떤 호출도 이 목록 밖의
    # 경로를 열지 않는다 — 참여자 답변에 적힌 경로가 다음 호출에서 열리는 길을 끊는다.
    set_brief_paths(task)

    # 브리프에 절대경로가 없으면 참여자는 파일을 한 줄도 못 읽는다 — 사본은 브리프에서
    # 찾은 경로로만 뜨기 때문이다. 2026-09-15 둘째 기계 run-20260915T045627Z 가 그렇게
    # 돌았고 snapshot 디렉토리 자체가 없었다. 막지는 않는다: 순수 정책·방향 토론은
    # 경로가 없는 게 정상이라 차단하면 오탐이다. 회차 기록에도 남겨서 나중에 그 회차가
    # 왜 얕은지를 되짚을 수 있게 한다.
    # 경로를 적었는데 하나도 못 쓰면 여기서 멈춘다. 경로가 아예 없는 회차(아래 경고)와
    # 다르다 — 그쪽은 글만 읽고 답하는 정상적인 정책 토론일 수 있지만, 이쪽은 파일을
    # 보라고 적어 놓고 아무것도 안 열리는 상태라 결과가 반드시 틀린다.
    _usable, _bad = classify_brief_paths(task)
    if _bad and not _usable:
        print(brief_path_abort_message(_bad), file=sys.stderr)
        return 2
    # 하나라도 열리면 돌던 자리다. 그런데 열린 것이 참고 자료뿐이고 필수 자료가 빠지면
    # 그 회차는 반드시 틀린다 — 표지가 없는 브리프는 전부 필수로 보므로 기본이 중단이다.
    _roles = brief_path_roles(task)
    _bad_req = [(_p, _why) for _p, _why in _bad if _roles.get(_p, "필수") == "필수"]
    if _bad_req:
        _msg = brief_required_abort_message(_bad_req)
        print(_msg, file=sys.stderr)
        (run_dir / "missing-required-inputs.txt").write_text(_msg + "\n", encoding="utf-8")
        return 2
    if _bad:
        _warn = ("경고: 참고 자료 %d개를 못 연다 — " % len(_bad) +
                 ", ".join(f"{_p}({_why})" for _p, _why in _bad))
        print(_warn, file=sys.stderr)
        (run_dir / "skipped-reference-inputs.txt").write_text(_warn + "\n", encoding="utf-8")

    if not brief_dirs(task):
        _no_path = ("경고: 브리프에 절대경로가 없다. 참여자에게 열어줄 사본이 안 만들어지므로"
                    " 세 모델은 이 글만 읽고 답한다. 코드·파일을 판단해 달라는 회차면"
                    " 검토 대상 절대경로를 브리프에 적어라.")
        print(_no_path, file=sys.stderr)
        (run_dir / "no-brief-path.txt").write_text(_no_path + "\n", encoding="utf-8")

    # 역할 선정 (planner 호출이 필요할 수 있어 run_dir 생성 후)
    selected_roles, roles_source = select_roles(task, args, run_dir)
    # 예산 가드: planner_call(0 or 1) + len(roles) * len(POOL) * rounds + arbiter(1)
    planner_calls = 1 if roles_source == "auto" else 0
    estimated_calls = planner_calls + len(selected_roles) * len(POOL) * args.max_rounds + 1
    budget_used_msg = f"{estimated_calls}/{args.max_total_calls}"

    (run_dir / "meta.json").write_text(json.dumps({
        "seed": seed, "started": run_id, "pool": POOL,
        "roles": selected_roles, "roles_source": roles_source,
        "estimated_calls": estimated_calls, "max_total_calls": args.max_total_calls,
        "max_rounds": args.max_rounds, "memory_attached": bool(memory_block),
        "parent_session_id": os.environ.get("CLAUDE_CODE_SESSION_ID", ""),
        "parent_cwd": str(Path.cwd()),
        # 어느 모델·강도가 낸 결론인지 나중에 되짚기 위한 것. 실측 비교(#77·#78)를 할 때
        # 이 두 값이 없어서 run 을 못 갈랐다. 파일 한 줄 읽기라 런타임 비용은 없다 —
        # 바이너리·버전은 비싸서 실패한 run 에만 붙인다(provider_health_lines).
        "codex_model": effective_codex_model() or _codex_configured_model(),
        "codex_effort": {"round": codex_round_effort(), "arbiter": codex_arbiter_effort()},
        "deep": DEEP,
        "claude_models": [CLAUDE_MODELS[a] for a in POOL if a in CLAUDE_MODELS],
        "claude_via_agy": sorted(a for a in POOL if a in CLAUDE_VIA_AGY),
        "claude_effort": claude_effort(),
    }, ensure_ascii=False, indent=2), encoding="utf-8")

    if estimated_calls > args.max_total_calls:
        print(f"ERROR: 예상 콜 {estimated_calls} > max-total-calls {args.max_total_calls}. 중단.", file=sys.stderr)
        print(f"  roles={selected_roles} pool={POOL} rounds={args.max_rounds}", file=sys.stderr)
        sys.exit(3)

    if args.dry_run:
        print(f"=== ai-debate DRY-RUN ===")
        print(f"run_id: {run_id}")
        print(f"roles_source: {roles_source}")
        print(f"selected_roles: {selected_roles}")
        print(f"pool: {POOL}")
        print(f"max_rounds: {args.max_rounds}")
        print(f"estimated_calls: {estimated_calls} (max {args.max_total_calls})")
        print(f"run_dir: {run_dir}")
        return

    all_outputs = []
    final_consensus = False
    rounds_done = 0
    skip_agents = set()
    effective_max = args.max_rounds       # 기본 라운드 상한 (--deep 이면 3)
    escalated = False                     # adaptive 4~5라운드 확장 여부
    round_idx = 0
    while round_idx < effective_max:
        round_idx += 1
        is_final = (round_idx >= effective_max)   # 마지막 라운드 = reconciliation
        outs = run_round(round_idx, task, memory_block, all_outputs, run_dir, skip_agents,
                         roles=selected_roles, is_final_round=is_final)
        (run_dir / f"r{round_idx}.outputs.json").write_text(
            json.dumps(outs, ensure_ascii=False, indent=2), encoding="utf-8")
        all_outputs.extend(outs)
        rounds_done = round_idx
        # 이번 라운드에서 모든 role이 실패한 provider는 다음 라운드 skip 대상
        for agent in POOL:
            agent_outs = [o for o in outs if o.get("_agent") == agent]
            if agent_outs and all("_error" in o for o in agent_outs):
                skip_agents.add(agent)
        if "debater" in selected_roles and "critic" in selected_roles and consensus_reached(outs):
            final_consensus = True
            break
        # adaptive escalation (--deep 전용): 기본 라운드 다 썼는데 미합의 + 핵심충돌/저신뢰 → 4~5라운드로 1회 확장.
        #
        # 확장 직전에 예산을 다시 센다. 시작 전 검사는 기본 라운드(--deep 이면 3)만 보고
        # 통과시키는데 확장은 그 뒤에 일어나서, 예상 50 으로 통과한 런이 실제로는 82 콜까지
        # 간다(역할 넷·풀 넷·5라운드). 예산은 시작 전 예상이 아니라 실제 상한이다
        # (2026-10-01 운영자 결정). 넘으면 확장을 안 하고 이 라운드로 닫는다 — 이미 돈 콜을
        # 버리는 것보다 결론을 받는 쪽이 낫다. 세는 방법은 escalation_projected_calls 참조.
        if (args.deep and not escalated and round_idx >= args.max_rounds
                and effective_max < deep_escalate_max and escalation_triggered(outs)):
            live_pool = [a for a in POOL if a not in skip_agents]
            projected = escalation_projected_calls(
                planner_calls, len(all_outputs), deep_escalate_max - round_idx,
                len(selected_roles), len(live_pool))
            if projected > args.max_total_calls:
                msg = (f"escalation refused at round {round_idx}: 확장하면 콜 {projected} > "
                       f"max-total-calls {args.max_total_calls}\n"
                       f"  지금까지 {planner_calls + len(all_outputs)} 콜, 남은 라운드 "
                       f"{deep_escalate_max - round_idx} × 역할 {len(selected_roles)} × "
                       f"살아있는 provider {len(live_pool)} + arbiter 1.\n"
                       f"  확장하지 않고 이 라운드로 닫는다. 더 가려면 --max-total-calls 를 "
                       f"올려 적어라.\n")
                (run_dir / "escalation.txt").write_text(msg, encoding="utf-8")
                print("경고: " + msg.splitlines()[0], file=sys.stderr)
            else:
                effective_max = deep_escalate_max
                escalated = True
                (run_dir / "escalation.txt").write_text(
                    f"escalated {args.max_rounds}->{deep_escalate_max} at round {round_idx}: "
                    f"미합의 + trigger(critic 분기/저신뢰), 확장 후 예상 콜 {projected} <= "
                    f"max-total-calls {args.max_total_calls}\n",
                    encoding="utf-8")

    # 부분 실패 임계: 성공 콜 / 실제 시도 콜 < 2/3 이면 arbiter 안 부르고 실패 종료.
    #
    # 2026-07-29: 분모를 len(selected_roles)*len(POOL)*rounds_done 에서 실제 시도 수로
    # 바꿨다. 한 provider 가 실패해 다음 라운드에서 의도적으로 빠지면(skip_agents) 그
    # 라운드는 애초에 시도하지 않은 콜인데, 옛 분모는 그것까지 "실패"로 세어 정상적인
    # 2자 토론을 실패 종료로 밀어냈다. claude 가 쿼터로 빠져도 codex+gemini 로 결론까지
    # 가는 게 맞다는 판단(run-20260729T061853Z arbiter 권고).
    #
    # 대신 품질 하한을 따로 둔다: 마지막 라운드에 성공한 provider 가 2개 미만이면
    # 그건 토론이 아니라 독백이므로 실패로 끝낸다.
    # 원본 무결성은 성공 요약보다 먼저, 그리고 어떤 종료 경로에서도 보이게 낸다.
    # 실패로 끝난 런이라고 원본이 안 바뀌었다는 보장은 없다 — 아래 조기 exit 들이
    # 요약 출력을 건너뛰기 때문에 여기서 stderr 로 못박고 파일로도 남긴다.
    _integrity = origin_integrity_lines()
    if _integrity and not _integrity[0].startswith("origin-integrity: OK"):
        for _il in _integrity:
            print(_il, file=sys.stderr)
        (run_dir / "origin-integrity.txt").write_text("\n".join(_integrity) + "\n", encoding="utf-8")

    # 결손 줄은 여기서 한 번만 만든다. 실패로 끝나든 결론까지 가든 같은 문자열을
    # 결론 첫 줄·주입 요약 첫 줄·metering 이 나눠 쓴다.
    _deficit = deficit_header(run_dir, all_outputs)
    if _deficit:
        print(_deficit, file=sys.stderr)

    attempted_calls = len(all_outputs)
    success_calls = sum(1 for o in all_outputs if "_error" not in o)
    # 정족수는 마지막 라운드가 아니라 모든 라운드에서 본다. 마지막만 보면 1라운드가
    # 독백이었던 실행이 2라운드 인원으로 가려진다(판정 run-20260909T071423Z 4단계).
    _per_round = valid_by_round(all_outputs)
    thin_rounds = {r: sorted(s) for r, s in sorted(_per_round.items()) if len(s) < 2}
    if attempted_calls > 0 and success_calls * 3 < attempted_calls * 2:
        print(f"ERROR: 성공 콜 {success_calls}/{attempted_calls} < 2/3. arbiter 건너뛰고 실패 종료.", file=sys.stderr)
        for rl in read_evidence_lines(all_outputs):
            print(rl, file=sys.stderr)
        for hl in provider_health_lines(run_dir, all_outputs, None):
            print(hl, file=sys.stderr)
        (run_dir / "final_result.json").write_text(json.dumps({
            "run_id": run_id, "run_dir": str(run_dir),
            "rounds_done": rounds_done, "consensus_reached": False,
            "deficit_header": _deficit,
            "partial_failure": True, "success_calls": success_calls,
            "attempted_calls": attempted_calls,
            "skipped_agents": sorted(skip_agents),
            "outputs": all_outputs,
        }, ensure_ascii=False, indent=2), encoding="utf-8")
        write_metering(run_dir, run_id, run_started_epoch, all_outputs, rounds_done, False,
                       deficit=_deficit)
        sys.exit(4)
    if thin_rounds:
        print("ERROR: 유효 참가자가 2명 미만인 라운드 — "
              + ", ".join(f"R{r}={v or ['없음']}" for r, v in thin_rounds.items())
              + ". 토론이 아니라 독백이므로 arbiter 건너뛰고 실패 종료.", file=sys.stderr)
        for hl in provider_health_lines(run_dir, all_outputs, None):
            print(hl, file=sys.stderr)
        (run_dir / "final_result.json").write_text(json.dumps({
            "run_id": run_id, "run_dir": str(run_dir),
            "rounds_done": rounds_done, "consensus_reached": False,
            "deficit_header": _deficit,
            "partial_failure": True, "success_calls": success_calls,
            "attempted_calls": attempted_calls,
            "thin_rounds": {str(r): v for r, v in thin_rounds.items()},
            "skipped_agents": sorted(skip_agents),
            "outputs": all_outputs,
        }, ensure_ascii=False, indent=2), encoding="utf-8")
        write_metering(run_dir, run_id, run_started_epoch, all_outputs, rounds_done, False,
                       deficit=_deficit)
        sys.exit(4)
    if skip_agents:
        # 강등은 조용히 지나가면 안 된다 — 어느 참여자 없이 나온 결론인지 남긴다(알림 아님).
        print(f"NOTE: 강등 실행 — {sorted(skip_agents)} 제외하고 진행 "
              f"(성공 {success_calls}/{attempted_calls}콜).", file=sys.stderr)

    # arbiter는 항상 최종 정리자
    arb = run_arbiter(task, memory_block, all_outputs, run_dir)
    all_outputs.append(arb)

    final = {
        "run_id": run_id,
        "deficit_header": _deficit,
        "run_dir": str(run_dir),
        "seed": seed,
        "rounds_done": rounds_done,
        "consensus_reached": final_consensus,
        "max_rounds": args.max_rounds,
        "outputs": all_outputs,
    }
    (run_dir / "final_result.json").write_text(
        json.dumps(final, ensure_ascii=False, indent=2), encoding="utf-8")
    try:
        write_metering(run_dir, run_id, run_started_epoch, all_outputs, rounds_done,
                       final_consensus, deficit=_deficit)
    except Exception as e:      # 계측은 부가기능 — 어떤 이유로든 토론 결과를 죽이면 안 된다
        print(f"NOTE: 계측 기록 실패({type(e).__name__}: {e}) — 토론 결과는 정상.", file=sys.stderr)

    # human summary (also captured for cache)
    summary_lines = []
    def _p(s=""):
        summary_lines.append(s)
        print(s)
    if _deficit:
        _p(_deficit)
    _p(f"=== ai-debate run {run_id} ===")
    _p(f"rounds={rounds_done}/{args.max_rounds} consensus={final_consensus}")
    _p(f"roles={selected_roles} ({roles_source}) budget={budget_used_msg}")
    # 시스템 헤더: 실제 호출된 에이전트 + 성공/실패 카운트 (arbiter narrative와 무관, 사실).
    agent_stats = {}
    for o in all_outputs:
        a = o.get("_agent")
        if not a or a == "arbiter":
            continue
        agent_stats.setdefault(a, [0, 0])
        if "_error" in o:
            agent_stats[a][1] += 1
        else:
            agent_stats[a][0] += 1
    participants = " | ".join(f"{a}={ok}ok/{fail}fail" for a, (ok, fail) in sorted(agent_stats.items())) or "-"
    _p(f"agents: {participants}")
    # 한 provider 가 의견을 0건 냈으면 그건 요약 줄의 숫자 하나가 아니라 결론의 성질이
    # 바뀐 사건이다 — 3의견인 줄 알고 읽는 판정문이 사실 2의견이다. 2026-08-18 에
    # bias 세션이 몇 주 동안 codex 0건으로 돌고 있었는데 아무도 몰랐다. 숫자는 이미
    # 찍히고 있었고 사람이 안 읽었을 뿐이라, 읽히는 문장으로 따로 세운다.
    _missing = [a for a in POOL if agent_stats.get(a, [0, 0])[0] == 0]
    if _missing:
        _p(f"!! 의견 0건: {', '.join(_missing)} — 이 판정은 {len(POOL) - len(_missing)}개 관점만으로 만들어졌다. "
           f"원인은 아래 provider 줄과 {run_dir}/*.raw.txt 를 봐라.")
    _p(f"artifacts={run_dir}")
    for il in origin_integrity_lines():
        _p(il)
    for rl in read_evidence_lines(all_outputs + ([arb] if isinstance(arb, dict) else [])):
        _p(rl)
    for hl in provider_health_lines(run_dir, all_outputs, arb):
        _p(hl)
    _p()

    # 라운드별 요약. 무옵션(legacy)이면 기존 per-agent 라벨 유지, 동적이면 역할별 집계.
    is_legacy = roles_source == "default"
    for r in range(1, rounds_done + 1):
        if is_legacy:
            deb_pos = []
            crit_sp = []
            for o in all_outputs:
                if o.get("_round") != r or "_error" in o:
                    continue
                if o.get("_role") == "debater":
                    p = (o.get("position", "") or "").strip()[:60]
                    deb_pos.append(f"{o.get('_agent')}={p}")
                elif o.get("_role") == "critic":
                    sp = o.get("should_proceed")
                    crit_sp.append(f"{o.get('_agent')}={'OK' if sp in (True, 'true', 'yes', 'Y', 'y', 'True', '예', 1) else 'NO'}")
            errs = [f"{o.get('_agent')}/{o.get('_role')}:{o['_error']}" for o in all_outputs if o.get("_round") == r and "_error" in o]
            _p(f"R{r}  debaters: {' | '.join(deb_pos) or '-'}")
            _p(f"     critics : {' | '.join(crit_sp) or '-'}")
            if errs:
                _p(f"     errors  : {' ; '.join(errs)}")
        else:
            # 역할별 성공/실패 카운트만 (per-agent 라벨 제거)
            _p(f"R{r}")
            for role in selected_roles:
                role_outs = [o for o in all_outputs if o.get("_round") == r and o.get("_role") == role]
                ok = sum(1 for o in role_outs if "_error" not in o)
                fail = len(role_outs) - ok
                _p(f"   {role:14s} ok={ok} fail={fail}")
        _p()

    # arbiter 최종 결정
    if not render_arbiter(arb, run_dir, all_outputs, _p):
        sys.exit(5)

    # cache 기록 (--no-cache 또는 --seed 명시 시 skip)
    # 예비 모델이 답한 회차는 캐시에 넣지 않는다. 캐시 키는 질문과 대상 파일로만 만들어져서
    # 어느 모델이 답했는지가 안 들어간다 — 넣어두면 한도가 풀린 뒤에 같은 질문을 물어도
    # 24시간 동안 능력 낮은 모델의 결론이 평소 모델의 결론인 척 돌아온다.
    _fb_model, _fb_calls = codex_fallback_info(run_dir)
    if _fb_model:
        print(f"[ai-debate] 예비 모델 {_fb_model} 이 답한 호출 {len(_fb_calls)}건 — 캐시에 남기지 않는다",
              file=sys.stderr)
    # 결손이 있는 회차도 같은 이유로 안 남긴다. 캐시 키에는 참가자도 모델도 안 들어가서,
    # 자리 하나가 빈 결론이 24시간 동안 멀쩡한 회차의 답인 척 돌아온다. 등급·판본을
    # 고친 직후에 같은 질문을 물어도 그렇다.
    if _deficit:
        print("[ai-debate] 결손이 있는 회차 — 캐시에 남기지 않는다", file=sys.stderr)
    if not args.no_cache and args.seed is None and not _fb_model and not _deficit:
        try:
            import hashlib as _h
            CACHE_DIR.mkdir(parents=True, exist_ok=True)
            cache_path.write_text(json.dumps({
                "run_id": run_id,
                "summary_text": "\n".join(summary_lines),
                # 진단용: task 원문 hash 와 preview 보존 (cross-topic cache hit 디버깅).
                "task_sha256": _h.sha256(task.encode("utf-8")).hexdigest(),
                "task_preview": task[:480],
                # 2026-06-04 anti-conformity: round1 독립출력 + dissent 보존 →
                # 잘못 수렴된 최종 요약만 재사용되는 것을 사람이 검증 가능하게.
                "round1_outputs": [
                    {"agent": o.get("_agent"), "role": o.get("_role"),
                     "position": o.get("position"), "should_proceed": o.get("should_proceed")}
                    for o in all_outputs if o.get("_round") == 1 and "_error" not in o
                ],
                "arbiter_dissent": arb.get("dissent"),
                "minority_survived": arb.get("minority_survived"),
                "escalated": escalated,
            }, ensure_ascii=False), encoding="utf-8")
        except Exception:
            pass


if __name__ == "__main__":
    main()
