#!/usr/bin/env python3
"""클로드 계정을 여럿 두고 갈아 끼운다 — 이 파일 하나면 된다.

그냥 실행한다.

  ./claude-accounts

지금 쓰는 계정을 보여 주고 번호로 고르는 메뉴가 뜬다 — 갈아 끼우기, 새 계정 등록,
목록 보기, 사용량 재기, 끊긴 로그인에 코드 넣기. 계정도 이름을 외워 치지 않고 번호로
고른다.

갈아 끼우는 데 재시작이 필요 없다. 떠 있는 세션은 자격 파일을 요청마다 다시 읽어서
바꾼 다음 요청부터 새 계정으로 간다.

필요한 것: 파이썬 3.8 이상, 그리고 claude 명령. 둘 다 바꾸기 전에 확인한다.
만드는 것: 계정 자리 ~/claude-accounts/<이름>/ 과 지금 쓰는 이름을 적는 표식 하나.
저장소도 다른 파일도 필요 없다.
"""
import argparse
import errno
import fcntl
import getpass
import json
import os
import pty
import re
import select
import shutil
import signal
import struct
import subprocess
import sys
import termios
import time
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

VERSION = "1"

HOME = Path(os.path.expanduser("~"))
ROOT = Path(os.environ.get("CLAUDE_ACCOUNTS_ROOT", str(HOME / "claude-accounts")))
LIVE_CRED = HOME / ".claude" / ".credentials.json"
MARKER = HOME / ".claude" / "state" / "account-current"
WORK = HOME / ".claude" / "state" / "accounts"
CACHE = HOME / ".claude" / "statusline_cache.json"
# 로그인이 방금 적용됐다는 표식. rate-limit-recovery 가 이걸 보고 한도 수치를 들어내고
# 막힘 표시를 지운다.
LOGIN_APPLIED = HOME / ".claude" / "state" / "rate-limit-login-applied"
# 몇 번째 교체인가. 갈아끼울 때마다 하나씩 오른다. 상태줄이 "이 수치는 교체 뒤에
# 받아온 것이다" 를 증명하는 데 쓰고, 가드는 세대가 안 맞는 수치로 차단하지 않는다
# (lib/claude_session_lib.py 의 account_generation).
GENERATION = HOME / ".claude" / "state" / "account-generation"
# 갈아 끼운 사실을 사람이 읽는 줄로 남기는 자리. 누가 언제 어디서 어디로 바꿨는지를
# 여기 말고는 아무도 안 적어서, 나중에 "이 교체가 사람 손이냐 자동이냐" 를 복구기의
# 표식 하나로만 가려야 했다. 표식은 한 번 읽고 지우는 값이라 지나간 회차를 못 되짚는다.
SWITCH_LOG = HOME / ".claude" / "logs" / "account-switch.log"

URL_RE = re.compile(
    r"https://[^\s\x00-\x20\x7f]*(?:claude\.(?:ai|com)|anthropic)[^\s\x00-\x20\x7f]*", re.I)
ANSI_RE = re.compile(
    r"\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)"
    r"|\x1b\[[0-9;?]*[ -/]*[@-~]"
    r"|\x1b[@-Z\\-_]"
    r"|[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]")


# --------------------------------------------------------------------------
# 이름과 경로
# --------------------------------------------------------------------------

def valid_name(name):
    """이름 하나로 들어와야 한다. 경로 조각이 섞이면 남의 자리를 건드린다."""
    return bool(name) and "/" not in name and "\\" not in name \
        and not name.startswith(".") and name not in (".", "..")


def home_of(name):
    return ROOT / name


# 계정별 수치는 그 홈에서 상태줄이 돌아야 생긴다. 안 걸어 두면 로그인은 되는데 사용량
# 칸이 영원히 "수치 없음" 으로 남는다(11-07 둘째 기계 여섯 홈이 그랬다). 상태줄 본체는
# 이 파일에 안 담는다 — 묶음은 한 파일이고 상태줄은 그와 따로 자라는 코드다. 이 기계에
# 있으면 걸고, 없으면 조용히 건너뛴다(묶음만 받은 기계는 저쪽 수치를 본다).
STATUSLINE_CMD = {"type": "command", "command": "python3 ~/.claude/statusline.py"}


def statusline_src():
    """이 기계에서 쓸 상태줄 본체. 없으면 None."""
    here = Path(__file__).resolve().parent
    for p in (here.parent / "claude" / "statusline.py", HOME / ".claude" / "statusline.py"):
        try:
            if p.is_file():
                return p.resolve()
        except OSError:
            continue
    return None


def wire_statusline(cdir):
    """그 홈의 상태줄을 걸고 설정을 채운다. 무엇을 했는지 목록으로 돌려준다."""
    src = statusline_src()
    if src is None:
        return []
    did = []
    link = cdir / "statusline.py"
    try:
        cur = link.resolve() if (link.exists() or link.is_symlink()) else None
    except OSError:
        cur = None
    if cur != src:
        if link.exists() or link.is_symlink():
            link.unlink()
        link.symlink_to(src)
        did.append("상태줄 연결")
    sfile = cdir / "settings.json"
    try:
        cfg = json.loads(sfile.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        cfg = None
    if not isinstance(cfg, dict) or cfg.get("statusLine") != STATUSLINE_CMD:
        merged = cfg if isinstance(cfg, dict) else {}
        merged["statusLine"] = STATUSLINE_CMD
        write_atomic(sfile, json.dumps(merged, ensure_ascii=False, indent=2) + "\n")
        did.append("상태줄 설정")
    return did


def cred_of(name):
    return home_of(name) / ".claude" / ".credentials.json"


def login_dir(name):
    return home_of(name) / "login"


class Abort(Exception):
    """멈출 사유. 메뉴에서는 한 줄 보여 주고 메뉴로 돌아가고, 바깥에서는 그대로 끝난다."""

    def __init__(self, msg, code=1):
        super().__init__(msg)
        self.code = code


def die(msg, code=1):
    raise Abort(msg, code)


def strip_ansi(s):
    return ANSI_RE.sub("", s)


# --------------------------------------------------------------------------
# 자격 파일
# --------------------------------------------------------------------------

def cred_ok(path):
    """토큰이 들어 있는 모양인가. 내용은 안 들여다본다 — 있고 없고만 가른다."""
    try:
        data = json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return False
    if not isinstance(data, dict):
        return False
    oauth = data.get("claudeAiOauth")
    if not isinstance(oauth, dict):
        return False
    return bool(oauth.get("accessToken") or oauth.get("refreshToken"))


def account_uuid(home):
    """그 홈이 어느 계정인가. 토큰이 아니라 계정 번호라 갱신돼도 안 바뀐다."""
    try:
        data = json.loads((Path(home) / ".claude.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return ""
    acct = data.get("oauthAccount")
    if not isinstance(acct, dict):
        return ""
    uid = acct.get("accountUuid")
    return uid if isinstance(uid, str) else ""


def name_by_uuid():
    """지금 선 계정의 번호를 계정 자리들과 맞춰 이름을 찾는다. 못 찾으면 빈 값.

    표식은 갈아 끼운 쪽이 적는 것이라, 손으로 로그인만 한 기계에는 아예 없다
    (11-07 둘째 기계가 그래서 "모름" 만 띄웠다). 계정 번호는 자격 파일이 아니라
    설정에 있고 토큰 갱신을 타지 않아서 그 자리를 메운다.
    """
    live = account_uuid(HOME)
    if not live:
        return ""
    try:
        entries = sorted(p.name for p in ROOT.iterdir() if p.is_dir())
    except OSError:
        return ""
    for name in entries:
        if valid_name(name) and account_uuid(home_of(name)) == live:
            return name
    return ""


def current_name():
    """지금 어느 계정으로 도는가.

    표식을 먼저 본다 — 갈아 끼운 직후에는 그쪽이 맞고, 설정의 계정 번호는 세션이
    다음에 프로필을 받아올 때까지 옛 값을 들고 있다. 표식이 없을 때만 번호로 찾는다.
    """
    try:
        name = MARKER.read_text(encoding="utf-8").splitlines()[0].strip()
    except (OSError, IndexError):
        name = ""
    if name and valid_name(name):
        return name
    return name_by_uuid()


def bump_generation():
    """교체 세대를 하나 올린다. 올린 값을 돌려주고, 못 올리면 None.

    못 올렸다고 교체를 멈추지는 않는다 — 자격은 이미 바뀌었고 되돌리는 쪽이 더 위험하다.
    대신 부르는 쪽이 한도 수치를 비운다. 세대가 안 오르면 교체 전에 받아 둔 수치가
    이 세대 것으로 인정돼 다시 눌러앉을 수 있는데, 비어 있으면 그럴 수치가 없다.
    """
    try:
        cur = int(GENERATION.read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        cur = 0
    nxt = cur + 1
    try:
        write_atomic(GENERATION, "%d\n" % nxt, mode=0o644)
    except OSError:
        return None
    return nxt


def write_atomic(path, data, mode=0o600):
    """같은 디렉토리 임시 파일 + rename. 중간에 끊겨도 반쪽 파일이 안 남는다."""
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".new.{}".format(os.getpid()))
    tmp.write_bytes(data if isinstance(data, bytes) else data.encode("utf-8"))
    os.chmod(tmp, mode)
    os.replace(tmp, path)


class Lock:
    """전환을 한 줄로 세운다. 두 곳에서 동시에 갈아 끼우면 자격과 표식이 어긋난다."""

    def __init__(self):
        WORK.mkdir(parents=True, exist_ok=True)
        self.path = WORK / ".switch.lock"
        self.fh = None

    def __enter__(self):
        self.fh = open(self.path, "w")
        try:
            fcntl.flock(self.fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            self.fh.close()
            die("다른 전환이 진행 중이다 — 잠시 뒤 다시 한다.")
        return self

    def __exit__(self, *exc):
        try:
            fcntl.flock(self.fh, fcntl.LOCK_UN)
        finally:
            self.fh.close()


# --------------------------------------------------------------------------
# 계정 자리 만들기
# --------------------------------------------------------------------------

def init_home(name):
    """그 계정이 쓸 홈을 세운다. 이미 있으면 빠진 것만 채운다."""
    home = home_of(name)
    cdir = home / ".claude"
    cdir.mkdir(parents=True, exist_ok=True)
    for p in (home, cdir):
        if (p.stat().st_mode & 0o077) != 0:
            os.chmod(p, 0o700)

    wire_statusline(cdir)

    # 첫 실행 화면과 "이 폴더를 믿느냐" 물음을 미리 지나간 것으로 적는다. 안 적으면
    # 로그인 프로세스가 그 물음에서 멈추고, 기본값이 "아니오" 라 그대로 끝난다.
    jfile = home / ".claude.json"
    try:
        cfg = json.loads(jfile.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        cfg = {}
    if not isinstance(cfg, dict):
        cfg = {}
    projects = cfg.get("projects")
    if not isinstance(projects, dict):
        projects = {}
    entry = projects.get(str(home))
    if not isinstance(entry, dict):
        entry = {}
    if cfg.get("hasCompletedOnboarding") is not True \
            or entry.get("hasTrustDialogAccepted") is not True:
        cfg["hasCompletedOnboarding"] = True
        entry["hasTrustDialogAccepted"] = True
        projects[str(home)] = entry
        cfg["projects"] = projects
        write_atomic(jfile, json.dumps(cfg, ensure_ascii=False, indent=2) + "\n")
    elif jfile.exists() and (jfile.stat().st_mode & 0o077) != 0:
        os.chmod(jfile, 0o600)
    return home


# --------------------------------------------------------------------------
# 로그인
# --------------------------------------------------------------------------

def find_claude():
    """부를 실행파일을 미리 정해 둔다 — 떼어 놓은 쪽의 PATH 는 여기 PATH 가 아니다."""
    found = shutil.which("claude")
    if found:
        return os.path.abspath(found)
    for cand in (HOME / ".local" / "bin" / "claude",
                 Path("/usr/local/bin/claude"), Path("/usr/bin/claude")):
        if os.access(str(cand), os.X_OK):
            return str(cand)
    return ""


def find_url(logfile):
    """주소를 원본과 정리본 양쪽에서 찾는다.

    로그인 화면은 주소를 그냥 찍기도 하고 터미널 링크로 감싸기도 한다. 감싼 경우
    주소가 이스케이프 안에 들어가 있어서 화면 글자만 정리해 보면 통째로 사라진다.
    """
    try:
        raw = Path(logfile).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""
    found = URL_RE.findall(raw) + URL_RE.findall(strip_ansi(raw))
    return max(found, key=len) if found else ""


def alive(pidfile):
    try:
        pid = int(Path(pidfile).read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        return 0
    try:
        os.kill(pid, 0)
    except OSError as exc:
        return 0 if exc.errno == errno.ESRCH else pid
    return pid


def wait_for_login(home, logfile, fifo, pidfile, claude_bin):
    """떼어 놓은 쪽: 로그인 프로세스를 가짜 터미널에 물리고 출력은 로그로, 입력은 파이프로.

    로그인은 한 턴에 안 끝난다. 주소를 내놓고 사람이 브라우저에서 승인해 코드를 돌려줄
    때까지 기다리는데, 그 코드를 검증하는 값이 이 프로세스 안에만 있다 — 끊으면 주소도
    같이 죽는다. 그래서 이쪽을 떼어 놓고 코드만 파이프로 넣는다.
    """
    Path(pidfile).write_text(str(os.getpid()), encoding="utf-8")
    env = dict(os.environ)
    env["HOME"] = str(home)
    env.pop("CLAUDE_CODE_ENTRYPOINT", None)
    env.pop("CLAUDECODE", None)
    # 인증·설정 경로를 바꾸는 상속 환경을 끊는다 — 안 끊으면 이 홈 밖에 자격이 쓰인다.
    for key in ("CLAUDE_CONFIG_DIR", "XDG_CONFIG_HOME", "CLAUDE_ACCOUNTS_ROOT"):
        env.pop(key, None)

    cmd = [claude_bin, "auth", "login", "--claudeai"]
    pid, fd = pty.fork()
    if pid == 0:
        os.execvpe(cmd[0], cmd, env)
        os._exit(127)

    # 창을 아주 넓게 잡는다. 기본 80칸이면 긴 주소가 줄바꿈으로 잘려 못 읽는다.
    try:
        fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", 50, 400, 0, 0))
    except OSError:
        pass

    # 읽기·쓰기로 열어 두면 쓰는 쪽이 없어도 파이프가 끝나지 않는다.
    ffd = os.open(str(fifo), os.O_RDWR | os.O_NONBLOCK)
    with open(logfile, "ab", buffering=0) as log:
        deadline = time.time() + 2 * 3600      # 사람 왕복이다 — 넉넉히 둔다
        while time.time() < deadline:
            try:
                r, _, _ = select.select([fd, ffd], [], [], 1.0)
            except OSError:
                break
            if fd in r:
                try:
                    chunk = os.read(fd, 4096)
                except OSError:
                    break
                if not chunk:
                    break
                log.write(chunk)
            if ffd in r:
                try:
                    data = os.read(ffd, 4096)
                except OSError:
                    data = b""
                if data:
                    os.write(fd, data)
            if os.waitpid(pid, os.WNOHANG)[0]:
                try:
                    log.write(os.read(fd, 65536))
                except OSError:
                    pass
                break
    try:
        os.kill(pid, signal.SIGTERM)
    except OSError:
        pass
    # 끝났으면 흔적을 지운다 — 남겨 두면 끝난 자리가 "기다리는 중" 으로 보인다.
    # 단 내가 만든 것만 지운다. 같은 계정으로 로그인을 다시 띄우면 그쪽이 같은 자리에
    # 자기 pid 를 적고 새 파이프를 만드는데, 여기서 그냥 지우면 새 로그인에 코드를 넣을
    # 통로가 사라진다(2026-11-06 공용 계정 하나에서 재현).
    cleanup_stale_login(pidfile, fifo, os.getpid())
    os._exit(0)


def cleanup_stale_login(pidfile, fifo, my_pid):
    """끝난 로그인의 흔적을 지우되 뒤에 온 로그인 것은 건드리지 않는다.

    주인 표식은 pid 파일 하나다 — 거기 적힌 값이 내 것일 때만 둘 다 지운다. 새 로그인은
    그 자리에 자기 pid 를 먼저 적으므로 값이 어긋나고, 그러면 아무것도 안 지운다.
    파일 inode 로는 못 가른다 — 지우고 다시 만들면 같은 번호가 그대로 다시 쓰인다
    (이 기계에서 재현).
    """
    try:
        owned = Path(pidfile).read_text(encoding="utf-8").strip() == str(my_pid)
    except OSError:
        return                      # 못 읽으면 남의 것일 수 있다 — 아무것도 안 지운다
    if not owned:
        return
    for p in (pidfile, fifo):
        try:
            Path(p).unlink()
        except FileNotFoundError:
            pass


def prepare_login_dir(name, fresh):
    d = login_dir(name)
    d.mkdir(parents=True, exist_ok=True)
    os.chmod(d, 0o700)        # 로그에 로그인 화면이 남는다
    logfile, fifo, pidfile = d / "log.txt", d / "in.fifo", d / "pid"
    if fresh:
        for p in (logfile, fifo, pidfile):
            try:
                p.unlink()
            except FileNotFoundError:
                pass
    if not fifo.exists():
        os.mkfifo(fifo, 0o600)
    logfile.touch()
    return logfile, fifo, pidfile


def detach_login(name, claude_bin):
    """기다리는 쪽을 이 터미널 밖으로 내보낸다.

    그냥 떼어 놓기만 하면 원격 접속이 끝날 때 같이 정리된다. 주소를 받은 뒤 사람이
    돌아오기까지 접속은 여러 번 끊기므로, 쓸 수 있으면 systemd 로 넘겨 수명을 끊는다.
    """
    me = [sys.executable, os.path.realpath(__file__), "--inner-login", name,
          "--claude-bin", claude_bin]
    if shutil.which("systemd-run"):
        unit = "claude-accounts-login-{}-{}".format(name, int(time.time()))
        try:
            rc = subprocess.run(
                ["systemd-run", "--user", "--collect", "--quiet", "--unit=" + unit] + me,
                stdin=subprocess.DEVNULL, capture_output=True, text=True)
            if rc.returncode == 0:
                return
        except OSError:
            pass
    pid = os.fork()
    if pid == 0:
        os.setsid()
        if os.fork():
            os._exit(0)
        nul = os.open(os.devnull, os.O_RDWR)
        os.dup2(nul, 0)
        os.dup2(nul, 1)
        os.dup2(nul, 2)
        home = home_of(name)
        logfile, fifo, pidfile = prepare_login_dir(name, fresh=False)
        wait_for_login(home, logfile, fifo, pidfile, claude_bin)
    os.waitpid(pid, 0)


def feed_code(name, logfile, fifo):
    """코드를 받아 기다리는 로그인에 넣는다.

    코드를 명령줄에 안 받는다 — 명령줄은 같은 기계의 남의 계정에서도 프로세스 목록으로
    그대로 보인다. 화면에도 안 찍는다.
    """
    try:
        code = getpass.getpass("승인 코드를 붙여 넣고 엔터 (화면에 안 보인다): ")
    except (EOFError, KeyboardInterrupt):
        print()
        return False
    code = code.strip()
    if not code:
        print("코드가 비어 있다.", file=sys.stderr)
        return False
    fd = os.open(str(fifo), os.O_WRONLY | os.O_NONBLOCK)
    try:
        os.write(fd, (code + "\r").encode())
    finally:
        os.close(fd)
    return True


def confirm_login(name, logfile, tries=20):
    """자격 파일이 실제로 생겼는지 본다.

    코드를 보냈다는 것은 로그인이 됐다는 뜻이 아니다. 틀린 코드·취소·시간초과가 전부
    "보냈다" 로 끝나므로, 그 계정 홈에 쓸 수 있는 자격이 생긴 것만 성공으로 센다.
    """
    for _ in range(tries):
        if cred_ok(cred_of(name)):
            return True
        time.sleep(1)
    return False


# --------------------------------------------------------------------------
# 명령
# --------------------------------------------------------------------------

def cmd_add(name):
    if cred_ok(cred_of(name)):
        print("{} 은 이미 로그인돼 있다. 메뉴 1번으로 갈아 끼운다.".format(name))
        return 0
    claude_bin = find_claude()
    if not claude_bin:
        die("claude 명령을 못 찾았다. 먼저 claude 를 깔고 다시 한다.")

    init_home(name)
    waiting = alive(login_dir(name) / "pid")
    if waiting:
        print("{} 의 로그인이 이미 기다리고 있다(pid {}).".format(name, waiting))
        logfile = login_dir(name) / "log.txt"
        fifo = login_dir(name) / "in.fifo"
    else:
        logfile, fifo, _ = prepare_login_dir(name, fresh=True)
        detach_login(name, claude_bin)

    url = ""
    for _ in range(60):
        url = find_url(logfile)
        if url:
            break
        time.sleep(1)
    if not url:
        print("로그인 주소를 못 받았다. 잠시 뒤 메뉴 5번으로 다시 붙는다.", file=sys.stderr)
        return 3

    print()
    print("브라우저에서 이 주소를 열고, 쓸 계정으로 승인한다:")
    print("  " + url)
    print()
    print("승인하면 화면에 코드가 나온다. 그 코드를 여기 붙여 넣는다.")
    print("(창을 닫았거나 코드를 늦게 받았으면 메뉴 5번으로 다시 붙는다)")
    print()
    if not feed_code(name, logfile, fifo):
        return 2
    if confirm_login(name, logfile):
        print("{} 로그인 완료. 메뉴 1번으로 갈아 끼운다.".format(name))
        return 0
    print("아직 로그인이 안 끝났다. 코드가 맞는지 보고 메뉴 5번으로 다시 넣는다.",
          file=sys.stderr)
    tail = strip_ansi(logfile.read_text(encoding="utf-8", errors="replace"))[-400:]
    print(tail or "(로그 비어 있음)", file=sys.stderr)
    return 3


def cmd_code(name):
    d = login_dir(name)
    logfile, fifo = d / "log.txt", d / "in.fifo"
    # 파일이 남아 있는 것과 받는 쪽이 살아 있는 것은 다르다. 죽은 자리에 코드를 넣으면
    # 아무도 안 읽는다 — 그래서 프로세스가 실제로 기다리는지로 가른다.
    if not alive(d / "pid") or not fifo.exists():
        die("{} 에 기다리는 로그인이 없다 — 메뉴 2번으로 먼저 시작한다.".format(name))
    url = find_url(logfile)
    if url:
        print("승인 주소: " + url)
    if not feed_code(name, logfile, fifo):
        return 2
    if confirm_login(name, logfile):
        print("{} 로그인 완료. 메뉴 1번으로 갈아 끼운다.".format(name))
        return 0
    print("아직 로그인이 안 끝났다.", file=sys.stderr)
    return 3


def cmd_list():
    cur = current_name()
    if not ROOT.is_dir():
        print("만들어 둔 계정 자리가 없다. 메뉴 2번으로 만든다.")
        return 0
    names = sorted(p.name for p in ROOT.iterdir() if p.is_dir())
    if not names:
        print("만들어 둔 계정 자리가 없다. 메뉴 2번으로 만든다.")
        return 0
    width = max(len(n) for n in names)
    for name in names:
        mark = "*" if name == cur else " "
        state = "로그인됨" if cred_ok(cred_of(name)) else "로그인 안 함"
        print("{} {:<{w}}  {}".format(mark, name, state, w=width))
    print()
    print("* 가 지금 쓰는 계정이다." if cur
          else "지금 쓰는 계정의 이름은 모른다 — 이 도구 밖에서 로그인했을 수 있다.")
    return 0


# --- 사용량 -------------------------------------------------------------------
# 한도 수치를 만드는 것은 그 계정으로 도는 대화형 세션의 상태줄 하나뿐이다. 머리 없는
# 호출은 상태줄을 아예 안 부른다. 그래서 계정마다 세션을 가짜 터미널에 잠깐 물려 띄우고,
# 짧은 물음 하나를 던져 한도 칸이 오면 바로 접는다.
CACHE_REL = Path(".claude") / "statusline_cache.json"
MCP_REL = Path(".claude") / "empty-mcp.json"
HIT_LIMIT = re.compile(r"hit your (?:weekly|5-hour|usage) limit[^\r\n│]*", re.I)
# 묻는 말을 몇 번까지 넣나, 그리고 다시 넣기까지 몇 초를 두나.
#
# 한 번만 넣으면 그 글자를 세션이 아니라 세션이 띄운 안내창이 받는 회차에 통째로
# 빈손이 된다. 2026-11-09 둘째 기계에서 공용 계정 넷이 전부 그렇게 빈손이었고, 밤 전환이
# 그것을 "다 막혔다" 로 읽어 안 갈아 끼운 채 사람에게 알렸다 — 계정은 멀쩡했고 새 모델
# 안내창이 첫 회차의 글자를 먹은 것이었다(네 홈의 그 안내 응답 시각이 전부 그 회차다).
# 안내창은 글자를 먹고 엔터로 닫히므로, 같은 말을 한 번 더 넣으면 그때는 들어간다.
# 말이 이미 들어간 회차에는 다시 안 넣는다 — 들어갔는지는 그 홈이 모델을 부른 시간이
# 0 보다 큰지로 본다.
ASK_TRIES = 3
RE_ASK_GAP = 15.0
ANSI = re.compile(r"\x1b\[[0-9;?]*[a-zA-Z]|\x1b\][^\a\x1b]*(?:\a|\x1b\\)")


def read_limits(cache, since=0.0):
    """수치 파일에서 한도 칸을 꺼낸다. 아직 안 왔으면 None.

    since 뒤에 적힌 파일만 본다 — 안 그러면 전 회차가 남긴 값을 이번에 받은 것으로
    읽어서, 말이 없는 계정도 늘 "받았다" 가 된다.
    """
    cache = Path(cache)
    try:
        if since and cache.stat().st_mtime < since:
            return None
        data = json.loads(cache.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    limits = (data or {}).get("rate_limits") or {}
    # 둘 중 하나만 와도 받은 것이다 — 7일가 거의 다 찬 계정은 다섯 시간 창이 아예
    # 안 열려서 그 칸이 안 온다.
    for key in ("five_hour", "seven_day"):
        win = limits.get(key)
        if isinstance(win, dict) and win.get("used_percentage") is not None:
            return limits
    return None


def api_touched(cache, since=0.0):
    """그 홈의 세션이 실제로 모델을 한 번이라도 불렀나.

    상태줄은 세션이 서자마자 한 번 그리므로 파일이 있다는 것만으로는 말이 들어갔다는
    뜻이 못 된다. 부른 시간이 0 보다 큰지가 그 신호다.
    """
    cache = Path(cache)
    try:
        if since and cache.stat().st_mtime < since:
            return False
        data = json.loads(cache.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return False
    cost = (data or {}).get("cost") or {}
    return bool(cost.get("total_api_duration_ms"))


def clear_limits(cache):
    """띄우기 전에 그 홈의 한도 칸을 비운다.

    안 비우면 이번 회차가 전 회차 값을 그대로 돌려준다. 상태줄은 한도 칸이 안 온 렌더에
    앞 값을 물려받으므로, 첫 렌더가 옛 값을 적고 파일 시각만 새것이 된다.
    """
    cache = Path(cache)
    try:
        data = json.loads(cache.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return
    if not isinstance(data, dict) or "rate_limits" not in data:
        return
    data.pop("rate_limits", None)
    tmp = cache.with_name(cache.name + ".tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False), encoding="utf-8")
    tmp.replace(cache)


def probe_one(home, claude_bin, timeout=75.0, ask="hi", ask_after=6.0,
              model="claude-haiku-5-5"):
    """홈 하나에서 세션을 잠깐 띄워 한도 칸을 받고 접는다. (상태, 걸린 시간, 칸)."""
    cache = home / CACHE_REL
    clear_limits(cache)
    mcp = home / MCP_REL
    mcp.parent.mkdir(parents=True, exist_ok=True)
    mcp.write_text('{"mcpServers":{}}', encoding="utf-8")

    env = dict(os.environ, HOME=str(home), TERM="xterm-256color")
    for key in ("CLAUDECODE", "CLAUDE_CODE_ENTRYPOINT", "CLAUDE_CONFIG_DIR",
                "XDG_CONFIG_HOME", "CLAUDE_ACCOUNTS_ROOT"):
        env.pop(key, None)

    t0 = time.time()
    pid, fd = pty.fork()
    if pid == 0:
        try:
            os.chdir(str(home))
            argv = [claude_bin, "--strict-mcp-config", "--mcp-config", str(mcp)]
            if model:
                argv += ["--model", model]   # 수치만 받으면 되니 가장 가벼운 것으로
            os.execvpe(claude_bin, argv, env)
        except OSError:
            pass
        os._exit(127)

    # 좁은 창이면 상태줄이 접히고, 접힌 화면은 그릴 것이 없다고 판단될 수 있다.
    try:
        fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", 50, 200, 0, 0))
    except OSError:
        pass

    state, lim, screen, asks = "수치가 안 왔다 (다시 재 본다)", None, "", 0
    next_ask = ask_after
    while time.time() - t0 < timeout:
        lim = read_limits(cache, since=t0)
        if lim is not None:
            state = "받았다"
            break
        if HIT_LIMIT.search(screen):
            state = "한도 소진"
            break
        if asks < ASK_TRIES and time.time() - t0 >= next_ask:
            if asks and api_touched(cache, t0):
                # 말은 들어갔고 답을 기다리는 중이다 — 더 넣으면 같은 계정을 두 번 쓴다.
                asks = ASK_TRIES
            else:
                try:    # 화면이 서기 전에 넣으면 글자가 먹힌다
                    os.write(fd, ask.encode("utf-8") + b"\r")
                except OSError:
                    break
                asks += 1
                next_ask = (time.time() - t0) + RE_ASK_GAP
        r, _, _ = select.select([fd], [], [], 0.5)
        if fd in r:
            try:
                chunk = os.read(fd, 65536)    # 안 읽으면 세션이 막힌다
            except OSError:
                break
            if not chunk:
                break
            screen = (screen + ANSI.sub("", chunk.decode("utf-8", "replace")))[-8192:]

    for sig in (signal.SIGTERM, signal.SIGKILL):
        try:
            os.kill(pid, sig)
        except OSError:
            break
        for _ in range(20):
            if os.waitpid(pid, os.WNOHANG)[0]:
                break
            time.sleep(0.1)
        else:
            continue
        break
    try:
        os.close(fd)
    except OSError:
        pass
    return state, time.time() - t0, lim


def bar(pct, width=10):
    if pct is None:
        return "-" * width
    filled = int(round(max(0.0, min(100.0, float(pct))) / 100.0 * width))
    return "#" * filled + "." * (width - filled)


def usage_line(name, mark, state, lim):
    if state != "받았다" or not lim:
        return "{} {}  {}".format(mark, name, state)
    five = (lim.get("five_hour") or {}).get("used_percentage")
    week = (lim.get("seven_day") or {}).get("used_percentage")
    return "{} {}  5시간 [{}] {:>4}   7일 [{}] {:>4}".format(
        mark, name, bar(five), "-" if five is None else "{:.0f}%".format(five),
        bar(week), "-" if week is None else "{:.0f}%".format(week))


def switched_at():
    """이 기계가 마지막으로 계정을 갈아 끼운 시각. 모르면 0.

    지금 쓰는 계정의 수치가 그 계정 것인지를 이 시각으로 가른다 — 수치 파일에는
    계정 이름이 안 적혀서, 시각을 안 보면 갈아 끼우기 전에 적힌 옛 계정 값을
    지금 계정 값으로 읽는다.
    """
    try:
        return MARKER.stat().st_mtime
    except OSError:
        return 0.0


def measure_all(say=None, only=None):
    """등록해 둔 계정의 한도를 한 번에 잰다. (이름들, 지금 계정, {이름: (상태, 칸)}).

    say 가 있으면 사람에게 보일 안내를 그쪽으로 넘긴다 — 기계가 읽는 출력에는 안 섞는다.

    only 가 있으면 그 이름들만 띄워 잰다. 재는 것은 공짜가 아니라 그 계정으로 세션을
    잠깐 띄워 한 번 묻는 것이다 — 필요 없는 계정까지 매번 건드리면 값도 들고, 다른
    기계가 쓰는 계정의 토큰을 같이 흔든다. 지금 쓰는 계정은 띄우지 않고 파일에서
    읽으므로 only 와 무관하게 늘 들어간다(값이 안 든다).
    """
    cur = current_name()
    names = [n for n in accounts() if cred_ok(cred_of(n))]
    if only is not None:
        keep = set(only)
        names = [n for n in names if n in keep or n == cur]
    if not names:
        return [], cur, {}
    claude_bin = find_claude()
    if not claude_bin:
        die("claude 명령을 못 찾았다.")

    # 지금 쓰는 계정은 안 띄운다 — 이 기계의 세션이 그 자격을 쓰고 있어서, 같은 토큰을
    # 두 자리에서 갱신하면 늦게 쓴 쪽이 이미 바뀐 옛 토큰을 내민다. 그 계정 수치는
    # 돌고 있는 세션이 이미 적어 둔 것을 읽는다.
    todo = [n for n in names if n != cur]
    if todo and say:
        say("\n{}개 계정을 잰다. 같이 띄우니 길어야 1분 남짓이다 — 잠깐 기다린다."
            .format(len(todo)))

    out = {}
    if todo:
        with ThreadPoolExecutor(max_workers=len(todo)) as pool:
            fut = {pool.submit(probe_one, home_of(n), claude_bin): n for n in todo}
            for f in fut:
                name = fut[f]
                try:
                    state, _took, lim = f.result()
                except Exception as exc:          # 한 계정이 깨져도 나머지는 보여 준다
                    state, lim = "못 쟀다 ({})".format(type(exc).__name__), None
                out[name] = (state, lim)

    if cur:
        # 갈아 끼운 뒤에 적힌 것만 본다. 그 전 값은 옛 계정 것이다.
        live = read_limits(CACHE, since=switched_at())
        out[cur] = ("받았다", live) if live else ("지금 쓰는 중 — 수치가 아직 없다", None)
    # 5시간 창이 없는 계정(울트라)은 그 칸을 비운다. 지금 계정이면 수치 파일이 앞 계정의
    # 값을 이어받아 들고 있을 수 있다. 목록 정본은 상태줄과 같은 설정 파일이다.
    for name in no_five_hour_names():
        state, lim = out.get(name, (None, None))
        if isinstance(lim, dict):
            out[name] = (state, {k: v for k, v in lim.items() if k != "five_hour"})
    return names, cur, out


def no_five_hour_names(path=None):
    """5시간 창이 없다고 사람이 적어 둔 자리 이름들. 파일이 없으면 빈 목록."""
    try:
        with open(path or os.path.expanduser("~/.config/claude-usage/no-five-hour"),
                  encoding="utf-8") as fh:
            return [ln.strip() for ln in fh if ln.strip() and not ln.lstrip().startswith("#")]
    except OSError:
        return []


def cmd_usage():
    """등록해 둔 계정의 한도를 한 번에 재서 보여 준다."""
    names, cur, out = measure_all(say=print)
    if not names:
        print("잴 계정이 없다. 2번으로 먼저 등록한다.")
        return 0

    width = max(len(n) for n in names)
    print()
    for name in names:
        state, lim = out.get(name, ("안 쟀다", None))
        print(usage_line(name, "*" if name == cur else " ",
                         state, lim).replace(name, name.ljust(width), 1))
    print()
    print("* 가 지금 쓰는 계정이다. 그 계정은 돌고 있는 세션이 적어 둔 값을 읽는다.")
    return 0


def cmd_usage_json(only=None):
    """같은 측정을 기계가 읽는 꼴로 낸다. 고르는 규칙은 여기 안 넣는다 —
    이 파일은 재고 갈아 끼우기만 하고, 어느 계정을 쓸지는 부르는 쪽이 정한다."""
    names, cur, out = measure_all(only=only)          # 안내문은 안 찍는다
    now = int(time.time())
    try:
        cache_at = int(CACHE.stat().st_mtime)
    except OSError:
        cache_at = 0
    rows = []
    for name in names:
        state, lim = out.get(name, ("안 쟀다", None))
        # 줄마다 언제 본 값인지 적는다. 띄워서 잰 줄은 지금이고, 지금 쓰는 계정 줄은
        # 수치 파일이 적힌 시각이다 — 전체 measured_at 하나로 뭉뚱그리면 며칠 묵은
        # 값도 방금 잰 것으로 읽힌다.
        row = {"name": name, "state": state, "current": name == cur,
               "observed_at": cache_at if name == cur else now,
               "five_hour": None, "seven_day": None,
               "five_hour_reset": None, "seven_day_reset": None}
        for key, pct_k, rs_k in (("five_hour", "five_hour", "five_hour_reset"),
                                 ("seven_day", "seven_day", "seven_day_reset")):
            win = (lim or {}).get(key)
            if isinstance(win, dict):
                row[pct_k] = win.get("used_percentage")
                row[rs_k] = win.get("resets_at")
        rows.append(row)
    print(json.dumps({"measured_at": int(time.time()), "current": cur,
                      "accounts": rows}, ensure_ascii=False))
    return 0


def mark_login_applied():
    """로그인이 적용됐다는 사실을 남긴다.

    rate-limit-recovery 가 다음 회차에 이걸 보고 한도 수치를 들어내고 막힘 표시를
    지운다. 계정 식별자(~/.claude.json 의 accountUuid)로는 이 경로를 못 잡는다 —
    자격 파일만 바꾸면 그 값은 세션이 다시 뜰 때까지 옛 계정 그대로다.
    """
    try:
        write_atomic(LOGIN_APPLIED, str(int(time.time())) + "\n", mode=0o644)
    except OSError:
        pass


def invoker():
    """나를 부른 명령줄 한 조각. 사람 손인지 타이머인지를 가르는 단서다."""
    try:
        raw = Path("/proc/{}/cmdline".format(os.getppid())).read_bytes()
    except OSError:
        return "?"
    return " ".join(raw.decode("utf-8", "replace").split("\0")).strip()[:120] or "?"


def log_switch(action, prev, name, gen):
    """교체 한 줄을 남긴다. 실패해도 교체는 그대로 간다 — 기록이 교체를 막지 않는다."""
    auto = HOME / ".claude" / "state" / "rate-limit-auto-switch"
    line = "{} {} {} -> {} 세대={} 자동표식={} 부른쪽={}\n".format(
        time.strftime("%Y-%m-%d %H:%M:%S KST"), action,
        prev or "모름", name or "모름",
        "?" if gen is None else gen,
        "있음" if auto.exists() else "없음", invoker())
    try:
        SWITCH_LOG.parent.mkdir(parents=True, exist_ok=True)
        with open(SWITCH_LOG, "a", encoding="utf-8") as fh:
            fh.write(line)
    except OSError:
        pass


def backup_live():
    """지금 자격을 백업한다. 되돌릴 길을 먼저 만들고 바꾼다."""
    WORK.mkdir(parents=True, exist_ok=True)
    if not LIVE_CRED.exists():
        return
    try:
        write_atomic(WORK / "last-live.json", LIVE_CRED.read_bytes())
    except OSError as exc:
        die("백업에 실패했다: {} — 갈아 끼우지 않는다.".format(exc))


def cmd_apply_login(path):
    """방금 로그인해 받은 자격을 그대로 올린다 — 어느 계정인지는 모른다.

    로그인 릴레이(텔레그램 버튼)가 쓰는 길이다. 이름을 모르므로 표식을 지워 '모름'
    으로 둔다 — 옛 이름을 그냥 두면 다음 전환이 엉뚱한 홈에 자격을 되돌려 써서 그
    계정을 망가뜨린다. 한도 수치도 같은 이유로 비운다.
    """
    src = Path(path)
    if not cred_ok(src):
        die("그 파일이 쓸 수 있는 자격이 아니다: {}".format(src))
    if LIVE_CRED.is_symlink():
        die("지금 쓰는 자격 파일이 심볼릭 링크다 — 손으로 살펴봐야 한다: {}".format(LIVE_CRED))
    # 올릴 내용을 먼저 손에 쥔다. 되돌릴 때는 백업 파일 자체가 올릴 자격으로 들어오는데,
    # 백업을 먼저 뜨면 그 파일이 지금 자격으로 덮여서 되돌리기가 조용히 제자리걸음이 된다.
    try:
        payload = src.read_bytes()
    except OSError as exc:
        die("그 파일을 읽지 못했다: {}".format(exc))

    with Lock():
        # 지금 자격의 주인을 알면 그 홈에 갱신분을 돌려 둔다. 안 돌려놓으면 다음에 그
        # 계정으로 올 때 밀려난 표를 들고 간다.
        prev = current_name()
        if prev and LIVE_CRED.exists() and home_of(prev).is_dir():
            try:
                write_atomic(cred_of(prev), LIVE_CRED.read_bytes())
            except OSError as exc:
                die("{} 홈에 지금 자격을 되돌리지 못했다: {} — 올리지 않는다."
                    .format(prev, exc))
        backup_live()
        try:
            write_atomic(LIVE_CRED, payload)
        except OSError as exc:
            die("자격을 바꾸지 못했다: {} — 지금 계정 그대로다.".format(exc))
        try:
            MARKER.unlink()
        except FileNotFoundError:
            pass
        except OSError:
            pass
        mark_login_applied()
        gen = bump_generation()
        log_switch("--apply-login", prev, "방금 로그인한 자격", gen)
        clear_quota()

    kick_recovery()
    print("방금 로그인한 자격을 올렸다. 재시작 없이 다음 요청부터 그 계정으로 간다.")
    return 0


RECOVERY_UNIT = "claude-rate-limit-recovery.service"


def kick_recovery():
    """갈아 끼운 직후 복구기를 한 번 부른다.

    복구기는 10분 타이머라, 부르지 않으면 계정이 바뀐 것을 알아채는 데 최대 10분이
    걸린다. 그 동안 한도에 막혀 큐가 쌓인 세션은 쓸 수 있는 계정을 두고도 조용하다.
    밤에 저절로 갈아 끼우는 쪽에는 이 호출이 있었는데 손으로 갈아 끼우는 이 길에는
    없어서, 2026-11-11 13:00 에 운영자가 손으로 바꾼 회차가 타이머를 기다렸다.

    막지 않는다(--no-block). 복구기 한 회차가 세션을 흩느라 몇십 초를 쉴 수 있는데,
    갈아 끼우는 쪽이 그걸 기다릴 이유가 없다. 실패해도 교체는 성공이다 — 타이머가
    다음 회차에 같은 일을 한다.
    """
    try:
        subprocess.run(["systemctl", "--user", "start", "--no-block", RECOVERY_UNIT],
                       capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError) as exc:
        sys.stderr.write("복구기를 못 불렀다({}) — 다음 타이머 회차가 대신한다.\n"
                         .format(type(exc).__name__))


def cmd_which():
    print(current_name() or "모름")
    return 0


def cmd_use(name):
    src = cred_of(name)
    if not cred_ok(src):
        die("{} 에 로그인 파일이 없다 — 메뉴 2번으로 먼저 로그인한다.".format(name))
    if LIVE_CRED.is_symlink():
        die("지금 쓰는 자격 파일이 심볼릭 링크다 — 손으로 살펴봐야 한다: {}".format(LIVE_CRED))
    # 올릴 내용을 먼저 손에 쥔다. 되돌릴 때는 백업 파일 자체가 올릴 자격으로 들어오는데,
    # 백업을 먼저 뜨면 그 파일이 지금 자격으로 덮여서 되돌리기가 조용히 제자리걸음이 된다.
    try:
        payload = src.read_bytes()
    except OSError as exc:
        die("그 파일을 읽지 못했다: {}".format(exc))

    with Lock():
        prev = current_name()
        if prev == name:
            # 같은 이름을 다시 고르면 아무것도 안 한다. 쓰는 동안 저절로 갱신된 지금
            # 자격을 홈에 있는 낡은 사본으로 덮으면 그 계정이 밀려난 표를 들고 가게 된다.
            log_switch("--use(그대로)", prev, name, None)
            print("{} 은 이미 쓰고 있다.".format(name))
            return 0

        # 떠나는 계정의 갱신분을 그 홈에 되돌린다. live 로 쓰는 동안 토큰이 저절로
        # 갱신되는데, 안 돌려놓으면 다음에 그 계정으로 올 때 낡은 표를 들고 간다.
        if prev and LIVE_CRED.exists() and home_of(prev).is_dir():
            try:
                write_atomic(cred_of(prev), LIVE_CRED.read_bytes())
            except OSError as exc:
                die("{} 홈에 지금 자격을 되돌리지 못했다: {} — 갈아 끼우지 않는다."
                    .format(prev, exc))

        backup_live()
        # 이 도구로 관리하지 않던 첫 자격은 따로 한 벌 남긴다. 평소 백업은 전환마다
        # 덮이므로, 몇 번 갈아 끼우고 나면 처음 쓰던 자격이 사라진다.
        first = WORK / "first-unmanaged.json"
        if LIVE_CRED.exists() and not prev and not first.exists():
            try:
                write_atomic(first, LIVE_CRED.read_bytes())
            except OSError:
                pass

        try:
            write_atomic(LIVE_CRED, payload)
        except OSError as exc:
            die("자격을 바꾸지 못했다: {} — 지금 계정 그대로다.".format(exc))

        try:
            write_atomic(MARKER, name + "\n", mode=0o644)
        except OSError as exc:
            # 자격은 바뀌었는데 이름표가 안 적힌 상태다. 그대로 두면 다음 전환이 엉뚱한
            # 홈에 자격을 되돌려 그 계정을 망가뜨린다 — 이름표를 아예 지워 모름으로 둔다.
            try:
                MARKER.unlink()
            except FileNotFoundError:
                pass
            die("자격은 바꿨는데 이름표를 못 적었다: {} — 다음 전환 전에 손봐야 한다."
                .format(exc))

        mark_login_applied()
        gen = bump_generation()
        log_switch("--use", prev, name, gen)
        adopt_quota(name, prev, gen)

    kick_recovery()
    print("{} 로 갈아 끼웠다. 재시작 없이 다음 요청부터 그 계정으로 간다.".format(name))
    return 0


# 한도 수치 이양은 이 파일 안에서 끝낸다. 형제 명령(claude-quota-cache-adopt)이 같은
# 일을 하지만 그것을 부르면 파일 하나만 받아 간 사람 쪽에서 조용히 안 돈다 — 이 도구는
# 저장소 없이 파일 하나로 서야 한다(운영자 지시).
def adopt_quota(name, prev, gen=None):
    """화면에 뜨는 한도 수치를 새 계정 것으로 바꿔 단다.

    수치는 이 기계의 모든 세션이 파일 하나를 같이 쓴다. 안 바꾸면 떠나는 계정의 숫자가
    새 계정의 여유처럼 보인다. 계정 표시를 수치와 같이 옮겨야 두 계정 수치가 안 합쳐진다.

    보관해 둔 수치를 도로 달 때 세대 표는 떼고 단다. 그 계정 것이 맞아도 지난 세대에
    받아온 값이라, 지금 얼마나 썼는지의 근거는 아니다 — 화면에는 보이되 차단 판정에는
    안 쓰인다. 세대를 못 올렸으면(gen 이 None) 수치를 아예 비운다. 그때는 교체 전에
    받아 둔 수치와 교체 뒤 수치를 가를 방법이 없으므로, 비는 쪽이 남의 수치보다 낫다.
    """
    try:
        live = json.loads(CACHE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return
    if not isinstance(live, dict):
        return
    acct_cache = home_of(name) / ".claude" / "statusline_cache.json"

    if prev:                                   # 떠나는 계정 수치를 그 홈에 보관
        rl = live.get("rate_limits")
        if isinstance(rl, dict) and rl and home_of(prev).is_dir():
            dst = home_of(prev) / ".claude" / "statusline_cache.json"
            try:
                kept = json.loads(dst.read_text(encoding="utf-8"))
            except (OSError, ValueError):
                kept = {}
            if not isinstance(kept, dict):
                kept = {}
            kept["rate_limits"] = rl
            if live.get("_account") is not None:
                kept["_account"] = live["_account"]
            try:
                write_atomic(dst, json.dumps(kept))
            except OSError:
                pass

    try:
        src = json.loads(acct_cache.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        src = {}
    rl = src.get("rate_limits") if isinstance(src, dict) else None
    live.pop("_generation", None)              # 보관분은 지난 세대 값이다
    if gen is not None and isinstance(rl, dict) and rl:
        live["rate_limits"] = rl
        if src.get("_account") is not None:
            live["_account"] = src["_account"]
    else:
        live.pop("rate_limits", None)          # 비는 것이 남의 수치보다 낫다
    try:
        write_atomic(CACHE, json.dumps(live), mode=0o644)
    except OSError:
        pass


def clear_quota():
    """어느 계정인지 모르는 채로 자격만 바뀌었을 때. 비는 것이 남의 수치보다 낫다.

    이름을 모르니 가져올 홈이 없다. 떠나는 계정의 숫자를 그대로 두면 그게 새 계정의
    여유처럼 읽히므로, 수치 칸만 들어내고 나머지는 건드리지 않는다.
    """
    try:
        live = json.loads(CACHE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return
    if not isinstance(live, dict):
        return
    live.pop("rate_limits", None)
    try:
        write_atomic(CACHE, json.dumps(live), mode=0o644)
    except OSError:
        pass


# --------------------------------------------------------------------------
# 대화형 — 그냥 실행하면 이쪽이 돈다
# --------------------------------------------------------------------------

def ask(prompt):
    """한 줄 받는다. 입력이 끊기면(끝·중단) 나가는 것으로 본다."""
    try:
        return input(prompt).strip()
    except (EOFError, KeyboardInterrupt):
        print()
        raise Abort("", 0)


def accounts():
    if not ROOT.is_dir():
        return []
    return sorted(p.name for p in ROOT.iterdir() if p.is_dir())


def pick(names, title, cur=""):
    """번호로 고르게 한다. 이름을 외워 치게 하지 않는다."""
    print()
    print(title)
    for i, name in enumerate(names, 1):
        mark = " (지금 쓰는 것)" if name == cur else ""
        state = "" if cred_ok(cred_of(name)) else "  — 로그인 안 함"
        print("  {}) {}{}{}".format(i, name, mark, state))
    print("  0) 돌아가기")
    while True:
        s = ask("번호: ")
        if s in ("0", ""):
            return ""
        if s.isdigit() and 1 <= int(s) <= len(names):
            return names[int(s) - 1]
        print("1 에서 {} 사이의 번호, 또는 0.".format(len(names)))


def ask_new_name():
    """새 계정 자리 이름. 무엇에 쓰는 이름인지 먼저 말해 준다."""
    print()
    print("새 계정에 붙일 이름을 정한다. 폴더 이름으로 쓰이니 한 낱말로 — 영문·숫자·밑줄.")
    print("(돌아가려면 그냥 엔터)")
    while True:
        name = ask("이름: ")
        if not name:
            return ""
        if not valid_name(name):
            print("경로나 점으로 시작하는 이름은 안 된다.")
            continue
        if name in accounts():
            print("{} 은 이미 있다. 다른 이름을 쓰거나 메뉴에서 갈아 끼우기를 고른다."
                  .format(name))
            continue
        return name


def menu():
    while True:
        cur = current_name()
        names = accounts()
        waiting = [n for n in names if alive(login_dir(n) / "pid")]
        print()
        print("=" * 52)
        print("클로드 계정 바꾸기")
        print("  지금 계정: " + (cur or "이름 모름 (이 도구 밖에서 로그인했을 수 있다)"))
        print("  만들어 둔 자리: {}개".format(len(names)))
        if waiting:
            print("  코드를 기다리는 로그인: " + ", ".join(waiting))
        print("-" * 52)
        print("  1) 계정 갈아 끼우기")
        print("  2) 새 계정 등록 (로그인)")
        print("  3) 목록 보기")
        print("  4) 사용량 재기 (등록한 계정 전부)")
        print("  5) 끊긴 로그인에 코드 넣기")
        print("  0) 나가기")
        print("=" * 52)
        choice = ask("고르기: ")

        try:
            if choice in ("0", "q", ""):
                return 0
            if choice == "1":
                ready = [n for n in names if cred_ok(cred_of(n)) and n != cur]
                if not ready:
                    print("\n갈아 끼울 계정이 없다. 2번으로 먼저 등록한다.")
                    continue
                name = pick(ready, "어느 계정으로 갈아 끼울까.", cur)
                if name:
                    cmd_use(name)
            elif choice == "2":
                name = ask_new_name()
                if name:
                    cmd_add(name)
            elif choice == "3":
                print()
                cmd_list()
            elif choice == "4":
                cmd_usage()
            elif choice == "5":
                if not waiting:
                    print("\n기다리는 로그인이 없다. 2번으로 새로 시작한다.")
                    continue
                name = pick(waiting, "어느 로그인에 코드를 넣을까.", cur)
                if name:
                    cmd_code(name)
            else:
                print("\n0 에서 5 사이의 번호.")
        except Abort as exc:
            if exc.code == 0:
                return 0
            if str(exc):
                print("\n" + str(exc))


def main(argv):
    ap = argparse.ArgumentParser(
        add_help=True,
        description="클로드 계정을 여럿 두고 갈아 끼운다. 그냥 실행하면 메뉴가 뜬다.")
    ap.add_argument("--version", action="store_true", help="판본")
    # 아래 셋은 메뉴 없이 바로 쓰는 길이다. 컨트롤봇의 텔레그램 버튼이 이쪽으로 들어온다 —
    # 갈아 끼우는 절차는 이 파일 하나에만 있다.
    ap.add_argument("--use", metavar="이름", help="그 계정으로 갈아 끼운다")
    ap.add_argument("--apply-login", dest="apply_login", metavar="자격파일",
                    help="방금 로그인해 받은 자격을 그대로 올린다 (계정 이름을 모를 때)")
    ap.add_argument("--which", action="store_true", help="지금 어느 계정인가")
    ap.add_argument("--list", action="store_true", dest="list_", help="계정 자리와 로그인 상태")
    ap.add_argument("--usage-json", action="store_true", dest="usage_json",
                    help="계정마다 한도를 그 자리에서 재서 기계가 읽는 꼴로 낸다")
    # 기본값이 None 인 것이 중요하다. 빈 문자열로 두면 "안 넘겼다" 와 "하나도 재지
    # 말고 지금 계정만 읽어라" 가 같은 값이 되어, 아무것도 안 재야 하는 회차가 등록한
    # 계정을 전부 띄운다.
    ap.add_argument("--only", default=None,
                    help="그 계정들만 띄워 잰다(쉼표나 공백으로 나눈다). 빈 값으로 넘기면 "
                         "아무것도 안 띄우고 지금 계정 수치만 읽는다. 재는 것은 값이 드는 일이다")
    ap.add_argument("--inner-login", metavar="이름", help=argparse.SUPPRESS)
    ap.add_argument("--claude-bin", dest="claude_bin", default="", help=argparse.SUPPRESS)
    args = ap.parse_args(argv[1:])

    if args.inner_login is not None and not valid_name(args.inner_login):
        print("계정 이름은 한 낱말이어야 한다: {}".format(args.inner_login),
              file=sys.stderr)
        return 2

    if args.inner_login:
        # 홈 세우기는 멱등이다. 여기서 한 번 더 부르는 것은 이쪽이 직접 불려 올 때를
        # 위해서다 — 설정이 없으면 로그인이 첫 실행 물음에서 멈춘다.
        home = init_home(args.inner_login)
        logfile, fifo, pidfile = prepare_login_dir(args.inner_login, fresh=False)
        wait_for_login(home, logfile, fifo, pidfile,
                       args.claude_bin or find_claude())
        return 0
    if args.version:
        print(VERSION)
        return 0
    if args.which:
        return cmd_which()
    if args.list_:
        return cmd_list()
    if args.usage_json:
        only = None
        if args.only is not None:
            only = [p for p in args.only.replace(",", " ").split() if p]
            bad = [p for p in only if not valid_name(p)]
            if bad:
                print("계정 이름은 한 낱말이어야 한다: {}".format(" ".join(bad)),
                      file=sys.stderr)
                return 2
        return cmd_usage_json(only=only)
    if args.use is not None:
        if not valid_name(args.use):
            print("계정 이름은 한 낱말이어야 한다: {}".format(args.use), file=sys.stderr)
            return 2
        return cmd_use(args.use)
    if args.apply_login is not None:
        return cmd_apply_login(args.apply_login)
    return menu()


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except Abort as _exc:
        if str(_exc):
            print(str(_exc), file=sys.stderr)
        sys.exit(_exc.code)
