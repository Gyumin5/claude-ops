#!/usr/bin/env python3
"""ai-debate: 멀티 AI 합의 토론 오케스트레이터 (단일 진입점).

풀 = [codex, gemini, claude]. 각 라운드마다 풀의 각 agent 를 역할 수만큼 호출 —
기본 역할은 debater(의견) + critic(비판). 같은 task에 다른 역할 프롬프트로 독립 호출.
평소 회차의 클로드 자리(오푸스 5.5)는 agy 로 부른다 — 그 자리 비용이 전 세션 공유 한도가
아니라 구글 울트라 쪽으로 간다(2026-11-05 운영자 지시). 클로드 코드로 부르는 자리는 깊은
회차의 페이블 5.2 하나이고, 그쪽은 안전모드(--safe-mode)와 빈 MCP 설정으로 호출해 부모 세션
설정·훅·MCP 충돌을 피한다. 로그인 파일은 다른 세션들과 공유한다 — 격리하는 것은 작업
폴더지 로그인이 아니다.
일부 provider 가 죽어도 나머지로 debater+critic 확보됨.

JSON 표준화 출력. 라운드 간에 이전 출력 전체를 다음 라운드 컨텍스트로 전달.
과반 critic 이 needs_another_round=false 면 합의 종료(2026-07-29 개정 — 구 판정이던
"critic 전원 should_proceed=true + debater position 수렴"은 폐기됐다. 근거는 consensus_reached
독스트링). should_proceed 는 종료가 아니라 escalation 판정에만 쓴다.
합의 안 되면 max_rounds(기본 2, --deep 시 3, 미합의면 조건부 5)까지 반복.
마지막에 codex arbiter가 final 결정 통일 정리.
성공 콜 / 예정 콜 < 2/3 이면 arbiter 건너뛰고 실패 종료.

사용:
  ai-debate "task"                          # 기본 2라운드
  cat big.md | ai-debate "이거 검토"
  ai-debate --deep "task"                   # 깊은 모드: 참가자 5·코덱스 둘·클로드 둘·최대 5라운드(강도는 high 그대로)
  ai-debate --auto-roles --max-roles 4 "task"   # planner 가 역할 자동선정
  ai-debate --dry-run --auto-roles "task"   # 예상 콜수만

산출물: ~/claude-work/ai-debate/run-<ts>/
- meta.json, task.txt
- r{N}.{role}.{agent}.{prompt|raw|normalized}.txt|json
- r{N}.outputs.json (라운드 통합)
- arbiter.{prompt|raw|normalized}
- final_result.json
"""

import argparse
import glob
import hashlib
import json
import os
import shutil
import random
import re
import pwd
import subprocess
import threading
import sys
import time
from concurrent.futures import ThreadPoolExecutor, as_completed
from datetime import datetime, timezone
from pathlib import Path

# 기본 풀 3개(=최소 3의견): codex+gemini(쿼터 여유) + claude-opus(정확도).
# 4번째 의견(claude-sonnet 옵트인)은 폐지 — claude는 한 자리만 참여 (2026-07-19 사용자 지정).
# 그 한 자리는 2026-09-29 운영자 지시로 Fable 5.1 → Opus 5.5 다. 공개 시험 아홉 개에서
# Opus 가 전부 앞선다 — 평소 회차는 그 다수 쪽을 쓰고, 갈림이 값이 되는 깊은 회차에서만
# Fable 을 더해 둘을 같이 듣는다(아래 DEEP_POOL_EXTRA).
POOL = ["codex", "gemini", "claude-opus"]
HOME_DIR = os.path.expanduser("~")
# 사본·열람 허용 경계는 이 계정의 실제 홈으로 판정한다. HOME_DIR 과 일부러 나눠 둔다 —
# 저쪽은 부르는 쪽이 바꿀 수 있는 값이라 자식 프로세스에 넘기는 용도로만 쓰고, 경계는
# 환경변수가 바뀌어도 안 움직여야 한다. 비교도 문자열 앞가지로 하지 않는다 —
# "/home/u".startswith 는 /home/u2 같은 옆 계정 홈을 통과시킨다.
ACCOUNT_HOME = Path(pwd.getpwuid(os.getuid()).pw_dir).resolve()


def _under_account_home(p):
    """p 가 이 계정 홈 자신이거나 그 아래인가. 경로 구성요소로 비교한다."""
    p = Path(p)
    return p == ACCOUNT_HOME or ACCOUNT_HOME in p.parents
# claude 풀 멤버 모델: fable 하나만 (2026-07-19 사용자 지정, 4번째 의견 폐지).
# 2026-09-02 사용자 지정으로 5 → 5.1, 2026-11-10 운영자 지시로 5.1 → 5.2. 이 이름은
# claude CLI 2.1.321 이상에서만 인식된다(2.1.319 이하 바이너리에는 문자열이 없다) —
# 모르는 판본에 넘기면 거부가 아니라 unrecognized_model 한 줄만 남기고 다른 모델로
# 조용히 대체해 답한다. 아래 UNRECOGNIZED_MODEL_MARK 가드가 그 침묵을 실패로 바꾼다.
CLAUDE_MODELS = {"claude-fable": "claude-fable-5-2", "claude-opus": "claude-opus-5-5"}
# 어느 클로드 자리를 agy(안티그래비티 CLI)로 부르나. 비어 있으면 클로드 자리는 전부
# 클로드 코드 통로다. 2026-11-05 에 오푸스 자리를 agy 로 옮겼다가(운영자 8229·8242)
# 2026-11-07 에 되돌렸다(운영자 8663) — agy 쪽 클로드 한도가 토론 회차 수를 못 견딘다.
# 실측(11-05 18:15 KST 교체 뒤 전수): 이 자리 40콜 중 39콜이 한도 거절이고 답이 돌아온
# 것은 하나다. 첫 거절이 11-06 14:41 KST 이고 거절 문구가 "Resets in 147h" 라 엿새를
# 막는다. 39 중 19 는 한도 거절을 "파싱 실패" 로 잘못 분류해 한 번 더 부른 헛호출이었다
# (그 분류는 같은 날 agy_quota_error 로 닫았다). 제미나이 자리는 같은 구간 24콜이 다
# 정상이다 — agy 한도는 모델별로 따로 센다.
# 다시 옮기려면 그 자리의 한도가 회차 수를 견디는지부터 재고 이 집합에 이름을 넣는다.
# agy 쪽 이름은 강도가 접미사로 붙은 "claude-opus-5-5-high" 꼴이라 아래 agy_model 이
# 모델 이름과 강도를 합쳐 만든다. 호출 갈래·게이트·기록이 전부 이 값을 본다.
CLAUDE_VIA_AGY = set()
UNRECOGNIZED_MODEL_MARK = "claude-code:unrecognized_model"
CLAUDE_EFFORT = "high"  # effort high (사용자 지정 2026-07-03).

# ---- 깊은 모드(--deep) 층 (2026-09-28 운영자 지시) -------------------------
# 평소 회차는 위 상수 그대로다. 깊게 가라는 지시를 받은 회차만 이 층으로 올린다.
# 클로드 자리는 하나를 고르지 않고 둘을 다 넣는다. 공개 시험은 Opus 5.5 가 아홉 개 전부
# 앞서는데, 유일하게 반대를 가리키는 평("어렵고 열린 문제에서는 Fable 5.1 이 아직 낫다")이
# 정확히 이 모드가 쓰이는 자리다. 자료로 못 가르는 갈림은 토론에 넣는 것이 이 도구의 값이다.
# 평소 자리가 Opus 이므로 깊은 회차에 더하는 쪽은 Fable 이다.
# 코덱스 자리도 깊은 회차에서는 둘이다. 평소 자리 gpt-6.1-sol(설정 파일)은 그대로 두고
# gpt-6-astra 를 한 자리 더 넣는다. 갈아끼우지 않는 이유를 실측으로 확인했다 — 같은
# 브리프 셋을 두 모델에 나란히 돌렸더니(2026-09-30, reports/2026-10-01-코덱스-두-모델-
# 짝지어-재기.html) 한쪽만 찾은 검증 가능한 지적이 각각 넷이었다. 공개 지표로는 둘이
# 사실상 동점이라(지능 astra 51 대 6.1-sol 50) 어느 쪽을 고르든 다른 쪽이 찾은 것을 잃는다.
# 대가는 깊은 회차 콜이 라운드당 여덟에서 열로 느는 것이고, 깊은 회차는 드물게 쓴다.
# 정리자는 이 확장 대상이 아니다(2026-09-29 운영자 지시) — 깊은 회차에서도 자리 하나이고
# 언제나 설정 파일값이다. 그래서 아래 매핑에서 "codex" 의 값이 None 이다.
# 강도는 깊은 회차의 라운드 자리만 xhigh 다 — 클로드 둘과 코덱스 둘(2026-11-11 운영자 지시
# "딥토론을 xhigh 로 올리자 클로드랑 코덱스 둘다 그냥 토론은 하이로"). 같은 날 세션 기본
# 강도를 medium 으로 내리면서 무거운 판단을 토론으로 돌리기로 했고, 깊은 회차가 그 판단을
# 받는 맨 위 자리다. 대가는 시간이다 — 같은 브리프 실측에서 코덱스가 high 134초 대 xhigh
# 168초라 콜마다 30초쯤 붙는다. 정리자는 안 올린다(R12, 언제나 high).
# 제미나이는 깊은 회차에 카본 자리가 더해져 둘이 된다(아래 CARBON_MODEL).
DEEP_POOL_EXTRA = ["claude-fable", "codex-astra", "gemini-carbon"]
DEEP_CLAUDE_EFFORT = "xhigh"
DEEP_CODEX_EFFORT = "xhigh"
# 코덱스 자리별 모델. None 은 "넘기지 않는다" 는 뜻이고, 그러면 codex-ask 가 설정 파일
# ~/.codex/config.toml 의 model 을 쓴다 — 그 파일이 평소 자리의 단일 출처다.
# 이름 앞가지 "codex" 로 코덱스 자리인지를 가린다(is_codex). 새 자리를 더할 때는
# 반드시 그 앞가지를 지켜라 — 한도 판정·사용량 계측·호출 갈래가 전부 그걸로 갈린다.
CODEX_MODELS = {"codex": None, "codex-astra": "gpt-6-astra"}
# 실행 시점에 main() 이 --deep 값으로 한 번 정한다. call_agent 가 프로세스 안 어디서든
# 같은 값을 보게 하려고 모듈 전역으로 둔다.
DEEP = False


def is_codex(agent):
    """코덱스 자리인가. 깊은 회차에는 codex 말고 codex-astra 도 있다."""
    return (agent or "").split("-", 1)[0] == "codex"


def deep_on(flag):
    """--deep 여부를 전역에 각인하고 풀을 확장한다. main() 이 한 번만 부른다."""
    global DEEP, POOL
    DEEP = bool(flag)
    if DEEP:
        POOL = POOL + [a for a in DEEP_POOL_EXTRA if a not in POOL]
    return POOL


def claude_effort():
    return DEEP_CLAUDE_EFFORT if DEEP else CLAUDE_EFFORT


def codex_round_effort():
    return DEEP_CODEX_EFFORT if DEEP else CODEX_EFFORT_ROUND


def codex_arbiter_effort():
    return CODEX_EFFORT_ARBITER
# gemini 멤버 모델 (2026-07-29 사용자 지정). agy 설정 기본값에 맡기면 머신마다 세대가
# 갈린다 — 양 호스트 `agy models` 에 노출되는 이름이어야 하고, 없는 이름을 넘기면 그
# 참여자가 통째로 빠진다.
# agy 기본값을 바꿔도 여기가 --model 로 이름을 넘기므로 토론은 이 상수를 따른다 — 기본값과
# 이 상수는 따로 논다. 이름을 올릴 때는 양 호스트에서 그 이름으로 실제 호출이 되는지 먼저
# 확인한다(`agy models` 는 사인인 상태에 따라 목록을 못 받는 호스트가 있다).
# 2026-09-04 3.7 → 3.8, 2026-10-14 3.8 → 4 아르곤 (둘 다 운영자 지시). 접미사 없는 이름은
# --effort 를 요구하므로 반드시 -high 까지 붙인다.
# 아르곤은 그 호스트 구글 계정이 AI 울트라일 때만 목록에 뜬다. 프로 계정에서 부르면
# "is not recognized as a known model" 과 함께 쓸 수 있는 목록을 찍고 그 참여자만 빠진다
# (조용히 다른 모델로 대체되지 않는다 — 2026-10-14 홈에서 실측). 그러니 등급이 안 맞는
# 호스트가 생기면 토론이 통째로 죽는 게 아니라 제미나이 자리 하나가 비고 기록에 남는다.
GEMINI_MODEL = "gemini-4-argon-high"
# 깊은 회차에는 아르곤 자리 옆에 카본 자리를 더한다(2026-11-13 운영자 9314 "딥토론에 carbon 도
# 추가"). 페이블·astra 처럼 갈아끼우지 않고 더한다. 두 기계 계정이 다 울트라라 부를 수 있다 —
# 같은 날 두 기계에서 시험 호출 성공, 홈 응답의 모델 자기보고 "Gemini 4 Carbon".
CARBON_MODEL = "gemini-4-carbon-high"


def gemini_model():
    """회차 기록·캐시 키에 적을 제미나이 모델. 카본 자리가 서면 둘을 같이 적는다."""
    if "gemini-carbon" in POOL:
        return GEMINI_MODEL + "+" + CARBON_MODEL
    return GEMINI_MODEL


def agy_model(agent):
    """이 자리를 agy 로 부른다면 넘길 모델 이름, 아니면 None.

    호출 갈래를 이 함수 하나로 가른다 — 제미나이 자리와 agy 로 옮긴 클로드 자리가
    같은 CLI 를 쓰므로 분기를 두 벌로 두면 한쪽만 고쳐지는 자리가 생긴다.
    클로드 자리의 agy 이름에는 강도가 접미사로 붙는다(모델 이름만 넘기면 agy 가
    --effort 를 요구하며 거절한다) — 그래서 claude_effort() 를 여기서 합친다.
    """
    if agent == "gemini":
        return GEMINI_MODEL
    if agent == "gemini-carbon":
        return CARBON_MODEL
    if agent in CLAUDE_VIA_AGY:
        return "%s-%s" % (CLAUDE_MODELS[agent], claude_effort())
    return None
# codex 멤버 모델은 여기서 정하지 않는다 — codex-ask 가 `-m` 없이 부르므로 codex 쪽 단일
# 출처인 ~/.codex/config.toml 의 model 이 그대로 쓰인다(추론 강도만 역할별로 덮어쓴다).
# 다만 나중에 "그 런은 무슨 모델이었나" 를 답하려면 기록이 있어야 한다. gemini·claude 는
# 상수라 그 자체가 기록인데 codex 는 파일에 있어서 런이 끝나면 흔적이 안 남았다. 그래서
# 런 시점의 값을 읽어 metering 에 적는다. 읽기만 하고 호출에는 안 넘긴다.
def codex_model():
    try:
        p = os.path.join(os.environ.get("CODEX_HOME") or
                         os.path.expanduser("~/.codex"), "config.toml")
        with open(p, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                m = re.match(r'\s*model\s*=\s*"([^"]*)"', line)
                if m:
                    return m.group(1)
    except Exception:
        pass
    return None


def agent_codex_model(agent):
    """그 코덱스 자리가 부르는 모델. 매핑이 None 이면 설정 파일값이다."""
    return CODEX_MODELS.get(agent) or codex_model()


def effective_codex_model():
    """이 회차가 부르는 코덱스 모델 전부. 자리가 둘이면 둘 다 적는다.

    기록용이다. 이름 하나만 적으면 깊은 회차의 결론이 어느 모델에서 나왔는지를 나중에
    못 가른다 — 클로드 자리를 둘로 늘릴 때 같은 자리에서 같은 문제를 겪었다.
    """
    return ",".join(agent_codex_model(a) or "?" for a in POOL if is_codex(a))
# 한도 구간에서는 codex-ask 가 예비 모델로 한 번 다시 부른다. 그러면 설정 파일의 값과
# 실제로 답한 모델이 갈려서, 회차 기록이 설정값만 적으면 거짓이 된다. codex-ask 가 남긴
# 전환 줄은 그 호출의 raw 에 실려 오므로 그것을 센다.
# 보는 자리를 두 번 좁힌다. 하나, 코덱스 호출의 raw 만 본다. 둘, 그 안에서도 [stderr]
# 뒤 꼬리만 본다 — raw 앞쪽은 codex 의 표준출력이고 거기엔 되울린 프롬프트와 모델의 답이
# 들어 있어서, 이 전환 줄을 글자 그대로 인용한 브리프(이 기능의 검사 파일이 그렇다)가
# 전환이 없었는데 있었던 것으로 찍힌다.
# 어느 호출이 예비였는지도 같이 돌려준다. 정리자가 예비였는지가 결론을 얼마나 믿을지를
# 정하는데, 하나로 뭉쳐 놓으면 "정리자만" 과 "전부" 가 같은 기록이 된다.
_FALLBACK_LINE = re.compile(r"\[codex-ask\] 한도 소진 — 예비 모델 (\S+) 로 1회 재시도")


def codex_fallback_info(run_dir):
    model, calls = None, []
    # 코덱스 자리가 둘이라 이름이 codex 로 끝나지 않는 파일도 있다(r1.debater.codex-astra).
    # 그것까지 안 보면 예비 모델 전환이 그 자리에서만 일어났을 때 회차 기록이 "전환 없음"
    # 으로 남는다.
    pats = ["*.codex.raw.txt", "*.codex.retry.raw.txt",
            "*.codex-*.raw.txt", "*.codex-*.retry.raw.txt",
            "arbiter.raw.txt", "arbiter.retry.raw.txt", "planner.raw.txt"]
    seen = set()
    for pat in pats:
        for fp in sorted(glob.glob(os.path.join(str(run_dir), pat))):
            if fp in seen:
                continue
            seen.add(fp)
            try:
                body = open(fp, encoding="utf-8", errors="ignore").read()
            except OSError:
                continue
            tail = body.split("\n[stderr]\n", 1)
            if len(tail) < 2:
                continue
            m = _FALLBACK_LINE.search(tail[1])
            if m:
                model = model or m.group(1)
                calls.append(os.path.basename(fp)[:-len(".raw.txt")])
    return model, sorted(calls)


def codex_fallback_model(run_dir):
    return codex_fallback_info(run_dir)[0]
