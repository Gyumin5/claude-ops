#!/bin/bash
# claude-daily-report-healthcheck: claude-daily-report-dispatch(09:00 KST)가
# 실제로 24h HTML 리포트 파일을 만들었는지 관측만 하는 스크립트.
#
# 배경: dispatch의 rc=0/send_via_userbot 성공은 "프롬프트 주입 성공"만 의미하고
# 세션이 실제로 HTML을 만들었는지는 보증 안 함(ai-debate run-20260710T021224Z).
# 이 스크립트는 파일 생성(존재+size>0) 여부만 확인 — 텔레그램 전송 성공까지
# 검증하는 건 아님(그건 별개 관측 대상, 여기서 다루지 않음).
#
# 재시도 (2026-07-27, 사용자 지시):
#   09:30 단발 검사였는데 세션이 늦게 끝내면 무조건 실패로 잡혔다. 2026-07-26 에
#   두 세션이 14:04~14:05 에 정상 생성했는데도 09:30 검사가
#   missing 으로 판정해 유닛이 failed 로 남는 오탐이 실제로 발생했다.
#   그래서 타이머를 09:30~17:30 사이 2시간 간격으로 돌리고, 이 스크립트는
#   마감시각(DEADLINE_HOUR, 기본 17시) 전에는 없어도 pending 으로 로그만 남기고
#   조용히 성공 종료한다. 마감 이후 실행에서만 알림 + exit 1.
#   알림은 날짜별 마커로 하루 1회만 (반복 알림 금지).
#
# 날짜 기준: 스크립트 "실행 시점" 기준 어제(KST) 하나만 검사한다 — dispatch와
# 동일 기준(date -d yesterday, TZ Asia/Seoul)이라야 파일명이 맞음. 오래된 날짜를
# 소급 검사하지 않음(그러면 stale 알림이 계속 반복돼 노이즈만 커짐).
set -uo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/operator_chat.sh"   # 방 번호 단일 출처
export TZ=Asia/Seoul

TARGETS_FILE="$HOME/.claude/reports/daily-report-targets.txt"
FALLBACK_TELEGRAM_ENV="$HOME/dotfiles/.claude/telegram/.env"
LOG_DIR="$HOME/.claude/state/daily-report-dispatch"
LOG_FILE="$LOG_DIR/healthcheck.log"
DEADLINE_HOUR="${CLAUDE_DAILY_REPORT_DEADLINE_HOUR:-17}"
mkdir -p "$LOG_DIR" 2>/dev/null
YESTERDAY=$(date -d 'yesterday' '+%Y%m%d')
NOW_HOUR=$(date '+%-H')
ALERT_MARKER="$LOG_DIR/alerted-${YESTERDAY}"

alert_operator() {
    [ -f "$FALLBACK_TELEGRAM_ENV" ] || return 0
    # shellcheck disable=SC1090
    ( . "$FALLBACK_TELEGRAM_ENV"; tok="${TELEGRAM_BOT_TOKEN:-${BOT_TOKEN:-}}"
      [ -n "$tok" ] || exit 0
      CHAT_ID="$(operator_chat_id)" || exit 0
      curl -s -m 8 -X POST "https://api.telegram.org/bot${tok}/sendMessage" \
        --data-urlencode "chat_id=$CHAT_ID" \
        --data-urlencode "text=$1" >/dev/null 2>&1 ) || true
}

# ---- 감시자 감시 (2026-07-27 ai-debate run-20260727T094804Z) ----
# claude-session-healthcheck 는 install 상태 감시까지 맡게 됐다. 그 감시자가 죽거나
# 매달리면 아무도 모른다 — 그래서 정상 종료 때만 갱신되는 heartbeat 의 노화를
# 이미 살아 있는 이 독립 소비자가 확인한다. 새 타이머는 만들지 않는다.
# (한계: 이 유닛은 둘째 기계 전용이라 home 에는 교차확인이 없다. 이 스크립트와 감시자가
#  동시에 죽으면 침묵한다 — 토론에서 인정된 유한한 한계.)
HEARTBEAT_FILE="$HOME/.claude/state/session-healthcheck-heartbeat"
HEARTBEAT_MAX_AGE=3600           # 60분. 감시자 주기는 15분이라 4틱 여유.
HB_MARKER="$LOG_DIR/hb-alerted-$(date '+%Y%m%d')"
hb_problem=""
if [ ! -f "$HEARTBEAT_FILE" ]; then
    hb_problem="heartbeat 파일 없음(감시자가 한 번도 정상 종료하지 않았거나 삭제됨)"
else
    hb_mtime=$(stat -c %Y "$HEARTBEAT_FILE" 2>/dev/null)
    case "${hb_mtime:-x}" in
        ''|*[!0-9]*) hb_problem="heartbeat 읽기 실패(stat 불가)" ;;
        *) hb_age=$(( $(date +%s) - hb_mtime ))
           [ "$hb_age" -gt "$HEARTBEAT_MAX_AGE" ] && hb_problem="heartbeat $((hb_age / 60))분 노화(임계 $((HEARTBEAT_MAX_AGE / 60))분)" ;;
    esac
fi
if [ -n "$hb_problem" ]; then
    echo "$(date -Iseconds) heartbeat-problem: $hb_problem" >> "$LOG_FILE" 2>/dev/null
    if [ ! -f "$HB_MARKER" ]; then
        alert_operator "[healthcheck-watch] claude-session-healthcheck 이상 — ${hb_problem}. install 상태 감시도 같이 멎은 상태다. 확인: systemctl --user status claude-session-healthcheck.timer"
        : > "$HB_MARKER"
    fi
else
    rm -f "$HB_MARKER" 2>/dev/null
fi

# 여기부터 리포트 생성 검사. targets 파일 없으면 이 머신은 대상 아님.
[ -f "$TARGETS_FILE" ] || exit 0

# claude-daily-report-dispatch/claude-daily-reports-backup-sync와 동일한 resolver.
# $HOME/$session 폴백 없음 — 잘못된 경로를 "정상"으로 오판하는 것보다 스킵이 낫다.
resolve_session_workdir() {
    local session="$1" wd
    wd=$(systemctl --user show "claude-${session}.service" -p WorkingDirectory --value 2>/dev/null)
    [ -z "$wd" ] && return 1
    [ "$wd" = "/" ] && return 1
    [ "$wd" = "$HOME" ] && return 1
    [ -d "$wd" ] || return 1
    printf '%s\n' "$wd"
}

# 마감 전이면 아직 만드는 중일 수 있으므로 알림 대상이 아니다.
FINAL=0
[ "$NOW_HOUR" -ge "$DEADLINE_HOUR" ] && FINAL=1

MISSING=()
while IFS= read -r SESSION; do
    SESSION="$(printf '%s' "$SESSION" | sed 's/#.*//' | xargs)"
    [ -z "$SESSION" ] && continue

    WD=$(resolve_session_workdir "$SESSION")
    if [ -z "$WD" ]; then
        echo "$(date -Iseconds) session=${SESSION} result=skip reason=workdir_resolve_failed" >> "$LOG_FILE"
        MISSING+=("${SESSION}(workdir 해석 실패)")
        continue
    fi

    # 이름이 두 가지다. 한 계열의 세션들은 reports 디렉토리를 공유해서 서로 덮어쓰는 걸 막으려고
    # 세션 접미사를 붙인다(work_report_24h_<날짜>.<세션>.html). 접미사 없는 이름만 보면
    # 파일이 멀쩡히 있는데 "생성 안 됨"으로 짖는다 — 08-01·08-02 그 계열 두 세션의
    # 경보가 그것이었다. 접미사 쪽을 없애면 공유 디렉토리 충돌이 되살아나므로 둘 다 인정한다.
    HTML="${WD}/reports/work_report_24h_${YESTERDAY}.html"
    HTML_SUFFIXED="${WD}/reports/work_report_24h_${YESTERDAY}.${SESSION}.html"
    [ -s "$HTML" ] || [ ! -s "$HTML_SUFFIXED" ] || HTML="$HTML_SUFFIXED"
    if [ -s "$HTML" ]; then
        echo "$(date -Iseconds) session=${SESSION} result=ok file=${HTML}" >> "$LOG_FILE"
    elif [ "$FINAL" -eq 0 ]; then
        # 아직 마감 전 — 지연 생성 가능. 관측만 하고 실패로 치지 않는다.
        echo "$(date -Iseconds) session=${SESSION} result=pending file=${HTML}" >> "$LOG_FILE"
        MISSING+=("${SESSION}(${HTML} 없음/0바이트, 접미사 형식도 없음)")
    else
        echo "$(date -Iseconds) session=${SESSION} result=missing file=${HTML}" >> "$LOG_FILE"
        MISSING+=("${SESSION}(${HTML} 없음/0바이트, 접미사 형식도 없음)")
    fi
done < "$TARGETS_FILE"

if [ "${#MISSING[@]}" -eq 0 ]; then
    # 전부 생성됨 — 이 날짜 알림 마커가 남아 있으면 정리(다음 날 재사용 대비).
    rm -f "$ALERT_MARKER" 2>/dev/null
    exit 0
fi

if [ "$FINAL" -eq 0 ]; then
    # 마감 전 미생성은 정상 경로. 알림도 실패도 없음 — 다음 틱에서 재검사한다.
    exit 0
fi

if [ ! -f "$ALERT_MARKER" ]; then
    alert_operator "[daily-report-healthcheck] ${YESTERDAY} 리포트 생성 안 됨(마감 ${DEADLINE_HOUR}시 기준): $(printf '%s, ' "${MISSING[@]}")(전송 성공 여부와는 별개 — 파일 생성만 확인함)"
    : > "$ALERT_MARKER"
fi
exit 1
