# 세션 하나를 systemd user 유닛으로 띄우는 본보기.
#
# 쓰는 법: <이름> 을 세션 이름으로 바꿔 ~/.config/systemd/user/claude-<이름>.service 로
# 저장하고 `systemctl --user enable --now claude-<이름>` 한다. 이름은 그 세션의 작업
# 폴더 이름과 같게 두는 것이 편하다 — 로그 파일과 텔레그램 상태 폴더가 그 이름을 따른다.
#
# 세션마다 유닛 하나다. 한 유닛에 여러 세션을 묶지 않는다 — 하나가 죽으면 같이 죽고,
# 어느 쪽이 멈췄는지가 로그에서 안 갈린다.

[Unit]
Description=Claude Code session for <이름> (telegram remote-control)
After=network-online.target
Wants=network-online.target
# 텔레그램 설정이 없으면 아예 안 뜬다. 떠서 조용히 아무 데도 못 보내는 것보다 낫다.
ConditionPathExists=%h/<작업폴더>/.claude/telegram/.env

[Service]
Type=simple
WorkingDirectory=%h/<작업폴더>
Environment="CLAUDE_SESSION_NAME=<이름>"
Environment="PATH=%h/.bun/bin:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="TELEGRAM_STATE_DIR=%h/<작업폴더>/.claude/telegram"
Environment="TERM=xterm-256color"
# 부팅 직후에는 네트워크가 서기 전에 텔레그램 쪽이 먼저 떠서 죽는 자리가 있다.
# 이 줄을 켜면 claude-service-exec 가 뜨기 전에 네트워크를 한 번 재고 기다린다.
# 부팅할 때 그 세션만 텔레그램이 안 붙는 기계에서 켠다.
#Environment="CLAUDE_NET_WAIT=1"
ExecStart=%h/.local/bin/claude-service-exec
ExecStartPost=%h/.local/bin/claude-service-notify start claude-<이름>
ExecStopPost=%h/.local/bin/claude-service-notify stop claude-<이름>
Restart=always
RestartSec=5
StandardOutput=append:%h/.claude/logs/claude-<이름>.log
StandardError=append:%h/.claude/logs/claude-<이름>.log
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=default.target
