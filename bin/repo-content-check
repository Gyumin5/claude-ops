#!/usr/bin/env python3
"""추적 파일 내용 검사 — 경계 안에 있어도 담으면 안 되는 값을 막는다.

경로 검사(bin/repo-scope-check)는 어느 파일을 추적하느냐만 본다. 허용된 경로 안에
적힌 값은 못 보므로 이 검사가 그 자리를 맡는다. R76 의 "허용된 경로 안에서도
개인·회사별 구체 데이터는 추적 밖 설정 파일로 분리한다" 가 근거다.

세는 것 넷: 사업자등록번호, 주민등록번호, 카드번호, 그리고 메일 주소.
메일은 허용 도메인 밖이면 전부 잡는다(fail-closed) — 새 도메인이 들어오면 막히는 쪽이
맞다. 실명·계좌번호는 형식이 자유로워 문자열로 못 가른다. 그건 사람이 본다.

쓰는 법:
    repo-content-check            스테이징된 추가·수정 파일, 인덱스 내용으로 (.githooks/pre-commit)
    repo-content-check --all      추적 파일 전부 (bin/repo-push-check)
    repo-content-check --objects-stdin   stdin 의 "<blob sha> <경로>" 줄마다 그 blob 내용을
                                  읽어 검사한다 — 이번에 밀려 나가는 내용 (같은 곳에서 부른다)
    repo-content-check <경로>...   준 경로만 (검사 코드)

종료코드 0 통과, 1 위반, 2 검사 자체가 못 돈 것.
"""
import os
import pathlib
import re
import subprocess
import sys

REPO = pathlib.Path(__file__).resolve().parent.parent
SELF = pathlib.Path(__file__).resolve()

NUMBER_PATTERNS = [
    ("사업자등록번호", re.compile(r"(?<!\d)\d{3}-\d{2}-\d{5}(?!\d)")),
    ("주민등록번호", re.compile(r"(?<!\d)\d{6}-[1-4]\d{6}(?!\d)")),
    ("카드번호", re.compile(r"(?<!\d)\d{4}-\d{4}-\d{4}-\d{4}(?!\d)")),
]

EMAIL = re.compile(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?\.[A-Za-z]{2,}")

# 메일처럼 보이지만 사람 주소가 아닌 것들.
ALLOWED_DOMAINS = {
    "anthropic.com",            # 커밋 귀속 줄
    "claude.com",
    "github.com",               # ssh 원격 주소 (git@github.com:...)
    "users.noreply.github.com",  # 공개 커밋 귀속
    "example.com", "example.org", "example.net",  # 본보기
    "localhost",
}
# systemd 템플릿 인스턴스(claude-session-nudge@delta.service, user@1000.service 등).
UNIT_SUFFIX = (".service", ".timer", ".socket", ".slice", ".scope", ".target",
               ".mount", ".path", ".device", ".swap")
# RFC 2606 이 본보기·시험용으로 예약한 최상위 도메인. 등록될 수 없으므로 그 아래
# 주소는 사람 주소가 될 수 없다 — 검사 코드가 쓰는 가짜 주소가 여기에 든다.
RESERVED_TLD = (".invalid",)


def is_allowed_email(addr):
    domain = addr.split("@", 1)[1].lower()
    if domain in ALLOWED_DOMAINS:
        return True
    return domain.endswith(UNIT_SUFFIX) or domain.endswith(RESERVED_TLD)


def git(*args):
    try:
        return subprocess.run(["git", "-C", str(REPO), *args],
                              capture_output=True, check=True, timeout=120).stdout
    except (OSError, subprocess.SubprocessError) as exc:
        print(f"repo-content-check: git 호출이 실패했다: {exc}", file=sys.stderr)
        sys.exit(2)


def staged_paths():
    out = git("diff", "--cached", "--name-only", "-z", "--diff-filter=ACMRT")
    return [p for p in out.decode("utf-8", "replace").split("\0") if p]


def tracked_paths():
    out = git("ls-files", "-z")
    return [p for p in out.decode("utf-8", "replace").split("\0") if p]


def index_text(rel):
    """인덱스에 올라간 그 파일의 내용. 평범한 파일이 아니거나 없으면 None.

    작업 트리가 아니라 인덱스를 읽는 이유는 커밋되는 것이 인덱스이기 때문이다.
    둘은 다를 수 있다 — 민감한 내용을 스테이징한 다음 작업 파일만 정리하면, 작업
    트리를 읽는 검사에는 깨끗하게 보이고 커밋에는 그 내용이 그대로 들어간다.
    """
    p = subprocess.run(["git", "-C", str(REPO), "ls-files", "-s", "-z", "--", rel],
                       capture_output=True, timeout=120)
    entry = p.stdout.decode("utf-8", "replace").split("\0")[0]
    if p.returncode != 0 or not entry or not entry.startswith("100"):
        return None          # 인덱스에 없거나 심링크(120000)·하위모듈(160000)
    p = subprocess.run(["git", "-C", str(REPO), "show", ":" + rel],
                       capture_output=True, timeout=120)
    if p.returncode != 0:
        return None
    try:
        return p.stdout.decode("utf-8")
    except UnicodeDecodeError:
        return None


def blob_text(sha):
    """그 blob 의 내용. 읽을 수 없거나 글이 아니면 None."""
    p = subprocess.run(["git", "-C", str(REPO), "cat-file", "blob", sha],
                       capture_output=True, timeout=120)
    if p.returncode != 0:
        return None
    try:
        return p.stdout.decode("utf-8")
    except UnicodeDecodeError:
        return None


def findings(rel, from_index=False, text=None):
    """그 파일에서 찾은 것들. 읽을 수 없으면 빈 목록.

    text 를 주면 그걸 본다 — 미는 자리에서 blob 내용을 그대로 넘기는 길이다.
    """
    path = REPO / rel
    if path.resolve() == SELF:  # 이 검사 자신의 본보기·허용 목록은 세지 않는다
        return []
    if text is not None:
        pass
    elif from_index:
        text = index_text(rel)
        if text is None:
            return []
    else:
        if not path.is_file() or path.is_symlink():
            return []
        try:
            text = path.read_text(encoding="utf-8")
        except (UnicodeDecodeError, OSError):
            return []
    out = []
    for label, pattern in NUMBER_PATTERNS:
        for m in pattern.finditer(text):
            out.append((text.count("\n", 0, m.start()) + 1, label, m.group(0)))
    for m in EMAIL.finditer(text):
        if is_allowed_email(m.group(0)):
            continue
        out.append((text.count("\n", 0, m.start()) + 1, "메일 주소", m.group(0)))
    return out


def main(argv):
    # 커밋되는 것은 인덱스다. 스테이징분을 볼 때는 작업 트리가 아니라 인덱스를 읽는다.
    from_index = False
    objects = None
    if argv and argv[0] == "--all":
        paths = tracked_paths()
    elif argv and argv[0] == "--objects-stdin":
        paths = []
        objects = []
        for line in sys.stdin.buffer.read().decode("utf-8", "replace").splitlines():
            sha, _, rel = line.partition(" ")
            if sha and rel:
                objects.append((sha, rel))
    elif argv:
        paths = argv
    else:
        paths = staged_paths()
        from_index = True

    hits = []
    for rel in paths:
        norm = os.path.normpath(rel).replace(os.sep, "/")
        for line, label, value in findings(norm, from_index=from_index):
            hits.append(f"  {norm}:{line}  {label}: {value}")
    for sha, rel in objects or []:
        text = blob_text(sha)
        if text is None:
            continue
        norm = os.path.normpath(rel).replace(os.sep, "/")
        for line, label, value in findings(norm, text=text):
            hits.append(f"  {norm}:{line}  {label}: {value}  (미는 내용 {sha[:9]})")

    if hits:
        print("저장소에 담으면 안 되는 값이 있다:", file=sys.stderr)
        print("\n".join(hits), file=sys.stderr)
        print("\n추적 밖 설정(~/.config/dotfiles-private/)으로 옮기고 코드가 거기서 읽게 한다.\n"
              "본보기나 기계 이름이라 담아도 되는 것이면 bin/repo-content-check 의 허용 목록을\n"
              "고치고 그 이유를 같은 커밋에 적는다.", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
