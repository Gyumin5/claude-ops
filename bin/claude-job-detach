#!/bin/bash
# claude-job-detach: systemd-run detach 장시간작업용 재사용 알림 래퍼.
#
# 배경: CLAUDE.md "장시간 작업 실행 = 3갈래 판단" 3번(체크포인트 불가능+길거나
# 비용큰 작업)은 systemd-run --collect로 detach하되, 매번 손으로 텔레그램 curl
# 알림 로직을 짜지 말고 이 래퍼를 통해 실행하라는 게 2026-07-07 ai-debate
# run-20260707T041213Z 결론이었음. 시작/종료 알림 + 로그저장 + exit code를
# 표준화해서 반복 보일러플레이트 제거.
#
# 사용법(2026-07-09 개정 — launch entrypoint 패턴, ai-debate run-20260708T220504Z):
#   세션 문맥에서 systemd-run 을 손으로 조립하지 말고 이 스크립트를 직접 호출한다:
#     $HOME/dotfiles/bin/claude-job-detach --slug <slug> \
#       [--notify-start] [--notify-success] -- <cmd...>
#   내부에서 발신 세션 신원(CLAUDE_SESSION_NAME 또는 cgroup)과 호스트를 캡처해
#   systemd-run --setenv 로 각인한 뒤 자기 자신을 --inner 모드로 재실행 detach한다.
#
#   배경: 2026-07-08 peer 실사례(claude-job-mono-lag-sweep-...) — 유닛명 규약
#   (claude-job-<session>-<slug>-<ts>)을 어기고 슬러그 자리에 세션명처럼 보이는
#   문자열("mono")이 들어가자, 완료보고 시점(이미 detach된 유닛 안 = 발신 세션
#   문맥이 사라진 뒤)엔 유닛명에서 역산하는 것 외엔 발신 세션을 복원할 방법이
#   없어 "mono"를 세션명으로 오인했다(relay-alias 미등록이라 fail-closed는
#   정상 작동했지만, 결과적으로 사람 직접 알림으로 낙하하는 UX 반복). 그래서
#   신원 캡처를 "이미 detach된 뒤"가 아니라 "아직 발신 세션 문맥이 살아있는
#   launch 시점"으로 앞당김 — 이게 이 개정의 핵심.
#
# --notify-start:   시작할 때도 텔레그램 알림(사람에게 직접, 기본은 시작시 조용).
# --notify-success: 정상 완료시에도 알림(기본은 succeed-silent — 실패시만 알림).
#                   결과를 세션이 나중에(재시작 후 등) 소비해야 하면 반드시 이 플래그 사용.
#                   완료 알림은 사람이 아니라 이 job을 launch한 세션 자신의 봇 채팅에
#                   claude-userbot-send로 주입한다 — 그래야 그 세션이 다음 턴에 정상
#                   inbound 메시지로 받아 이어받는다(2026-07-07 사용자 지적 반영: 완료를
#                   사람한테 직접 보내면 세션이 못 받고 사람만 알림 받는 꼴이 됨).
#                   실패는 사람 개입이 필요할 수 있어 계속 사람에게 직접(텔레그램) 알림.
#
# 세션명 해석 우선순위(완료측, --inner 모드 안):
#   1) CLAUDE_DETACH_ORIGIN_SESSION 환경변수(launch 시점에 --setenv 로 각인, 가장 신뢰).
#   2) legacy: 유닛명에서 등록된 세션명(targets.json ∪ relay-alias.json 키)과
#      최장 접두사 일치(하이픈 섞인 세션명, 예: peer-dotfiles, 잘못 잘리는 것 방지).
#   3) legacy 최후: 옛 방식(첫 하이픈까지만) — 등록 안 된 신규/규약위반 유닛명이면
#      결과적으로 relay-alias 조회가 실패해 tier-3(사람 직접)로 자연히 떨어짐.
#   각 경로에서 어떤 근거로 세션명을 골랐는지 SESSION_FALLBACK_REASON 에 남겨서
#   tier-3 메시지에 사유를 명시한다(ai-debate 지적: "왜 떨어졌는지" 필수 표기).
#
# 착수시점(launch, outer 모드) 검증은 경고 전용이다 — registry(targets.json/
# relay-alias.json) 에 발신 세션이 없다고 작업 자체를 막지 않는다(신규/임시
# 세션까지 강제 차단하면 과잉; ai-debate 명시 결론).
set -uo pipefail

# 고정 배포경로를 그대로 씀(이 저장소 관례 — USERBOT_SEND 등 다른 절대경로들과
# 동일 패턴) — $0 기반 계산은 bare PATH 호출("claude-job-detach"만, 슬래시 없음)
# 시 dirname이 "."로 떨어져 CWD 기준으로 잘못 풀리는 실사용 결함이 있었음
# (ai-debate run-20260708T222719Z 지적). 심링크(peer ~/.local/bin/ 경유 호출)로
# 불려도 항상 이 고정 경로가 맞다.
SELF="$HOME/dotfiles/bin/claude-job-detach"
ENV_FILE="$(pwd)/.claude/telegram/.env"
# 잡 cwd 에 .env 가 없으면 dotfiles 봇으로 보낸다(의도된 동작 — 발신세션이 텔레그램에
# 안 붙어 있을 수도 있으므로 확실히 도달하는 채널로 보낸다, 2026-07-22 사용자 확정).
# 대신 "어느 세션/폴더에서 온 잡인지"를 메시지에 반드시 실어보낸다(tier3_suffix).
[ -f "$ENV_FILE" ] || ENV_FILE="$HOME/dotfiles/.claude/telegram/.env"
CHAT_ID="${TELEGRAM_CHAT_ID:-}"
USERBOT_SEND="$HOME/dotfiles/bin/claude-userbot-send"
USERBOT_TARGETS="$HOME/.claude/userbot/targets.json"
RELAY_CONF="$HOME/.claude/userbot/relay.conf"
RELAY_ALIAS_FILE="$HOME/.claude/userbot/relay-alias.json"
LOG_DIR="$HOME/claude-work/jobs"
mkdir -p "$LOG_DIR" 2>/dev/null

send_tg() {
    local text="$1"
    [ -f "$ENV_FILE" ] || return 0
    # shellcheck disable=SC1090
    . "$ENV_FILE"
    [ -n "${TELEGRAM_BOT_TOKEN:-}" ] || return 0
    curl -s --max-time 10 -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
        --data-urlencode "chat_id=${CHAT_ID}" \
        --data-urlencode "text=${text}" >/dev/null 2>&1
}

# ---- 세션명이 targets.json 또는 relay-alias.json 어딘가에 등록돼 있는지 ----
session_is_known() {
    local session="$1"
    python3 -c "
import json
names = set()
for path in ('$USERBOT_TARGETS', '$RELAY_ALIAS_FILE'):
    try:
        names.update(json.load(open(path)).keys())
    except Exception:
        pass
raise SystemExit(0 if '$session' in names else 1)
" 2>/dev/null
}

# ==================================================================
# ---- OUTER(launch) 모드: 세션 문맥에서 직접 호출됨 ----
# ==================================================================
if [ "${1:-}" != "--inner" ]; then
    slug=""
    passthrough=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --slug) shift; slug="${1:-}"; shift ;;
            --notify-start|--notify-success) passthrough+=("$1"); shift ;;
            --) shift; break ;;
            *) echo "usage: claude-job-detach --slug <slug> [--notify-start] [--notify-success] -- <cmd...>" >&2; exit 2 ;;
        esac
    done
    [ -n "$slug" ] || { echo "usage: --slug <slug> 필요" >&2; exit 2; }
    OUTER_CMD=("$@")
    [ "${#OUTER_CMD[@]}" -gt 0 ] || { echo "usage: -- <cmd...> 필요" >&2; exit 2; }

    # 발신 세션 신원 — 아직 세션 문맥이 살아있는 지금(detach 전)만 확실히 알 수 있음.
    ORIGIN_SESSION="${CLAUDE_SESSION_NAME:-}"
    if [ -z "$ORIGIN_SESSION" ]; then
        ORIGIN_SESSION=$(grep -oE 'claude-[^/]+\.service' /proc/self/cgroup 2>/dev/null | head -1 | sed 's/^claude-//; s/\.service$//')
    fi
    # 발신 호스트는 machine-id 로 판정한다. `~/.claude/userbot/host` 는 "유저봇이 있는
    # 호스트"(= 릴레이 대상)라 자기 신원이 아니다 — peer 에서 그 파일은 "home" 이어서
    # peer 이 띄운 잡의 발신호스트가 home 으로 보고됐다(2026-07-28 사용자 신고).
    ORIGIN_HOST=$(cat "$HOME/.config/claude-machine-id" 2>/dev/null)
    ORIGIN_HOST=${ORIGIN_HOST:-$(hostname -s 2>/dev/null || echo unknown)}

    # 착수시점 검증은 경고 전용 — registry 미등록만으로 작업을 막지 않는다.
    if [ -n "$ORIGIN_SESSION" ]; then
        if ! session_is_known "$ORIGIN_SESSION"; then
            echo "[claude-job-detach] 경고: 발신세션 '${ORIGIN_SESSION}' 이 targets.json/relay-alias.json 어디에도 등록 안 됨 — 완료보고가 tier-3(사람 직접 알림)으로 떨어질 수 있음. 작업은 그대로 진행." >&2
        fi
    else
        echo "[claude-job-detach] 경고: 발신세션명을 못 찾음(CLAUDE_SESSION_NAME/cgroup 둘 다 없음) — 완료보고가 tier-3로 떨어질 수 있음. 작업은 그대로 진행." >&2
    fi

    # systemd unit 이름에 안전하지 않은 문자(공백, 슬래시 등)가 세션명/슬러그에
    # 섞이면 systemd-run 자체가 실패할 수 있어 미리 정규화(ai-debate 지적).
    UNIT_SESSION=$(printf '%s' "${ORIGIN_SESSION:-unknown}" | tr -c 'A-Za-z0-9_.-' '_')
    UNIT_SLUG=$(printf '%s' "$slug" | tr -c 'A-Za-z0-9_.-' '_')

    # detach 후에도 원래 작업 디렉토리에서 커맨드가 돌게 보존 — systemd-run은
    # 기본적으로 호출자의 cwd를 안 물려받고 자체 기본 WorkingDirectory를 쓰므로,
    # 명시 안 하면 상대경로 기반 작업이 엉뚱한 곳(대개 $HOME)에서 실행돼 깨짐
    # (ai-debate 실사용결함 지적).
    CALLER_CWD="$(pwd)"

    TS=$(date +%s)
    UNIT="claude-job-${UNIT_SESSION}-${UNIT_SLUG}-${TS}"
    exec systemd-run --user --unit="${UNIT}" --collect \
        --working-directory="${CALLER_CWD}" \
        --setenv="CLAUDE_DETACH_ORIGIN_SESSION=${ORIGIN_SESSION}" \
        --setenv="CLAUDE_DETACH_ORIGIN_HOST=${ORIGIN_HOST}" \
        "$SELF" --inner "${passthrough[@]}" -- "${OUTER_CMD[@]}"
fi

# ==================================================================
# ---- INNER 모드: 이미 detach된 유닛 안(발신 세션 문맥 없음) ----
# ==================================================================
shift  # drop leading --inner

notify_start=0
notify_success=0
while [ $# -gt 0 ]; do
    case "$1" in
        --notify-start) notify_start=1; shift ;;
        --notify-success) notify_success=1; shift ;;
        --) shift; break ;;
        *) break ;;
    esac
done
CMD=("$@")
if [ "${#CMD[@]}" -eq 0 ]; then
    echo "usage(inner): claude-job-detach --inner [--notify-start] [--notify-success] -- <cmd...>" >&2
    exit 2
fi

UNIT_NAME=$(grep -o 'claude-job-[^/]*\.service' /proc/self/cgroup 2>/dev/null | head -1)
UNIT_NAME="${UNIT_NAME:-claude-job-unknown}"
JOB_ID="${UNIT_NAME%.service}"
REST="${JOB_ID#claude-job-}"

# legacy: 등록된 세션명(targets.json ∪ relay-alias.json)과 REST 의 최장 접두사
# 일치를 찾는다 — 하이픈 섞인 세션명(peer-dotfiles 등)이 첫 하이픈 컷으로
# 잘못 잘리는 걸 방지. 못 찾으면 옛 방식(첫 하이픈까지)으로 최종 폴백.
legacy_match_session() {
    local rest="$1"
    python3 -c "
import json
names = set()
for path in ('$USERBOT_TARGETS', '$RELAY_ALIAS_FILE'):
    try:
        names.update(json.load(open(path)).keys())
    except Exception:
        pass
rest = '$rest'
best = ''
for n in names:
    if n and (rest == n or rest.startswith(n + '-')) and len(n) > len(best):
        best = n
print(best)
" 2>/dev/null
}

SESSION_FALLBACK_REASON=""
if [ -n "${CLAUDE_DETACH_ORIGIN_SESSION:-}" ]; then
    SESSION_NAME="$CLAUDE_DETACH_ORIGIN_SESSION"
    SESSION_FALLBACK_REASON="origin env(CLAUDE_DETACH_ORIGIN_SESSION)"
else
    SESSION_NAME=$(legacy_match_session "$REST")
    if [ -n "$SESSION_NAME" ]; then
        SESSION_FALLBACK_REASON="origin env 없음 → legacy 유닛명 최장일치: '${SESSION_NAME}'"
    else
        SESSION_NAME="${REST%%-*}"
        SESSION_FALLBACK_REASON="origin env 없음, legacy 최장일치도 실패 → 첫 토큰 사용: '${SESSION_NAME}'(등록 안 된 이름일 수 있음)"
    fi
fi
# 각인값이 없으면(구버전 유닛에서 재개된 잡 등) 지금 이 머신의 machine-id 가 최선의
# 근사다 — inner 는 launch 한 머신에서 그대로 돌기 때문. 그마저 없을 때만 불명.
ORIGIN_HOST_INFO="${CLAUDE_DETACH_ORIGIN_HOST:-$(cat "$HOME/.config/claude-machine-id" 2>/dev/null)}"
ORIGIN_HOST_INFO="${ORIGIN_HOST_INFO:-불명}"
LOG_FILE="$LOG_DIR/${JOB_ID}.log"
CWD="$(pwd)"
START_TS=$(date +%s)

# 로컬 세션명 -> 릴레이 대상 머신에서의 별칭 변환(예: peer 머신의 로컬 "dotfiles"
# 세션은 home targets.json 의 "dotfiles" 키(=home 자기 세션)와 겹쳐 오배송되므로
# "peer-dotfiles" 로 바꿔야 함). ~/.claude/userbot/relay-alias.json(머신 로컬,
# git 비추적)에 명시적으로 등록된 세션만 릴레이 허용 — 파일이 없거나 이 세션의
# 키가 없으면 실패를 반환해 릴레이를 포기시킨다(아래 inject_session 참고).
# ai-debate run-20260708T125143Z 지적 반영: "매핑 없으면 이름 그대로 릴레이"는
# 다른 머신의 동명 세션으로 조용히 오배송될 위험이 있어(예: peer 로컬 dotfiles가
# home 자기 dotfiles로) fail-open 대신 fail-closed 로 바꿈 — 새 세션은 릴레이
# 전에 relay-alias.json 에 명시 등록 필요(등록 전엔 최후 fallback으로 안전하게
# 떨어질 뿐, 무동작은 아님).
resolve_relay_alias() {
    local session="$1"
    [ -f "$RELAY_ALIAS_FILE" ] || return 1
    local mapped
    mapped=$(python3 -c "
import json
try:
    with open('$RELAY_ALIAS_FILE') as f:
        m = json.load(f)
    v = m.get('$session')
    if v:
        print(v)
except Exception:
    pass
" 2>/dev/null)
    [ -n "$mapped" ] || return 1
    printf '%s' "$mapped"
}

# 세션 자신에게 주입(그 세션의 다음 턴이 정상 inbound 로 받아 해석 후 이어받음/사람에게
# 재설명). 성공·실패 둘 다 이 경로 — 사람이 raw 로그덤프를 직접 받아도 판단 못 하니
# 세션이 먼저 해석하게 한다(2026-07-07 사용자 지적). 주입 자체가 실패하면(세션 못 찾음
# 등) send_tg 로 사람에게 직접 알리는 걸 최후 fallback 으로만 남긴다.
#
# 3단 경로(2026-07-08 peer 신고 반영 — peer 머신엔 telethon userbot 미설정이라
# 로컬 claude-userbot-send --session 이 항상 실패해 완료보고가 사람에게 raw 로
# 떨어짐):
#   1) 로컬에 userbot 설정(targets.json) 있으면 그대로 로컬 claude-userbot-send.
#   2) 없으면 relay.conf 의 USERBOT_HOST 로 ssh 릴레이 — claude-soft-restart /
#      claude-daily-report-dispatch 와 동일 패턴 재사용. 크리덴셜은 relay-host 에만
#      유지, 이쪽엔 새로 안 깜. relay-host 가 이미 로컬(=여기가 home)이면 1)에서
#      이미 성공했을 것이므로 이 경로에 도달 자체가 안 됨 — 별도 self-loop 체크 불필요.
#      relay-alias.json 에 이 세션명이 명시 등록돼 있지 않으면 릴레이 자체를
#      포기한다(fail-closed). 새 세션을 릴레이 대상에 넣으려면 그 머신의
#      relay-alias.json 에 명시 추가 필요.
#   3) 위 둘 다 실패하면(또는 등록 안 된 세션이면) send_tg 로 사람 직접(최후
#      fallback). 이때 INJECT_FAIL_REASON 에 실패 지점을 남겨 메시지에 포함한다
#      (ai-debate 지적: tier-3 낙하 사유를 사람이 알 수 있어야 함).
# ssh 로 넘기는 텍스트는 로그 tail 등 임의 내용을 포함할 수 있어 printf %q 로
# 셸 안전 이스케이프 후 원격 커맨드 문자열에 넣는다(작은따옴표 그대로 감싸면 텍스트에
# 따옴표가 섞였을 때 원격 셸 인젝션 위험 — claude-soft-restart 류의 '${text}' 방식은
# 이 새 코드에는 그대로 재사용하지 않음).
INJECT_FAIL_REASON=""
# 출처 꼬리표(claude-userbot-send 의 [[xsrc:from=...]])는 반드시 우리가 명시해서 넘긴다.
# 넘기지 않으면 발송을 실제로 수행하는 쪽에서 계산되는데, 그 시점의 문맥은
# (a) ssh 릴레이면 릴레이 호스트(home), (b) 로컬이면 claude-job-<...> 유닛 cgroup 이라
# 세션명을 못 찾는다 → 실제로 `home/?` 로 찍혔다(2026-07-28 사용자 신고). 발신 신원은
# launch 시점에만 확실하므로 그때 각인한 값을 그대로 전달한다.
origin_tag() {
    local h s
    h="${ORIGIN_HOST_INFO:-unknown}"
    [ "$h" = "불명" ] && h="unknown"      # 비ASCII 는 아래 tr 에서 밑줄로 뭉개진다
    h=$(printf '%s' "$h" | tr -c 'A-Za-z0-9_.-' '_')
    s=$(printf '%s' "${SESSION_NAME:-unknown}" | tr -c 'A-Za-z0-9_.-' '_')
    printf '%s/%s' "$h" "$s"
}
inject_session() {
    local text="$1"
    if [ -z "$SESSION_NAME" ]; then
        INJECT_FAIL_REASON="세션명 해석 실패"
        return 1
    fi

    if [ -x "$USERBOT_SEND" ] && [ -f "$USERBOT_TARGETS" ]; then
        if "$USERBOT_SEND" --session "$SESSION_NAME" --origin "$(origin_tag)" "$text" >/dev/null 2>&1; then
            return 0
        fi
        INJECT_FAIL_REASON="로컬 userbot-send 실패(세션 '${SESSION_NAME}' targets.json 미등록 가능)"
        return 1
    fi

    if [ -f "$RELAY_CONF" ]; then
        # shellcheck disable=SC1090
        . "$RELAY_CONF"
        case "${USERBOT_HOST:-}" in
            *@*) ;;
            *) INJECT_FAIL_REASON="relay.conf 의 USERBOT_HOST 값이 비어있거나 형식이상"; return 1 ;;
        esac
        local mapped quoted_session quoted_text
        if ! mapped=$(resolve_relay_alias "$SESSION_NAME"); then
            INJECT_FAIL_REASON="relay-alias.json 미등록(세션 '${SESSION_NAME}')"
            return 1
        fi
        local quoted_origin
        quoted_session=$(printf '%q' "$mapped")
        quoted_text=$(printf '%q' "$text")
        quoted_origin=$(printf '%q' "$(origin_tag)")
        # --no-relay: 별칭을 여기서 이미 해석했으므로 원격이 다시 릴레이하면 안 된다(재귀 가드).
        if timeout 30 ssh -n -o BatchMode=yes -o ConnectTimeout=10 "$USERBOT_HOST" \
            "~/.local/bin/claude-userbot-send --session --no-relay --origin ${quoted_origin} ${quoted_session} ${quoted_text}" >/dev/null 2>&1; then
            return 0
        fi
        INJECT_FAIL_REASON="ssh 릴레이 실패(host=${USERBOT_HOST})"
        return 1
    fi

    INJECT_FAIL_REASON="로컬 userbot 미설정 + relay.conf 없음"
    return 1
}

tier3_suffix() {
    echo "
[발신세션 추정: ${SESSION_NAME:-불명} / 발신폴더: ${CWD:-불명} / 근거: ${SESSION_FALLBACK_REASON} / 발신호스트: ${ORIGIN_HOST_INFO} / 세션주입 실패사유: ${INJECT_FAIL_REASON}]"
}

if [ "$notify_start" = 1 ]; then
    inject_session "detach 작업 시작 — ${JOB_ID} (cwd=${CWD})
cmd: ${CMD[*]}" || send_tg "▶ detach 작업 시작 — ${JOB_ID} (cwd=${CWD}, 세션주입 실패라 직접알림)
cmd: ${CMD[*]}$(tier3_suffix)"
fi

"${CMD[@]}" > "$LOG_FILE" 2>&1
rc=$?
DUR=$(( $(date +%s) - START_TS ))

if [ "$rc" -ne 0 ]; then
    tail_out=$(tail -c 800 "$LOG_FILE" 2>/dev/null)
    inject_session "detach 작업 실패 — ${JOB_ID} (exit=${rc}, ${DUR}s)
cmd: ${CMD[*]}
로그tail:
${tail_out}
전체로그: ${LOG_FILE}
journalctl: journalctl --user -u ${UNIT_NAME} --no-pager | tail -50" || send_tg "⚠ detach 작업 실패 — ${JOB_ID} (exit=${rc}, ${DUR}s, 세션주입 실패라 직접알림)
cmd: ${CMD[*]}
로그tail:
${tail_out}
전체로그: ${LOG_FILE}
journalctl: journalctl --user -u ${UNIT_NAME} --no-pager | tail -50$(tier3_suffix)"
elif [ "$notify_success" = 1 ]; then
    tail_out=$(tail -c 500 "$LOG_FILE" 2>/dev/null)
    inject_session "detach 작업 완료 — ${JOB_ID} (${DUR}s)
cmd: ${CMD[*]}
로그tail:
${tail_out}
전체로그: ${LOG_FILE}" || send_tg "✅ detach 작업 완료 — ${JOB_ID} (${DUR}s, 세션주입 실패라 직접알림)
cmd: ${CMD[*]}
로그tail:
${tail_out}
전체로그: ${LOG_FILE}$(tier3_suffix)"
fi

exit "$rc"
