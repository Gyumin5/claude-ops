[Unit]
Description=Claude Code session for resume (telegram remote-control)
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/resume/.claude/telegram/.env

[Service]
Type=simple
WorkingDirectory=%h/resume
Environment="CLAUDE_SESSION_NAME=resume"
Environment="PATH=%h/.bun/bin:%h/.nvm/versions/node/v22.17.0/bin:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="TELEGRAM_STATE_DIR=%h/resume/.claude/telegram"
Environment="TERM=xterm-256color"
ExecStart=%h/.local/bin/claude-service-exec
ExecStartPost=%h/.local/bin/claude-service-notify start claude-resume
ExecStopPost=%h/.local/bin/claude-service-notify stop claude-resume
Restart=always
RestartSec=5
StandardOutput=append:%h/.claude/logs/claude-resume.log
StandardError=append:%h/.claude/logs/claude-resume.log
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=default.target
