def empty_mcp_config(run_dir):
    """빈 MCP 설정 파일 경로. 없으면 만든다.

    라운드 안의 콜이 병렬이라 여럿이 동시에 들어올 수 있다 — 쓰다 만 파일을 다른 콜이
    읽으면 claude 가 시작도 못 하므로 임시 이름에 쓰고 rename 한다.
    """
    p = Path(run_dir) / "empty-mcp.json"
    if not p.exists():
        tmp = p.with_name(f".empty-mcp.{os.getpid()}.{threading.get_ident()}.tmp")
        tmp.write_text('{"mcpServers":{}}', encoding="utf-8")
        os.replace(tmp, p)
    return p


