#!/usr/bin/env bash
# claude.ai 커넥터(MCP) session-expired 자동복구 v2 (ai-debate run-20260723T061618Z 반영).
# 증분 스캔 LLM 이 "실제 MCP 도구 호출"이 인증/세션만료 오류로 실패한 걸 확인했을 때만 호출한다.
# (메일·메시지 '본문'에 'session expired' 문자열이 있는 경우는 절대 트리거 아님 — 프롬프트 인젝션 가드)
#
# 설계 요지:
#  - 즉시 재스캔(SSH 원샷)은 두지 않는다. last_check.txt 는 실패 시 전진 안 하므로, 재시작 후
#    다음 매시 :04 스캔이 놓친 구간을 그대로 재처리한다(데이터 손실 X, 최대 ~1h 지연).
#  - incident latch: 한 incident(만료 국면) 당 재시작 1회. 이미 active 면 재시작 대신 재로그인 알림.
#    성공한 전체 커넥터 스캔이 --clear 로 latch 를 푼다.
#  - 하루 재시작 상한 3회(날짜 바뀌면 리셋). flock 으로 동시호출 직렬화.
#  - 실제 재시작은 세션 프로세스 밖 transient user 유닛(systemd-run)에서 수행 → 헬퍼가 자기 자신을
#    죽이며 상태기록이 끊기는 일 없음(incident 기록 후 재시작 예약, 헬퍼는 즉시 반환).
#
# 사용법:
#   claude-mcp-recover            # 만료 확인 시 복구(조건 맞으면 재시작 예약)
#   claude-mcp-recover --clear    # 스캔 정상완료 시 incident latch 해제 + 알림마커 제거
#                                 # (래치가 이미 내려가 있으면 recover 경로가 알아서 마커를 치운다)
#   claude-mcp-recover --dry-run  # 무엇을 할지만 출력, 아무 것도 안 함
#   claude-mcp-recover --status   # 현재 incident 상태 출력
#   → 10/11 로 끝나면 출력의 alert=yes/no 가 알림 여부를 정한다. 표식 파일 생성도 이 안에서 한다.
#
# 종료코드: 0 정상(복구 예약/해제/무동작), 10 INCIDENT_ACTIVE(알림만), 11 DAILY_CAP(알림만),
#           1 오류. LLM 은 10/11 이면 재시작 기대 말고 "재로그인 필요" 1줄 알림.
set -uo pipefail

UNIT="claude-dotfiles.service"
DAILY_CAP=3
STATE_DIR="$HOME/.claude/state"
INCIDENT="$STATE_DIR/mcp-incident.json"     # {active:bool, day:"YYYY-MM-DD", count:int}
# 사람에게 "재로그인 필요" 를 이미 한 번 알렸다는 표시. 만료 국면이 끝나면 같이 지워야
# 다음 국면에서 다시 알릴 수 있다. 지우는 일을 프롬프트가 Bash 로 직접 하면 .claude 경로를
# 건드리는 삭제라 매 tick 승인창이 뜬다 — 래치 해제와 한 몸이니 여기서 같이 지운다
# (2026-08-25 peer-dotfiles 요청, 실제로 17:14 tick 에서 승인창이 떴다).
ALERTED="$STATE_DIR/mcp-alerted"
LOCK="$STATE_DIR/mcp-recover.lock"
mkdir -p "$STATE_DIR"

# 안전가드: peer 전용 도구. 다른 머신엔 동명 claude-dotfiles.service 가 있을 수 있어
# (home 도 세션명 dotfiles) 잘못 실행되면 엉뚱한 세션을 재시작한다. machine-id 로 fail-safe.
MID=""
[ -f "$HOME/.config/claude-machine-id" ] && MID=$(cat "$HOME/.config/claude-machine-id" 2>/dev/null)
if [ "$MID" != "peer" ]; then
  echo "WRONG_MACHINE: 이 헬퍼는 peer 전용(현재 machine-id='$MID'). 아무 것도 안 함."
  exit 0
fi

MODE=recover
case "${1:-}" in
  --clear)   MODE=clear ;;
  --dry-run) MODE=dry ;;
  --status)  MODE=status ;;
  "")        MODE=recover ;;
  *) echo "unknown arg: $1" >&2; exit 1 ;;
esac

today=$(date +%Y-%m-%d)

# ---- 상태 로드 (flock 로 직렬화) ----
exec 9>"$LOCK"
if ! flock -n 9; then
  echo "LOCK_BUSY: 다른 복구가 진행 중 — 이번 호출은 무동작."
  exit 0
fi

active=false; day=""; count=0
if [ -f "$INCIDENT" ]; then
  active=$(jq -r '.active // false' "$INCIDENT" 2>/dev/null || echo false)
  day=$(jq -r '.day // ""' "$INCIDENT" 2>/dev/null || echo "")
  count=$(jq -r '.count // 0' "$INCIDENT" 2>/dev/null || echo 0)
fi
case "$count" in ''|*[!0-9]*) count=0 ;; esac
# 날짜 바뀌면 카운트 리셋(latch 는 유지: active 는 성공스캔으로만 해제)
if [ "$day" != "$today" ]; then day="$today"; count=0; fi

write_state() { # $1=active $2=count
  printf '{"active":%s,"day":"%s","count":%s}\n' "$1" "$today" "$2" > "$INCIDENT.tmp" \
    && mv -f "$INCIDENT.tmp" "$INCIDENT"
}

# 표식은 래치에 종속된다 — 국면이 안 열려 있으면 지난 국면의 잔재고 유효하지 않다.
# 남아 있으면 다음 만료 국면에서 "이미 알렸다"로 읽혀 알림이 한 번도 안 나간다(침묵 실패).
# 래치가 false 인데 표식만 남는 조합은 실제로 났다(2026-08-27 14:45 옆 기계 관측). 증분 규격
# 7b 는 active=true 일 때만 --clear 를 부르므로 그 조합은 아무도 안 치운다. 그래서 해제
# 경로가 아니라 여기서 스스로 치운다 — 이 헬퍼는 다음 국면이 열릴 때 반드시 불리므로
# 표식이 해를 끼치기 직전에 걸린다. tick 마다 부르는 게 아니라 추가 비용이 없다.
# --status 는 진단용이라 안 고친다. --clear 는 아래에서 무조건 지운다.
stale_alerted=false
if [ "$active" != "true" ] && [ -e "$ALERTED" ]; then
  stale_alerted=true
  if [ "$MODE" = recover ]; then
    rm -f "$ALERTED"
    echo "STALE_ALERT_CLEARED: 래치가 내려간 상태의 알림 표식을 지웠다(지난 국면 잔재)."
  elif [ "$MODE" = dry ]; then
    echo "DRY: 래치가 내려간 상태의 알림 표식을 지울 것(지난 국면 잔재)."
  fi
fi

if [ "$MODE" = status ]; then
  alerted=no; [ -e "$ALERTED" ] && alerted=yes
  echo "active=$active day=$day count=$count/$DAILY_CAP alerted=$alerted stale_alerted=$stale_alerted"
  exit 0
fi

if [ "$MODE" = clear ]; then
  write_state false "$count"
  alerted_note="없음"
  if [ -e "$ALERTED" ]; then
    rm -f "$ALERTED" && alerted_note="지움"
  fi
  echo "CLEARED: incident latch 해제(count 유지 $count, 알림마커 $alerted_note)."
  exit 0
fi

# 알림 표식을 만드는 쪽도 여기 둔다 — 프롬프트가 Bash 로 touch 하면 .claude 밑 쓰기라
# 허용 규칙과 무관하게 매 tick 승인창이 뜨고, 그 대기는 대화 기록에 안 남아 세션이 조용히
# 멈춘다. 지우는 쪽(--clear·stale 정리)은 이미 이 안에 있었는데 만드는 쪽만 명령줄에 남아
# 짝이 안 맞았다. 호출자는 출력의 alert=yes/no 만 보고 알릴지 정한다.
# (2026-09-01 태스크 정리 — ai-debate run-20260901T021126Z 6번 판정.)
alert_gate() {
  if [ "$MODE" = dry ]; then
    if [ -e "$ALERTED" ]; then echo "  alert=no (표식 있음 — 추가 알림 안 함)"
    else echo "  alert=yes (표식을 만들 것)"; fi
    return
  fi
  if [ -e "$ALERTED" ]; then
    echo "  alert=no  이미 이 국면에서 알렸다. 추가 알림 금지."
  else
    : > "$ALERTED"
    echo "  alert=yes 사용자에게 'claude.ai 재로그인 필요 가능(커넥터 반복 만료)' 1줄 알림."
  fi
}

# ---- recover / dry ----
if [ "$active" = "true" ]; then
  echo "INCIDENT_ACTIVE: 이미 이 국면에서 재시작함(아직 성공스캔으로 해제 안 됨). 재시작 안 함."
  alert_gate
  exit 10
fi
if [ "$count" -ge "$DAILY_CAP" ]; then
  echo "DAILY_CAP: 오늘 재시작 ${count}/${DAILY_CAP} 도달. 재시작 안 함."
  alert_gate
  exit 11
fi

newcount=$((count + 1))
ts=$(date +%s)
RUNIT="claude-mcp-restart-${ts}"

if [ "$MODE" = dry ]; then
  echo "[dry-run] incident 기록: active=true day=$today count=$newcount"
  echo "[dry-run] systemd-run --user --on-active=2s --unit=$RUNIT --collect systemctl --user restart $UNIT"
  echo "[dry-run] 실제로는 아무것도 하지 않음."
  exit 0
fi

# incident 를 먼저 원자적으로 기록(재시작이 헬퍼를 죽여도 기록은 남음)
write_state true "$newcount"

# 세션 프로세스 밖 transient 유닛에서 2초 뒤 재시작(헬퍼는 즉시 반환, flock 해제).
if systemd-run --user --on-active=2s --unit="$RUNIT" --collect \
     systemctl --user restart "$UNIT" 2>/tmp/mcp-restart-schedule.err; then
  echo "RECOVER: 2s 뒤 $UNIT 재시작 예약(incident active, count=$newcount)."
  echo "  → 이 tick 은 여기서 중단(나머지 스캔단계 스킵, last_check 미전진). 다음 :04 스캔이 놓친 구간 재처리."
  exit 0
else
  # 예약 실패면 incident 를 되돌린다(재시작 안 됐으니 다음 시도 허용).
  write_state false "$count"
  echo "RESTART_SCHEDULE_FAIL: 재시작 예약 실패 — incident 롤백. 사유:"
  head -3 /tmp/mcp-restart-schedule.err 2>/dev/null
  exit 1
fi
